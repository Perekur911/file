def get_act_columns(act_wb) -> list[str]:
    ws = act_wb[ACT_SHEET]
    max_col = ws.max_column

    headers: list[str] = []

    for col in range(1, max_col + 1):
        value = ws.cell(ACT_HEADER_ROW, col).value
        text = normalize_text(value)
        if text:
            headers.append(text)
        else:
            headers.append(f"__blank_{col}")

    headers.append("sampleCode")
    return headers


def write_defined_name_value(wb, name: str, value: Any) -> None:
    if name not in wb.defined_names:
        raise ValueError(f"В шаблоне акта нет именованного диапазона {name!r}")

    dn = wb.defined_names[name]

    destinations = list(dn.destinations)
    if not destinations:
        raise ValueError(f"Именованный диапазон {name!r} не указывает на ячейку")

    sheet_name, coord = destinations[0]
    ws = wb[sheet_name]
    ws[coord].value = value_for_excel(value)


def clear_and_write_act_table(act_wb, act_rows: list[dict[str, Any]], columns: list[str]) -> None:
    ws = act_wb[ACT_SHEET]

    available_rows = ACT_MAX_TEMPLATE_ROW - ACT_DATA_START_ROW + 1

    if len(act_rows) > available_rows:
        raise ValueError(
            f"В шаблоне акта хватает строк только на {available_rows} проб, "
            f"а нужно записать {len(act_rows)}. Добавь строки в шаблон или расширь скрипт."
        )

    col_count = len(columns)
    start_col = ACT_DATA_START_COL
    end_col = start_col + col_count - 1

    # Полностью очищаем строки шаблона под данные, включая hidden sampleCode.
    for row_idx in range(ACT_DATA_START_ROW, ACT_MAX_TEMPLATE_ROW + 1):
        ws.row_dimensions[row_idx].hidden = False
        for col_idx in range(start_col, end_col + 1):
            ws.cell(row_idx, col_idx).value = None

    # Пишем строки.
    for row_offset, row_data in enumerate(act_rows):
        excel_row = ACT_DATA_START_ROW + row_offset
        ws.row_dimensions[excel_row].hidden = False

        for col_offset, column_name in enumerate(columns):
            excel_col = start_col + col_offset

            value = row_data.get(column_name)
            ws.cell(excel_row, excel_col).value = value_for_excel(value)

    # Скрываем неиспользуемые строки до 32 включительно.
    first_unused = ACT_DATA_START_ROW + len(act_rows)

    for row_idx in range(first_unused, ACT_MAX_TEMPLATE_ROW + 1):
        ws.row_dimensions[row_idx].hidden = True

    # Последний служебный столбец sampleCode скрываем.
    sample_code_col = start_col + len(columns) - 1
    ws.column_dimensions[get_column_letter(sample_code_col)].hidden = True


