Public Sub createSampleCodeGOR2(Optional numPage As Integer)
    
    Dim sheetGOR As Worksheet
    Set sheetGOR = ActiveWorkbook.Worksheets("GOR")
    pageRow = sheetGOR.Range("GOR_1_page").row
    Dim page As Integer
    Dim pageRange As Range
    
    If Not sheetGOR.Shapes(Application.Caller) Is Nothing Then
        Set pageRange = sheetGOR.Cells(pageRow, (sheetGOR.Shapes(Application.Caller).TopLeftCell.Column))
        If NameExist2(pageRange) Then
            If pageRange.name.name Like "GOR_#*_page" Then
                page = pageRange.value
            Else
                Exit Sub
            End If
        End If
    End If
    If numPage <> 0 Then
        page = numPage
    ElseIf page = 0 Then
        Exit Sub
    End If
    If sheetGOR.Range("GOR_" & page & "_sampleCode").value = "" Then
        MsgBox "Íå çàïîëíåí øèôð èññëåäóåìîé ïðîáû."
        Exit Sub
    End If
    Dim GOR_samples_table As ListObject
    Set GOR_samples_table = sheetGOR.ListObjects("GOR_" & page)
    
    If sheetGOR.Range("GOR_" & page & "_sampleCode").value = "" Then
        Exit Sub
    End If
    Dim countVial As Variant
    Dim countBottle As Variant
    Dim countTedlarBag As Variant
    Dim countPics As Variant
    
    countVial = sheetGOR.Range("GOR_" & page & "_vial").value
    countBottle = sheetGOR.Range("GOR_" & page & "_bottle").value
    countTedlarBag = sheetGOR.Range("GOR_" & page & "_TedlarBag").value
    countPics = sheetGOR.Range("GOR_" & page & "_pics").value
    analyseNumber = sheetGOR.Range("GOR_" & page & "_analyseNumber").value
    
    Dim sampleCodeLPh As New Collection
    Dim sampleCodeGPh As New Collection
    Dim sampleCodePrefix As String
    Dim sampleCodePostfix As String
    
    If analyseNumber = "1" Then
        sampleCodePrefix = sheetGOR.Range("GOR_" & page & "_sampleCode").value & "-GOR-"
    Else
        sampleCodePrefix = sheetGOR.Range("GOR_" & page & "_sampleCode").value & "-GOR" & analyseNumber & "-"
    End If
    
    If IsNumeric(countVial) And countVial <> 0 Then
        
        If sheetGOR.Range("GOR_" & page & "_m2").value - sheetGOR.Range("GOR_" & page & "_m0").value > 0.4 Then
            sampleCodePostfix = "L"
        Else
            sampleCodePostfix = "Rinse"
        End If
        If countVial > 1 Then
            For i = 1 To countVial
                sampleCodeLPh.Add (sampleCodePrefix & sampleCodePostfix & i)
            Next i
        ElseIf countVial = 1 Then
            sampleCodeLPh.Add (sampleCodePrefix & sampleCodePostfix)
        End If
    End If
    
    If IsNumeric(countPics) And countPics <> 0 Then
        sampleCodePostfix = ""
        If IsNumeric(sheetGOR.Range("GOR_" & page & "_VHeTot").value) Then
            If sheetGOR.Range("GOR_" & page & "_VHeTot") > 0 Then
                sampleCodePostfix = "-He"
            End If
        End If
        If countPics > 1 Then
            For i = 1 To countPics
                sampleCodeGPh.Add (sampleCodePrefix & "G" & i & sampleCodePostfix)
            Next i
        ElseIf countPics = 1 Then
            sampleCodeGPh.Add (sampleCodePrefix & "G" & sampleCodePostfix)
        End If
    End If
    
    If IsNumeric(countTedlarBag) And countTedlarBag <> 0 Then
        sampleCodePostfix = ""
        If IsNumeric(sheetGOR.Range("GOR_" & page & "_VHeTot").value) Then
            If sheetGOR.Range("GOR_" & page & "_VHeTot") > 0 Then
                sampleCodePostfix = "-He"
            End If
        End If
        If countTedlarBag > 1 Then
            For i = 1 To countTedlarBag
                sampleCodeGPh.Add (sampleCodePrefix & "TB" & i & sampleCodePostfix)
            Next i
        ElseIf countTedlarBag = 1 Then
            sampleCodeGPh.Add (sampleCodePrefix & "TB" & sampleCodePostfix)
        End If
    End If
    
    If IsNumeric(countBottle) And countBottle <> 0 Then
        
        sampleCodePostfix = "LB"
            
        If countBottle > 1 Then
            For i = 1 To countBottle
                sampleCodeLPh.Add (sampleCodePrefix & sampleCodePostfix & i)
            Next i
        ElseIf countBottle = 1 Then
            sampleCodeLPh.Add (sampleCodePrefix & sampleCodePostfix)
        End If
    End If
    
    ' ïîêàç ôîðìû
    Dim frm As New frmCheckCodes
    frm.InitWithCollections sampleCodeLPh, sampleCodeGPh, "GOR", sheetGOR.Range("GOR_" & page & "_sampleCode"), page
    frm.show

    Dim arrSamples() As String
    Dim countSamples As Integer
    countSamples = sampleCodeLPh.count + sampleCodeGPh.count
    ReDim arrSamples(1 To countSamples, 1 To GOR_samples_table.ListColumns.count)
    
    rowDiff = GOR_samples_table.ListRows.count - sampleCodeLPh.count - sampleCodeGPh.count
    If rowDiff > 0 Then
        For i = rowDiff To 1 Step -1
            GOR_samples_table.ListRows(GOR_samples_table.ListRows.count).Delete
        Next i
    ElseIf rowDiff < 0 Then
        For i = -1 * rowDiff To 1 Step -1
            GOR_samples_table.ListRows.Add
        Next i
    End If
    
    If frm.result Then
        For i = 1 To sampleCodeLPh.count
            arrSamples(i, GOR_samples_table.ListColumns("sampleCode").index) = sampleCodeLPh(i)
            arrSamples(i, GOR_samples_table.ListColumns("TypePh").index) = "LPh"
            If sheetGOR.Range("GOR_" & page & "_resultIdGOR").value > 0 Then
                arrSamples(i, GOR_samples_table.ListColumns("resultIdGOR").index) = sheetGOR.Range("GOR_" & page & "_resultIdGOR").value
            End If
            arrSamples(i, GOR_samples_table.ListColumns("rowIdGOR").index) = GOR_samples_table.ListColumns("rowIdGOR").DataBodyRange(i, 1)
            'Debug.Print sampleCodeLPh(i)
        Next i
        
        For i = 1 To sampleCodeGPh.count
            arrSamples(i + sampleCodeLPh.count, GOR_samples_table.ListColumns("sampleCode").index) = sampleCodeGPh(i)
            arrSamples(i + sampleCodeLPh.count, GOR_samples_table.ListColumns("TypePh").index) = "GPh"
            If sheetGOR.Range("GOR_" & page & "_resultIdGOR").value > 0 Then
                arrSamples(i + sampleCodeLPh.count, GOR_samples_table.ListColumns("resultIdGOR").index) = sheetGOR.Range("GOR_" & page & "_resultIdGOR").value
            End If
            arrSamples(i + sampleCodeLPh.count, GOR_samples_table.ListColumns("rowIdGOR").index) = GOR_samples_table.ListColumns("rowIdGOR").DataBodyRange(i + sampleCodeLPh.count, 1)
            'Debug.Print sampleCodeGPh(i)
        Next i
        
        GOR_samples_table.DataBodyRange = arrSamples
        
        Dim printArea() As String
        printArea = Split(sheetGOR.PageSetup.printArea, ":")
        Dim lastRow As Long
        lastRow = Cells.Find("*", SearchOrder:=xlByRows, SearchDirection:=xlPrevious).row
        sheetGOR.PageSetup.printArea = printArea(0) & ":" & sheetGOR.Cells(lastRow, sheetGOR.Range(printArea(1)).Column).Address
    Else
        MsgBox "????", vbInformation
    End If
    
End Sub


Public Function CreateSampleCodeGOR3(Optional ByVal formIndex As Long = 0) As Boolean

    CreateSampleCodeGOR3 = False

    Dim sheetGOR As Worksheet
    Set sheetGOR = ActiveWorkbook.Worksheets("GOR")

    If formIndex <= 0 Then Exit Function

    If Not NamedRangeExists(ActiveWorkbook, "GOR_" & formIndex & "_sampleCode") Then
        MsgBox "Ôîðìà GOR_" & formIndex & " íå íàéäåíà."
        Exit Function
    End If

    If sheetGOR.Range("GOR_" & formIndex & "_sampleCode").value = "" Then
        MsgBox "Íå çàïîëíåí øèôð èññëåäóåìîé ïðîáû."
        Exit Function
    End If

    If sheetGOR.Range("GOR_" & formIndex & "_sampleCode").value = "" Then
        MsgBox "Íå çàïîëíåí øèôð èññëåäóåìîé ïðîáû."
        Exit Function
    End If

    Dim GORSamplesTable As ListObject
    Set GORSamplesTable = sheetGOR.ListObjects("GOR_source_" & formIndex)

    Dim countVial As Variant
    Dim countBottle As Variant
    Dim countTedlarBag As Variant
    Dim countPics As Variant
    Dim analyseNumber As Variant

    countVial = sheetGOR.Range("GOR_" & formIndex & "_vial").value
    countBottle = sheetGOR.Range("GOR_" & formIndex & "_bottle").value
    countTedlarBag = sheetGOR.Range("GOR_" & formIndex & "_TedlarBag").value
    countPics = sheetGOR.Range("GOR_" & formIndex & "_pics").value
    analyseNumber = sheetGOR.Range("GOR_" & formIndex & "_analyseNumber").value
    
    If Not countVial & countBottle & countTedlarBag & countPics Like "*#*" Then
        MsgBox "Íå óêàçàíî íè îäíîé ïîëó÷åííîé ïðîáû."
        Exit Function
    End If
    
    Dim sampleCodeLPh As New Collection
    Dim sampleCodeGPh As New Collection

    Dim sampleCodePrefix As String
    Dim sampleCodePostfix As String

    If analyseNumber = "1" Then
        sampleCodePrefix = sheetGOR.Range("GOR_" & formIndex & "_sampleCode").value & "-GOR-"
    Else
        sampleCodePrefix = sheetGOR.Range("GOR_" & formIndex & "_sampleCode").value & "-GOR" & analyseNumber & "-"
    End If

    Dim i As Long

    If IsNumeric(countVial) And countVial <> 0 Then

        If sheetGOR.Range("GOR_" & formIndex & "_m2").value - sheetGOR.Range("GOR_" & formIndex & "_m0").value > 0.4 Then
            sampleCodePostfix = "L"
        Else
            sampleCodePostfix = "Rinse"
        End If

        If countVial > 1 Then
            For i = 1 To countVial
                sampleCodeLPh.Add sampleCodePrefix & sampleCodePostfix & i
            Next i
        ElseIf countVial = 1 Then
            sampleCodeLPh.Add sampleCodePrefix & sampleCodePostfix
        End If

    End If

    If IsNumeric(countPics) And countPics <> 0 Then

        sampleCodePostfix = ""

        If IsNumeric(sheetGOR.Range("GOR_" & formIndex & "_VHeTot").value) Then
            If sheetGOR.Range("GOR_" & formIndex & "_VHeTot").value > 0 Then
                sampleCodePostfix = "-He"
            End If
        End If

        If countPics > 1 Then
            For i = 1 To countPics
                sampleCodeGPh.Add sampleCodePrefix & "G" & i & sampleCodePostfix
            Next i
        ElseIf countPics = 1 Then
            sampleCodeGPh.Add sampleCodePrefix & "G" & sampleCodePostfix
        End If

    End If

    If IsNumeric(countTedlarBag) And countTedlarBag <> 0 Then

        sampleCodePostfix = ""

        If IsNumeric(sheetGOR.Range("GOR_" & formIndex & "_VHeTot").value) Then
            If sheetGOR.Range("GOR_" & formIndex & "_VHeTot").value > 0 Then
                sampleCodePostfix = "-He"
            End If
        End If

        If countTedlarBag > 1 Then
            For i = 1 To countTedlarBag
                sampleCodeGPh.Add sampleCodePrefix & "TB" & i & sampleCodePostfix
            Next i
        ElseIf countTedlarBag = 1 Then
            sampleCodeGPh.Add sampleCodePrefix & "TB" & sampleCodePostfix
        End If

    End If

    If IsNumeric(countBottle) And countBottle <> 0 Then

        sampleCodePostfix = "LB"

        If countBottle > 1 Then
            For i = 1 To countBottle
                sampleCodeLPh.Add sampleCodePrefix & sampleCodePostfix & i
            Next i
        ElseIf countBottle = 1 Then
            sampleCodeLPh.Add sampleCodePrefix & sampleCodePostfix
        End If

    End If

    Dim countSamples As Long
    countSamples = sampleCodeLPh.count + sampleCodeGPh.count

    If countSamples = 0 Then
        MsgBox "Ñòðàíèöà " & formIndex & ": íå ñôîðìèðîâàíî íè îäíîãî øèôðà ïîëó÷åííîé ïðîáû.", vbExclamation
        Exit Function
    End If

    ' Ïîêàç ôîðìû ïðîâåðêè/ðåäàêòèðîâàíèÿ øèôðîâ.
    Dim frm As New frmCheckCodes
    frm.InitWithCollections sampleCodeLPh, sampleCodeGPh, "GOR", sheetGOR.Range("GOR_" & formIndex & "_sampleCode"), formIndex
    frm.show

    If Not frm.result Then
        MsgBox "Ââîä øèôðîâ äëÿ ñòðàíèöû " & formIndex & " îòìåíåí.", vbInformation
        Exit Function
    End If

    If GORSamplesTable.DataBodyRange Is Nothing Then
        GORSamplesTable.ListRows.Add
    End If

    ' Ñîõðàíÿåì ñòàðûå rowIdGOR ïî íîìåðàì ñòðîê.
    ' Ýòî âàæíî, åñëè ÷àñòü ïðîá óäàëèëè: ñòàðàÿ ñòðîêà ñ rowIdGOR äîëæíà óéòè â Python ïóñòîé,
    ' ÷òîáû òàì ìîæíî áûëî óäàëèòü child-çàïèñü èç ÁÄ.
    Dim oldRowIds As Object
    Set oldRowIds = CreateObject("Scripting.Dictionary")
    oldRowIds.CompareMode = vbTextCompare

    Dim oldRowsCount As Long
    oldRowsCount = GORSamplesTable.ListRows.count

    If ListColumnExists(GORSamplesTable, COL_GOR_ROW_ID_DB) Then
        For i = 1 To oldRowsCount
            oldRowIds(CStr(i)) = NormalizeKeyValue( _
                GORSamplesTable.DataBodyRange.Cells( _
                    i, _
                    GORSamplesTable.ListColumns(COL_GOR_ROW_ID_DB).index _
                ).value _
            )
        Next i
    End If

    Dim targetRowsCount As Long
    targetRowsCount = countSamples

    If oldRowsCount > targetRowsCount Then
        targetRowsCount = oldRowsCount
    End If

    Dim rowDiff As Long
    rowDiff = GORSamplesTable.ListRows.count - targetRowsCount

    If rowDiff > 0 Then
        For i = rowDiff To 1 Step -1
            GORSamplesTable.ListRows(GORSamplesTable.ListRows.count).Delete
        Next i
    ElseIf rowDiff < 0 Then
        For i = -1 * rowDiff To 1 Step -1
            GORSamplesTable.ListRows.Add
        Next i
    End If

    Dim arrSamples() As Variant
    ReDim arrSamples(1 To targetRowsCount, 1 To GORSamplesTable.ListColumns.count)

    Dim parentResultId As String
    parentResultId = NormalizeKeyValue(sheetGOR.Range("GOR_" & formIndex & "_resultIdGOR").value)

    Dim rowIndex As Long
    rowIndex = 1

    For i = 1 To sampleCodeLPh.count

        arrSamples(rowIndex, GORSamplesTable.ListColumns(COL_GOR_SAMPLE_CODE_DB).index) = sampleCodeLPh(i)
        arrSamples(rowIndex, GORSamplesTable.ListColumns(COL_GOR_TYPE_PH_DB).index) = "LPh"

        If ListColumnExists(GORSamplesTable, COL_GOR_RESULT_ID_DB) Then
            If Len(parentResultId) > 0 And parentResultId <> "0" Then
                arrSamples(rowIndex, GORSamplesTable.ListColumns(COL_GOR_RESULT_ID_DB).index) = parentResultId
            End If
        End If

        If ListColumnExists(GORSamplesTable, COL_GOR_ROW_ID_DB) Then
            If oldRowIds.Exists(CStr(rowIndex)) Then
                arrSamples(rowIndex, GORSamplesTable.ListColumns(COL_GOR_ROW_ID_DB).index) = oldRowIds(CStr(rowIndex))
            End If
        End If

        rowIndex = rowIndex + 1

    Next i

    For i = 1 To sampleCodeGPh.count

        arrSamples(rowIndex, GORSamplesTable.ListColumns(COL_GOR_SAMPLE_CODE_DB).index) = sampleCodeGPh(i)
        arrSamples(rowIndex, GORSamplesTable.ListColumns(COL_GOR_TYPE_PH_DB).index) = "GPh"

        If ListColumnExists(GORSamplesTable, COL_GOR_RESULT_ID_DB) Then
            If Len(parentResultId) > 0 And parentResultId <> "0" Then
                arrSamples(rowIndex, GORSamplesTable.ListColumns(COL_GOR_RESULT_ID_DB).index) = parentResultId
            End If
        End If

        If ListColumnExists(GORSamplesTable, COL_GOR_ROW_ID_DB) Then
            If oldRowIds.Exists(CStr(rowIndex)) Then
                arrSamples(rowIndex, GORSamplesTable.ListColumns(COL_GOR_ROW_ID_DB).index) = oldRowIds(CStr(rowIndex))
            End If
        End If

        rowIndex = rowIndex + 1

    Next i

    ' Îñòàëüíûå ñòàðûå ñòðîêè îñòàâëÿåì ïóñòûìè, íî ñ rowIdGOR/resultIdGOR.
    ' Òàê Python ïîéìåò, ÷òî ýòè child-ñòðîêè íàäî óäàëèòü.
    For i = rowIndex To targetRowsCount

        If ListColumnExists(GORSamplesTable, COL_GOR_ROW_ID_DB) Then
            If oldRowIds.Exists(CStr(i)) Then
                arrSamples(i, GORSamplesTable.ListColumns(COL_GOR_ROW_ID_DB).index) = oldRowIds(CStr(i))
            End If
        End If

        If ListColumnExists(GORSamplesTable, COL_GOR_RESULT_ID_DB) Then
            If Len(parentResultId) > 0 And parentResultId <> "0" Then
                arrSamples(i, GORSamplesTable.ListColumns(COL_GOR_RESULT_ID_DB).index) = parentResultId
            End If
        End If

    Next i

    GORSamplesTable.DataBodyRange.NumberFormat = "@"
    GORSamplesTable.DataBodyRange.value = arrSamples

    Dim printArea() As String
    printArea = Split(sheetGOR.PageSetup.printArea, ":")

    Dim lastRow As Long
    lastRow = sheetGOR.Cells.Find("*", SearchOrder:=xlByRows, SearchDirection:=xlPrevious).row

    sheetGOR.PageSetup.printArea = printArea(0) & ":" & _
                                   sheetGOR.Cells(lastRow, sheetGOR.Range(printArea(1)).Column).Address

    CreateSampleCodeGOR3 = True

End Function

Public Sub Load_GOR_results_to_forms( _
    Optional ByVal mode As String = "by_key", _
    Optional ByVal fields As Variant _
)

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetGOR As Worksheet
    Set sheetGOR = wb.Worksheets("GOR")

    Dim resultTable As ListObject
    Set resultTable = wb.Worksheets("GOR_results").ListObjects("GOR_results")

    Dim sourceTable As ListObject
    Set sourceTable = wb.Worksheets("GOR_sourceData").ListObjects("GOR_sourceData")

    Dim fieldFilter As Object
    Set fieldFilter = BuildFieldFilter(fields)

    mode = LCase$(Trim$(mode))

    If mode <> "by_key" And mode <> "sequential" Then
        Err.Raise vbObjectError + 5101, , "mode äîëæåí áûòü 'by_key' èëè 'sequential'"
    End If

    If resultTable.DataBodyRange Is Nothing Then Exit Sub

    Dim resultRowIndex As Long
    Dim formIndex As Long
    Dim notFoundCount As Long

    For resultRowIndex = 1 To resultTable.ListRows.count

        If mode = "sequential" Then
            formIndex = resultRowIndex
            EnsureGORFormExists wb, formIndex
        Else
            formIndex = FindFormIndexForResultRow( _
                wb, _
                sheetGOR, _
                resultTable, _
                resultRowIndex, _
                "GOR", _
                Array("sampleCode", "analyseNumber") _
            )
        End If

        If formIndex = 0 Or Not NamedRangeExists(wb, "GOR_" & formIndex & "_sampleCode") Then
            notFoundCount = notFoundCount + 1
            GoTo NextResultRow
        End If

        FillOneGORFormFromResultRow _
            wb, _
            sheetGOR, _
            resultTable, _
            sourceTable, _
            resultRowIndex, _
            formIndex, _
            fieldFilter

NextResultRow:
    Next resultRowIndex

    If notFoundCount > 0 Then
        MsgBox "Äàííûå GOR ïåðåíåñåíû ÷àñòè÷íî. Íå íàéäåíî ôîðì: " & notFoundCount, vbExclamation
    End If

End Sub


Private Sub EnsureGORFormExists( _
    ByVal wb As Workbook, _
    ByVal formIndex As Long _
)
    Do While Not NamedRangeExists(wb, "GOR_" & formIndex & "_sampleCode")
        Call InsertListGOR2
    Loop
End Sub


Private Sub FillOneGORFormFromResultRow( _
    ByVal wb As Workbook, _
    ByVal sheetGOR As Worksheet, _
    ByVal resultTable As ListObject, _
    ByVal sourceTable As ListObject, _
    ByVal resultRowIndex As Long, _
    ByVal formIndex As Long, _
    ByVal fieldFilter As Object _
)

    Dim resultId As Variant
    resultId = GetTableValue(resultTable, resultRowIndex, COL_GOR_RESULT_ID_DB)

    Call CopyTableRowToNamedRanges( _
        wb, _
        sheetGOR, _
        resultTable, _
        resultRowIndex, _
        "GOR", _
        formIndex, _
        fieldFilter _
    )

    If Len(NormalizeKeyValue(resultId)) > 0 Then
        FillGORSourceTableFromSourceData sheetGOR, sourceTable, formIndex, resultId, fieldFilter
    End If

End Sub


Private Sub FillGORSourceTableFromSourceData( _
    ByVal sheetGOR As Worksheet, _
    ByVal sourceTable As ListObject, _
    ByVal formIndex As Long, _
    ByVal resultId As Variant, _
    ByVal fieldFilter As Object _
)

    Dim formSourceTable As ListObject
    Set formSourceTable = sheetGOR.ListObjects("GOR_source_" & formIndex)

    If formSourceTable.DataBodyRange Is Nothing Then
        Exit Sub
    End If

    Call ClearMappedColumnsInTable( _
        formSourceTable, _
        GORSourceMappings(), _
        fieldFilter _
    )

    Call CopyMatchingTableRowsToTableRows( _
        sourceTable, _
        formSourceTable, _
        COL_GOR_RESULT_ID_DB, _
        resultId, _
        GORSourceMappings(), _
        fieldFilter _
    )

End Sub


