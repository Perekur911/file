Public Function Save_GOR(Optional ByVal taskStatus As String = "") As macroResult
    
    Save_GOR = MACRO_FAILED
    Dim t0 As Double
    Dim t As Double
    
    t0 = Timer
    t = t0

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetGOR As Worksheet
    Set sheetGOR = wb.Worksheets("GOR")

    Dim sheetGORResult As Worksheet
    Set sheetGORResult = wb.Worksheets("GOR_results")

    Dim sheetGORSourceData As Worksheet
    Set sheetGORSourceData = wb.Worksheets("GOR_sourceData")

    Dim tasks As ListObject
    Set tasks = wb.Worksheets("Task").ListObjects(1)

    Dim GORTable As ListObject
    Set GORTable = sheetGORResult.ListObjects("GOR_results")

    Dim GORSourceDataTable As ListObject
    Set GORSourceDataTable = sheetGORSourceData.ListObjects("GOR_sourceData")

    Dim parentRows As Collection
    Set parentRows = New Collection

    Dim childRows As Collection
    Set childRows = New Collection

    Dim validForms As Collection
    Set validForms = New Collection

    Dim oldSourceRowIds As Object
    Set oldSourceRowIds = BuildOldChildRowIdMap( _
        GORSourceDataTable, _
        COL_GOR_ROW_ID_DB, _
        COL_GOR_RESULT_ID_DB _
    )
    
    Dim formState As GORFormState
    Dim i As Long
    Dim x As Long

    i = 1

    Do While NamedRangeExists(wb, "GOR_" & i & "_sampleCode")
        
        formState = Get_GOR_FormState(i)

        Select Case formState
    
            Case GOR_FORM_EMPTY
                GoTo NextFormFirstPass
    
            Case GOR_FORM_RESERVED
                GoTo NextFormFirstPass
    
            Case GOR_FORM_FILLED
                ' èä¸ì äàëüøå
                
        End Select
        
        If sheetGOR.Range("GOR_" & i & "_TaskId").Interior.ColorIndex = 3 Then
            GoTo NextFormFirstPass
        End If
        
        If sheetGOR.Range("GOR_" & i & "_analyseNumber").value = "" Then
            Call checkNumberAnalys2(sheetGOR.Range("GOR_" & i & "_sampleCode").value, "GOR")
        End If
        
        If Not Validate_GOR_Form(i) Then
            Exit Function
        End If
        
        Dim curTask As Variant
        curTask = sheetGOR.Range("GOR_" & i & "_TaskId").value

        If Len(Trim$(CStr(curTask))) > 0 And CLng(val(curTask)) <> 0 Then
            If Not CheckGORTask(tasks, CLng(val(curTask)), CStr(sheetGOR.Range("GOR_" & i & "_sampleCode").value), i) Then
                GoTo NextFormFirstPass
            End If
        End If

        If Not GOR_SourceTableHasValidSampleCodes(i) Then

            Application.ScreenUpdating = True
            DoEvents
            Application.ScreenUpdating = False

            If Not CreateSampleCodeGOR3(i) Then
                GoTo NextFormFirstPass
            End If
        End If
        
        If Not GOR_SourceTableHasValidSampleCodes(i) Then
            MsgBox "Ñòðàíèöà " & i & ": â òàáëèöå GOR_source_" & i & _
                   " íåò íè îäíîãî øèôðà ïîëó÷åííîé ïðîáû ñ óêàçàííûì TypePh.", vbExclamation
            Exit Function
        End If
        
        validForms.Add i

NextFormFirstPass:
        i = i + 1
    Loop

    Debug.Print "GOR v3 after sample forms", _
                "step:", Format$(Timer - t, "0.000"), _
                "total:", Format$(Timer - t0, "0.000")
    t = Timer

    ' 2. Òåïåðü ñîáèðàåì äàííûå èç ôîðì â GOR_results è GOR_sourceData.
    Dim pageValue As Variant

    For Each pageValue In validForms

        i = CLng(pageValue)

        Dim resultIdValue As Variant
        Dim parentKey As String

        resultIdValue = sheetGOR.Range("GOR_" & i & "_resultIdGOR").value

        If Len(NormalizeKeyValue(resultIdValue)) = 0 Or NormalizeKeyValue(resultIdValue) = "0" Then
            parentKey = "temp_" & i
        Else
            parentKey = NormalizeKeyValue(resultIdValue)
        End If

        Dim parentRow() As Variant
        ReDim parentRow(1 To GORTable.ListColumns.count)

        Dim headerCell As Range
        Dim headerName As String
        Dim parentColIndex As Long
        Dim formRangeName As String

        For Each headerCell In GORTable.HeaderRowRange.Cells

            headerName = CStr(headerCell.value)
            parentColIndex = GORTable.ListColumns(headerName).index
            formRangeName = "GOR_" & i & "_" & headerName

            If headerName = "dateTimeSync" Then
                parentRow(parentColIndex) = Format$(Now, "yyyy-mm-dd hh:nn:ss")

            ElseIf headerName = COL_GOR_RESULT_ID_DB Then
                parentRow(parentColIndex) = parentKey

            ElseIf NamedRangeExists(wb, formRangeName) Then
                parentRow(parentColIndex) = FormatValueForSyncText( _
                    headerName, _
                    sheetGOR.Range(formRangeName).value _
                )

            Else
                parentRow(parentColIndex) = vbNullString

            End If

        Next headerCell

        parentRows.Add parentRow

        Dim srcTable As ListObject
        Set srcTable = sheetGOR.ListObjects("GOR_source_" & i)

        If Not srcTable.DataBodyRange Is Nothing Then

            For x = 1 To srcTable.ListRows.count

                Dim hasSourceData As Boolean
                Dim oldRowIdGOR As String

                hasSourceData = SourceRowHasData( _
                    srcTable, _
                    x, _
                    Array(COL_GOR_SAMPLE_CODE_DB, COL_GOR_TYPE_PH_DB), _
                    Array("AND") _
                )

                oldRowIdGOR = GetOldChildRowId(oldSourceRowIds, parentKey, x)

                If Len(oldRowIdGOR) = 0 Then
                    If ListColumnExists(srcTable, COL_GOR_ROW_ID_DB) Then
                        oldRowIdGOR = NormalizeKeyValue( _
                            srcTable.DataBodyRange.Cells( _
                                x, _
                                srcTable.ListColumns(COL_GOR_ROW_ID_DB).index _
                            ).value _
                        )
                    End If
                End If

                ' Äîáàâëÿåì ñòðîêó â GOR_sourceData, åñëè:
                ' 1) åñòü sampleCode + TypePh — insert/update;
                ' 2) äàííûõ óæå íåò, íî åñòü ñòàðûé rowIdGOR — delete.
                If hasSourceData Or Len(oldRowIdGOR) > 0 Then

                    Dim childRow() As Variant
                    ReDim childRow(1 To GORSourceDataTable.ListColumns.count)

                    childRow(GORSourceDataTable.ListColumns(COL_GOR_ROW_ID_DB).index) = oldRowIdGOR
                    childRow(GORSourceDataTable.ListColumns(COL_GOR_RESULT_ID_DB).index) = parentKey

                    If hasSourceData Then

                        childRow(GORSourceDataTable.ListColumns(COL_GOR_SAMPLE_CODE_DB).index) = _
                            FormatValueForSyncText( _
                                COL_GOR_SAMPLE_CODE_DB, _
                                srcTable.DataBodyRange.Cells( _
                                    x, _
                                    srcTable.ListColumns(COL_GOR_SAMPLE_CODE_DB).index _
                                ).value _
                            )

                        childRow(GORSourceDataTable.ListColumns(COL_GOR_TYPE_PH_DB).index) = _
                            FormatValueForSyncText( _
                                COL_GOR_TYPE_PH_DB, _
                                srcTable.DataBodyRange.Cells( _
                                    x, _
                                    srcTable.ListColumns(COL_GOR_TYPE_PH_DB).index _
                                ).value _
                            )

                    End If

                    childRows.Add childRow

                End If

            Next x

        End If

    Next pageValue

    WriteCollectionToListObject GORTable, parentRows
    WriteCollectionToListObject GORSourceDataTable, childRows

    ' 3. Python sync.
    If parentRows.count > 0 Then

        Dim syncResult As String
        syncResult = RunStudySync("save", studies:="GOR", taskStatus:=taskStatus)

        If InStr(1, syncResult, """ok"": true", vbTextCompare) > 0 Then

            Call DeleteEmptyRowsByColumns( _
                GORSourceDataTable, _
                COL_GOR_ROW_ID_DB, _
                Array(COL_GOR_SAMPLE_CODE_DB, COL_GOR_TYPE_PH_DB) _
            )

            ' Âîçâðàùàåì â ôîðìû òîëüêî id:
            ' - resultIdGOR â ðîäèòåëüñêóþ ôîðìó;
            ' - resultIdGOR è rowIdGOR â GOR_source_N.
            Call Load_GOR_results_to_forms( _
                "by_key", _
                Array(COL_GOR_RESULT_ID_DB, COL_GOR_ROW_ID_DB) _
            )
            Save_GOR = MACRO_CHANGED
        Else
            MsgBox "Ñèíõðîíèçàöèÿ GOR íå ïîäòâåðæäåíà êàê óñïåøíàÿ." & vbCrLf & vbCrLf & syncResult, vbExclamation
        End If
    Else
        Save_GOR = MACRO_NO_CHANGES
    End If

End Function



