Sub CreateStepNames( _
    ByVal startCell As Range, _
    ByVal prefix As String, _
    ByVal fieldName As String _
)

    Dim i As Long
    Dim nm As String
    Dim targetCell As Range

    ' st1 ... st10
    For i = 1 To 10
        
        Set targetCell = startCell.Offset(0, i - 1)
        
        nm = prefix & "_st" & i & "_" & fieldName
        
        On Error Resume Next
        ThisWorkbook.Names(nm).Delete
        On Error GoTo 0
        
        ThisWorkbook.Names.Add _
            Name:=nm, _
            RefersTo:="=" & targetCell.Address(External:=True)
        
    Next i

    ' last
    Set targetCell = startCell.Offset(0, 10)
    
    nm = prefix & "_last_" & fieldName
    
    On Error Resume Next
    ThisWorkbook.Names(nm).Delete
    On Error GoTo 0
    
    ThisWorkbook.Names.Add _
        Name:=nm, _
        RefersTo:="=" & targetCell.Address(External:=True)

End Sub
