Public Function cancelCurrentTaskJOIN() As macroResult
    
    cancelCurrentTaskJOIN = MACRO_FAILED
    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetJOIN As Worksheet
    Set sheetJOIN = wb.Worksheets("JOIN")
    
    Dim lenght As Integer
    lenght = sheetJOIN.Range("JOIN_2_sampleCode").Column - sheetJOIN.Range("JOIN_1_sampleCode").Column
    
    Dim curFormIndex As Integer
    curFormIndex = (activeCell.Column - JOIN_FIRST_FORM_FIRST_COL) \ lenght + 1
    
    Dim taskCell As Range
    Set taskCell = sheetJOIN.Range("JOIN_" & curFormIndex & "_taskId")
    
    Dim answer As Integer
    
    answer = MsgBox("Âû äåéñòâèòåëüíî õîòèòå óäàëèòü çàäàíèå ¹" & taskCell.value & "?", vbQuestion + vbYesNo, "Ïîäòâåðæäåíèå")
    
    If answer <> vbYes Then
        cancelCurrentTaskJOIN = MACRO_NO_CHANGES
        Exit Function
    End If
    
    Dim comment As String
    comment = InputBox("Ââåäèòå ïðè÷èíó îòìåíû:", "Îêíî ââîäà")
    
    Dim syncResult As String
    syncResult = SetTaskStatusOnly(taskCell.value, "JOIN", "Îòìåíà", comment)

    If InStr(1, syncResult, """ok"": true", vbTextCompare) > 0 Then
        With taskCell.MergeArea
            .Interior.ColorIndex = 3
            If .Locked = False Then
                .Locked = True
            End If
        End With
        cancelCurrentTaskJOIN = MACRO_CHANGED
        
    ElseIf syncResult = "NoComment" Or syncResult = "NoTaskId" Then
        cancelCurrentTaskJOIN = MACRO_NO_CHANGES
        
    End If
End Function

Public Sub AddFormJOIN()

    Dim sheetJOIN As Worksheet
    Set sheetJOIN = ActiveWorkbook.Worksheets("JOIN")
    
    Dim lastList As Integer
    Dim lastColumn As Integer
    Dim firstColumn As Integer
    Dim lenght As Integer
    Dim dataRow As Integer
    lenght = sheetJOIN.Range("Join_2_sampleCode").Column - sheetJOIN.Range("Join_1_sampleCode").Column
    lastList = sheetJOIN.ListObjects.count + 1
    lastColumn = lastList * lenght + JOIN_FIRST_FORM_FIRST_COL - 1
    firstColumn = lastColumn - lenght + 1
    dataRow = sheetJOIN.Range("Join_source_1").row
    
    sheetJOIN.Activate
    Range(sheetJOIN.columns(firstColumn - lenght), sheetJOIN.columns(lastColumn - lenght)).EntireColumn.Copy
    sheetJOIN.columns(firstColumn).Select
    sheetJOIN.Paste
    Application.CutCopyMode = False
    
    sheetJOIN.Cells(JOIN_PAGE_ROW, firstColumn + JOIN_PAGE_FIRST_COL - 1).value = lastList
    
    Dim name As String
    Dim new_name As String
    Dim prev_src_name As String
    Dim new_src_name As String
    name = "JOIN_" & (lastList - 1)
    prev_src_name = "JOIN_source_" & (lastList - 1)
    new_name = "JOIN_" & lastList
    new_src_name = "JOIN_source_" & lastList
    
    Dim xTable As ListObject
    
    Dim i As Long
    Dim x As Long
    For i = sheetJOIN.ListObjects.count To 1 Step -1
        Set xTable = sheetJOIN.ListObjects(i)
        
        If xTable.name Like name & "#*" Then
            xTable.name = new_name
            For x = 1 To xTable.ListRows.count
                xTable.ListRows(1).Delete
            Next x
            Exit For
        End If
    Next i
    
    For i = sheetJOIN.ListObjects.count To 1 Step -1
        Set xTable = sheetJOIN.ListObjects(i)
        If xTable.name Like prev_src_name & "#*" Then
            xTable.name = new_src_name
            Exit For
        End If
    Next i
    
    Set xTable = sheetJOIN.ListObjects(new_src_name)

