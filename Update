Обработка заняла 21m 59s

Да. Используем твою createMnemonicTabless и существующую getEquipmentNumbers. Python обновляет только три исходных справочника, а VBA заполняет таблицы номерами оборудования. Всё остаётся внутри одного запуска Python.

Ниже — точные изменения. Шаблон формы менять не требуется.

1. Полностью замени содержимое equipment_catalog.py, расположенного рядом с refresh_tasks.py, следующим кодом.

Он проверяет хэш, обновляет существующие typesEquipment, modelsEquipment, unitsEquipment и возвращает результат. Хэш в свойства книги запишет VBA после заполнения списков.

from __future__ import annotations

import hashlib
import json
import sqlite3
from pathlib import Path
from urllib.parse import urlsplit


HASH_PROPERTY = "EquipmentCatalogHash"
CATALOG_VERSION = "equipment-vba-v2"

TABLES = {
    "typesEquipment": "typeEquipmentId",
    "modelsEquipment": "equipmentModelId",
    "unitsEquipment": "equipmentUnitId",
}

BOOL_COLUMNS = {
    "SeparationGasVolume",
    "TransferVolume",
    "phaseRatio",
    "Viscosity",
    "Density",
    "PVTCell",
    "absolutePressure",
}

TEXT_COLUMNS = {
    "typeEquipment",
    "shortNameEquipment",
    "fullNameEquipment",
    "mnemonicName",
    "Manufacturer",
    "serialNumber",
    "inventoryNumber",
    "shortNumber",
    "status",
    "UnitPressure",
    "UnitVolume",
}


def read_catalog(db_path):
    uri = Path(db_path).absolute().as_uri()
    parts = urlsplit(uri)

    if parts.netloc:
        uri = "file:////" + parts.netloc + parts.path

    conn = sqlite3.connect(
        uri + "?mode=ro",
        uri=True,
        timeout=15,
    )
    conn.row_factory = sqlite3.Row

    try:
        conn.execute("BEGIN")
        catalog = {}

        for name, pk in TABLES.items():
            cur = conn.execute(
                f'SELECT * FROM "{name}" ORDER BY "{pk}"'
            )
            catalog[name] = {
                "columns": [c[0] for c in cur.description],
                "rows": [dict(row) for row in cur.fetchall()],
            }
    finally:
        conn.close()

    payload = json.dumps(
        [CATALOG_VERSION, catalog],
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
        allow_nan=False,
    ).encode("utf-8")

    digest = hashlib.sha256(payload).hexdigest()
    return catalog, CATALOG_VERSION + ":" + digest


def excel_value(value, column):
    if value is None or value == "":
        return None

    if column in BOOL_COLUMNS:
        text = str(value).strip().casefold()

        if text in {"true", "истина", "1", "1.0"}:
            return True

        if text in {"false", "ложь", "0", "0.0"}:
            return False

        raise ValueError(
            f"Некорректный флаг {column}: {value!r}"
        )

    if column in TEXT_COLUMNS:
        return str(value)

    return value


def matrix_of(values, column_count):
    if not isinstance(values, (tuple, list)):
        return ((values,),)

    if values and isinstance(values[0], (tuple, list)):
        return tuple(tuple(row) for row in values)

    if column_count == 1:
        return tuple((value,) for value in values)

    return (tuple(values),)


def refresh_for_book(book, db_path, *, force=False):
    catalog, new_hash = read_catalog(db_path)

    try:
        prop = book.api.CustomDocumentProperties.Item(HASH_PROPERTY)
        old_hash = str(prop.Value or "")
    except Exception:
        old_hash = ""

    if not force and old_hash == new_hash:
        return {
            "ok": True,
            "changed": False,
            "catalog_hash": new_hash,
        }

    sheet = book.sheets["Пересчет"]
    objects = sheet.api.ListObjects
    tables = {}

    for i in range(1, int(objects.Count) + 1):
        table = objects.Item(i)
        name = str(table.Name)

        if name in TABLES:
            tables[name] = table

    missing = set(TABLES) - set(tables)

    if missing:
        raise ValueError(
            "На листе Пересчет отсутствуют таблицы: "
            f"{sorted(missing)}"
        )

    # Проверяем все три таблицы до начала записи.
    plans = []

    for name, data in catalog.items():
        table = tables[name]

        headers = [
            str(value)
            for value in matrix_of(
                table.HeaderRowRange.Value2,
                len(data["columns"]),
            )[0]
        ]

        if (
            len(headers) != len(data["columns"])
            or set(headers) != set(data["columns"])
        ):
            raise ValueError(
                f"Не совпадают столбцы таблицы {name}: {headers}"
            )

        matrix = tuple(
            tuple(excel_value(row.get(h), h) for h in headers)
            for row in data["rows"]
        )

        # Excel оставляем одну пустую строку, если справочник пуст.
        matrix = matrix or (tuple(None for _ in headers),)
        plans.append((table, headers, matrix))

    app = book.app.api
    previous = (
        app.Calculation,
        app.EnableEvents,
        app.ScreenUpdating,
    )

    protected = bool(sheet.api.ProtectContents)
    unprotected = False

    try:
        if plans:
            app.Calculation = -4135  # xlCalculationManual
            app.EnableEvents = False
            app.ScreenUpdating = False

            if protected:
                sheet.api.Unprotect(Password="1984")
                unprotected = True

        for table, headers, matrix in plans:
            top = int(table.HeaderRowRange.Row)
            left = int(table.HeaderRowRange.Column)
            right = left + len(headers) - 1

            old_bottom = (
                int(table.Range.Row)
                + int(table.Range.Rows.Count)
                - 1
            )
            bottom = (
                top
                + len(matrix)
                + int(bool(table.ShowTotals))
            )

            if int(table.ListRows.Count) != len(matrix):
                new_range = sheet.range(
                    (top, left),
                    (bottom, right),
                )
                table.Resize(new_range.api)

            body = table.DataBodyRange

            if body is None or int(body.Rows.Count) != len(matrix):
                raise RuntimeError(
                    f"Не удалось задать размер таблицы {table.Name}"
                )

            if old_bottom > bottom:
                sheet.range(
                    (bottom + 1, left),
                    (old_bottom, right),
                ).clear_contents()

            for i, header in enumerate(headers):
                column_range = sheet.range(
                    (top + 1, left + i),
                    (top + len(matrix), left + i),
                )
                column_range.number_format = (
                    "@" if header in TEXT_COLUMNS else "General"
                )

            body.Value2 = matrix

    finally:
        if plans:
            try:
                if unprotected:
                    sheet.api.Protect(Password="1984")
            finally:
                app.Calculation = previous[0]
                app.EnableEvents = previous[1]
                app.ScreenUpdating = previous[2]

    # Хэш подтвердит VBA после заполнения таблиц номеров.
    return {
        "ok": True,
        "changed": True,
        "catalog_hash": new_hash,
    }

