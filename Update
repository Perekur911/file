Public Function Load_JOIN_results_to_forms( _
    Optional ByVal mode As String = "sequential", _
    Optional ByVal fields As Variant, _
    Optional ByVal silence As Boolean = False _
) As String

    On Error GoTo CleanFail

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetJOIN As Worksheet
    Set sheetJOIN = wb.Worksheets("JOIN")

    Dim resultTable As ListObject
    Set resultTable = wb.Worksheets("Join_results").ListObjects("Join_results")

    Dim sourceTable As ListObject
    Set sourceTable = wb.Worksheets("Join_sourceData").ListObjects("Join_sourceData")

    Dim fieldFilter As Object
    Set fieldFilter = BuildFieldFilter(fields)

    Dim text As String
    Dim warnText As String

    mode = LCase$(Trim$(mode))
    If mode = "" Then mode = "sequential"

    If mode <> "by_key" And mode <> "sequential" Then
        text = "ERROR|mode äîëæåí áûòü 'by_key' èëè 'sequential'"
        Load_JOIN_results_to_forms = text

        If Not silence Then
            MsgBox text, vbExclamation
        End If

        Exit Function
    End If

    If resultTable.DataBodyRange Is Nothing Then
        text = "OK|Òàáëèöà Join_results ïóñòàÿ."
        Load_JOIN_results_to_forms = text

        If Not silence Then
            MsgBox text, vbInformation
        End If

        Exit Function
    End If

    Dim resultRowIndex As Long
    Dim formIndex As Long
    Dim notFoundCount As Long

    For resultRowIndex = 1 To resultTable.ListRows.count

        If mode = "sequential" Then
            formIndex = resultRowIndex
            EnsureJOINFormExists wb, formIndex
        Else
            formIndex = FindFormIndexForResultRow( _
                wb, _
                sheetJOIN, _
                resultTable, _
                resultRowIndex, _
                "JOIN", _
                Array("sampleCode", COL_TASK_ID_DB) _
            )
        End If

        If formIndex = 0 Or _
           Not NamedRangeExists(wb, "JOIN_" & formIndex & "_sampleCode") Then

            notFoundCount = notFoundCount + 1

            warnText = warnText & _
                "Íå íàéäåíà ôîðìà äëÿ ñòðîêè Join_results #" & _
                resultRowIndex & vbCrLf & _
                "sampleCode = " & _
                GetTableValue(resultTable, resultRowIndex, "sampleCode") & vbCrLf & _
                "TaskId = " & _
                GetTableValue(resultTable, resultRowIndex, COL_TASK_ID_DB) & _
                vbCrLf & vbCrLf

            GoTo NextResultRow
        End If

        FillOneJOINFormFromResultRow _
            wb, _
            sheetJOIN, _
            resultTable, _
            sourceTable, _
            resultRowIndex, _
            formIndex, _
            fieldFilter

NextResultRow:
    Next resultRowIndex

    If notFoundCount = 0 Then
        text = "OK|Äàííûå JOIN ïåðåíåñåíû â ôîðìû."
        Load_JOIN_results_to_forms = text

        If Not silence Then
            MsgBox text, vbInformation
        End If
    Else
        text = _
            "WARN|Äàííûå JOIN ïåðåíåñåíû ÷àñòè÷íî. " & _
            "Íå íàéäåíî ôîðì: " & notFoundCount & _
            vbCrLf & warnText

        Load_JOIN_results_to_forms = text

        If Not silence Then
            MsgBox text, vbExclamation
        End If
    End If

    Exit Function

CleanFail:
    text = _
        "ERROR|" & _
        CStr(Err.Number) & "|" & _
        Err.Description

    Load_JOIN_results_to_forms = text

    If Not silence Then
        MsgBox text, vbCritical
    End If

End Function

