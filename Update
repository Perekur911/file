Option Explicit

Private Const REFRESH_TASKS_NONE As Long = 0
Private Const REFRESH_TASKS_BEFORE As Long = 1
Private Const REFRESH_TASKS_AFTER As Long = 2
Private Const REFRESH_TASKS_BEFORE_AND_AFTER As Long = 3

Public Enum macroResult
    
    MACRO_NO_RESULT = 0
    MACRO_FAILED = 1
    MACRO_NO_CHANGES = 2
    MACRO_CHANGED = 3

End Enum

Public Sub CallMacro(ByVal macroName As String, ParamArray studies() As Variant)

    Call CallMacroCore(macroName, False, Empty, REFRESH_TASKS_NONE, studies)

End Sub


Public Sub CallMacroWithParam( _
    ByVal macroName As String, _
    ByVal macroParam As Variant, _
    ParamArray studies() As Variant _
)

    Call CallMacroCore(macroName, True, macroParam, REFRESH_TASKS_NONE, studies)

End Sub


Public Sub CallMacroEx( _
    ByVal macroName As String, _
    ByVal refreshTasksMode As Long, _
    ParamArray studies() As Variant _
)

    Call CallMacroCore(macroName, False, Empty, refreshTasksMode, studies)

End Sub


Public Sub CallMacroWithParamEx( _
    ByVal macroName As String, _
    ByVal macroParam As Variant, _
    ByVal refreshTasksMode As Long, _
    ParamArray studies() As Variant _
)

    Call CallMacroCore(macroName, True, macroParam, refreshTasksMode, studies)

End Sub

Private Function CallMacroCore( _
    ByVal macroName As String, _
    ByVal hasMacroParam As Boolean, _
    ByVal macroParam As Variant, _
    ByVal refreshTasksMode As Long, _
    ByVal studies As Variant _
) As macroResult

    CallMacroCore = MACRO_FAILED

    Dim wb As Workbook
    Set wb = ActiveWorkbook
    
    Dim curSheet As Worksheet
    Set curSheet = ActiveSheet
    
    On Error GoTo CleanFail

    StartMacro wb, studies

    If refreshTasksMode = REFRESH_TASKS_BEFORE _
       Or refreshTasksMode = REFRESH_TASKS_BEFORE_AND_AFTER Then

        RefreshTasks_SelectFile

    End If

    Dim rawResult As Variant
    Dim macroResult As macroResult

    If hasMacroParam Then

        rawResult = Application.Run( _
            macroName, _
            macroParam _
        )

    Else

        rawResult = Application.Run(macroName)

    End If
    
    If IsEmpty(rawResult) Or rawResult = 0 Then
        macroResult = MACRO_NO_RESULT
    ElseIf IsNumeric(rawResult) Then
        macroResult = CLng(rawResult)

    Else
        Err.Raise _
            vbObjectError + 1000, _
            "CallMacroCore", _
            "Макрос " & macroName & _
            " вернул значение неподдерживаемого типа."
    End If
    
    Select Case macroResult

        Case MACRO_NO_RESULT
    
            If refreshTasksMode = REFRESH_TASKS_AFTER _
               Or refreshTasksMode = REFRESH_TASKS_BEFORE_AND_AFTER Then
                RefreshTasks_SelectFile
            End If
            CallMacroCore = MACRO_NO_RESULT
    
        Case MACRO_FAILED
            GoTo CleanExit
    
    
        Case MACRO_NO_CHANGES
            CallMacroCore = MACRO_NO_CHANGES
            GoTo CleanExit
    
    
        Case MACRO_CHANGED
            If refreshTasksMode = REFRESH_TASKS_AFTER _
               Or refreshTasksMode = REFRESH_TASKS_BEFORE_AND_AFTER Then
    
                RefreshTasks_SelectFile
    
            End If
    
            CallMacroCore = MACRO_CHANGED
    
        Case Else
    
            Err.Raise _
                vbObjectError + 1002, _
                "CallMacroCore", _
                "?????? " & macroName & _
                " ?????? ??????????? ?????????: " & CStr(rawResult)

End Select

CleanExit:

    EndMacro wb, studies

    curSheet.Activate

    Exit Function

CleanFail:

    Dim errNumber As Long
    Dim errSource As String
    Dim errDescription As String

    errNumber = Err.Number
    errSource = Err.Source
    errDescription = Err.Description

    On Error Resume Next
    EndMacro wb, studies
    On Error GoTo 0
    
    curSheet.Activate
    Err.Raise errNumber, errSource, errDescription

End Function


Private Function HasAnyStudy(ByVal studies As Variant) As Boolean

    On Error GoTo SafeExit

    If IsArray(studies) Then
        HasAnyStudy = (UBound(studies) >= LBound(studies))
    End If

SafeExit:

End Function


Public Sub Load_All_wrap()
    
    CallMacro "Load_All", "OP", "OPOH", "GC", "BP", "AP", "GOR", "SSF", "REC", "EMV", "JOIN", "CCE", "CVD"

End Sub

Public Sub Save_All_wrap()
    
    CallMacroEx _
        "Save_all", _
        REFRESH_TASKS_AFTER, _
        "OP", "OPOH", "GC", "BP", "AP", "GOR", "SSF", "REC", "EMV", "JOIN", "CCE", "CVD"

End Sub

Public Function Silent_Save_All_wrap() As macroResult

    Silent_Save_All_wrap = CallMacroCore( _
        "Silent_Save_All_OneByOne_wrap", _
        True, _
        True, _
        REFRESH_TASKS_NONE, _
        Array("OP", "OPOH", "GC", "BP", "AP", "GOR", "SSF", "REC", "EMV", "JOIN", "CCE", "CVD") _
    )

End Function
