Private Function NormalizeStudiesOrDefault(Optional ByVal studies As Variant) As Variant

    If IsMissing(studies) Then
        NormalizeStudiesOrDefault = DefaultStudies()
        Exit Function
    End If
    
    If IsEmpty(studies) Then
        NormalizeStudiesOrDefault = DefaultStudies()
        Exit Function
    End If

    Dim dict As Object
    Set dict = CreateObject("Scripting.Dictionary")
    dict.CompareMode = vbTextCompare

    Dim i As Long

    If IsArray(studies) Then
        For i = LBound(studies) To UBound(studies)
            AddStudiesFromText dict, CStr(studies(i))
        Next i
    Else
        AddStudiesFromText dict, CStr(studies)
    End If

    If dict.count = 0 Then
        NormalizeStudiesOrDefault = DefaultStudies()
        Exit Function
    End If

    If dict.Exists("ALL") Or dict.Exists("*") Then
        NormalizeStudiesOrDefault = DefaultStudies()
        Exit Function
    End If

    Dim key As Variant
    
    For Each key In dict.Keys
        If Not IsKnownStudyCode(CStr(key)) Then
            Err.Raise vbObjectError + 1201, , "Неизвестный тип исследования: " & CStr(key)
        End If
    Next key

    Dim result() As String
    ReDim result(0 To dict.count - 1)

    i = 0
    For Each key In dict.Keys
        result(i) = UCase$(CStr(key))
        i = i + 1
    Next key

    NormalizeStudiesOrDefault = result

End Function


Private Sub AddStudiesFromText( _
    ByVal dict As Object, _
    ByVal text As String _
)

    text = UCase$(Trim$(text))
    
    If Len(text) = 0 Then Exit Sub
    
    text = Replace(text, ";", " ")
    text = Replace(text, ",", " ")
    text = Replace(text, vbCrLf, " ")
    text = Replace(text, vbLf, " ")
    text = Replace(text, vbTab, " ")

    Do While InStr(1, text, "  ", vbBinaryCompare) > 0
        text = Replace(text, "  ", " ")
    Loop

    Dim parts() As String
    parts = Split(text, " ")

    Dim i As Long
    Dim studyCode As String

    For i = LBound(parts) To UBound(parts)
        studyCode = UCase$(Trim$(parts(i)))

        If Len(studyCode) > 0 Then
            If Not dict.Exists(studyCode) Then
                dict.Add studyCode, True
            End If
        End If
    Next i

End Sub


Private Function IsKnownStudyCode(ByVal studyCode As String) As Boolean

    Select Case UCase$(Trim$(studyCode))
        Case "OP", "AP", "GC", "SSF", "GOR", "BP", "REC", "EMV", "CCE", "JOIN"
            IsKnownStudyCode = True
        Case Else
            IsKnownStudyCode = False
    End Select

End Function

