Private Sub RefreshStudyIfNeeded( _
    ByVal wb As Workbook, _
    ByVal studyCode As String, _
    ByVal hashProperty As String, _
    ByVal stateProperty As String _
)

    ' Если статус отсутствует/unknown, проверяем в любом случае.
    ' Это нужно для первой проверки новой книги.
    If Not StudyNeedsHashCheck(wb, studyCode) _
       And GetStudySyncStatus(wb, stateProperty) <> SYNC_STATUS_UNKNOWN Then
        Exit Sub
    End If

    UpdateStudySyncStatus _
        wb, studyCode, hashProperty, stateProperty

End Sub

Private Sub UpdateStudySyncStatus( _
    ByVal wb As Workbook, _
    ByVal studyCode As String, _
    ByVal hashProperty As String, _
    ByVal stateProperty As String _
)

    On Error GoTo ErrorHandler

    Dim currentHash As String
    Dim savedHash As String
    Dim status As StudySyncStatus

    currentHash = GetCurrentStudyHash(studyCode)
    savedHash = GetWorkbookMetadataProperty(wb, hashProperty)

    status = DetermineStudySyncStatus(currentHash, savedHash)

    If GetStudySyncStatus(wb, stateProperty) <> status Then
        SetStudySyncStatus wb, stateProperty, status, False
    End If

    ClearStudyHashCheck wb, studyCode
    Exit Sub


ErrorHandler:

    Debug.Print "Ошибка определения статуса " & studyCode & ": " & _
        Err.Number & ": " & Err.Description

    On Error Resume Next
    SetStudySyncStatus wb, stateProperty, SYNC_STATUS_ERROR, False
    ClearStudyHashCheck wb, studyCode
    On Error GoTo 0

End Sub

Private Function DetermineStudySyncStatus( _
    ByVal currentHash As String, _
    ByVal savedHash As String _
) As StudySyncStatus

    If savedHash = "" Then

        If currentHash = EMPTY_DATA_HASH Then
            DetermineStudySyncStatus = SYNC_STATUS_EMPTY
        Else
            DetermineStudySyncStatus = SYNC_STATUS_UNSAVED
        End If

    ElseIf currentHash = savedHash Then

        If currentHash = EMPTY_DATA_HASH Then
            DetermineStudySyncStatus = SYNC_STATUS_EMPTY
        Else
            DetermineStudySyncStatus = SYNC_STATUS_SYNCED
        End If

    Else

        DetermineStudySyncStatus = SYNC_STATUS_DIRTY

    End If

End Function

