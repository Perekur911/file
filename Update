    End If


    Dim TableJoinResult As ListObject
    Set TableJoinResult = ActiveWorkbook.Worksheets("Join_results").ListObjects("Join_results")
    
    Dim name_rng As Range
    Dim oldName As String
    For Each name_rng In TableJoinResult.HeaderRowRange
        If name_rng.value = "dateTimeSync" Then
            GoTo cont
        End If
        Dim current As Range
        oldName = name & "_" & name_rng.value
        Set current = sheetJOIN.Cells(sheetJOIN.Range(oldName).row, sheetJOIN.Range(oldName).Column + lenght)
        current.name = Replace(oldName, name, new_name)
        If Not current.HasFormula Then
            current.value = ""
        Else
            Application.DisplayAlerts = False
            On Error Resume Next
            current.Formula = Replace(current.Formula, "_" & (lastList - 1), "_" & lastList)
            Application.DisplayAlerts = True
        End If
cont:
    Next name_rng

    'sheetJoin.PageSetup.PrintArea = Range(Cells(1, 1), Cells(59, lastcolumn + 10)).Address
    
    Dim sh As CheckBox
    Dim count As Integer
    count = 0
    Set xTable = sheetJOIN.ListObjects("JOIN_source_" & lastList)
    For x = sheetJOIN.CheckBoxes.count To 1 Step -1
        If count = xTable.ListRows.count + 2 Then
            Exit For
        End If
        Set sh = sheetJOIN.CheckBoxes(x)
        'Debug.Print sh.TopLeftCell.Column
        If sh.TopLeftCell.Column >= sheetJOIN.ListObjects("JOIN_source_" & lastList).ListColumns("Ïðîáà èçðàñõîäîâàíà").DataBodyRange.Column Then
