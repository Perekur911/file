    Dim rowDeltaMatBalance As Integer
    rowDeltaMatBalance = sheetGOR.Range("GOR_1_deltaMatBalance").row
    
    Dim rowCorrect As Integer
    rowCorrect = sheetGOR.Range("GOR_1_Correct").row
    
    Dim strRangeFormat As String
    strRangeFormat = "$" & rowCorrect & ":$" & rowCorrect
    With sheetGOR.Range(strRangeFormat).FormatConditions.Add(Type:=xlCellValue, Operator:=xlEqual, Formula1:="=ИСТИНА")
        .Interior.Color = RGB(0, 218, 99) ' Зелёный цвет
    End With
    With sheetGOR.Range(strRangeFormat).FormatConditions.Add(Type:=xlCellValue, Operator:=xlEqual, Formula1:="=ЛОЖЬ")
        .Interior.Color = RGB(255, 71, 87) ' Красный цвет
    End With
    
    strRangeFormat = "$" & rowDeltaAP & ":$" & rowDeltaAP
    ' 1. Зелёный: значение <= 0.01
    With sheetGOR.Range(strRangeFormat).FormatConditions.Add(Type:=xlExpression, Formula1:="=И(ЕЧИСЛО(A$" & rowDeltaAP & "); A$" & rowDeltaAP & " <= 0,01)")
        .Interior.Color = RGB(0, 218, 99) ' Зелёный цвет
    End With
    ' 2. Жёлтый: > 0.01 и <= 0.02
    With sheetGOR.Range(strRangeFormat).FormatConditions.Add(Type:=xlExpression, Formula1:="=И(ЕЧИСЛО(A$" & rowDeltaAP & "); A$" & rowDeltaAP & " > 0,01; A$" & rowDeltaAP & " <= 0,03)")
        .Interior.Color = RGB(255, 235, 4) ' Ярко-жёлтый
    End With
    ' 3. Красный: > 0.02
    With sheetGOR.Range(strRangeFormat).FormatConditions.Add(Type:=xlExpression, Formula1:="=И(ЕЧИСЛО(A$" & rowDeltaAP & "); A$" & rowDeltaAP & " > 0,03)")
        .Interior.Color = RGB(255, 71, 87) ' Красный
    End With
    
    strRangeFormat = "$" & rowDeltaMatBalance & ":$" & rowDeltaMatBalance
    ' 1. Зелёный: значение <= 0.01
    With sheetGOR.Range(strRangeFormat).FormatConditions.Add(Type:=xlExpression, Formula1:="=И(ЕЧИСЛО(A$" & rowDeltaMatBalance & "); A$" & rowDeltaMatBalance & " <= 0,01)")
        .Interior.Color = RGB(0, 218, 99) ' Зелёный цвет
    End With
    ' 2. Жёлтый: > 0.01 и <= 0.02
    With sheetGOR.Range(strRangeFormat).FormatConditions.Add(Type:=xlExpression, Formula1:="=И(ЕЧИСЛО(A$" & rowDeltaMatBalance & "); A$" & rowDeltaMatBalance & " > 0,01; A$" & rowDeltaMatBalance & " <= 0,03)")
        .Interior.Color = RGB(255, 235, 4) ' Ярко-жёлтый
    End With
    ' 3. Красный: > 0.02
    With sheetGOR.Range(strRangeFormat).FormatConditions.Add(Type:=xlExpression, Formula1:="=И(ЕЧИСЛО(A$" & rowDeltaMatBalance & "); A$" & rowDeltaMatBalance & " > 0,03)")
        .Interior.Color = RGB(255, 71, 87) ' Красный
    End With
    
    
    Dim prev_name As String
    Dim new_name As String
    prev_name = "GOR_source_" & (lastList - 1)
    new_name = "GOR_source_" & (lastList)
    
    Dim i As Integer
    
    For i = lastList To 1 Step -1
        If sheetGOR.ListObjects(i).name Like prev_name & "##*" Then
            sheetGOR.ListObjects(i).name = new_name
            sheetGOR.ListObjects(i).DataBodyRange.ClearContents
            Exit For
        End If
    Next i
    
    Dim TableGORResult As ListObject
    Set TableGORResult = ActiveWorkbook.Worksheets("GOR_results").ListObjects("GOR_results")
    Dim name_rng As Range
    
    prev_name = "GOR_" & (lastList - 1)
    new_name = "GOR_" & (lastList)
    
    Dim oldName As String
    
    For Each name_rng In TableGORResult.HeaderRowRange
            If name_rng.value = "dateTimeSync" Then
                GoTo cont
            End If
            Dim current As Range
            oldName = prev_name & "_" & name_rng.value
            Set current = sheetGOR.Cells(sheetGOR.Range(oldName).row, sheetGOR.Range(oldName).Column + lenght)
            current.name = Replace(oldName, prev_name, new_name)
            If name_rng.value = "gorEquipment" Then
                GoTo cont
            End If
            If Not current.HasFormula Then
                current.value = ""
            Else
                If current.HasArray Then
                    current.FormulaArray = Replace(current.FormulaArray, "_" & (lastList - 1), "_" & lastList)
                Else
                    current.Formula = Replace(current.Formula, "_" & (lastList - 1), "_" & lastList)
                End If
            End If
cont:
