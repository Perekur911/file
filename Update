### 4. Добавить хэш REC

`rowIdRec` и `resultIdRec` в хэш не входят.

```vb
Public Function CalculateCurrentRecHash() As String

    Dim data As Object
    Set data = Build_Rec_HashData(ActiveWorkbook)

    CalculateCurrentRecHash = CalculateDataHash(data)

End Function


Private Function Build_Rec_HashData(ByVal wb As Workbook) As Object

    Dim data As Object
    Set data = CreateObject("Scripting.Dictionary")

    Dim sheetREC As Worksheet
    Set sheetREC = wb.Worksheets("Rec")

    Dim recTable As ListObject
    Set recTable = wb.Worksheets("Rec_results").ListObjects("Rec_results")

    Dim childFields As Variant
    childFields = Array( _
        COL_MIX_SAMPLE_CODE_CHILD_DB, COL_MASS_FRACTION_CHILD_DB, _
        COL_P_TRANSFER_CHILD_DB, COL_T_TRANSFER_CHILD_DB, _
        COL_DENSITY_CHILD_DB, COL_FIRST_CHILD_DB, _
        COL_VOLUME_CHILD_DB, COL_MASS_CHILD_DB)

    Dim formIndex As Long
    Dim resultIndex As Long
    formIndex = 1

    Do While NamedRangeExists(wb, "Rec_" & formIndex & "_sampleCode")

        If Get_Rec_FormState(formIndex) <> REC_FORM_FILLED Then GoTo NextForm

        If sheetREC.Range("Rec_" & formIndex & "_TaskId").MergeArea.Interior.ColorIndex = 3 Then
            GoTo NextForm
        End If

        resultIndex = resultIndex + 1

        Dim headerCell As Range
        Dim headerName As String
        Dim formatValue As Variant

        For Each headerCell In recTable.HeaderRowRange.Cells

            headerName = CStr(headerCell.Value)

            Select Case LCase$(headerName)
                Case "datetimesync", "resultidrec"

                Case Else
                    If NamedRangeExists(wb, "Rec_" & formIndex & "_" & headerName) Then
                        formatValue = FormatValueForSyncText( _
                            headerName, sheetREC.Range("Rec_" & formIndex & "_" & headerName).Value)
                    Else
                        formatValue = vbNullString
                    End If

                    data.Add resultIndex & "." & headerName, formatValue
            End Select

        Next headerCell

        Dim childIndex As Long
        Dim childDataIndex As Long
        Dim fieldIndex As Long
        Dim fieldName As String
        Dim rangeName As String

        For childIndex = 1 To REC_CHILD_COUNT_PER_FORM

            If RecChildHasData(wb, formIndex, childIndex) Then

                childDataIndex = childDataIndex + 1

                For fieldIndex = LBound(childFields) To UBound(childFields)

                    fieldName = CStr(childFields(fieldIndex))
                    rangeName = "Rec_" & formIndex & "_" & fieldName & childIndex

                    formatValue = FormatValueForSyncText( _
                        fieldName, GetNamedRangeStrict(wb, rangeName).Value)

                    data.Add resultIndex & "." & childDataIndex & "." & fieldName, formatValue

                Next fieldIndex

            End If

        Next childIndex

NextForm:
        formIndex = formIndex + 1
    Loop

    Set Build_Rec_HashData = data

End Function
```

Здесь я специально использую `childDataIndex`, а не физический `childIndex`: пустой промежуток между компонентами сам по себе хэш не меняет, но порядок реальных компонентов меняет.

