5. Поиск формы при загрузке

В модуле Stable найди функцию целиком:

Private Function FindStableFormIndexForResultRow(

Она заканчивается ближайшим:

End Function

Полностью замени всю эту функцию на следующую:

Private Function FindStableFormIndexForResultRow( _
    ByVal ws As Worksheet, _
    ByVal resultTable As ListObject, _
    ByVal resultRowIndex As Long _
) As Long

    Dim resultSampleCode As String
    Dim resultAnalyseNumber As String

    resultSampleCode = NormalizeKeyValue( _
        GetTableValue( _
            resultTable, _
            resultRowIndex, _
            COL_SAMPLE_CODE_DB _
        ) _
    )

    resultAnalyseNumber = NormalizeKeyValue( _
        GetTableValue( _
            resultTable, _
            resultRowIndex, _
            COL_ANALYSE_NUMBER_DB _
        ) _
    )

    If Len(resultSampleCode) = 0 Then Exit Function
    If Len(resultAnalyseNumber) = 0 Then Exit Function

    Dim formIndex As Long
    Dim lastFormIndex As Long
    Dim sampleRange As Range
    Dim analyseRange As Range

    lastFormIndex = Stable_LastFormIndexOnSheet(ws)

    For formIndex = 1 To lastFormIndex

        Set sampleRange = Stable_FormRange( _
            ws, _
            formIndex, _
            COL_SAMPLE_CODE_DB _
        )

        Set analyseRange = Stable_FormRange( _
            ws, _
            formIndex, _
            COL_ANALYSE_NUMBER_DB _
        )

        If Not sampleRange Is Nothing _
           And Not analyseRange Is Nothing Then

            If NormalizeKeyValue(sampleRange.value) = _
                   resultSampleCode _
               And NormalizeKeyValue(analyseRange.value) = _
                   resultAnalyseNumber Then

                FindStableFormIndexForResultRow = formIndex
                Exit Function

            End If

        End If

    Next formIndex

End Function

Вызов этой функции внутри Load_Stable_results_to_forms менять не нужно. Он уже выглядит примерно так:

formIndex = FindStableFormIndexForResultRow( _
    sheetStable, _
    resultTable, _
    resultRowIndex _
)

