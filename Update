Private Function CheckGORTask( _
    ByVal taskId As Long, _
    ByVal sampleCode As String, _
    ByVal temperature As Variant, _
    ByVal pageNumber As Long _
) As String

    Dim tasks As ListObject
    Set tasks = ActiveWorkbook.Worksheets("Task").ListObjects(1)

    Dim taskCheck As Range
    Set taskCheck = tasks.ListColumns("Номер задания").DataBodyRange.Find( _
        What:=taskId, _
        LookAt:=xlWhole, _
        SearchOrder:=xlByColumns _
    )

    If taskCheck Is Nothing Then
        CheckGORTask = _
            "Указан неизвестный номер задания " & taskId & _
            " на странице " & pageNumber & _
            ". Попробуйте обновить данные проекта или исправьте значение."
        Exit Function
    End If

    Dim taskRowIndex As Long
    taskRowIndex = taskCheck.row - tasks.DataBodyRange.row + 1

    If CStr(tasks.ListColumns("Код проекта").DataBodyRange.Cells(taskRowIndex, 1).value) <> sampleCode Then

        CheckGORTask = _
            "Указан неверный номер задания " & taskId & _
            " на странице " & pageNumber & _
            ". Шифр пробы в задании отличается от шифра пробы в исследовании. " & _
            "Исправьте номер задания или выберите верную форму для внесения."

        Exit Function

    ElseIf IsNumeric(tasks.ListColumns("Тэкс, °C").DataBodyRange.Cells(taskRowIndex, 1).value) _
       And IsNumeric(temperature) Then
        Dim spTemp As Double
        spTemp = CDbl(tasks.ListColumns("Тэкс, °C").DataBodyRange.Cells(taskRowIndex, 1).value)
        If spTemp >= 19 And spTemp <= 25 Then
            If CDbl(temperature) < 19 Or CDbl(temperature) > 25 Then
                
                CheckGORTask = _
                    "Температура исследования в задании " & taskId & _
                    " на странице " & pageNumber & _
                    " отличается от заданной комнатной температуры. " & _
                    "Исправьте номер задания или выберите верную форму для внесения."
    
                Exit Function
            End If
        Else
            If Abs(spTemp - CDbl(temperature)) > 1.5 Then
                
                CheckGORTask = _
                    "Температура исследования в задании " & taskId & _
                    " на странице " & pageNumber & _
                    " отличается от фактической более чем на 1,5 °C. " & _
                    "Исправьте номер задания или выберите верную форму для внесения."
    
                Exit Function
            End If
        End If

    End If

    CheckGORTask = "OK"

End Function
Public Function Save_GOR(Optional ByVal taskStatus As String = "") As macroResult
    On Error GoTo ErrHandler
    Save_GOR = MACRO_FAILED
    Dim t0 As Double
    Dim t As Double
    
    t0 = Timer
    t = t0

    Dim wb As Workbook
    Set wb = ActiveWorkbook
    
    Dim newHashResult As String
    Dim oldHashResult As String
    Dim lastWorkflowStage As String
    
    newHashResult = CalculateCurrentGORHash()
    oldHashResult = GetWorkbookMetadataProperty(wb, PROP_GOR_DATA_HASH)
    lastWorkflowStage = GetWorkbookMetadataProperty(wb, PROP_GOR_LAST_WORKFLOW_STAGE)
    
    If Not ShouldSaveStudy(newHashResult, oldHashResult, lastWorkflowStage, taskStatus) Then
        Save_GOR = MACRO_NO_CHANGES
        Exit Function
    End If
    
    Dim sheetGOR As Worksheet
    Set sheetGOR = wb.Worksheets("GOR")

    Dim sheetGORResult As Worksheet
    Set sheetGORResult = wb.Worksheets("GOR_results")

    Dim sheetGORSourceData As Worksheet
    Set sheetGORSourceData = wb.Worksheets("GOR_sourceData")

    Dim GORTable As ListObject
    Set GORTable = sheetGORResult.ListObjects("GOR_results")

    Dim GORSourceDataTable As ListObject
    Set GORSourceDataTable = sheetGORSourceData.ListObjects("GOR_sourceData")

    Dim parentRows As Collection
    Set parentRows = New Collection

    Dim childRows As Collection
    Set childRows = New Collection

    Dim validForms As Collection
    Set validForms = New Collection
    
    Dim formState As GORFormState
    Dim i As Long
    Dim x As Long
    Dim newResultIDs As Collection
    Set newResultIDs = New Collection

    i = 1

    Do While NamedRangeExists(wb, "GOR_" & i & "_sampleCode")
        
        formState = Get_GOR_FormState(i)

        Select Case formState
    
            Case GOR_FORM_EMPTY
                GoTo NextFormFirstPass
    
            Case GOR_FORM_RESERVED
                GoTo NextFormFirstPass
    
            Case GOR_FORM_FILLED
                ' идём дальше
                
        End Select
        
        If sheetGOR.Range("GOR_" & i & "_TaskId").Interior.ColorIndex = 3 Then
            GoTo NextFormFirstPass
        End If
        
        If sheetGOR.Range("GOR_" & i & "_analyseNumber").value = "" Then
            Call checkNumberAnalys2(sheetGOR.Range("GOR_" & i & "_sampleCode").value, "GOR")
        End If
        
        If Not Validate_GOR_Form(i) Then
            Exit Function
        End If

        If Not GOR_SourceTableHasValidSampleCodes(i) Then

            Application.ScreenUpdating = True
            DoEvents
            Application.ScreenUpdating = False

            If Not CreateSampleCodeGOR3(i) Then
                Save_GOR = MACRO_FAILED
                Exit Function
            End If
        End If
        
        If Not GOR_SourceTableHasValidSampleCodes(i) Then
            MsgBox "Страница " & i & ": в таблице GOR_source_" & i & _
                   " нет ни одного шифра полученной пробы с указанным TypePh.", vbExclamation
            Save_GOR = MACRO_FAILED
            Exit Function
        End If
        
        validForms.Add i

NextFormFirstPass:
        i = i + 1
    Loop

    ' 2. Теперь собираем данные из форм в GOR_results и GOR_sourceData.
    Dim pageValue As Variant

    For Each pageValue In validForms

        i = CLng(pageValue)

        Dim resultIdValue As Variant
        Dim parentKey As String

        resultIdValue = sheetGOR.Range("GOR_" & i & "_resultIdGOR").value

        If Len(NormalizeKeyValue(resultIdValue)) = 0 Or NormalizeKeyValue(resultIdValue) = "0" Then
            parentKey = "temp_" & i
        Else
            parentKey = NormalizeKeyValue(resultIdValue)
        End If

        If IsNumeric(parentKey) Then
            newResultIDs.Add parentKey
        End If
        
        Dim parentRow() As Variant
        ReDim parentRow(1 To GORTable.ListColumns.count)

        Dim headerCell As Range
        Dim headerName As String
        Dim parentColIndex As Long
        Dim formRangeName As String

        For Each headerCell In GORTable.HeaderRowRange.Cells

            headerName = CStr(headerCell.value)
            parentColIndex = GORTable.ListColumns(headerName).index
            formRangeName = "GOR_" & i & "_" & headerName

            If headerName = "dateTimeSync" Then
                parentRow(parentColIndex) = Format$(Now, "yyyy-mm-dd hh:nn:ss")

            ElseIf headerName = COL_GOR_RESULT_ID_DB Then
                parentRow(parentColIndex) = parentKey

            ElseIf NamedRangeExists(wb, formRangeName) Then
                parentRow(parentColIndex) = FormatValueForSyncText( _
                    headerName, _
                    sheetGOR.Range(formRangeName).value _
                )

            Else
                parentRow(parentColIndex) = vbNullString

            End If

        Next headerCell

        parentRows.Add parentRow

        Dim srcTable As ListObject
        Set srcTable = sheetGOR.ListObjects("GOR_source_" & i)

        If Not srcTable.DataBodyRange Is Nothing Then

            For x = 1 To srcTable.ListRows.count

                Dim hasSourceData As Boolean
                Dim oldRowIdGOR As String

                hasSourceData = SourceRowHasData( _
                    srcTable, _
                    x, _
                    Array(COL_GOR_SAMPLE_CODE_DB, COL_GOR_TYPE_PH_DB), _
                    Array("AND") _
                )

                oldRowIdGOR = NormalizeKeyValue( _
                    srcTable.DataBodyRange.Cells( _
                        x, srcTable.ListColumns(COL_GOR_ROW_ID_DB).index _
                    ).value _
                )

                ' Добавляем строку в GOR_sourceData, если:
                ' 1) есть sampleCode + TypePh — insert/update;
                ' 2) данных уже нет, но есть старый rowIdGOR — delete.
                If hasSourceData Or Len(oldRowIdGOR) > 0 Then

                    Dim childRow() As Variant
                    ReDim childRow(1 To GORSourceDataTable.ListColumns.count)

                    childRow(GORSourceDataTable.ListColumns(COL_GOR_ROW_ID_DB).index) = oldRowIdGOR
                    childRow(GORSourceDataTable.ListColumns(COL_GOR_RESULT_ID_DB).index) = parentKey

                    If hasSourceData Then

                        childRow(GORSourceDataTable.ListColumns(COL_GOR_SAMPLE_CODE_DB).index) = _
                            FormatValueForSyncText( _
                                COL_GOR_SAMPLE_CODE_DB, _
                                srcTable.DataBodyRange.Cells( _
                                    x, _
                                    srcTable.ListColumns(COL_GOR_SAMPLE_CODE_DB).index _
                                ).value _
                            )

                        childRow(GORSourceDataTable.ListColumns(COL_GOR_TYPE_PH_DB).index) = _
                            FormatValueForSyncText( _
                                COL_GOR_TYPE_PH_DB, _
                                srcTable.DataBodyRange.Cells( _
                                    x, _
                                    srcTable.ListColumns(COL_GOR_TYPE_PH_DB).index _
                                ).value _
                            )

                    End If

                    childRows.Add childRow

                End If

            Next x

        End If

    Next pageValue

    Dim cellID As Range
    Dim oldResultID As String

    If Not GORTable.DataBodyRange Is Nothing Then

        For Each cellID In GORTable.ListColumns(COL_GOR_RESULT_ID_DB).DataBodyRange.Cells

            If Not IsError(cellID.value) Then

                oldResultID = NormalizeKeyValue(cellID.value)

                If IsNumeric(oldResultID) And oldResultID <> "0" Then

                    If Not CollectionContains(newResultIDs, oldResultID) Then

                        MsgBox _
                            "Удалены данные синхронизированной формы GOR. " & _
                            "Синхронизация невозможна. " & _
                            "Вызовите загрузку данных из БД.", _
                            vbExclamation

                        Save_GOR = MACRO_FAILED
                        Exit Function

                    End If

                End If

            End If

        Next cellID

    End If

    WriteCollectionToListObject GORTable, parentRows
    WriteCollectionToListObject GORSourceDataTable, childRows

    Dim syncResult As String
    syncResult = RunStudySync("save", studies:="GOR", taskStatus:=taskStatus)

    If InStr(1, syncResult, """ok"": true", vbTextCompare) > 0 Then

        Call DeleteEmptyRowsByColumns( _
            GORSourceDataTable, _
            COL_GOR_ROW_ID_DB, _
            Array(COL_GOR_SAMPLE_CODE_DB, COL_GOR_TYPE_PH_DB) _
        )

        Call Load_GOR_results_to_forms("by_key", Array(COL_GOR_RESULT_ID_DB, COL_GOR_ROW_ID_DB))

        newHashResult = CalculateCurrentGORHash()
        Call SetWorkbookMetadataProperty(wb, PROP_GOR_DATA_HASH, newHashResult, False)
        Call SetWorkbookMetadataProperty(wb, PROP_GOR_LAST_WORKFLOW_STAGE, EffectiveWorkflowStage(taskStatus), False)
        SetStudySyncStatus wb, PROP_GOR_DATA_STATE, SYNC_STATUS_SYNCED, False
        ClearStudyHashCheck wb, "GOR"
    Else
        MsgBox "Синхронизация GOR не подтверждена как успешная." & vbCrLf & vbCrLf & syncResult, vbExclamation
        Exit Function
    End If

    Save_GOR = MACRO_CHANGED
    Exit Function

ErrHandler:
    Debug.Print Err.Number & ": " & Err.Description
    Save_GOR = MACRO_FAILED
End Function

Public Function CalculateCurrentGORHash() As String

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim data As Object
    Set data = Build_GOR_HashData(wb)

    CalculateCurrentGORHash = CalculateDataHash(data)

End Function

Private Function Build_GOR_HashData( _
    ByVal wb As Workbook _
) As Object

    Dim data As Object
    Set data = CreateObject("Scripting.Dictionary")

    Dim sheetGOR As Worksheet
    Set sheetGOR = wb.Worksheets("GOR")

    Dim GORTable As ListObject
    Set GORTable = wb.Worksheets("GOR_results").ListObjects("GOR_results")

    Dim i As Long
    Dim formIndex As Long

    i = 1
    formIndex = 0

    Do While NamedRangeExists(wb, "GOR_" & i & "_sampleCode")

        If sheetGOR.Range("GOR_" & i & "_TaskId").Interior.ColorIndex = 3 Then
            GoTo NextForm
        End If

        Dim formState As GORFormState
        formState = Get_GOR_FormState(i)

        Select Case formState
            Case GOR_FORM_EMPTY, GOR_FORM_RESERVED
                GoTo NextForm
            Case GOR_FORM_FILLED
        End Select

        formIndex = formIndex + 1

        ' Родительские поля.
        Dim headerCell As Range
        Dim headerName As String
        Dim formatValue As Variant

        For Each headerCell In GORTable.HeaderRowRange.Cells

            headerName = CStr(headerCell.value)

            Select Case headerName

                Case "dateTimeSync", COL_GOR_RESULT_ID_DB
                    ' Служебные поля не хешируем.

                Case Else
                    formatValue = FormatValueForSyncText( _
                        headerName, _
                        sheetGOR.Range("GOR_" & i & "_" & headerName).value _
                    )

                    data.Add formIndex & "." & headerName, formatValue

            End Select

        Next headerCell

        ' Полученные пробы.
        Dim srcTable As ListObject
        Set srcTable = sheetGOR.ListObjects("GOR_source_" & i)

        Dim x As Long
        Dim sourceIndex As Long

        sourceIndex = 0

        If Not srcTable.DataBodyRange Is Nothing Then

            For x = 1 To srcTable.ListRows.count

                If SourceRowHasData( _
                    srcTable, _
                    x, _
                    Array(COL_GOR_SAMPLE_CODE_DB, COL_GOR_TYPE_PH_DB), _
                    Array("AND") _
                ) Then

                    sourceIndex = sourceIndex + 1

                    formatValue = FormatValueForSyncText( _
                        COL_GOR_SAMPLE_CODE_DB, _
                        srcTable.DataBodyRange.Cells( _
                            x, srcTable.ListColumns(COL_GOR_SAMPLE_CODE_DB).index _
                        ).value _
                    )

                    data.Add _
                        formIndex & "." & COL_GOR_SAMPLE_CODE_DB & "." & sourceIndex, _
                        formatValue

                    formatValue = FormatValueForSyncText( _
                        COL_GOR_TYPE_PH_DB, _
                        srcTable.DataBodyRange.Cells( _
                            x, srcTable.ListColumns(COL_GOR_TYPE_PH_DB).index _
                        ).value _
                    )

                    data.Add _
                        formIndex & "." & COL_GOR_TYPE_PH_DB & "." & sourceIndex, _
                        formatValue

                End If

            Next x

        End If

NextForm:
        i = i + 1
    Loop

    Set Build_GOR_HashData = data

End Function

