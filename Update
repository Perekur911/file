Private Function Validate_CVD_Form(ByVal formIndex As Long) As Boolean

    Validate_CVD_Form = False

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetCVD As Worksheet
    Set sheetCVD = wb.Worksheets("CVD")

    Dim CVDTable As ListObject
    Set CVDTable = wb.Worksheets("CVD_results").ListObjects("CVD_results")

    Dim CVDSourceDataTable As ListObject
    Set CVDSourceDataTable = wb.Worksheets("CVD_sourceData").ListObjects("CVD_sourceData")

    Dim errors As String
    Dim errorCount As Long

    If formIndex <= 0 Then
        MsgBox "Некорректный номер формы CVD: " & formIndex, vbExclamation
        Exit Function
    End If

    If Not NamedRangeExists(wb, "CVD_" & formIndex & "_sampleCode") Then
        MsgBox "Форма CVD_" & formIndex & " не найдена.", vbExclamation
        Exit Function
    End If

    Dim headerCell As Range
    Dim fieldName As String
    Dim rangeName As String
    Dim rng As Range
    Dim valueText As String

    ' 1. Проверяем поля CVD_results.
    For Each headerCell In CVDTable.HeaderRowRange.Cells

        fieldName = CStr(headerCell.value)

        If fieldName = "dateTimeSync" Then
            GoTo next_result_header
        End If

        rangeName = "CVD_" & formIndex & "_" & fieldName

        If Not NamedRangeExists(wb, rangeName) Then
            errorCount = errorCount + 1
            errors = errors & errorCount & ". Не найден именованный диапазон: " & rangeName & vbCrLf
            GoTo next_result_header
        End If

        Set rng = sheetCVD.Range(rangeName)

        If IsError(rng.value) Then
            errorCount = errorCount + 1
            errors = errors & errorCount & ". " & rangeName & _
                     " содержит ошибку Excel: " & rng.text & _
                     " (" & rng.Worksheet.name & "!" & rng.Address(False, False) & ")" & vbCrLf
            GoTo next_result_header
        End If

        valueText = Trim$(CStr(rng.value))

        Select Case fieldName

            Case "resultIdCVD"
                ' Может быть пустым до первого сохранения.

            Case "sampleCode"
                If valueText = "" Then
                    errorCount = errorCount + 1
                    errors = errors & errorCount & ". Не заполнен шифр пробы: " & rangeName & vbCrLf
                End If

            Case "TaskId"
                If valueText <> "" Then
                    If Not IsNumeric(rng.value) Then
                        errorCount = errorCount + 1
                        errors = errors & errorCount & ". Номер задания должен быть числом: " & rangeName & vbCrLf
                    ElseIf CDbl(rng.value) < 0 Then
                        errorCount = errorCount + 1
                        errors = errors & errorCount & ". Номер задания не может быть отрицательным: " & rangeName & vbCrLf
                    End If
                End If

            Case "analyseNumber"
                If valueText = "" Then
                    errorCount = errorCount + 1
                    errors = errors & errorCount & ". Не указан номер анализа: " & rangeName & vbCrLf
                ElseIf Not IsNumeric(rng.value) Then
                    errorCount = errorCount + 1
                    errors = errors & errorCount & ". Номер анализа должен быть числом: " & rangeName & vbCrLf
                End If

            Case "dateStart", "dateEnd"
                If valueText <> "" Then
                    If Not IsDate(rng.value) Then
                        errorCount = errorCount + 1
                        errors = errors & errorCount & ". Значение должно быть датой: " & rangeName & vbCrLf
                    End If
                End If

            Case "timeStart", "timeEnd"
                If valueText <> "" Then
                    If Not rng.text Like "##:##" And Not rng.text Like "#:##" Then
                        errorCount = errorCount + 1
                        errors = errors & errorCount & ". Значение должно быть временем: " & rangeName & vbCrLf
                    End If
                End If

            Case "deltaMatBalance", "Pabs", "Pstart", "Ptransfer", _
                 "Tstart", "Ttransfer", "Vstart", "Vtransfer"

                If valueText <> "" Then
                    If Not IsNumeric(rng.value) Then
                        errorCount = errorCount + 1
                        errors = errors & errorCount & ". Значение должно быть числом: " & rangeName & vbCrLf
                    End If
                End If

            Case "Punit", "pvtCell"
                ' Пока базовая проверка: может быть пустым.
                ' Если нужно обязательно — добавишь здесь.

        End Select

next_result_header:
    Next headerCell

    ' 2. Проверяем sourceData-поля по step-столбцам.
    Dim steps As Variant
    Dim stepIndex As Long
    Dim stepKey As String

    steps = CVD_StepKeys()

    For stepIndex = LBound(steps) To UBound(steps)

        stepKey = CStr(steps(stepIndex))

        If Not CVD_StepHasData(formIndex, stepKey) Then
            GoTo next_step
        End If

        For Each headerCell In CVDSourceDataTable.HeaderRowRange.Cells

            fieldName = CStr(headerCell.value)

            Select Case fieldName
                Case COL_CVD_ROW_ID_DB, COL_CVD_RESULT_ID_DB, COL_CVD_STEP_DB
                    GoTo next_source_header
            End Select

            rangeName = "CVD_" & formIndex & "_" & stepKey & "_" & fieldName

            If Not NamedRangeExists(wb, rangeName) Then
                errorCount = errorCount + 1
                errors = errors & errorCount & ". Не найден именованный диапазон: " & rangeName & vbCrLf
                GoTo next_source_header
            End If

            Set rng = sheetCVD.Range(rangeName)

            If IsError(rng.value) Then
                errorCount = errorCount + 1
                errors = errors & errorCount & ". " & rangeName & _
                         " содержит ошибку Excel: " & rng.text & _
                         " (" & rng.Worksheet.name & "!" & rng.Address(False, False) & ")" & vbCrLf
                GoTo next_source_header
            End If

            valueText = Trim$(CStr(rng.value))

            Select Case fieldName

                Case "operator"
                    If valueText = "" Then
                        errorCount = errorCount + 1
                        errors = errors & errorCount & ". Не указан исполнитель: " & rangeName & vbCrLf
                    ElseIf Not IsValidExecutor(rng.value) Then
                        errorCount = errorCount + 1
                        errors = errors & errorCount & ". Неверно указан исполнитель: " & rangeName & vbCrLf
                    End If

                Case "date"
                    If valueText = "" Then
                        errorCount = errorCount + 1
                        errors = errors & errorCount & ". Не указана дата step: " & rangeName & vbCrLf
                    ElseIf Not IsDate(rng.value) Then
                        errorCount = errorCount + 1
                        errors = errors & errorCount & ". Значение должно быть датой: " & rangeName & vbCrLf
                    End If

                Case "sampleCodeLPh", "sampleCodeGPh"
                    ' Базово допускаем 1 или 2 полученные пробы.
                    ' Но если обе пустые — ошибка ниже после цикла по полям.

                Case "Ppic"
                    If valueText <> "" Then
                        If Not valueText Like "20##-P##" Then
                            errorCount = errorCount + 1
                            errors = errors & errorCount & ". Формат Ppic должен быть 20##-P##: " & rangeName & vbCrLf
                        End If
                    End If

                Case "Upic"
                    If valueText <> "" Then
                        ' Пока без строгой проверки.
                    End If

                Case "gorEquipment"
                    If valueText = "" Then
                        errorCount = errorCount + 1
                        errors = errors & errorCount & ". Не указано оборудование: " & rangeName & vbCrLf
                    End If

                Case "cellFluidMass", "d20", "dGas", "evacuatedFluidMass", _
                     "GF", "initPatm", "m0", "m0Trap", "m1", "m1Trap", "m2", _
                     "mgas", "mLiq", "Patm", "picDen", "stepPcell", "stepTcell", _
                     "T", "transferPcell", "V1", "V2", "Vcell", "Vcellend", _
                     "VCellLiq", "Vgas", "VgasSt", "VGCyl", "VGTot", _
                     "VHeCyl", "VHeTot", "VLiq", "VLiqRelative", "Vtransfer"

                    If valueText <> "" Then
                        If Not IsNumeric(rng.value) Then
                            errorCount = errorCount + 1
                            errors = errors & errorCount & ". Значение должно быть числом: " & rangeName & vbCrLf
                        End If
                    End If

            End Select

next_source_header:
        Next headerCell

        Dim lphText As String
        Dim gphText As String

        lphText = ""
        gphText = ""

        If NamedRangeExists(wb, "CVD_" & formIndex & "_" & stepKey & "_sampleCodeLPh") Then
            lphText = Trim$(CStr(sheetCVD.Range("CVD_" & formIndex & "_" & stepKey & "_sampleCodeLPh").value))
        End If

        If NamedRangeExists(wb, "CVD_" & formIndex & "_" & stepKey & "_sampleCodeGPh") Then
            gphText = Trim$(CStr(sheetCVD.Range("CVD_" & formIndex & "_" & stepKey & "_sampleCodeGPh").value))
        End If

        If lphText = "" And gphText = "" Then
            errorCount = errorCount + 1
            errors = errors & errorCount & ". В CVD_" & formIndex & "_" & stepKey & _
                     " не указан ни один шифр полученной пробы: sampleCodeLPh/sampleCodeGPh." & vbCrLf
        End If

        ' Пример связанной проверки внутри step.
        ' Пока мягкая: если есть масса газа, должен быть объем газа или VGTot.
        If NamedRangeExists(wb, "CVD_" & formIndex & "_" & stepKey & "_mgas") _
           And NamedRangeExists(wb, "CVD_" & formIndex & "_" & stepKey & "_Vgas") _
           And NamedRangeExists(wb, "CVD_" & formIndex & "_" & stepKey & "_VGTot") Then

            If Trim$(CStr(sheetCVD.Range("CVD_" & formIndex & "_" & stepKey & "_mgas").value)) <> "" Then

                If Trim$(CStr(sheetCVD.Range("CVD_" & formIndex & "_" & stepKey & "_Vgas").value)) = "" _
                   And Trim$(CStr(sheetCVD.Range("CVD_" & formIndex & "_" & stepKey & "_VGTot").value)) = "" Then

                    errorCount = errorCount + 1
                    errors = errors & errorCount & ". В CVD_" & formIndex & "_" & stepKey & _
                             " указана mgas, но не указан Vgas/VGTot." & vbCrLf

                End If

            End If

        End If

next_step:
    Next stepIndex

    If errorCount > 0 Then
        MsgBox "CVD_" & formIndex & " не сохранена. Исправьте ошибки:" & vbCrLf & vbCrLf & errors, vbExclamation
        Exit Function
    End If

    Validate_CVD_Form = True

End Function
```

```vb
Private Function CVD_StepKeys() As Variant

    CVD_StepKeys = Array( _
        "st1", "st2", "st3", "st4", "st5", _
        "st6", "st7", "st8", "st9", "st10", _
        "last" _
    )

End Function


Private Function CVD_StepHasData( _
    ByVal formIndex As Long, _
    ByVal stepKey As String _
) As Boolean

    CVD_StepHasData = False

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetCVD As Worksheet
    Set sheetCVD = wb.Worksheets("CVD")

    ' Ключевые поля для определения непустого step.
    ' Я поставил примерный набор. Потом можешь спокойно поправить.
    Dim keyFields As Variant
    keyFields = Array( _
        "operator", _
        "date", _
        "Ppic", _
        "Vcell", _
        "VGTot", _
        "VLiq", _
        "sampleCodeLPh", _
        "sampleCodeGPh" _
    )

    Dim i As Long
    Dim rangeName As String
    Dim v As Variant

    For i = LBound(keyFields) To UBound(keyFields)

        rangeName = "CVD_" & formIndex & "_" & stepKey & "_" & CStr(keyFields(i))

        If NamedRangeExists(wb, rangeName) Then

            v = sheetCVD.Range(rangeName).value

            If IsError(v) Then
                CVD_StepHasData = True
                Exit Function
            End If

            If Trim$(CStr(v)) <> "" Then

                If IsNumeric(v) Then
                    If Abs(CDbl(v)) > 0 Then
                        CVD_StepHasData = True
                        Exit Function
                    End If
                Else
                    CVD_StepHasData = True
                    Exit Function
                End If

            End If

        End If

    Next i

End Function


Private Function CVD_StepKeyFromDbValue(ByVal stepValue As Variant) As String

    CVD_StepKeyFromDbValue = ""

    If IsError(stepValue) Then Exit Function
    If Trim$(CStr(stepValue)) = "" Then Exit Function
    If Not IsNumeric(stepValue) Then Exit Function

    Dim n As Long
    n = CLng(val(stepValue))

    If n >= 1 And n <= 10 Then
        CVD_StepKeyFromDbValue = "st" & n
    ElseIf n = 11 Then
        CVD_StepKeyFromDbValue = "last"
    End If

End Function


Private Function CVD_CalculateCommonTaskStatus(ByVal validForms As Collection) As String

    CVD_CalculateCommonTaskStatus = ""

    If validForms Is Nothing Then Exit Function
    If validForms.count = 0 Then Exit Function

    Dim sheetCVD As Worksheet
    Set sheetCVD = ActiveWorkbook.Worksheets("CVD")

    Dim steps As Variant
    steps = CVD_StepKeys()

    Dim pageValue As Variant
    Dim formIndex As Long

    Dim formStatus As String
    Dim commonStatus As String

    For Each pageValue In validForms

        formIndex = CLng(pageValue)

        If CVD_StepHasData(formIndex, "last") Then
            formStatus = "Завершено"
        Else
            Dim completedSteps As Long
            Dim i As Long

            completedSteps = 0

            For i = 0 To 9
                If CVD_StepHasData(formIndex, CStr(steps(i))) Then
                    completedSteps = completedSteps + 1
                Else
                    Exit For
                End If
            Next i

            If completedSteps > 0 Then
                formStatus = "В работе " & completedSteps & "/11"
            Else
                formStatus = ""
            End If
        End If

        If commonStatus = "" Then
            commonStatus = formStatus
        ElseIf commonStatus <> formStatus Then
            ' Важно: RunStudySync принимает один taskStatus на весь save.
            ' Если одновременно сохраняются формы с разным прогрессом,
            ' одним параметром это корректно не описать.
            commonStatus = ""
            Exit For
        End If

    Next pageValue

    CVD_CalculateCommonTaskStatus = commonStatus

End Function
```

```vb
Private Function CVD_CurrentFormIndex() As Long

    CVD_CurrentFormIndex = 0

    Dim sheetCVD As Worksheet
    Set sheetCVD = ActiveWorkbook.Worksheets("CVD")

    Dim length As Long

    On Error Resume Next
    length = sheetCVD.Range("CVD_2_sampleCode").Column - sheetCVD.Range("CVD_1_sampleCode").Column
    On Error GoTo 0

    If length <= 0 Then Exit Function

    CVD_CurrentFormIndex = (ActiveCell.Column - CVD_FIRST_FORM_FIRST_COL) \ length + 1

End Function


Private Function CVD_CurrentStepKey() As String

    CVD_CurrentStepKey = ""

    Dim cellName As String

    On Error Resume Next
    cellName = ActiveCell.Name.Name
    On Error GoTo 0

    If cellName = "" Then Exit Function

    Dim parts() As String
    parts = Split(cellName, "_")

    If UBound(parts) < 2 Then Exit Function

    If UCase$(parts(0)) <> "CVD" Then Exit Function

    If LCase$(parts(2)) Like "st#" _
       Or LCase$(parts(2)) Like "st##" _
       Or LCase$(parts(2)) = "last" Then

        CVD_CurrentStepKey = LCase$(parts(2))

    End If

End Function
