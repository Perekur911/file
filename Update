Attribute VB_Name = "SSF"
Option Explicit
Private Const COL_SSF_ROW_ID_DB As String = "rowIdSSF"
Private Const COL_SSF_RESULT_ID_DB As String = "resultIdSSF"
Private Const COL_SSF_SAMPLE_CODE_DB As String = "sampleCode"
Private Const COL_SSF_TYPE_PH_DB As String = "TypePh"

Private Const SSF_FIRST_FORM_FIRST_COL As Long = 2
Private Const SSF_PAGE_ROW = 4
Private Const SSF_PAGE_FIRST_COL = 2

Private Enum SSFFormState
    SSF_FORM_EMPTY = 0
    SSF_FORM_RESERVED = 1
    SSF_FORM_FILLED = 2
End Enum

Public Function cancelCurrentTaskSSF() As macroResult
    
    cancelCurrentTaskSSF = MACRO_FAILED
    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetSSF As Worksheet
    Set sheetSSF = wb.Worksheets("SSF")
    
    Dim lenght As Integer
    lenght = sheetSSF.Range("SSF_2_sampleCode").Column - sheetSSF.Range("SSF_1_sampleCode").Column
    
    Dim curFormIndex As Integer
    curFormIndex = (activeCell.Column - SSF_FIRST_FORM_FIRST_COL) \ lenght + 1
    
    Dim taskCell As Range
    Set taskCell = sheetSSF.Range("SSF_" & curFormIndex & "_taskId")
    
    Dim answer As Integer
    
    answer = MsgBox("Вы действительно хотите удалить задание №" & taskCell.value & "?", vbQuestion + vbYesNo, "Подтверждение")
    
    If answer <> vbYes Then
        cancelCurrentTaskSSF = MACRO_NO_CHANGES
        Exit Function
    End If
    
    Dim comment As String
    comment = InputBox("Введите причину отмены:", "Окно ввода")
    
    Dim syncResult As String
    syncResult = SetTaskStatusOnly(taskCell.value, "SSF", "Отмена", comment)

    If InStr(1, syncResult, """ok"": true", vbTextCompare) > 0 Then
        With taskCell.MergeArea
            .Interior.ColorIndex = 3
            If .Locked = False Then
                .Locked = True
            End If
        End With
        cancelCurrentTaskSSF = MACRO_CHANGED
        
    ElseIf syncResult = "NoComment" Or syncResult = "NoTaskId" Then
        cancelCurrentTaskSSF = MACRO_NO_CHANGES
        
    End If
End Function


Public Sub editCurrentSamplesFormSSF()
    
    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetSSF As Worksheet
    Set sheetSSF = wb.Worksheets("SSF")
    
    Dim lenght As Integer
    lenght = sheetSSF.Range("SSF_2_sampleCode").Column - sheetSSF.Range("SSF_1_sampleCode").Column
    
    Dim curFormIndex As Integer
    curFormIndex = (activeCell.Column - SSF_FIRST_FORM_FIRST_COL) \ lenght + 1
    
    CreateSampleCodeSSF3 curFormIndex
    
End Sub

Public Sub AddFormSSF()

    Dim sheetSSF As Worksheet
    Set sheetSSF = ActiveWorkbook.Worksheets("SSF")

    Dim lastList As Integer
    Dim lastColumn As Integer
    Dim firstColumn As Integer
    Dim lenght As Integer
    lenght = sheetSSF.Range("SSF_2_sampleCode").Column - sheetSSF.Range("SSF_1_sampleCode").Column
    lastList = sheetSSF.ListObjects.count + 1
    lastColumn = (lastList) * lenght + SSF_FIRST_FORM_FIRST_COL - 1
    firstColumn = lastColumn - lenght + 1
    
    Range(sheetSSF.columns(firstColumn - lenght), sheetSSF.columns(lastColumn - lenght)).EntireColumn.Copy
    sheetSSF.Paste Destination:=sheetSSF.columns(firstColumn)
    
    sheetSSF.Cells(SSF_PAGE_ROW, firstColumn + SSF_FIRST_FORM_FIRST_COL - SSF_FIRST_FORM_FIRST_COL).value = lastList
    
    sheetSSF.Cells.FormatConditions.Delete
    
    Dim rowDeltaMatBalance As Integer
    rowDeltaMatBalance = sheetSSF.Range("SSF_1_deltaMatBalance").row
    
    Dim rowCorrect As Integer
    rowCorrect = sheetSSF.Range("SSF_1_Correct").row
    
    Dim strRangeFormat As String
    strRangeFormat = "$" & rowCorrect & ":$" & rowCorrect
    With sheetSSF.Range(strRangeFormat).FormatConditions.Add(Type:=xlCellValue, Operator:=xlEqual, Formula1:="=ИСТИНА")
        .Interior.Color = RGB(0, 218, 99) ' Зелёный цвет
    End With
    With sheetSSF.Range(strRangeFormat).FormatConditions.Add(Type:=xlCellValue, Operator:=xlEqual, Formula1:="=ЛОЖЬ")
        .Interior.Color = RGB(255, 71, 87) ' Красный цвет
    End With
    
    strRangeFormat = "$" & rowDeltaMatBalance & ":$" & rowDeltaMatBalance
    ' 1. Зелёный: значение <= 0.01
    With sheetSSF.Range(strRangeFormat).FormatConditions.Add(Type:=xlExpression, Formula1:="=И(ЕЧИСЛО(A$" & rowDeltaMatBalance & "); A$" & rowDeltaMatBalance & " <= 0,01)")
        .Interior.Color = RGB(0, 218, 99)
    End With
    ' 2. Жёлтый: > 0.01 и <= 0.02
    With sheetSSF.Range(strRangeFormat).FormatConditions.Add(Type:=xlExpression, Formula1:="=И(ЕЧИСЛО(A$" & rowDeltaMatBalance & "); A$" & rowDeltaMatBalance & " > 0,01; A$" & rowDeltaMatBalance & " <= 0,03)")
        .Interior.Color = RGB(255, 235, 4)
    End With
    ' 3. Красный: > 0.02
    With sheetSSF.Range(strRangeFormat).FormatConditions.Add(Type:=xlExpression, Formula1:="=И(ЕЧИСЛО(A$" & rowDeltaMatBalance & "); A$" & rowDeltaMatBalance & " > 0,03)")
        .Interior.Color = RGB(255, 71, 87)
    End With
    
    Dim prev_name As String
    Dim new_name As String
    prev_name = "SSF_source_" & (lastList - 1)
    new_name = "SSF_source_" & (lastList)
    
    For i = lastList To 1 Step -1
        If sheetSSF.ListObjects(i).name Like prev_name & "##*" Then
            sheetSSF.ListObjects(i).name = new_name
            Exit For
        End If
    Next i
    
    prev_name = "SSF_" & (lastList - 1)
    new_name = "SSF_" & (lastList)
    
    Dim TableSSFResult As ListObject
    Set TableSSFResult = ActiveWorkbook.Worksheets("SSF_results").ListObjects("SSF_results")
    Dim name_rng As Range

    For Each name_rng In TableSSFResult.HeaderRowRange
            If name_rng.value = "dateTimeSync" Then
                GoTo cont
            End If
            Dim current As Range
            oldName = prev_name & "_" & name_rng.value
            Set current = sheetSSF.Cells(sheetSSF.Range(oldName).row, sheetSSF.Range(oldName).Column + lenght)
            current.name = Replace(oldName, prev_name, new_name)
            If Not current.HasFormula Then
                current.value = ""
            Else
                Application.DisplayAlerts = False
                On Error Resume Next
                    current.Formula = Replace(current.Formula, "_" & (lastList - 1), "_" & lastList)
                Application.DisplayAlerts = True
            End If
cont:
    Next name_rng
    
    Dim printArea() As String
    printArea = Split(sheetSSF.PageSetup.printArea, ":")
    sheetSSF.PageSetup.printArea = printArea(0) & ":" & Range(printArea(1)).Offset(0, lenght).Address
    
    Dim sh As CheckBox
    For x = sheetSSF.CheckBoxes.count To 1 Step -1
        Set sh = sheetSSF.CheckBoxes(x)
        If sh.TopLeftCell.Column = sheetSSF.Range(new_name & "_Correct").Column Then
            sh.name = "CheckBox_SSF_" & lastList
            sh.linkedCell = sh.TopLeftCell.Address
            sh.value = xlOn
            Exit For
        End If
    Next x
    
    sheetSSF.Range(new_name & "_sampleCode").Resize(1, 3).Locked = False
    sheetSSF.Range(new_name & "_sampleCode").Interior.Color = xlNone
    sheetSSF.Range(new_name & "_TaskId").Resize(1, 3).Locked = False
    sheetSSF.Range(new_name & "_TaskId").Interior.Color = xlNone

End Sub


Public Function Save_SSF(Optional ByVal taskStatus As String = "") As macroResult
    Save_SSF = MACRO_FAILED
    Dim t0 As Double
    Dim t As Double
    
    t0 = Timer
    t = t0

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetSSF As Worksheet
    Set sheetSSF = wb.Worksheets("SSF")

    Dim sheetSSFResults As Worksheet
    Set sheetSSFResults = wb.Worksheets("SSF_results")

    Dim sheetSSFSourceData As Worksheet
    Set sheetSSFSourceData = wb.Worksheets("SSF_sourceData")

    Dim tasks As ListObject
    Set tasks = wb.Worksheets("Task").ListObjects(1)

    Dim SSFTable As ListObject
    Set SSFTable = sheetSSFResults.ListObjects("SSF_results")

    Dim SSFSourceDataTable As ListObject
    Set SSFSourceDataTable = sheetSSFSourceData.ListObjects("SSF_sourceData")

    Dim parentRows As Collection
    Set parentRows = New Collection

    Dim childRows As Collection
    Set childRows = New Collection

    Dim validForms As Collection
    Set validForms = New Collection

    Dim oldSourceRowIds As Object
    Set oldSourceRowIds = BuildOldChildRowIdMap( _
        SSFSourceDataTable, _
        COL_SSF_ROW_ID_DB, _
        COL_SSF_RESULT_ID_DB _
    )
    
    Dim formState As SSFFormState
    Dim i As Long
    Dim x As Long

    i = 1

    Do While NamedRangeExists(wb, "SSF_" & i & "_sampleCode")
        
        formState = Get_SSF_FormState(i)

        Select Case formState
    
            Case SSF_FORM_EMPTY
                GoTo NextFormFirstPass
    
            Case SSF_FORM_RESERVED
                GoTo NextFormFirstPass
    
            Case SSF_FORM_FILLED
                ' идём дальше
                
        End Select
        
        If sheetSSF.Range("SSF_" & i & "_TaskId").Interior.ColorIndex = 3 Then
            GoTo NextFormFirstPass
        End If
        
        If sheetSSF.Range("SSF_" & i & "_analyseNumber").value = "" Then
            Call checkNumberAnalys2( _
                sheetSSF.Range("SSF_" & i & "_sampleCode").value, _
                "SSF" _
            )
        End If
        
        If Not Validate_SSF_Form(i) Then
            Exit Function
        End If
        
        Dim curTask As Variant
        curTask = sheetSSF.Range("SSF_" & i & "_TaskId").value
        
        If Len(Trim$(CStr(curTask))) > 0 And CLng(val(curTask)) <> 0 Then
            If Not CheckSSFTask(tasks, CLng(val(curTask)), CStr(sheetSSF.Range("SSF_" & i & "_sampleCode").value), i) Then
                GoTo NextFormFirstPass
            End If
        End If
        
        Dim expectedLPhCount As Long
        Dim expectedGPhCount As Long
        
        Dim actualLPhCount As Long
        Dim actualGPhCount As Long
        
        Dim countAnswer As VbMsgBoxResult
        
        actualLPhCount = 0
        actualGPhCount = 0
        
        ' Если корректных шифров вообще нет,
        ' предлагаем их сформировать.
        If Not SSF_GetSampleCodeCounts( _
            i, _
            actualLPhCount, _
            actualGPhCount _
        ) Then
        
            Application.ScreenUpdating = True
            DoEvents
            Application.ScreenUpdating = False
        
            If Not CreateSampleCodeSSF3(i) Then
                GoTo NextFormFirstPass
            End If
        
            ' После создания перечитываем фактические количества.
            actualLPhCount = 0
            actualGPhCount = 0
        
            Call SSF_GetSampleCodeCounts( _
                i, _
                actualLPhCount, _
                actualGPhCount _
            )
        
        End If
        
        ' После формирования всё равно нет ни одного
        ' корректного шифра.
        If actualLPhCount + actualGPhCount = 0 Then
        
            MsgBox _
                "Страница " & i & ": в таблице SSF_source_" & i & _
                " нет ни одного корректного шифра полученной пробы " & _
                "с TypePh = LPh или GPh.", _
                vbExclamation
        
            GoTo NextFormFirstPass
        
        End If
        
        ' Ожидаемое число жидких проб:
        ' vial + bottle.
        expectedLPhCount = 0
        
        If IsNumeric( _
            sheetSSF.Range("SSF_" & i & "_vial").value _
        ) Then
        
            expectedLPhCount = expectedLPhCount + _
                CLng(sheetSSF.Range( _
                    "SSF_" & i & "_vial" _
                ).value)
        
        End If
        
        If IsNumeric( _
            sheetSSF.Range("SSF_" & i & "_bottle").value _
        ) Then
        
            expectedLPhCount = expectedLPhCount + _
                CLng(sheetSSF.Range( _
                    "SSF_" & i & "_bottle" _
                ).value)
        
        End If
        
        ' Ожидаемое число газовых проб:
        ' pics.
        expectedGPhCount = 0
        
        If IsNumeric( _
            sheetSSF.Range("SSF_" & i & "_pics").value _
        ) Then
        
            expectedGPhCount = _
                CLng(sheetSSF.Range( _
                    "SSF_" & i & "_pics" _
                ).value)
        
        End If
        
        ' Предупреждаем, если отличается количество
        ' хотя бы одной фазы.
        If actualLPhCount <> expectedLPhCount _
           Or actualGPhCount <> expectedGPhCount Then
        
            countAnswer = MsgBox( _
                "Страница " & i & "." & vbCrLf & vbCrLf & _
                "Количество фактически полученных проб " & _
                "не совпадает с количеством, указанным в форме." & _
                vbCrLf & vbCrLf & _
                "Жидкие пробы LPh:" & vbCrLf & _
                "  Указано vial + bottle: " & expectedLPhCount & vbCrLf & _
                "  Фактически шифров: " & actualLPhCount & _
                vbCrLf & vbCrLf & _
                "Газовые пробы GPh:" & vbCrLf & _
                "  Указано pics: " & expectedGPhCount & vbCrLf & _
                "  Фактически шифров: " & actualGPhCount & _
                vbCrLf & vbCrLf & _
                "Продолжить сохранение этой формы?", _
                vbQuestion + vbYesNo + vbDefaultButton2, _
                "Несоответствие количества полученных проб" _
            )
        
            If countAnswer <> vbYes Then
                GoTo NextFormFirstPass
            End If
        
        End If
        
        validForms.Add i
        
NextFormFirstPass:
        i = i + 1
    Loop

    Debug.Print "SSF v3 after sample forms", _
                "step:", Format$(Timer - t, "0.000"), _
                "total:", Format$(Timer - t0, "0.000")
    t = Timer

    Dim formValue As Variant

    For Each formValue In validForms

        i = CLng(formValue)

        Dim resultIdValue As Variant
        Dim parentKey As String

        resultIdValue = sheetSSF.Range("SSF_" & i & "_resultIdSSF").value

        If Len(NormalizeKeyValue(resultIdValue)) = 0 Or NormalizeKeyValue(resultIdValue) = "0" Then
            parentKey = "temp_" & i
        Else
            parentKey = NormalizeKeyValue(resultIdValue)
        End If

        Dim parentRow() As Variant
        ReDim parentRow(1 To SSFTable.ListColumns.count)

        Dim headerCell As Range
        Dim headerName As String
        Dim parentColIndex As Long
        Dim formRangeName As String

        For Each headerCell In SSFTable.HeaderRowRange.Cells

            headerName = CStr(headerCell.value)
            parentColIndex = SSFTable.ListColumns(headerName).index
            formRangeName = "SSF_" & i & "_" & headerName

            If headerName = "dateTimeSync" Then
                parentRow(parentColIndex) = Format$(Now, "yyyy-mm-dd hh:nn:ss")

            ElseIf headerName = COL_SSF_RESULT_ID_DB Then
                parentRow(parentColIndex) = parentKey

            ElseIf NamedRangeExists(wb, formRangeName) Then
                parentRow(parentColIndex) = FormatValueForSyncText( _
                    headerName, _
                    sheetSSF.Range(formRangeName).value _
                )

            Else
                parentRow(parentColIndex) = vbNullString

            End If

        Next headerCell

        parentRows.Add parentRow

        Dim srcTable As ListObject
        Set srcTable = sheetSSF.ListObjects("SSF_source_" & i)

        If Not srcTable.DataBodyRange Is Nothing Then

            For x = 1 To srcTable.ListRows.count

                Dim hasSourceData As Boolean
                Dim oldRowIdSSF As String

                hasSourceData = SourceRowHasData( _
                    srcTable, _
                    x, _
                    Array(COL_SSF_SAMPLE_CODE_DB, COL_SSF_TYPE_PH_DB), _
                    Array("AND") _
                )

                oldRowIdSSF = GetOldChildRowId(oldSourceRowIds, parentKey, x)

                If Len(oldRowIdSSF) = 0 Then
                    If ListColumnExists(srcTable, COL_SSF_ROW_ID_DB) Then
                        oldRowIdSSF = NormalizeKeyValue( _
                            srcTable.DataBodyRange.Cells( _
                                x, _
                                srcTable.ListColumns(COL_SSF_ROW_ID_DB).index _
                            ).value _
                        )
                    End If
                End If

                If hasSourceData Or Len(oldRowIdSSF) > 0 Then

                    Dim childRow() As Variant
                    ReDim childRow(1 To SSFSourceDataTable.ListColumns.count)

                    childRow(SSFSourceDataTable.ListColumns(COL_SSF_ROW_ID_DB).index) = oldRowIdSSF
                    childRow(SSFSourceDataTable.ListColumns(COL_SSF_RESULT_ID_DB).index) = parentKey

                    If hasSourceData Then

                        childRow(SSFSourceDataTable.ListColumns(COL_SSF_SAMPLE_CODE_DB).index) = _
                            FormatValueForSyncText( _
                                COL_SSF_SAMPLE_CODE_DB, _
                                srcTable.DataBodyRange.Cells( _
                                    x, _
                                    srcTable.ListColumns(COL_SSF_SAMPLE_CODE_DB).index _
                                ).value _
                            )

                        childRow(SSFSourceDataTable.ListColumns(COL_SSF_TYPE_PH_DB).index) = _
                            FormatValueForSyncText( _
                                COL_SSF_TYPE_PH_DB, _
                                srcTable.DataBodyRange.Cells( _
                                    x, _
                                    srcTable.ListColumns(COL_SSF_TYPE_PH_DB).index _
                                ).value _
                            )

                    End If

                    childRows.Add childRow

                End If

            Next x

        End If

    Next formValue

    WriteCollectionToListObject SSFTable, parentRows
    WriteCollectionToListObject SSFSourceDataTable, childRows

    Debug.Print "SSF v3 after write tables", _
                "step:", Format$(Timer - t, "0.000"), _
                "total:", Format$(Timer - t0, "0.000")
    t = Timer

    If parentRows.count > 0 Then

        Dim syncResult As String
        syncResult = RunStudySync("save", studies:="SSF", taskStatus:=taskStatus)

        If InStr(1, syncResult, """ok"": true", vbTextCompare) > 0 Then

            Call DeleteEmptyRowsByColumns( _
                SSFSourceDataTable, _
                COL_SSF_ROW_ID_DB, _
                Array(COL_SSF_SAMPLE_CODE_DB, COL_SSF_TYPE_PH_DB) _
            )

            Call Load_SSF_results_to_forms( _
                "by_key", _
                Array(COL_SSF_RESULT_ID_DB, COL_SSF_ROW_ID_DB) _
            )
            Save_SSF = MACRO_CHANGED
        Else
            MsgBox "Синхронизация SSF не подтверждена как успешная." & vbCrLf & vbCrLf & syncResult, vbExclamation
        End If
    Else
        Save_SSF = MACRO_NO_CHANGES
    End If

End Function

Public Sub createSampleCodeSSF2(Optional numPage As Integer)
    
    Dim sheetSSF As Worksheet
    Set sheetSSF = ActiveWorkbook.Worksheets("SSF")
    pageRow = sheetSSF.Range("SSF_1_page").row
    Dim page As Integer
    Dim pageRange As Range
    
    If Not sheetSSF.Shapes(Application.Caller) Is Nothing Then
        Set pageRange = sheetSSF.Cells(pageRow, (sheetSSF.Shapes(Application.Caller).TopLeftCell.Column - 2))
        If NameExist2(pageRange) Then
            If pageRange.name.name Like "SSF_#*_page" Then
                page = pageRange.value
            Else
                Exit Sub
            End If
        End If
    End If
    If numPage <> 0 Then
        page = numPage
    ElseIf page = 0 Then
        Exit Sub
    End If
    
    Dim SSF_samples_table As ListObject
    Set SSF_samples_table = sheetSSF.ListObjects("SSF_" & page)
    
    If sheetSSF.Range("SSF_" & page & "_sampleCode").value = "" Then
        Exit Sub
    End If
    Dim countVial As Variant
    Dim countBottle As Variant
    Dim countPics As Variant
    
    countVial = sheetSSF.Range("SSF_" & page & "_vial").value
    countBottle = sheetSSF.Range("SSF_" & page & "_bottle").value
    countPics = sheetSSF.Range("SSF_" & page & "_pics").value
    analyseNumber = sheetSSF.Range("SSF_" & page & "_analyseNumber").value
    
    Dim sampleCodeLPh As New Collection
    Dim sampleCodeGPh As New Collection
    Dim sampleCodePrefix As String
    Dim sampleCodePostfix As String
    
    If analyseNumber = "1" Then
        sampleCodePrefix = sheetSSF.Range("SSF_" & page & "_sampleCode").value & "-SSF-"
    Else
        sampleCodePrefix = sheetSSF.Range("SSF_" & page & "_sampleCode").value & "-SSF" & analyseNumber & "-"
    End If
    
    If IsNumeric(countVial) And countVial <> 0 Then
        
        If sheetSSF.Range("SSF_" & page & "_m1Trap1").value - sheetSSF.Range("SSF_" & page & "_m0Trap1").value > 0.4 Then
            sampleCodePostfix = "L"
        Else
            sampleCodePostfix = "Rinse"
        End If
        If countVial > 1 Then
            For i = 1 To countVial
                sampleCodeLPh.Add (sampleCodePrefix & sampleCodePostfix & i)
            Next i
        ElseIf countVial = 1 Then
            sampleCodeLPh.Add (sampleCodePrefix & sampleCodePostfix)
        End If
    End If
    
    If IsNumeric(countPics) And countPics <> 0 Then
        sampleCodePostfix = ""
        If IsNumeric(sheetSSF.Range("SSF_" & page & "_VHeTot").value) Then
            If sheetSSF.Range("SSF_" & page & "_VHeTot") > 0 Then
                sampleCodePostfix = "-He"
            End If
        End If
        If countPics > 1 Then
            For i = 1 To countPics
                sampleCodeGPh.Add (sampleCodePrefix & "G" & i & sampleCodePostfix)
            Next i
        ElseIf countPics = 1 Then
            sampleCodeGPh.Add (sampleCodePrefix & "G" & sampleCodePostfix)
        End If
    End If
    
    If IsNumeric(countBottle) And countBottle <> 0 Then
        
        sampleCodePostfix = "LB"
            
        If countBottle > 1 Then
            For i = 1 To countBottle
                sampleCodeLPh.Add (sampleCodePrefix & sampleCodePostfix & i)
            Next i
        ElseIf countBottle = 1 Then
            sampleCodeLPh.Add (sampleCodePrefix & sampleCodePostfix)
        End If
    End If
    
    ' показ формы
    Dim frm As New frmCheckCodes
    frm.InitWithCollections sampleCodeLPh, sampleCodeGPh, "SSF", sheetSSF.Range("SSF_" & page & "_sampleCode"), page
    frm.show
    Dim arrSamples() As String
    Dim countSamples As Integer
    countSamples = sampleCodeLPh.count + sampleCodeGPh.count
    ReDim arrSamples(1 To countSamples, 1 To SSF_samples_table.ListColumns.count)

    rowDiff = SSF_samples_table.ListRows.count - sampleCodeLPh.count - sampleCodeGPh.count
    If rowDiff > 0 Then
        For i = rowDiff To 1 Step -1
            SSF_samples_table.ListRows(SSF_samples_table.ListRows.count).Delete
        Next i
    ElseIf rowDiff < 0 Then
        For i = -1 * rowDiff To 1 Step -1
            SSF_samples_table.ListRows.Add
        Next i
    End If

    
    If frm.result Then
        For i = 1 To sampleCodeLPh.count
            arrSamples(i, SSF_samples_table.ListColumns("sampleCode").index) = sampleCodeLPh(i)
            arrSamples(i, SSF_samples_table.ListColumns("TypePh").index) = "LPh"
            If sheetSSF.Range("SSF_" & page & "_resultIdSSF").value > 0 Then
                arrSamples(i, SSF_samples_table.ListColumns("resultIdSSF").index) = sheetSSF.Range("SSF_" & page & "_resultIdSSF").value
            End If
            arrSamples(i, SSF_samples_table.ListColumns("rowIdSSF").index) = SSF_samples_table.ListColumns("rowIdSSF").DataBodyRange(i, 1)
            'Debug.Print sampleCodeLPh(i)
        Next i
        
        For i = 1 To sampleCodeGPh.count
            arrSamples(i + sampleCodeLPh.count, SSF_samples_table.ListColumns("sampleCode").index) = sampleCodeGPh(i)
            arrSamples(i + sampleCodeLPh.count, SSF_samples_table.ListColumns("TypePh").index) = "GPh"
            If sheetSSF.Range("SSF_" & page & "_resultIdSSF").value > 0 Then
                arrSamples(i + sampleCodeLPh.count, SSF_samples_table.ListColumns("resultIdSSF").index) = sheetSSF.Range("SSF_" & page & "_resultIdSSF").value
            End If
            arrSamples(i + sampleCodeLPh.count, SSF_samples_table.ListColumns("rowIdSSF").index) = SSF_samples_table.ListColumns("rowIdSSF").DataBodyRange(i + sampleCodeLPh.count, 1)
            'Debug.Print sampleCodeGPh(i)
        Next i
        
        SSF_samples_table.DataBodyRange = arrSamples
        
        Dim printArea() As String
        printArea = Split(sheetSSF.PageSetup.printArea, ":")
        Dim lastRow As Long
        lastRow = Cells.Find("*", SearchOrder:=xlByRows, SearchDirection:=xlPrevious).row
        If lastRow <> sheetSSF.Range(printArea(1)).row Then
            sheetSSF.PageSetup.printArea = printArea(0) & ":" & sheetSSF.Cells(lastRow, sheetSSF.Range(printArea(1)).Column).Address
        End If
    Else
        MsgBox "????", vbInformation
    End If
    
    Dim arr As Variant
    arr = Array("SSF")
    Call CallPythonWithArrays(arr)
    
End Sub

Public Function CreateSampleCodeSSF3(Optional ByVal formIndex As Long = 0) As Boolean

    CreateSampleCodeSSF3 = False

    Dim sheetSSF As Worksheet
    Set sheetSSF = ActiveWorkbook.Worksheets("SSF")

    If formIndex <= 0 Then Exit Function

    If Not NamedRangeExists(ActiveWorkbook, "SSF_" & formIndex & "_sampleCode") Then
        MsgBox "Форма SSF_" & formIndex & " не найдена."
        Exit Function
    End If

    If sheetSSF.Range("SSF_" & formIndex & "_sampleCode").value = "" Then
        MsgBox "Не заполнен шифр исследуемой пробы."
        Exit Function
    End If

    Dim SSFSamplesTable As ListObject
    Set SSFSamplesTable = sheetSSF.ListObjects("SSF_source_" & formIndex)

    Dim countVial As Variant
    Dim countBottle As Variant
    Dim countPics As Variant
    Dim analyseNumber As Variant

    countVial = sheetSSF.Range("SSF_" & formIndex & "_vial").value
    countBottle = sheetSSF.Range("SSF_" & formIndex & "_bottle").value
    countPics = sheetSSF.Range("SSF_" & formIndex & "_pics").value
    analyseNumber = sheetSSF.Range("SSF_" & formIndex & "_analyseNumber").value

    Dim sampleCodeLPh As New Collection
    Dim sampleCodeGPh As New Collection

    Dim sampleCodePrefix As String
    Dim sampleCodePostfix As String

    If analyseNumber = "1" Then
        sampleCodePrefix = sheetSSF.Range("SSF_" & formIndex & "_sampleCode").value & "-SSF-"
    Else
        sampleCodePrefix = sheetSSF.Range("SSF_" & formIndex & "_sampleCode").value & "-SSF" & analyseNumber & "-"
    End If

    Dim i As Long

    If IsNumeric(countVial) And countVial <> 0 Then

        If sheetSSF.Range("SSF_" & formIndex & "_m1Trap1").value - _
           sheetSSF.Range("SSF_" & formIndex & "_m0Trap1").value > 0.4 Then
            sampleCodePostfix = "L"
        Else
            sampleCodePostfix = "Rinse"
        End If

        If countVial > 1 Then
            For i = 1 To countVial
                sampleCodeLPh.Add sampleCodePrefix & sampleCodePostfix & i
            Next i
        ElseIf countVial = 1 Then
            sampleCodeLPh.Add sampleCodePrefix & sampleCodePostfix
        End If

    End If

    If IsNumeric(countPics) And countPics <> 0 Then

        sampleCodePostfix = ""

        If IsNumeric(sheetSSF.Range("SSF_" & formIndex & "_VHeTot").value) Then
            If sheetSSF.Range("SSF_" & formIndex & "_VHeTot").value > 0 Then
                sampleCodePostfix = "-He"
            End If
        End If

        If countPics > 1 Then
            For i = 1 To countPics
                sampleCodeGPh.Add sampleCodePrefix & "G" & i & sampleCodePostfix
            Next i
        ElseIf countPics = 1 Then
            sampleCodeGPh.Add sampleCodePrefix & "G" & sampleCodePostfix
        End If

    End If

    If IsNumeric(countBottle) And countBottle <> 0 Then

        sampleCodePostfix = "LB"

        If countBottle > 1 Then
            For i = 1 To countBottle
                sampleCodeLPh.Add sampleCodePrefix & sampleCodePostfix & i
            Next i
        ElseIf countBottle = 1 Then
            sampleCodeLPh.Add sampleCodePrefix & sampleCodePostfix
        End If

    End If

    Dim countSamples As Long
    countSamples = sampleCodeLPh.count + sampleCodeGPh.count

    If countSamples = 0 Then
        MsgBox "Страница " & formIndex & ": не сформировано ни одного шифра полученной пробы.", vbExclamation
        Exit Function
    End If

    Dim frm As New frmCheckCodes
    frm.InitWithCollections sampleCodeLPh, sampleCodeGPh, "SSF", sheetSSF.Range("SSF_" & formIndex & "_sampleCode"), formIndex
    frm.show

    If Not frm.result Then
        MsgBox "Ввод шифров для страницы " & formIndex & " отменен.", vbInformation
        Exit Function
    End If

    If SSFSamplesTable.DataBodyRange Is Nothing Then
        MsgBox "В таблице SSF_source_" & formIndex & " нет строк.", vbExclamation
        Exit Function
    End If

    Dim oldRowIds As Object
    Set oldRowIds = CreateObject("Scripting.Dictionary")
    oldRowIds.CompareMode = vbTextCompare

    Dim oldRowsCount As Long
    oldRowsCount = SSFSamplesTable.ListRows.count

    If ListColumnExists(SSFSamplesTable, COL_SSF_ROW_ID_DB) Then
        For i = 1 To oldRowsCount
            oldRowIds(CStr(i)) = NormalizeKeyValue( _
                SSFSamplesTable.DataBodyRange.Cells( _
                    i, _
                    SSFSamplesTable.ListColumns(COL_SSF_ROW_ID_DB).index _
                ).value _
            )
        Next i
    End If

    If countSamples > oldRowsCount Then
        MsgBox "В SSF_source_" & formIndex & " недостаточно строк." & vbCrLf & _
               "Нужно строк: " & countSamples & vbCrLf & _
               "Есть строк: " & oldRowsCount, vbExclamation
        Exit Function
    End If

    Dim arrSamples() As Variant
    ReDim arrSamples(1 To oldRowsCount, 1 To SSFSamplesTable.ListColumns.count)

    Dim parentResultId As String
    parentResultId = NormalizeKeyValue(sheetSSF.Range("SSF_" & formIndex & "_resultIdSSF").value)

    Dim rowIndex As Long
    rowIndex = 1

    For i = 1 To sampleCodeLPh.count

        arrSamples(rowIndex, SSFSamplesTable.ListColumns(COL_SSF_SAMPLE_CODE_DB).index) = sampleCodeLPh(i)
        arrSamples(rowIndex, SSFSamplesTable.ListColumns(COL_SSF_TYPE_PH_DB).index) = "LPh"

        If ListColumnExists(SSFSamplesTable, COL_SSF_RESULT_ID_DB) Then
            If Len(parentResultId) > 0 And parentResultId <> "0" Then
                arrSamples(rowIndex, SSFSamplesTable.ListColumns(COL_SSF_RESULT_ID_DB).index) = parentResultId
            End If
        End If

        If ListColumnExists(SSFSamplesTable, COL_SSF_ROW_ID_DB) Then
            If oldRowIds.Exists(CStr(rowIndex)) Then
                arrSamples(rowIndex, SSFSamplesTable.ListColumns(COL_SSF_ROW_ID_DB).index) = oldRowIds(CStr(rowIndex))
            End If
        End If

        rowIndex = rowIndex + 1

    Next i

    For i = 1 To sampleCodeGPh.count

        arrSamples(rowIndex, SSFSamplesTable.ListColumns(COL_SSF_SAMPLE_CODE_DB).index) = sampleCodeGPh(i)
        arrSamples(rowIndex, SSFSamplesTable.ListColumns(COL_SSF_TYPE_PH_DB).index) = "GPh"

        If ListColumnExists(SSFSamplesTable, COL_SSF_RESULT_ID_DB) Then
            If Len(parentResultId) > 0 And parentResultId <> "0" Then
                arrSamples(rowIndex, SSFSamplesTable.ListColumns(COL_SSF_RESULT_ID_DB).index) = parentResultId
            End If
        End If

        If ListColumnExists(SSFSamplesTable, COL_SSF_ROW_ID_DB) Then
            If oldRowIds.Exists(CStr(rowIndex)) Then
                arrSamples(rowIndex, SSFSamplesTable.ListColumns(COL_SSF_ROW_ID_DB).index) = oldRowIds(CStr(rowIndex))
            End If
        End If

        rowIndex = rowIndex + 1

    Next i

    For i = rowIndex To oldRowsCount

        If ListColumnExists(SSFSamplesTable, COL_SSF_ROW_ID_DB) Then
            If oldRowIds.Exists(CStr(i)) Then
                arrSamples(i, SSFSamplesTable.ListColumns(COL_SSF_ROW_ID_DB).index) = oldRowIds(CStr(i))
            End If
        End If

        If ListColumnExists(SSFSamplesTable, COL_SSF_RESULT_ID_DB) Then
            If Len(parentResultId) > 0 And parentResultId <> "0" Then
                arrSamples(i, SSFSamplesTable.ListColumns(COL_SSF_RESULT_ID_DB).index) = parentResultId
            End If
        End If

    Next i

    SSFSamplesTable.DataBodyRange.NumberFormat = "@"
    SSFSamplesTable.DataBodyRange.value = arrSamples

    CreateSampleCodeSSF3 = True

End Function

Public Function Load_SSF_results_to_forms( _
    Optional ByVal mode As String = "by_key", _
    Optional ByVal fields As Variant, _
    Optional ByVal silence As Boolean = False _
) As String

    On Error GoTo CleanFail

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetSSF As Worksheet
    Set sheetSSF = wb.Worksheets("SSF")

    Dim resultTable As ListObject
    Set resultTable = _
        wb.Worksheets("SSF_results").ListObjects("SSF_results")

    Dim sourceTable As ListObject
    Set sourceTable = _
        wb.Worksheets("SSF_sourceData").ListObjects("SSF_sourceData")

    Dim fieldFilter As Object
    Set fieldFilter = BuildFieldFilter(fields)

    Dim text As String
    Dim warnText As String

    mode = LCase$(Trim$(mode))

    If mode <> "by_key" And mode <> "sequential" Then
        text = "ERROR|mode должен быть 'by_key' или 'sequential'"
        Load_SSF_results_to_forms = text

        If Not silence Then
            MsgBox text, vbExclamation
        End If

        Exit Function
    End If

    If resultTable.DataBodyRange Is Nothing Then
        text = "OK|Таблица SSF_results пустая."
        Load_SSF_results_to_forms = text

        If Not silence Then
            MsgBox text, vbInformation
        End If

        Exit Function
    End If

    Dim resultRowIndex As Long
    Dim formIndex As Long
    Dim notFoundCount As Long

    For resultRowIndex = 1 To resultTable.ListRows.count

        If mode = "sequential" Then

            formIndex = resultRowIndex
            EnsureSSFFormExists wb, formIndex

        Else

            formIndex = FindFormIndexForResultRow( _
                wb, _
                sheetSSF, _
                resultTable, _
                resultRowIndex, _
                "SSF", _
                Array("sampleCode", "analyseNumber") _
            )

        End If

        If formIndex = 0 Or _
           Not NamedRangeExists( _
               wb, _
               "SSF_" & formIndex & "_sampleCode" _
           ) Then

            notFoundCount = notFoundCount + 1

            warnText = warnText & _
                "Не найдена форма для строки SSF_results #" & _
                resultRowIndex & vbCrLf & _
                "sampleCode = " & _
                GetTableValue( _
                    resultTable, _
                    resultRowIndex, _
                    "sampleCode" _
                ) & vbCrLf & _
                "TaskId = " & _
                GetTableValue( _
                    resultTable, _
                    resultRowIndex, _
                    "TaskId" _
                ) & vbCrLf & _
                "analyseNumber = " & _
                GetTableValue( _
                    resultTable, _
                    resultRowIndex, _
                    "analyseNumber" _
                ) & vbCrLf & vbCrLf

            GoTo NextResultRow
        End If

        FillOneSSFFormFromResultRow _
            wb, _
            sheetSSF, _
            resultTable, _
            sourceTable, _
            resultRowIndex, _
            formIndex, _
            fieldFilter

NextResultRow:
    Next resultRowIndex

    If notFoundCount = 0 Then

        text = "OK|Данные SSF перенесены в формы."
        Load_SSF_results_to_forms = text

        If Not silence Then
            MsgBox text, vbInformation
        End If

    Else

        text = _
            "WARN|Данные SSF перенесены частично. " & _
            "Не найдено форм: " & notFoundCount & _
            vbCrLf & warnText

        Load_SSF_results_to_forms = text

        If Not silence Then
            MsgBox text, vbExclamation
        End If

    End If

    Exit Function

CleanFail:
    text = _
        "ERROR|" & _
        CStr(Err.Number) & "|" & _
        Err.Description

    Load_SSF_results_to_forms = text

    If Not silence Then
        MsgBox text, vbCritical
    End If

End Function

Private Sub EnsureSSFFormExists( _
    ByVal wb As Workbook, _
    ByVal formIndex As Long _
)
    Do While Not NamedRangeExists(wb, "SSF_" & formIndex & "_sampleCode")
        Call AddFormSSF
    Loop
End Sub


Private Sub FillOneSSFFormFromResultRow( _
    ByVal wb As Workbook, _
    ByVal sheetSSF As Worksheet, _
    ByVal resultTable As ListObject, _
    ByVal sourceTable As ListObject, _
    ByVal resultRowIndex As Long, _
    ByVal formIndex As Long, _
    ByVal fieldFilter As Object _
)

    Dim resultId As Variant
    resultId = GetTableValue(resultTable, resultRowIndex, COL_SSF_RESULT_ID_DB)

    Call CopyTableRowToNamedRanges( _
        wb, _
        sheetSSF, _
        resultTable, _
        resultRowIndex, _
        "SSF", _
        formIndex, _
        fieldFilter _
    )

    If Len(NormalizeKeyValue(resultId)) > 0 Then
        FillSSFSourceTableFromSourceData sheetSSF, sourceTable, formIndex, resultId, fieldFilter
    End If

End Sub


Private Sub FillSSFSourceTableFromSourceData( _
    ByVal sheetSSF As Worksheet, _
    ByVal sourceTable As ListObject, _
    ByVal formIndex As Long, _
    ByVal resultId As Variant, _
    ByVal fieldFilter As Object _
)

    Dim formSourceTable As ListObject
    Set formSourceTable = sheetSSF.ListObjects("SSF_source_" & formIndex)

    If formSourceTable.DataBodyRange Is Nothing Then
        MsgBox "В таблице SSF_source_" & formIndex & " нет строк для загрузки полученных проб.", vbExclamation
        Exit Sub
    End If

    Call ClearMappedColumnsInTable( _
        formSourceTable, _
        SSFSourceMappings(), _
        fieldFilter _
    )

    Call CopyMatchingTableRowsToTableRows( _
        sourceTable, _
        formSourceTable, _
        COL_SSF_RESULT_ID_DB, _
        resultId, _
        SSFSourceMappings(), _
        fieldFilter _
    )

End Sub


Private Function SSFSourceMappings() As Variant

    SSFSourceMappings = Array( _
        Array(COL_SSF_ROW_ID_DB, COL_SSF_ROW_ID_DB), _
        Array(COL_SSF_RESULT_ID_DB, COL_SSF_RESULT_ID_DB), _
        Array(COL_SSF_SAMPLE_CODE_DB, COL_SSF_SAMPLE_CODE_DB), _
        Array(COL_SSF_TYPE_PH_DB, COL_SSF_TYPE_PH_DB) _
    )

End Function

Private Function CheckSSFTask( _
    ByVal tasks As ListObject, _
    ByVal taskId As Long, _
    ByVal sampleCode As String, _
    ByVal formIndex As Long _
) As Boolean

    CheckSSFTask = False

    Dim taskCheck As Range
    Set taskCheck = tasks.ListColumns("Номер задания").DataBodyRange.Find( _
        What:=taskId, _
        LookAt:=xlWhole, _
        SearchOrder:=xlByColumns _
    )

    If taskCheck Is Nothing Then
        MsgBox "Указан неизвестный номер анализа " & taskId & _
               " на странице " & formIndex & _
               ". Данное исследование игнорируется, попробуйте обновить данные проекта или исправьте значение."
        Exit Function
    End If

    Dim taskRowIndex As Long
    taskRowIndex = taskCheck.row - tasks.DataBodyRange.row + 1

    If CStr(tasks.ListColumns("Код проекта").DataBodyRange.Cells(taskRowIndex, 1).value) <> sampleCode Then
        MsgBox "Указан неверный номер анализа " & taskId & _
               " на странице " & formIndex & _
               ". Шифр пробы в задании отличается от шифра пробы в исследовании. " & _
               "Данное исследование игнорируется, исправьте номер задания или выберите верную форму для внесения."
        Exit Function
    End If

    CheckSSFTask = True

End Function


