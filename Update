    Select Case fieldName

        Case "TaskId"
            AP_FieldCaption = "Номер задания"

        Case "sampleCode"
            AP_FieldCaption = "Шифр пробы"

        Case "analyseNumber"
            AP_FieldCaption = "Номер анализа"

        Case "apEquipment"
            AP_FieldCaption = "Оборудование"

        Case "apEquipmentNumber"
            AP_FieldCaption = "Номер оборудования"

        Case "Tfact"
            AP_FieldCaption = "Температура"

        Case "ka"
            AP_FieldCaption = "Коэффициент ka"

        Case "kb"
            AP_FieldCaption = "Коэффициент kb"

        Case "kc"
            AP_FieldCaption = "Коэффициент kc"

        Case "operator"
            AP_FieldCaption = "Исполнитель"

        Case "date"
            AP_FieldCaption = "Дата выполнения"

        Case Else
            AP_FieldCaption = fieldName

    End Select

End Function

Public Function FindEmptyFormAP() As Long

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetAP As Worksheet
    Set sheetAP = wb.Worksheets("AP")

    Dim formIndex As Long
    formIndex = 1

    Do While NamedRangeExists(wb, "AP_" & formIndex & "_sampleCode")

        If Get_AP_FormState(formIndex) = AP_FORM_EMPTY Then
            FindEmptyFormAP = formIndex
            Exit Function
        End If

        formIndex = formIndex + 1

    Loop

    Call AddFormAP

    FindEmptyFormAP = formIndex

End Function

Private Function Get_AP_FormState(ByVal formIndex As Long) As APFormState

    Dim sheetAP As Worksheet
    Set sheetAP = ActiveWorkbook.Worksheets("AP")

    Dim sampleCode As String
    Dim taskId As String

    sampleCode = Trim$(CStr(sheetAP.Range("AP_" & formIndex & "_sampleCode").value))
    taskId = Trim$(CStr(sheetAP.Range("AP_" & formIndex & "_TaskId").value))

    Dim ka As Variant
    Dim kb As Variant
    Dim kc As Variant

    ka = sheetAP.Range("AP_" & formIndex & "_ka").value
    kb = sheetAP.Range("AP_" & formIndex & "_kb").value
    kc = sheetAP.Range("AP_" & formIndex & "_kc").value

    ' Если в коэффициентах ошибка Excel — считаем форму начатой
    Dim coeffsHaveError As Boolean
    coeffsHaveError = IsError(ka) Or IsError(kb) Or IsError(kc)

    Dim coeffsAreZero As Boolean

    If coeffsHaveError Then
        coeffsAreZero = False
    Else
        coeffsAreZero = (val(ka) = 0 And val(kb) = 0 And val(kc) = 0)
    End If

    Dim hasSampleCode As Boolean
    Dim hasTaskId As Boolean
    Dim hasCoeffs As Boolean

    hasSampleCode = (sampleCode <> "")
    hasTaskId = (taskId <> "")
    hasCoeffs = Not coeffsAreZero

    ' Форма вообще пустая и не нужна
    If Not hasSampleCode And Not hasCoeffs Then
        Get_AP_FormState = AP_FORM_EMPTY
        Exit Function
    End If

    ' Форма заполнена
    If hasSampleCode And hasCoeffs Then
        Get_AP_FormState = AP_FORM_FILLED
        Exit Function
    End If

    ' остальное считаем зарезервированным / пока не сохраняем.
    Get_AP_FormState = AP_FORM_RESERVED

End Function

