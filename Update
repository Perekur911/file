Private Function Get_SSF_FormState( _
    ByVal formIndex As Long _
) As SSFFormState

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetSSF As Worksheet
    Set sheetSSF = wb.Worksheets("SSF")

    Dim sampleCode As String
    sampleCode = Trim$(CStr( _
        sheetSSF.Range( _
            "SSF_" & formIndex & "_sampleCode" _
        ).value _
    ))

    Dim hasSampleCode As Boolean
    hasSampleCode = (sampleCode <> "")

    Dim hasVGTot As Boolean
    hasVGTot = SSF_HasNonZeroOrError( _
        sheetSSF.Range( _
            "SSF_" & formIndex & "_VGTot" _
        ).value _
    )

    Dim hasInitMassTrap1 As Boolean
    Dim hasInitMassTrap2 As Boolean

    hasInitMassTrap1 = SSF_HasNonZeroOrError( _
        sheetSSF.Range( _
            "SSF_" & formIndex & "_m0Trap1" _
        ).value _
    )

    hasInitMassTrap2 = SSF_HasNonZeroOrError( _
        sheetSSF.Range( _
            "SSF_" & formIndex & "_m0Trap2" _
        ).value _
    )

    Dim hasInitMass As Boolean
    hasInitMass = hasInitMassTrap1 Or hasInitMassTrap2

    Dim hasVial As Boolean
    Dim hasBottle As Boolean
    Dim hasPics As Boolean

    hasVial = SSF_HasNonZeroOrError( _
        sheetSSF.Range( _
            "SSF_" & formIndex & "_vial" _
        ).value _
    )

    hasBottle = SSF_HasNonZeroOrError( _
        sheetSSF.Range( _
            "SSF_" & formIndex & "_bottle" _
        ).value _
    )

    hasPics = SSF_HasNonZeroOrError( _
        sheetSSF.Range( _
            "SSF_" & formIndex & "_pics" _
        ).value _
    )

    Dim hasAnySampleCount As Boolean
    hasAnySampleCount = _
        hasVial Or _
        hasBottle Or _
        hasPics

    Dim hasSourceRows As Boolean
    hasSourceRows = SSF_SourceTableHasData(formIndex)

    ' Полностью пустая форма.
    If Not hasSampleCode _
       And Not hasVGTot _
       And Not hasInitMass _
       And Not hasAnySampleCount _
       And Not hasSourceRows Then

        Get_SSF_FormState = SSF_FORM_EMPTY
        Exit Function

    End If

    ' Форма считается заполненной и должна пройти полную валидацию.
    If hasSampleCode And hasVGTot Then

        Get_SSF_FormState = SSF_FORM_FILLED
        Exit Function

    End If

    ' Всё остальное — частично заполненная или зарезервированная форма.
    Get_SSF_FormState = SSF_FORM_RESERVED

End Function


Private Function SSF_HasNonZeroOrError( _
    ByVal value As Variant _
) As Boolean

    If IsError(value) Then

        SSF_HasNonZeroOrError = True
        Exit Function

    End If

    If Trim$(CStr(value)) = "" Then

        SSF_HasNonZeroOrError = False
        Exit Function

    End If

    If Not IsNumeric(value) Then

        SSF_HasNonZeroOrError = True
        Exit Function

    End If

    SSF_HasNonZeroOrError = (Abs(CDbl(value)) > 0)

End Function


Private Function SSF_SourceTableHasData( _
    ByVal formIndex As Long _
) As Boolean

    SSF_SourceTableHasData = False

    Dim sheetSSF As Worksheet
    Set sheetSSF = ActiveWorkbook.Worksheets("SSF")

    Dim tableName As String
    tableName = "SSF_source_" & formIndex

    If Not ListObjectExists(sheetSSF, tableName) Then
        Exit Function
    End If

    Dim sourceTable As ListObject
    Set sourceTable = sheetSSF.ListObjects(tableName)

    If sourceTable.DataBodyRange Is Nothing Then
        Exit Function
    End If

    If Not ListColumnExists( _
        sourceTable, _
        COL_SSF_SAMPLE_CODE_DB _
    ) Then
        Exit Function
    End If

    If Not ListColumnExists( _
        sourceTable, _
        COL_SSF_TYPE_PH_DB _
    ) Then
        Exit Function
    End If

    Dim rowIndex As Long
    Dim sampleCodeValue As Variant
    Dim typePhValue As Variant

    For rowIndex = 1 To sourceTable.ListRows.count

        sampleCodeValue = sourceTable.DataBodyRange.Cells( _
            rowIndex, _
            sourceTable.ListColumns( _
                COL_SSF_SAMPLE_CODE_DB _
            ).index _
        ).value

        typePhValue = sourceTable.DataBodyRange.Cells( _
            rowIndex, _
            sourceTable.ListColumns( _
                COL_SSF_TYPE_PH_DB _
            ).index _
        ).value

        If IsError(sampleCodeValue) _
           Or IsError(typePhValue) Then

            SSF_SourceTableHasData = True
            Exit Function

        End If

        If Trim$(CStr(sampleCodeValue)) <> "" Then

            SSF_SourceTableHasData = True
            Exit Function

        End If

        If Trim$(CStr(typePhValue)) <> "" Then

            SSF_SourceTableHasData = True
            Exit Function

        End If

    Next rowIndex

End Function

Private Function SSF_GetSampleCodeCounts( _
    ByVal formIndex As Long, _
    ByRef LPhCount As Long, _
    ByRef GPhCount As Long _
) As Boolean

    SSF_GetSampleCodeCounts = False

    LPhCount = 0
    GPhCount = 0

    Dim sheetSSF As Worksheet
    Set sheetSSF = ActiveWorkbook.Worksheets("SSF")

    Dim tableName As String
    tableName = "SSF_source_" & formIndex

    If Not ListObjectExists(sheetSSF, tableName) Then
        Exit Function
    End If

    Dim sourceTable As ListObject
    Set sourceTable = sheetSSF.ListObjects(tableName)

    If sourceTable.DataBodyRange Is Nothing Then
        Exit Function
    End If

    If Not ListColumnExists( _
        sourceTable, _
        COL_SSF_SAMPLE_CODE_DB _
    ) Then
        Exit Function
    End If

    If Not ListColumnExists( _
        sourceTable, _
        COL_SSF_TYPE_PH_DB _
    ) Then
        Exit Function
    End If

    Dim sampleCodeCol As Long
    Dim typePhCol As Long

    sampleCodeCol = sourceTable _
        .ListColumns(COL_SSF_SAMPLE_CODE_DB).index

    typePhCol = sourceTable _
        .ListColumns(COL_SSF_TYPE_PH_DB).index

    Dim rowIndex As Long

    Dim sampleCodeValue As Variant
    Dim typePhValue As Variant

    Dim sampleCodeText As String
    Dim typePhText As String

    For rowIndex = 1 To sourceTable.ListRows.count

        sampleCodeValue = sourceTable.DataBodyRange.Cells( _
            rowIndex, _
            sampleCodeCol _
        ).value

        typePhValue = sourceTable.DataBodyRange.Cells( _
            rowIndex, _
            typePhCol _
        ).value

        If IsError(sampleCodeValue) _
           Or IsError(typePhValue) Then

            GoTo NextRow

        End If

        sampleCodeText = Trim$(CStr(sampleCodeValue))
        typePhText = UCase$(Trim$(CStr(typePhValue)))

        If sampleCodeText = "" Then
            GoTo NextRow
        End If

        Select Case typePhText

            Case "LPH"
                LPhCount = LPhCount + 1

            Case "GPH"
                GPhCount = GPhCount + 1

        End Select

NextRow:
    Next rowIndex

    SSF_GetSampleCodeCounts = _
        (LPhCount + GPhCount > 0)

End Function

Public Function FindEmptyFormSSF() As Long

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetSSF As Worksheet
    Set sheetSSF = wb.Worksheets("SSF")

    Dim formIndex As Long
    formIndex = 1

    Do While NamedRangeExists(wb, "SSF_" & formIndex & "_sampleCode")

        If Get_SSF_FormState(formIndex) = SSF_FORM_EMPTY Then
            FindEmptyFormSSF = formIndex
            Exit Function
        End If

        formIndex = formIndex + 1

    Loop

    Call AddFormSSF

    FindEmptyFormSSF = formIndex

End Function

