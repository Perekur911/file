' ============================================================
' СТАТУС СИНХРОНИЗАЦИИ
' ============================================================

Public Enum StudySyncStatus

    ' Статус ещё не определён или свойство отсутствует.
    SYNC_STATUS_UNKNOWN = 0

    ' В исследовании нет данных, требующих сохранения.
    SYNC_STATUS_EMPTY = 1

    ' Данные заполнены, но ещё ни разу не сохранялись в БД.
    SYNC_STATUS_UNSAVED = 2

    ' Данные ранее сохранялись, но текущий хеш отличается.
    SYNC_STATUS_DIRTY = 3

    ' Текущий хеш совпадает с хешем после сохранения.
    SYNC_STATUS_SYNCED = 4

    ' При определении состояния произошла ошибка.
    SYNC_STATUS_ERROR = 5

End Enum


' ============================================================
' ЗАПИСЬ СВОЙСТВА
' ============================================================

Public Sub SetWorkbookMetadataProperty( _
    ByVal wb As Workbook, _
    ByVal propertyName As String, _
    ByVal propertyValue As String, _
    Optional ByVal saveWorkbook As Boolean = False _
)

    Dim documentProperty As Object

    If wb Is Nothing Then
        Err.Raise _
            vbObjectError + 2100, _
            "SetWorkbookMetadataProperty", _
            "Книга не указана."
    End If

    propertyName = Trim$(propertyName)

    If propertyName = "" Then
        Err.Raise _
            vbObjectError + 2101, _
            "SetWorkbookMetadataProperty", _
            "Название свойства не указано."
    End If

    On Error Resume Next

    Set documentProperty = _
        wb.CustomDocumentProperties(propertyName)

    On Error GoTo ErrorHandler

    If documentProperty Is Nothing Then

        wb.CustomDocumentProperties.Add _
            name:=propertyName, _
            LinkToContent:=False, _
            Type:=msoPropertyTypeString, _
            value:=propertyValue

    Else

        documentProperty.value = propertyValue

    End If

    If saveWorkbook Then
        wb.Save
    End If

    Exit Sub

ErrorHandler:

    Err.Raise _
        vbObjectError + 2102, _
        "SetWorkbookMetadataProperty", _
        "Не удалось записать свойство '" & _
        propertyName & "' в книгу '" & _
        wb.name & "'." & vbCrLf & _
        Err.Description

End Sub


' ============================================================
' ЧТЕНИЕ СВОЙСТВА
' ============================================================

Public Function GetWorkbookMetadataProperty( _
    ByVal wb As Workbook, _
    ByVal propertyName As String, _
    Optional ByVal defaultValue As String = "" _
) As String

    Dim documentProperty As Object

    If wb Is Nothing Then
        Err.Raise _
            vbObjectError + 2110, _
            "GetWorkbookMetadataProperty", _
            "Книга не указана."
    End If

    propertyName = Trim$(propertyName)

    If propertyName = "" Then
        Err.Raise _
            vbObjectError + 2111, _
            "GetWorkbookMetadataProperty", _
            "Название свойства не указано."
    End If

    On Error Resume Next

    Set documentProperty = _
        wb.CustomDocumentProperties(propertyName)

    On Error GoTo ErrorHandler

    If documentProperty Is Nothing Then

        GetWorkbookMetadataProperty = defaultValue

    ElseIf IsNull(documentProperty.value) Then

        GetWorkbookMetadataProperty = defaultValue

    Else

        GetWorkbookMetadataProperty = _
            CStr(documentProperty.value)

    End If

    Exit Function

ErrorHandler:

    Err.Raise _
        vbObjectError + 2112, _
        "GetWorkbookMetadataProperty", _
        "Не удалось прочитать свойство '" & _
        propertyName & "' из книги '" & _
        wb.name & "'." & vbCrLf & _
        Err.Description

End Function


' ============================================================
' ПРОВЕРКА НАЛИЧИЯ СВОЙСТВА
' ============================================================

Public Function WorkbookMetadataPropertyExists( _
    ByVal wb As Workbook, _
    ByVal propertyName As String _
) As Boolean

    Dim documentProperty As Object

    If wb Is Nothing Then
        Exit Function
    End If

    propertyName = Trim$(propertyName)

    If propertyName = "" Then
        Exit Function
    End If

    On Error Resume Next

    Set documentProperty = _
        wb.CustomDocumentProperties(propertyName)

    On Error GoTo 0

    WorkbookMetadataPropertyExists = _
        Not documentProperty Is Nothing

End Function


' ============================================================
' ПРЕОБРАЗОВАНИЕ ENUM В СТРОКУ ДЛЯ МЕТАДАННЫХ
' ============================================================

Public Function StudySyncStatusToString( _
    ByVal status As StudySyncStatus _
) As String

    Select Case status

        Case SYNC_STATUS_EMPTY
            StudySyncStatusToString = "empty"

        Case SYNC_STATUS_UNSAVED
            StudySyncStatusToString = "unsaved"

        Case SYNC_STATUS_DIRTY
            StudySyncStatusToString = "dirty"

        Case SYNC_STATUS_SYNCED
            StudySyncStatusToString = "synced"

        Case SYNC_STATUS_ERROR
            StudySyncStatusToString = "error"

        Case Else
            StudySyncStatusToString = "unknown"

    End Select

End Function


' ============================================================
' ПРЕОБРАЗОВАНИЕ СТРОКИ ИЗ МЕТАДАННЫХ В ENUM
' ============================================================

Public Function StringToStudySyncStatus( _
    ByVal value As String _
) As StudySyncStatus

    Select Case LCase$(Trim$(value))

        Case "empty"
            StringToStudySyncStatus = _
                SYNC_STATUS_EMPTY

        Case "unsaved"
            StringToStudySyncStatus = _
                SYNC_STATUS_UNSAVED

        Case "dirty"
            StringToStudySyncStatus = _
                SYNC_STATUS_DIRTY

        Case "synced"
            StringToStudySyncStatus = _
                SYNC_STATUS_SYNCED

        Case "error"
            StringToStudySyncStatus = _
                SYNC_STATUS_ERROR

        Case Else
            StringToStudySyncStatus = _
                SYNC_STATUS_UNKNOWN

    End Select

End Function


' ============================================================
' УДОБНЫЕ ОБЁРТКИ ДЛЯ СТАТУСА
' ============================================================

Public Sub SetStudySyncStatus( _
    ByVal wb As Workbook, _
    ByVal propertyName As String, _
    ByVal status As StudySyncStatus, _
    Optional ByVal saveWorkbook As Boolean = False _
)

    SetWorkbookMetadataProperty _
        wb:=wb, _
        propertyName:=propertyName, _
        propertyValue:=StudySyncStatusToString(status), _
        saveWorkbook:=saveWorkbook

End Sub


Public Function GetStudySyncStatus( _
    ByVal wb As Workbook, _
    ByVal propertyName As String _
) As StudySyncStatus

    Dim storedValue As String

    storedValue = GetWorkbookMetadataProperty( _
        wb:=wb, _
        propertyName:=propertyName, _
        defaultValue:="unknown" _
    )

    GetStudySyncStatus = _
        StringToStudySyncStatus(storedValue)

End Function




