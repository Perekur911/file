4. Замени _build_details и добавь два новых метода

Внутри ProjectFormsApp замени существующий _build_details этим блоком из трёх методов:

def _build_details(self) -> None:
        ttk = self.ttk

        self.details_toggle_frame = ttk.Frame(
            self.forms_page,
            padding=(8, 0, 8, 4),
        )
        self.details_toggle_frame.pack(fill="x")

        ttk.Checkbutton(
            self.details_toggle_frame,
            text="Показывать подробности кэша",
            variable=self.show_details_var,
            command=self._toggle_details,
        ).pack(side="left")

        self.details_frame = ttk.LabelFrame(
            self.forms_page,
            text="Подробности выбранного проекта",
            padding=6,
        )

        # Внешний контейнер при запуске остаётся скрытым.
        self.details = self.tk.Text(
            self.details_frame,
            height=8,
            wrap="word",
            state="disabled",
            borderwidth=0,
        )
        self.details.pack(fill="x")

    def _toggle_details(self):
        if self.show_details_var.get():
            self.details_frame.pack(
                fill="x",
                padx=8,
                pady=(0, 8),
                after=self.details_toggle_frame,
            )
            self.show_details()
        else:
            self.details_frame.pack_forget()

    def _on_theme_changed(self):
        from project_tasks_ui import apply_theme

        theme = (
            "dark"
            if self.dark_theme_var.get()
            else "light"
        )

        palette = apply_theme(
            self.root,
            theme,
        )

        row_colors = {
            "ok": palette["projects"]["validated"],
            "attention": palette["projects"]["open"],
            "blocked": palette["blocked"],
            "planned": palette["selection"],
        }

        for tag, color in row_colors.items():
            self.tree.tag_configure(
                tag,
                background=color,
                foreground=palette["fg"],
            )

        self.task_view.refresh_theme()

Существующий метод show_details оставь — он продолжит заполнять содержимое блока при выборе проекта.

