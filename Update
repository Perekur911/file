    Next x
    
    sheetJOIN.Range(new_src_name & "[[Íà÷àëüíàÿ ìàññà ïèêíîìåòðà, ã]:[Êîíå÷íîå ïîëîæåíèå ïîðøíÿ]]").ClearContents
