Private Function Get_CVD_FormState(ByVal formIndex As Long) As CVDFormState

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetCVD As Worksheet
    Set sheetCVD = wb.Worksheets("CVD")

    Dim sampleCode As String
    sampleCode = Trim$(CStr(sheetCVD.Range("CVD_" & formIndex & "_sampleCode").value))

    Dim hasSampleCode As Boolean
    hasSampleCode = (sampleCode <> "")

    Dim hasAnyStepData As Boolean
    Dim steps As Variant
    Dim stepIndex As Long
    Dim stepKey As String

    steps = CVD_StepKeys()

    For stepIndex = LBound(steps) To UBound(steps)
        stepKey = CStr(steps(stepIndex))

        If CVD_StepHasData(formIndex, stepKey) Then
            hasAnyStepData = True
            Exit For
        End If
    Next stepIndex

    If Not hasSampleCode And Not hasAnyStepData Then
        Get_CVD_FormState = CVD_FORM_EMPTY
        Exit Function
    End If

    If hasSampleCode And hasAnyStepData Then
        Get_CVD_FormState = CVD_FORM_FILLED
        Exit Function
    End If

    Get_CVD_FormState = CVD_FORM_RESERVED

End Function
