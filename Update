Да, лучше сделать отдельную функцию, которая:

* вызывает каждый `Save_*` отдельно;
* **не останавливается** на первом `MACRO_FAILED`;
* в конце возвращает:

  * `MACRO_CHANGED`, если что-то сохранилось и ошибок не было;
  * `MACRO_NO_CHANGES`, если изменений не было и ошибок не было;
  * `MACRO_FAILED`, если **хотя бы одно** исследование упало.

Вот готовый вариант.

---

### 1. Новая функция покомпонентного сохранения

```vb
Public Function Save_All_OneByOne( _
    Optional ByVal silent As Boolean = False _
) As macroResult

    Dim totalResult As macroResult
    Dim currentResult As macroResult

    Dim hasChanges As Boolean
    Dim hasFailures As Boolean
    Dim failedStudies As String

    totalResult = MACRO_NO_CHANGES

    currentResult = Save_OP(silent:=silent)
    If currentResult = MACRO_CHANGED Then
        hasChanges = True
    ElseIf currentResult = MACRO_FAILED Then
        hasFailures = True
        failedStudies = failedStudies & "OP, "
    End If

    currentResult = Save_OPOH(silent:=silent)
    If currentResult = MACRO_CHANGED Then
        hasChanges = True
    ElseIf currentResult = MACRO_FAILED Then
        hasFailures = True
        failedStudies = failedStudies & "OPOH, "
    End If

    currentResult = Save_AP(silent:=silent)
    If currentResult = MACRO_CHANGED Then
        hasChanges = True
    ElseIf currentResult = MACRO_FAILED Then
        hasFailures = True
        failedStudies = failedStudies & "AP, "
    End If

    currentResult = Save_BP(silent:=silent)
    If currentResult = MACRO_CHANGED Then
        hasChanges = True
    ElseIf currentResult = MACRO_FAILED Then
        hasFailures = True
        failedStudies = failedStudies & "BP, "
    End If

    currentResult = Save_GC(silent:=silent)
    If currentResult = MACRO_CHANGED Then
        hasChanges = True
    ElseIf currentResult = MACRO_FAILED Then
        hasFailures = True
        failedStudies = failedStudies & "GC, "
    End If

    currentResult = Save_EMV(silent:=silent)
    If currentResult = MACRO_CHANGED Then
        hasChanges = True
    ElseIf currentResult = MACRO_FAILED Then
        hasFailures = True
        failedStudies = failedStudies & "EMV, "
    End If

    currentResult = Save_GOR(silent:=silent)
    If currentResult = MACRO_CHANGED Then
        hasChanges = True
    ElseIf currentResult = MACRO_FAILED Then
        hasFailures = True
        failedStudies = failedStudies & "GOR, "
    End If

    currentResult = Save_SSF(silent:=silent)
    If currentResult = MACRO_CHANGED Then
        hasChanges = True
    ElseIf currentResult = MACRO_FAILED Then
        hasFailures = True
        failedStudies = failedStudies & "SSF, "
    End If

    currentResult = Save_CCE(silent:=silent)
    If currentResult = MACRO_CHANGED Then
        hasChanges = True
    ElseIf currentResult = MACRO_FAILED Then
        hasFailures = True
        failedStudies = failedStudies & "CCE, "
    End If

    currentResult = Save_CVD(silent:=silent)
    If currentResult = MACRO_CHANGED Then
        hasChanges = True
    ElseIf currentResult = MACRO_FAILED Then
        hasFailures = True
        failedStudies = failedStudies & "CVD, "
    End If

    currentResult = Save_Rec(silent:=silent)
    If currentResult = MACRO_CHANGED Then
        hasChanges = True
    ElseIf currentResult = MACRO_FAILED Then
        hasFailures = True
        failedStudies = failedStudies & "REC, "
    End If

    currentResult = Save_JOIN(silent:=silent)
    If currentResult = MACRO_CHANGED Then
        hasChanges = True
    ElseIf currentResult = MACRO_FAILED Then
        hasFailures = True
        failedStudies = failedStudies & "JOIN, "
    End If

    If hasFailures Then
        If Len(failedStudies) >= 2 Then
            failedStudies = Left$(failedStudies, Len(failedStudies) - 2)
        End If

        If Not silent Then
            MsgBox _
                "Не удалось сохранить исследования: " & failedStudies, _
                vbExclamation
        End If

        Save_All_OneByOne = MACRO_FAILED
        Exit Function
    End If

    If hasChanges Then
        Save_All_OneByOne = MACRO_CHANGED
    Else
        Save_All_OneByOne = MACRO_NO_CHANGES
    End If

End Function
```

