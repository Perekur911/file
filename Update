Существующий _upsert_row() замени целиком:

def _upsert_row(self, item: ProjectInspection) -> None:
    year = self._read_year()

    if year is None:
        return

    project = item.refresh_project

    should_show = (
        self._project_visible_for_year(project, year)
        and self._matches_filters(item)
    )

    if not should_show:
        if self.tree.exists(project):
            self.tree.delete(project)
        return

    self._set_tree_row(item)
    self._sort_tree_items()

Это важно: если после сканирования статус проекта изменился и перестал соответствовать фильтру, строка автоматически исчезнет из таблицы.

6. Добавить полное обновление таблицы

Перед show_cached_year() вставь:

def refresh_table(self) -> None:
    year = self._read_year()

    if year is None:
        return

    selected_before = set(self.selected_projects())

    self._update_filter_lists(year)

    for iid in self.tree.get_children():
        self.tree.delete(iid)

    total_for_year = 0
    shown = 0

    for project in sorted(self.cache):
        item = self.cache[project]

        if not self._project_visible_for_year(project, year):
            continue

        total_for_year += 1

        if not self._matches_filters(item):
            continue

        self._set_tree_row(item)
        shown += 1

    self._sort_tree_items()

    selected_after = [
        project
        for project in selected_before
        if self.tree.exists(project)
    ]

    if selected_after:
        self.tree.selection_set(selected_after)

    self.status_var.set(
        f"Показано проектов: {shown} из {total_for_year}; "
        f"год: {year}"
    )

