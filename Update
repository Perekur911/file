            " íå íàéäåíû îáÿçàòåëüíûå ñòîëáöû."

        GoTo after_source_validation

    End If

    If sourceTable.DataBodyRange Is Nothing Then

        AddValidationError _
            errors, _
            errorCount, _
            "Òàáëèöà " & sourceTableName & _
            " íå ñîäåðæèò ñòðîê."

        GoTo after_source_validation

    End If


    ' =============================================================
    ' ÏÐÎÂÅÐÊÀ ÑÒÐÎÊ SOURCE
    ' =============================================================

    Dim mixCol As Long
    Dim depletedCol As Long

    mixCol = _
        sourceTable.ListColumns( _
            COL_MIX_SAMPLE_CODE_FORM _
        ).index

    depletedCol = _
        sourceTable.ListColumns( _
            COL_DEPLETED_FORM _
        ).index

    Dim mixCell As Range
    Dim depletedCell As Range

    Dim mixValue As Variant
    Dim depletedValue As Variant

    Dim mixText As String
    Dim filledMixCount As Long
    Dim rowIndex As Long

    For rowIndex = 1 To sourceTable.ListRows.count

        Set mixCell = _
            sourceTable.DataBodyRange.Cells( _
                rowIndex, _
                mixCol _
            )

        Set depletedCell = _
            sourceTable.DataBodyRange.Cells( _
                rowIndex, _
                depletedCol _
            )

        ClearValidationFill mixCell
        ClearValidationFill depletedCell

        mixValue = mixCell.value
        depletedValue = depletedCell.value


        ' ---------------------------------------------------------
        ' ØÈÔÐ ÏÐÎÁÛ
        ' ---------------------------------------------------------

        If IsError(mixValue) Then

            AddValidationError _
                errors, _
                errorCount, _
                sourceTableName & _
                ", ñòðîêà " & rowIndex & _
                ": øèôð ïðîáû ñîäåðæèò îøèáêó Excel.", _
                mixCell

            GoTo next_source_row

        End If

        mixText = Trim$(CStr(mixValue))


        ' ---------------------------------------------------------
        ' ÏÐÎÁÀ ÈÇÐÀÑÕÎÄÎÂÀÍÀ
        ' ---------------------------------------------------------

        If IsError(depletedValue) Then

            AddValidationError _
                errors, _
                errorCount, _
                sourceTableName & _
                ", ñòðîêà " & rowIndex & _
                ": ïîëå ""Ïðîáà èçðàñõîäîâàíà"" " & _
                "ñîäåðæèò îøèáêó Excel.", _
                depletedCell

            GoTo next_source_row

        End If


        If mixText <> "" Then

            filledMixCount = filledMixCount + 1

            If VarType(depletedValue) <> vbBoolean Then

                AddValidationError _
                    errors, _
                    errorCount, _
                    sourceTableName & _
                    ", ñòðîêà " & rowIndex & _
                    ": ïîëå ""Ïðîáà èçðàñõîäîâàíà"" " & _
                    "äîëæíî ñîäåðæàòü True/False.", _
                    depletedCell

            End If

        Else

            ' Åñëè øèôðà íåò, íî ïîëüçîâàòåëü óñòàíîâèë
            ' ôëàã "Ïðîáà èçðàñõîäîâàíà", ñòðîêà íåêîððåêòíà.
            If VarType(depletedValue) = vbBoolean Then

                If CBool(depletedValue) Then

                    AddValidationError _
                        errors, _
                        errorCount, _
                        sourceTableName & _
                        ", ñòðîêà " & rowIndex & _
                        ": óñòàíîâëåí ïðèçíàê ""Ïðîáà èçðàñõîäîâàíà"", " & _
                        "íî íå óêàçàí øèôð ïðîáû.", _
                        mixCell

                End If

            End If

        End If


next_source_row:
    Next rowIndex


    ' =============================================================
    ' ÄÎËÆÍÎ ÁÛÒÜ ÌÈÍÈÌÓÌ ÄÂÅ ÏÐÎÁÛ
    ' =============================================================

    If filledMixCount < 2 Then

        AddValidationError _
            errors, _
            errorCount, _
            "Â òàáëèöå " & sourceTableName & _
            " äîëæíî áûòü óêàçàíî ìèíèìóì äâå ïðîáû äëÿ îáúåäèíåíèÿ."

    End If


after_source_validation:

    If errorCount > 0 Then

        MsgBox _
