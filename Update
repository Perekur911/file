VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
END
Attribute VB_Name = "CApplicationEvents"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = False
Option Explicit

Public WithEvents App As Application


Private Sub App_WorkbookBeforeClose( _
    ByVal Wb As Workbook, _
    Cancel As Boolean _
)

    On Error GoTo ErrHandler

    Dim eventsWereEnabled As Boolean
    eventsWereEnabled = Application.EnableEvents

    ' Старые и будущие несовместимые версии не трогаем.
    If Not IsCurrentHashFormVersion(Wb) Then Exit Sub

    Dim wasSaved As Boolean
    wasSaved = Wb.Saved

    ' Пока CalculateCurrent...Hash используют ActiveWorkbook.
    If Not Wb Is Application.ActiveWorkbook Then
        Wb.Activate
    End If

    ' Пересчитываем статусы всех исследований.
    RefreshAllStudySyncStatuses Wb

    Dim unsyncedText As String
    unsyncedText = GetUnsyncedStudiesText(Wb)

    If unsyncedText <> "" Then

        Dim answer As VbMsgBoxResult

        answer = MsgBox( _
            "В книге обнаружены исследования с данными, " & _
            "которые не синхронизированы с БД:" & _
            vbCrLf & vbCrLf & _
            unsyncedText & _
            vbCrLf & _
            "Настоятельно рекомендуется сохранить эти исследования " & _
            "перед закрытием книги." & _
            vbCrLf & vbCrLf & _
            "Всё равно закрыть книгу?", _
            vbExclamation + vbYesNo + vbDefaultButton2, _
            "Есть несохранённые исследования" _
        )

        If answer <> vbYes Then
            Cancel = True
            Exit Sub
        End If

    End If

    ' Если до обработчика книга уже была сохранена,
    ' изменения появились только из-за записи DataState.
    ' Сохраняем их автоматически.
    If wasSaved Then
        Application.EnableEvents = False
        Wb.Save
        Application.EnableEvents = eventsWereEnabled
    End If

    Exit Sub

ErrHandler:

    On Error Resume Next
    Application.EnableEvents = eventsWereEnabled
    On Error GoTo 0

    Debug.Print _
        "WorkbookBeforeClose [" & Wb.Name & "]: " & _
        Err.Number & ": " & Err.Description

End Sub

