Public Function GetUnsyncedStudiesText(ByVal wb As Workbook) As String

    Dim studyNames As Variant
    Dim stateProperties As Variant

    studyNames = Array( _
        "OP", "OPOH", "AP", "BP", "GC", "EMV", _
        "GOR", "SSF", "CCE", "CVD", "REC", "JOIN" _
    )

    stateProperties = Array( _
        PROP_OP_DATA_STATE, PROP_OPOH_DATA_STATE, _
        PROP_AP_DATA_STATE, PROP_BP_DATA_STATE, _
        PROP_GC_DATA_STATE, PROP_EMV_DATA_STATE, _
        PROP_GOR_DATA_STATE, PROP_SSF_DATA_STATE, _
        PROP_CCE_DATA_STATE, PROP_CVD_DATA_STATE, _
        PROP_REC_DATA_STATE, PROP_JOIN_DATA_STATE _
    )

    Dim i As Long
    Dim status As StudySyncStatus
    Dim statusText As String
    Dim result As String

    For i = LBound(studyNames) To UBound(studyNames)

        status = GetStudySyncStatus(wb, CStr(stateProperties(i)))
        statusText = ""

        Select Case status
            Case SYNC_STATUS_UNSAVED
                statusText = "данные ещё не сохранялись в БД"

            Case SYNC_STATUS_DIRTY
                statusText = "есть изменения после последнего сохранения в БД"

            Case SYNC_STATUS_ERROR
                statusText = "не удалось определить состояние данных"
        End Select

        If statusText <> "" Then
            result = result & "• " & CStr(studyNames(i)) & _
                " — " & statusText & vbCrLf
        End If

    Next i

    GetUnsyncedStudiesText = result

End Function

