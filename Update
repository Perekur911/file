Public Function RunStudySync( _
    ByVal mode As String, _
    Optional ByVal projectNumber As String = "", _
    Optional ByVal studies As String = "", _
    Optional ByVal taskStatus As String = "" _
) As String
    
    Dim targetBook As Workbook
    Dim targetWorkbookPath As String
    
    Dim shell As Object
    Dim exec As Object
    Dim cmd As String
    Dim stdoutText As String
    Dim stderrText As String
    
    If ActiveWorkbook Is Nothing Then
        Err.Raise vbObjectError + 1002, , "Нет активной книги с данными"
    End If
    
    If ActiveWorkbook.name = ThisWorkbook.name Then
        Err.Raise vbObjectError + 1003, , "Активна книга-надстройка, а не книга с данными"
    End If
    
    If Len(ActiveWorkbook.path) = 0 Then
        Err.Raise vbObjectError + 1004, , "Книга с данными должна быть сохранена перед запуском синхронизации"
    End If
    
    Set targetBook = ActiveWorkbook
    targetWorkbookPath = targetBook.fullName
    
    mode = LCase$(Trim$(mode))
    
    If mode <> "save" And mode <> "load" Then
        Err.Raise vbObjectError + 1000, , "mode должен быть save или load"
    End If
    
    If mode = "load" And Len(Trim$(projectNumber)) = 0 Then
        Err.Raise vbObjectError + 1001, , "Для режима load нужно указать projectNumber"
    End If
    
    If Len(Trim$(studies)) = 0 Then
        studies = "OP AP GC SSF GOR BP REC EMV"
    End If
    
    ' Пересчёт только книги с данными.
    Dim ws As Worksheet

    For Each ws In targetBook.Worksheets
        ws.Calculate
    Next ws
    
    cmd = Quote(GetWorkingPythonExe) & " -u " & _
          Quote(SYNC_SCRIPT) & " " & _
          "--mode " & mode & " " & _
          "--workbook " & Quote(targetWorkbookPath) & " " & _
          "--db " & Quote(DB_PATH) & " " & _
          "--studies " & studies
    
    If mode = "load" Then
        cmd = cmd & " --project " & Quote(projectNumber)
    End If
    
    If Len(Trim$(taskStatus)) > 0 Then
        cmd = cmd & " --status " & Quote(taskStatus)
    End If
    
    'Debug.Print cmd
    
    Dim progressFile As String
    progressFile = Environ$("TEMP") & "\python_progress_" & _
               Format$(Now, "yyyymmdd_hhnnss") & "_" & _
               CStr(Int(Rnd() * 1000000)) & ".log"
    
    cmd = cmd & " --progress-file " & Quote(progressFile)
    
    Set shell = CreateObject("WScript.Shell")
    Set exec = shell.exec(cmd)
    
    Dim lastProgressLen As Long
    Dim lastPoll As Double
    Dim progressText As String
    Dim newChunk As String
    
    frmProgress.lblStatus.Caption = "Запуск Python-скрипта..."
    frmProgress.show vbModeless
    DoEvents
    
    lastProgressLen = 0
    lastPoll = Timer
    
    Do While exec.status = 0
        DoEvents
        
        If Timer - lastPoll >= 0.2 Then
            progressText = ReadUtf8TextFileSafe(progressFile)
            
            If Len(progressText) > lastProgressLen Then
                newChunk = Mid$(progressText, lastProgressLen + 1)
                lastProgressLen = Len(progressText)
                UpdateProgressFromText newChunk
            End If
            
            lastPoll = Timer
        End If
    Loop
    
    progressText = ReadUtf8TextFileSafe(progressFile)
    
    If Len(progressText) > lastProgressLen Then
        newChunk = Mid$(progressText, lastProgressLen + 1)
        UpdateProgressFromText newChunk
    End If
    
    stdoutText = exec.StdOut.ReadAll
    stderrText = exec.StdErr.ReadAll
    
    Application.StatusBar = False
    Unload frmProgress
    
    If exec.exitCode <> 0 Then
        MsgBox "Ошибка выполнения Python-скрипта:" & vbCrLf & vbCrLf & _
               stdoutText & vbCrLf & stderrText, vbCritical
    Else
        MsgBox "Готово:" & vbCrLf & vbCrLf & stdoutText, vbInformation
    End If
    
    RunStudySync = stdoutText
End Function

Public Function SetTaskStatusOnly( _
    ByVal taskId As Long, _
    ByVal taskType As String, _
    ByVal taskStatus As String, _
    ByVal statusComment As String, _
    Optional ByVal resultId As Variant, _
    Optional ByVal dateTimeText As String = "" _
) As String

    Dim shell As Object
    Dim exec As Object
    Dim cmd As String
    Dim stdoutText As String
    Dim stderrText As String
    
    If taskId <= 0 Then
        SetTaskStatusOnly = "NoTaskId"
        Exit Function
    End If
    
    taskType = UCase$(Trim$(taskType))
    taskStatus = Trim$(taskStatus)
    
    If Len(taskType) = 0 Then
        Err.Raise vbObjectError + 1102, , "Нужно указать taskType"
    End If
    
    If Len(taskStatus) = 0 Then
        Err.Raise vbObjectError + 1103, , "Нужно указать taskStatus"
    End If
    
    If statusComment = "" And taskStatus = "Отмена" Then
        MsgBox "Нужно указать statusComment"
        SetTaskStatusOnly = "NoComment"
        Exit Function
    End If
    
    cmd = Quote(GetWorkingPythonExe) & " -u " & _
          Quote(SYNC_SCRIPT) & " " & _
          "--mode status " & _
          "--db " & Quote(DB_PATH) & " " & _
          "--task-id " & CStr(taskId) & " " & _
          "--task-type " & Quote(taskType) & " " & _
          "--status " & Quote(taskStatus) & " " & _
          "--status-comment " & Quote(statusComment)
          
    If Not IsMissing(resultId) Then
        If Len(Trim$(CStr(resultId))) > 0 Then
            cmd = cmd & " --result-id " & CStr(CLng(val(resultId)))
        End If
    End If
    
    If Len(Trim$(dateTimeText)) > 0 Then
        cmd = cmd & " --date-time " & Quote(dateTimeText)
    End If
    
    Debug.Print cmd
    
    Set shell = CreateObject("WScript.Shell")
    Set exec = shell.exec(cmd)
    
    Do While exec.status = 0
        DoEvents
    Loop
    
    stdoutText = exec.StdOut.ReadAll
    stderrText = exec.StdErr.ReadAll
    
    If exec.exitCode <> 0 Then
        MsgBox "Ошибка изменения статуса задания:" & vbCrLf & vbCrLf & _
               stdoutText & vbCrLf & stderrText, vbCritical
    Else
        MsgBox "Готово:" & vbCrLf & vbCrLf & stdoutText, vbInformation
    End If
    
    SetTaskStatusOnly = stdoutText

End Function


