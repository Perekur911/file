Теперь сократим обращения при форматировании. Перед refresh_for_book добавь:

def column_letter(number):
    result = ""

    while number:
        number, remainder = divmod(number - 1, 26)
        result = chr(65 + remainder) + result

    return result

Внутри refresh_for_book замени цикл от for table, headers, matrix in plans: до следующего finally:, оставив сам finally и его содержимое, на:

for table, headers, matrix in plans:
            header = table.HeaderRowRange

            top = int(header.Row)
            left = int(header.Column)
            right = left + len(headers) - 1

            left_letter = column_letter(left)
            right_letter = column_letter(right)

            old_range = table.Range
            old_bottom = (
                int(old_range.Row)
                + int(old_range.Rows.Count)
                - 1
            )

            bottom = (
                top
                + len(matrix)
                + int(bool(table.ShowTotals))
            )

            if int(table.ListRows.Count) != len(matrix):
                table.Resize(
                    sheet.api.Range(
                        f"{left_letter}{top}:"
                        f"{right_letter}{bottom}"
                    )
                )

            body = table.DataBodyRange

            if body is None or int(body.Rows.Count) != len(matrix):
                raise RuntimeError(
                    f"Не удалось задать размер таблицы {table.Name}"
                )

            if old_bottom > bottom:
                sheet.api.Range(
                    f"{left_letter}{bottom + 1}:"
                    f"{right_letter}{old_bottom}"
                ).ClearContents()

            body.NumberFormat = "General"

            text_areas = []

            for i, name in enumerate(headers):
                if name in TEXT_COLUMNS:
                    col = column_letter(left + i)
                    text_areas.append(
                        f"{col}{top + 1}:{col}{top + len(matrix)}"
                    )

            if text_areas:
                sheet.api.Range(
                    ",".join(text_areas)
                ).NumberFormat = "@"

            body.Value2 = matrix

Теперь форматирование выполняется шестью операциями вместо 29: общий формат и текстовые столбцы для каждой таблицы. Несмежные текстовые столбцы объединяются одним адресом Range через запятую — Excel поддерживает такой способ обращения. 

Запись значений остаётся одной операцией на таблицу.

