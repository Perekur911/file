            sh.TopLeftCell.ClearContents
            count = count + 1
        ElseIf sh.TopLeftCell.row = sheetJOIN.Range("JOIN_1_absolutePressure").row Then
            If sh.TopLeftCell.Column = sheetJOIN.Range("JOIN_" & lastList & "_absolutePressure").Column Then
                sh.name = "CheckBox_Join_" & lastList & "_absolute"
