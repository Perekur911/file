def refresh_theme(self):
        self._close_popup()

        for state, color in COLORS.items():
            self.projects_tree.tag_configure(
                state,
                background=color,
                foreground=FG,
            )

        for state, swatch in self.legend_swatches.items():
            swatch.configure(
                background=COLORS[state]
            )

        for line in self.outline_lines:
            line.configure(background=BLUE)

        self._queue_outline()

Он обновляет цвета уже существующих строк, легенды и рамки выбранного проекта.

