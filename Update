4. Добавить функции фильтрации и сортировки

Сразу после метода:

def _project_visible_for_year(...)

вставь следующие методы:

def _on_filter_text_changed(self, *_args) -> None:
    if hasattr(self, "tree") and not self.busy:
        self.refresh_table()


def clear_filters(self) -> None:
    self.filter_text_var.set("")
    self.filter_version_var.set("Все")
    self.filter_recommended_var.set("Все")
    self.filter_safe_var.set("Все")
    self.filter_source_var.set("Все")
    self.filter_action_var.set("Все")

    if hasattr(self, "tree"):
        self.refresh_table()


def _update_filter_lists(self, year: int) -> None:
    year_items = [
        item
        for project, item in self.cache.items()
        if self._project_visible_for_year(project, year)
    ]

    version_values = (
        "Все",
        *sorted({
            item.version_status
            for item in year_items
            if item.version_status
        }),
    )

    recommended_values = (
        "Все",
        *sorted({
            item.recommended_action
            for item in year_items
            if item.recommended_action
        }),
    )

    source_values = (
        "Все",
        *sorted({
            item.inspection_source
            for item in year_items
            if item.inspection_source
        }),
    )

    self.filter_version_combo.configure(
        values=version_values,
    )
    self.filter_recommended_combo.configure(
        values=recommended_values,
    )
    self.filter_source_combo.configure(
        values=source_values,
    )

    if self.filter_version_var.get() not in version_values:
        self.filter_version_var.set("Все")

    if self.filter_recommended_var.get() not in recommended_values:
        self.filter_recommended_var.set("Все")

    if self.filter_source_var.get() not in source_values:
        self.filter_source_var.set("Все")


def _matches_filters(self, item: ProjectInspection) -> bool:
    version_filter = self.filter_version_var.get()

    if (
        version_filter != "Все"
        and item.version_status != version_filter
    ):
        return False

    recommended_filter = self.filter_recommended_var.get()

    if (
        recommended_filter != "Все"
        and item.recommended_action != recommended_filter
    ):
        return False

    safe_filter = self.filter_safe_var.get()

    if safe_filter == "ДА" and not item.safe_to_recreate:
        return False

    if safe_filter == "НЕТ" and item.safe_to_recreate:
        return False

    source_filter = self.filter_source_var.get()

    if (
        source_filter != "Все"
        and item.inspection_source != source_filter
    ):
        return False

    action_filter = self.filter_action_var.get()

    action_mapping = {
        "Без действия": "",
        "Обновить/создать": "update",
        "Пересоздать": "recreate",
    }

    if action_filter != "Все":
        expected_action = action_mapping[action_filter]

        if item.selected_action != expected_action:
            return False

    search_text = self.filter_text_var.get().strip().casefold()

    if search_text:
        search_values = list(self._row_values(item))
        search_values.extend(
            (
                item.issue,
                item.selected_folder,
                item.expected_folder,
                " ".join(item.found_folders),
                " ".join(item.workbook_candidates),
            )
        )

        full_text = "\n".join(
            str(value)
            for value in search_values
            if value is not None
        ).casefold()

        if search_text not in full_text:
            return False

    return True


@staticmethod
def _natural_sort_key(value: Any) -> tuple:
    text = str(value or "").strip().casefold()

    parts = re.split(r"(\d+)", text)

    return tuple(
        (0, int(part))
        if part.isdigit()
        else (1, part)
        for part in parts
        if part != ""
    )


def _column_display_value(
    self,
    item: ProjectInspection,
    column: str,
) -> str:
    column_index = self.table_columns.index(column)
    return self._row_values(item)[column_index]


def sort_by_column(self, column: str) -> None:
    if self.sort_column == column:
        self.sort_reverse = not self.sort_reverse
    else:
        self.sort_column = column
        self.sort_reverse = False

    self._update_sort_headings()
    self._sort_tree_items()


def _update_sort_headings(self) -> None:
    for column in self.table_columns:
        caption = self.table_headings[column]

        if column == self.sort_column:
            caption += " ▼" if self.sort_reverse else " ▲"

        self.tree.heading(column, text=caption)


def _sort_tree_items(self) -> None:
    if not hasattr(self, "tree"):
        return

    children = list(self.tree.get_children())

    filled: list[str] = []
    empty: list[str] = []

    for project in children:
        item = self.cache.get(project)

        if item is None:
            continue

        value = self._column_display_value(
            item,
            self.sort_column,
        )

        if str(value).strip():
            filled.append(project)
        else:
            empty.append(project)

    filled.sort(
        key=lambda project: self._natural_sort_key(
            self._column_display_value(
                self.cache[project],
                self.sort_column,
            )
        ),
        reverse=self.sort_reverse,
    )

    # Пустые значения всегда располагаются внизу.
    ordered = filled + empty

    for position, project in enumerate(ordered):
        self.tree.move(project, "", position)

Сортировка будет натуральной: например, 26-F9 не окажется после 26-F100.

