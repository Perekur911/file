        Array(COL_PRESSURE_DB, COL_PRESSURE_FORM), _
        Array(COL_TEMPERATURE_DB, COL_TEMPERATURE_FORM), _
        Array(COL_DENSITY_DB, COL_DENSITY_FORM), _
        Array(COL_ACTIVE_DB, COL_ACTIVE_FORM) _
    )

End Function

Private Function Validate_AP_Form(ByVal formIndex As Long) As Boolean

    Validate_AP_Form = False

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetAP As Worksheet
    Set sheetAP = wb.Worksheets("AP")

    Dim APTable As ListObject
    Set APTable = wb.Worksheets("AP_results").ListObjects("AP_results")

    Dim errors As String
    Dim errorCount As Long

    If formIndex <= 0 Then
        MsgBox "Некорректный номер формы AP: " & formIndex, vbExclamation
        Exit Function
    End If

    If Not NamedRangeExists(wb, "AP_" & formIndex & "_sampleCode") _
       Or Not ListObjectExists(sheetAP, "AP_source_" & formIndex) Then

        MsgBox "Форма AP_" & formIndex & " не найдена.", vbExclamation
        Exit Function

    End If

    Dim headerCell As Range
    Dim fieldName As String
    Dim rangeName As String

    Dim rng As Range
    Dim valueCell As Range

    Dim fieldValue As Variant
    Dim fieldText As String
    
    For Each headerCell In APTable.HeaderRowRange.Cells

        fieldName = CStr(headerCell.value)

        If fieldName = "dateTimeSync" Then
            GoTo next_header
        End If

        rangeName = "AP_" & formIndex & "_" & fieldName

        If Not NamedRangeExists(wb, rangeName) Then

            AddValidationError _
                errors, _
                errorCount, _
                "Не найден именованный диапазон: " & rangeName

            GoTo next_header

        End If

        Set rng = sheetAP.Range(rangeName)
        Set valueCell = rng.Cells(1, 1)

        ' Снимаем старую подсветку перед новой проверкой.
        ClearValidationFill rng

        fieldValue = valueCell.value

        If IsError(fieldValue) Then

            AddValidationError _
                errors, _
                errorCount, _
                rangeName & _
                " содержит ошибку Excel: " & valueCell.text & _
                " (" & valueCell.Worksheet.name & _
                "!" & valueCell.Address(False, False) & ")", _
                rng

            GoTo next_header

        End If

        fieldText = Trim$(CStr(fieldValue))

        ' =========================================================
        ' ГРУППА 1. Поля, которые должны содержать число,
        ' если они заполнены.
        ' =========================================================

        Select Case fieldName
            Case "TaskId"

                If fieldText <> "" Then

                    If Not IsNumeric(fieldValue) Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "В поле """ & AP_FieldCaption(fieldName) & _
                            """ должно быть указано число: " & rangeName, _
                            rng
                    ElseIf CDbl(fieldValue) <> Fix(CDbl(fieldValue)) Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "В поле """ & AP_FieldCaption(fieldName) & _
                            """ должно быть указано целое число: " & rangeName, _
                            rng
                    ElseIf fieldValue <= 0 Then
                        AddValidationError _
                            errors, _
                            errorCount, _
                            "В поле """ & AP_FieldCaption(fieldName) & _
                            """ должно быть указано положительное целое число: " & rangeName, _
                            rng
                    Else
                        Dim result As String

                        result = CheckAPTask( _
                            CLng(fieldValue), _
                            CStr(sheetAP.Range( _
                                "AP_" & formIndex & "_sampleCode" _
                            ).value), _
                            sheetAP.Range( _
                                "AP_" & formIndex & "_Tfact" _
                            ).value, _
                            formIndex _
                        )

                        If result <> "OK" Then

                            AddValidationError _
                                errors, _
                                errorCount, _
                                result, _
                                rng

                        End If
                    End If
                End If

            Case "Tfact", _
                 "ka", _
                 "kb", _
                 "kc"

                If fieldText <> "" Then

                    If Not IsNumeric(fieldValue) Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "В поле """ & AP_FieldCaption(fieldName) & _
                            """ должно быть указано число: " & rangeName, _
                            rng

                    End If

                End If

        End Select

        ' =========================================================
        ' ГРУППА 2. Обязательные непустые поля.
        ' =========================================================

        Select Case fieldName

            Case "sampleCode", _
                 "analyseNumber", _
                 "apEquipment", _
                 "apEquipmentNumber"

                If fieldText = "" Then

                    AddValidationError _
                        errors, _
                        errorCount, _
                        "Не заполнено обязательное поле """ & _
                        AP_FieldCaption(fieldName) & _
                        """: " & rangeName, _
                        rng

                End If

        End Select

        ' =========================================================
        ' ГРУППА 3. Поля ввода исполнителя.
        ' =========================================================

        Select Case fieldName

            Case "operator"

                If fieldText = "" Then

                    AddValidationError _
                        errors, _
                        errorCount, _
                        "Не указан исполнитель: " & rangeName, _
                        rng

                ElseIf Not IsValidExecutor(fieldValue) Then

                    AddValidationError _
                        errors, _
                        errorCount, _
                        "Неверно указан исполнитель: " & rangeName, _
                        rng

                End If

        End Select

        ' =========================================================
        ' ГРУППА 4. Поля с датой.
        ' =========================================================

        Select Case fieldName

            Case "date"

                If fieldText = "" Then

                    AddValidationError _
                        errors, _
                        errorCount, _
                        "Не заполнена дата выполнения: " & rangeName, _
                        rng

                ElseIf Not IsDate(fieldValue) Then

                    AddValidationError _
                        errors, _
                        errorCount, _
                        "Введённое значение невозможно преобразовать " & _
                        "в дату: " & rangeName, _
                        rng

                End If

        End Select

        ' =========================================================
        ' ГРУППА 5. Дополнительные ограничения для числовых полей.
        ' Сюда попадаем только после проверки IsNumeric.
        ' =========================================================

        Select Case fieldName

            Case "TaskId"

                If fieldText <> "" And IsNumeric(fieldValue) Then

                    If CDbl(fieldValue) < 0 Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Номер задания не может быть отрицательным: " & _
                            rangeName, _
                            rng

                    End If

                End If

        End Select

next_header:
    Next headerCell

    ' =============================================================
    ' ПРОВЕРКА ТАБЛИЦЫ ИСХОДНЫХ ДАННЫХ
    ' =============================================================

    Dim sourceTable As ListObject
    Set sourceTable = sheetAP.ListObjects("AP_source_" & formIndex)

    If Not ListColumnExists(sourceTable, COL_ROW_ID_DB) _
            Or Not ListColumnExists(sourceTable, COL_PRESSURE_FORM) _
            Or Not ListColumnExists(sourceTable, COL_TEMPERATURE_FORM) _
            Or Not ListColumnExists(sourceTable, COL_DENSITY_FORM) _
            Or Not ListColumnExists(sourceTable, COL_ACTIVE_FORM) Then

        AddValidationError _
            errors, _
            errorCount, _
            "В таблице AP_source_" & formIndex & _
            " не найдены обязательные столбцы."

        GoTo after_source_validation

    End If

    If sourceTable.DataBodyRange Is Nothing Then

        AddValidationError _
            errors, _
            errorCount, _
            "Таблица AP_source_" & formIndex & _
            " не содержит строк."

        GoTo after_source_validation

    End If

    Dim pressureCol As Long
    Dim temperatureCol As Long
    Dim densityCol As Long
    Dim activeCol As Long

    pressureCol = sourceTable.ListColumns(COL_PRESSURE_FORM).index
    temperatureCol = sourceTable.ListColumns(COL_TEMPERATURE_FORM).index
    densityCol = sourceTable.ListColumns(COL_DENSITY_FORM).index
    activeCol = sourceTable.ListColumns(COL_ACTIVE_FORM).index

    Dim rowIndex As Long

    Dim pressureCell As Range
    Dim temperatureCell As Range
    Dim densityCell As Range
    Dim activeCell As Range

    Dim pressureValue As Variant
    Dim temperatureValue As Variant
    Dim densityValue As Variant
    Dim activeValue As Variant

    Dim pressureText As String
    Dim temperatureText As String
    Dim densityText As String

    Dim validRowsCount As Long
    Dim activeRowsCount As Long
    Dim isActive As Boolean

    For rowIndex = 1 To sourceTable.ListRows.count

        Set pressureCell = _
            sourceTable.DataBodyRange.Cells(rowIndex, pressureCol)

        Set temperatureCell = _
            sourceTable.DataBodyRange.Cells(rowIndex, temperatureCol)

        Set densityCell = _
            sourceTable.DataBodyRange.Cells(rowIndex, densityCol)

        Set activeCell = _
            sourceTable.DataBodyRange.Cells(rowIndex, activeCol)

        ' Сначала снимаем прежнюю подсветку проверяемых ячеек строки.
        ClearValidationFill pressureCell
        ClearValidationFill temperatureCell
        ClearValidationFill densityCell
        ClearValidationFill activeCell

        pressureValue = pressureCell.value
        temperatureValue = temperatureCell.value
        densityValue = densityCell.value
        activeValue = activeCell.value

        ' ---------------------------------------------------------
        ' Ошибки Excel в давлении и плотности.
        ' ---------------------------------------------------------

        If IsError(pressureValue) Then

            AddValidationError _
                errors, _
                errorCount, _
                "AP_source_" & formIndex & _
                ", строка " & rowIndex & _
                ": давление содержит ошибку Excel: " & _
                pressureCell.text, _
                pressureCell

            GoTo next_source_row

        End If

        If IsError(densityValue) Then

            AddValidationError _
                errors, _
                errorCount, _
                "AP_source_" & formIndex & _
                ", строка " & rowIndex & _
                ": плотность содержит ошибку Excel: " & _
                densityCell.text, _
                densityCell

            GoTo next_source_row

        End If

        pressureText = Trim$(CStr(pressureValue))
        densityText = Trim$(CStr(densityValue))

        ' Если давление или плотность не указаны,
        ' строку не считаем заполненной и дальше не проверяем.
        If pressureText = "" Or densityText = "" Then
            GoTo next_source_row
        End If

        validRowsCount = validRowsCount + 1

        ' ---------------------------------------------------------
        ' Давление.
        ' ---------------------------------------------------------

        If Not IsNumeric(pressureValue) Then

            AddValidationError _
                errors, _
                errorCount, _
                "AP_source_" & formIndex & _
                ", строка " & rowIndex & _
                ": давление должно быть числом.", _
                pressureCell

        ElseIf CDbl(pressureValue) <= 0 _
            Or CDbl(pressureValue) >= 14000 Then

            AddValidationError _
                errors, _
                errorCount, _
                "AP_source_" & formIndex & _
                ", строка " & rowIndex & _
                ": давление должно быть > 0 и < 14000 psig.", _
                pressureCell

        End If

        ' ---------------------------------------------------------
        ' Плотность.
        ' ---------------------------------------------------------

        If Not IsNumeric(densityValue) Then

            AddValidationError _
                errors, _
                errorCount, _
                "AP_source_" & formIndex & _
                ", строка " & rowIndex & _
                ": плотность должна быть числом.", _
                densityCell

        ElseIf CDbl(densityValue) <= 0 _
            Or CDbl(densityValue) >= 1 Then

            AddValidationError _
                errors, _
                errorCount, _
                "AP_source_" & formIndex & _
                ", строка " & rowIndex & _
                ": плотность должна быть > 0 и < 1 г/см3.", _
                densityCell

        End If

        ' ---------------------------------------------------------
        ' Температура.
        ' ---------------------------------------------------------

        If IsError(temperatureValue) Then

            AddValidationError _
                errors, _
                errorCount, _
                "AP_source_" & formIndex & _
                ", строка " & rowIndex & _
                ": температура содержит ошибку Excel: " & _
                temperatureCell.text, _
                temperatureCell

        Else

            temperatureText = Trim$(CStr(temperatureValue))

            If temperatureText = "" Then

                AddValidationError _
                    errors, _
                    errorCount, _
                    "AP_source_" & formIndex & _
                    ", строка " & rowIndex & _
                    ": не указана температура.", _
                    temperatureCell

            ElseIf Not IsNumeric(temperatureValue) Then

                AddValidationError _
                    errors, _
                    errorCount, _
                    "AP_source_" & formIndex & _
                    ", строка " & rowIndex & _
                    ": температура должна быть числом.", _
                    temperatureCell

            ElseIf CDbl(temperatureValue) < -20 _
                Or CDbl(temperatureValue) > 140 Then

                AddValidationError _
                    errors, _
                    errorCount, _
                    "AP_source_" & formIndex & _
                    ", строка " & rowIndex & _
                    ": температура должна быть в диапазоне " & _
                    "от -20 до 140 °C.", _
                    temperatureCell

            End If

        End If

        ' ---------------------------------------------------------
        ' Поле Active.
        ' ---------------------------------------------------------

        If IsError(activeValue) Then

            AddValidationError _
                errors, _
                errorCount, _
                "AP_source_" & formIndex & _
                ", строка " & rowIndex & _
                ": поле «Активна» содержит ошибку Excel: " & _
                activeCell.text, _
                activeCell

        Else

            isActive = False

            Select Case LCase$(Trim$(CStr(activeValue)))

                Case "true", _
                     "истина", _
                     "1", _
                     "yes", _
                     "да", _
                     "+"

                    isActive = True

            End Select

            If isActive Then
                activeRowsCount = activeRowsCount + 1
            End If

        End If

next_source_row:
    Next rowIndex

    ' =============================================================
    ' ОБЩИЕ ПРОВЕРКИ ТАБЛИЦЫ
    ' =============================================================

    If validRowsCount = 0 Then

        AddValidationError _
            errors, _
            errorCount, _
            "В AP_source_" & formIndex & _
            " нет ни одной строки с заполненными " & _
            "давлением и плотностью.", _
            sourceTable.ListColumns(COL_PRESSURE_FORM).DataBodyRange

        SetValidationErrorFill _
            sourceTable.ListColumns(COL_DENSITY_FORM).DataBodyRange

    End If

    If activeRowsCount = 0 Then

        AddValidationError _
            errors, _
            errorCount, _
            "В AP_source_" & formIndex & _
            " нет ни одной заполненной строки с «Активна» = True.", _
            sourceTable.ListColumns(COL_ACTIVE_FORM).DataBodyRange

    End If

after_source_validation:

    If errorCount > 0 Then

        MsgBox _
            "AP_" & formIndex & _
            " не сохранена. Исправьте ошибки:" & _
            vbCrLf & vbCrLf & errors, _
            vbExclamation

        Exit Function

    End If

    Validate_AP_Form = True

End Function

