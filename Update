    Set sheetREC = ActiveWorkbook.Sheets("Rec")
    
    Dim eq() As String
    
    eq = getEquipmentModels("", "PVTCell")
    Dim strEqTS As String
    strEqTS = eq(1)
    For i = 2 To UBound(eq)
        strEqTS = strEqTS & "," & eq(i)
    Next i
    
    eq = getEquipmentModels("", "TransferVolume")
    Dim strEqEq As String
    strEqEq = eq(1)
    For i = 2 To UBound(eq)
        strEqEq = strEqEq & "," & eq(i)
    Next i
    
    Dim CellTS As Range
    Dim CellEq As Range
    i = 1
    
    On Error Resume Next
    Do While True
        Set CellTS = Nothing
        Set CellTS = sheetREC.Range("Rec_" & i & "_typeSampler")
        If CellTS Is Nothing Then Exit Do
        
        Set CellEq = sheetREC.Range("Rec_" & i & "_equipmentForTransfer")
        
        With CellTS.Validation
            .Delete
            .Add Type:=xlValidateList, AlertStyle:=xlValidAlertStop, Operator:= _
            xlBetween, Formula1:=strEqTS
            .IgnoreBlank = True
            .InCellDropdown = True
            .ShowInput = True
            .ShowError = True
        End With
        With CellEq.Validation
            .Delete
            .Add Type:=xlValidateList, AlertStyle:=xlValidAlertStop, Operator:= _
            xlBetween, Formula1:=strEqEq
            .IgnoreBlank = True
            .InCellDropdown = True
            .ShowInput = True
            .ShowError = True
        End With
        i = i + 1
    Loop
    On Error GoTo 0
    
End Sub


Public Function GetRecVisibleColumnCount( _
    ByVal formNumber As Long, _
    Optional ByVal wb As Workbook = Nothing _
) As Long

    If wb Is Nothing Then Set wb = ActiveWorkbook

    Const REC_FIXED_VISIBLE_BLUE_COLS As Long = 4
    Const REC_FIRST_DYNAMIC_BLUE_COL_INDEX As Long = 5
    Const REC_MAX_BLUE_COL_INDEX As Long = 12

    Dim visibleCount As Long
    visibleCount = REC_FIXED_VISIBLE_BLUE_COLS

    Dim sampleIndex As Long
    Dim rangeName As String
    Dim namedRange As Range

    For sampleIndex = REC_FIRST_DYNAMIC_BLUE_COL_INDEX To REC_MAX_BLUE_COL_INDEX

        rangeName = "Rec_" & formNumber & "_" & COL_MIX_SAMPLE_CODE_CHILD_DB & sampleIndex

        If Not TryGetNamedRange(wb, rangeName, namedRange) Then
            Err.Raise vbObjectError + 2000, , _
                "Именованный диапазон не найден: " & rangeName
        End If

        If IsNamedRangeColumnHidden(namedRange) Then
            Exit For
        End If

        visibleCount = visibleCount + 1

    Next sampleIndex

    GetRecVisibleColumnCount = visibleCount

End Function

Private Function IsNamedRangeColumnHidden(ByVal namedRange As Range) As Boolean

    Dim checkCell As Range

    If namedRange.MergeCells Then
        Set checkCell = namedRange.MergeArea.Cells(1, 1)
    Else
        Set checkCell = namedRange.Cells(1, 1)
    End If

    IsNamedRangeColumnHidden = checkCell.EntireColumn.Hidden

