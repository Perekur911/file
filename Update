Вот макрос. Он перебирает **имена уровня книги**, относящиеся к заданному листу, и добавляет недостающие столбцы справа в соответствующие таблицы.

```vba
Public Sub CreateCVDTableColumns()

    Const SHEET_NAME As String = "CVD"
    Const NAME_PREFIX As String = "CVD_1_"

    Const RESULTS_TABLE_NAME As String = "CVD_results"
    Const SOURCE_TABLE_NAME As String = "CVD_sourceData"

    Dim wb As Workbook
    Dim ws As Worksheet

    Dim resultsTable As ListObject
    Dim sourceTable As ListObject

    Dim nm As Name
    Dim namedRange As Range

    Dim rangeName As String
    Dim nameParts() As String
    Dim columnName As String

    Dim addedResults As Long
    Dim addedSource As Long

    Set wb = ThisWorkbook
    Set ws = wb.Worksheets(SHEET_NAME)

    Set resultsTable = ws.ListObjects(RESULTS_TABLE_NAME)
    Set sourceTable = ws.ListObjects(SOURCE_TABLE_NAME)

    For Each nm In wb.Names

        ' Берём только имена уровня книги.
        If InStr(1, nm.Name, "!", vbTextCompare) = 0 Then

            rangeName = nm.Name

            ' Имя должно начинаться с CVD_1_.
            If StrComp( _
                    Left$(rangeName, Len(NAME_PREFIX)), _
                    NAME_PREFIX, _
                    vbTextCompare _
               ) = 0 Then

                Set namedRange = Nothing

                On Error Resume Next
                Set namedRange = nm.RefersToRange
                On Error GoTo 0

                ' Проверяем, что имя относится к нужному листу.
                If Not namedRange Is Nothing Then
                    If namedRange.Worksheet Is ws Then

                        nameParts = Split(rangeName, "_")

                        Select Case UBound(nameParts) - LBound(nameParts) + 1

                            ' Например:
                            ' CVD_1_taskId
                            Case 3

                                columnName = nameParts(2)

                                If Not TableColumnExists( _
                                        resultsTable, _
                                        columnName _
                                   ) Then

                                    resultsTable.ListColumns.Add.Name = columnName
                                    addedResults = addedResults + 1

                                End If

                            ' Например:
                            ' CVD_1_st1_Ppic
                            Case 4

                                If StrComp( _
                                        nameParts(2), _
                                        "st1", _
                                        vbTextCompare _
                                   ) = 0 Then

                                    columnName = nameParts(3)

                                    If Not TableColumnExists( _
                                            sourceTable, _
                                            columnName _
                                       ) Then

                                        sourceTable.ListColumns.Add.Name = columnName
                                        addedSource = addedSource + 1

                                    End If

                                End If

                        End Select
                    End If
                End If
            End If
        End If
    Next nm

    MsgBox _
        "Создано колонок:" & vbCrLf & _
        RESULTS_TABLE_NAME & ": " & addedResults & vbCrLf & _
        SOURCE_TABLE_NAME & ": " & addedSource, _
        vbInformation

End Sub


Private Function TableColumnExists( _
    ByVal table As ListObject, _
    ByVal columnName As String _
) As Boolean

    Dim tableColumn As ListColumn

    For Each tableColumn In table.ListColumns

        If StrComp( _
                tableColumn.Name, _
                columnName, _
                vbTextCompare _
           ) = 0 Then

            TableColumnExists = True
            Exit Function

        End If
    Next tableColumn

    TableColumnExists = False

End Function
```

Логика получается такая:

```text
CVD_1_taskId
```

Три фрагмента: `CVD`, `1`, `taskId` → в `CVD_results` добавится колонка `taskId`.

```text
CVD_1_st1_Ppic
```

Четыре фрагмента, третий равен `st1` → в `CVD_sourceData` добавится колонка `Ppic`.

```text
CVD_1_st2_Ppic
CVD_1_last_Ppic
```

Четыре фрагмента, но третий не `st1` → ничего не создаётся.

Уже существующие в таблицах колонки повторно не добавляются. Название листа меняется здесь:

```vba
Const SHEET_NAME As String = "CVD"
```
