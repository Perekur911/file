Private Function RecFormHasAnyChildData( _
    ByVal wb As Workbook, _
    ByVal formIndex As Long _
) As Boolean

    Dim childIndex As Long

    For childIndex = 1 To REC_CHILD_COUNT_PER_FORM
        If RecChildHasData(wb, formIndex, childIndex) Then
            RecFormHasAnyChildData = True
            Exit Function
        End If
    Next childIndex

    RecFormHasAnyChildData = False

End Function


Private Function RecChildHasData( _
    ByVal wb As Workbook, _
    ByVal formIndex As Long, _
    ByVal childIndex As Long _
) As Boolean

    RecChildHasData = _
        RecNamedChildValueHasData(wb, formIndex, childIndex, COL_MIX_SAMPLE_CODE_CHILD_DB) _
        And (RecNamedChildValueHasData(wb, formIndex, childIndex, COL_P_TRANSFER_CHILD_DB) _
        Or RecNamedChildValueHasData(wb, formIndex, childIndex, COL_T_TRANSFER_CHILD_DB) _
        Or RecNamedChildValueHasData(wb, formIndex, childIndex, COL_VOLUME_CHILD_DB))

End Function


Private Function RecNamedChildValueHasData( _
    ByVal wb As Workbook, _
    ByVal formIndex As Long, _
    ByVal childIndex As Long, _
    ByVal fieldName As String _
) As Boolean

    Dim rangeName As String
    rangeName = "Rec_" & formIndex & "_" & fieldName & childIndex

    If Not NamedRangeExists(wb, rangeName) Then
        RecNamedChildValueHasData = False
        Exit Function
    End If

    RecNamedChildValueHasData = _
        Len(Trim$(CStr(wb.Names(rangeName).RefersToRange.value))) > 0

End Function


