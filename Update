# Study migration
# =============================================================================

def old_source_form_table_name(study: str, form_index: int) -> str:
    # В v20 AP/BP/GC/EMV назывались <study>_<n>.
    # У GOR/SSF дочерние шифры фаз были отдельными именованными диапазонами,
    # а не таблицами.
    return f"{study}_{form_index}"


def new_source_form_table_name(study: str, form_index: int) -> str:
    return f"{study}_source_{form_index}"


def old_form_exists(old_book: xw.Book, study: str, form_index: int) -> bool:
    return (
        named_range_exists(old_book, f"{study}_{form_index}_Id")
        or named_range_exists(old_book, f"{study}_{form_index}_sampleCode")
    )


def source_field_for_target(study: str, target_field: str) -> str:
    return NAMED_FIELD_SOURCE_MAP.get(study, {}).get(target_field, target_field)


def migrate_legacy_phase_links(
    *,
    old_book: xw.Book,
    new_book: xw.Book,
    study: str,
    form_index: int,
) -> int:
    """
    GOR/SSF v20:
        IdLPh, IdGPh
    GOR/SSF v23:
        таблица <study>_source_<n> с колонками sampleCode / TypePh.

    Технические rowId/resultId не заполняются.
    """
    if study not in ("GOR", "SSF"):
        return 0

    new_table = try_get_list_object(
        new_book,
        study,
        new_source_form_table_name(study, form_index),
    )

    if new_table is None:
        return 0

    new_map = header_index_map(new_table)

    if "sampleCode" not in new_map or "TypePh" not in new_map:
        return 0

    phase_values = [
        ("IdLPh", "LPh"),
        ("IdGPh", "GPh"),
    ]

    values_to_write: list[tuple[Any, str]] = []

    for old_field, phase_type in phase_values:
        old_rng = get_named_range(old_book, f"{study}_{form_index}_{old_field}")

        if old_rng is None or range_has_formula(old_rng):
            continue

        value = get_cell_value_from_range(old_rng)

        if is_blank_value(value):
            continue

        values_to_write.append((value, phase_type))

    if not values_to_write:
        return 0

    ensure_table_rows(new_table, len(values_to_write))
    body = new_table.DataBodyRange

    if body is None:
        return 0

    copied = 0

    for row_idx, (sample_code, phase_type) in enumerate(values_to_write, start=1):
        sample_cell = body.Cells(row_idx, new_map["sampleCode"])
        type_cell = body.Cells(row_idx, new_map["TypePh"])

        if not cell_has_formula(sample_cell):
            sample_cell.Value = sample_code
            copied += 1

        if not cell_has_formula(type_cell):
            type_cell.Value = phase_type
            copied += 1

    return copied


def migrate_named_range_study(
    *,
    old_book: xw.Book,
    new_book: xw.Book,
    study: str,
    warnings: list[str],
) -> tuple[int, int, int]:
    """
    Перенос обычных форм v20 -> v23:
    AP, BP, GC, GOR, SSF, EMV.

    - технические resultId/rowId и analyseNumber пропускаются;
    - sampleCode берётся из старого Id;
    - формулы старой формы не копируются;
    - формулы новой формы не затираются;
    - табличная часть переносится по общим/переименованным колонкам;
    - старое '+'/'-' в колонке "График" превращается в True/False "Активна";
    - оборудование преобразуется в новый формат "тип + номер";
    - IdLPh/IdGPh для GOR/SSF перекладываются в source-таблицу.
    """
    forms_copied = 0
    named_values_copied = 0
    table_values_copied = 0

    result_table = try_get_list_object(
        new_book,
        f"{study}_results",
        f"{study}_results",
    )

    if result_table is None:
        warnings.append(f"{study}: не найдена новая таблица {study}_results, пропускаю")
        return 0, 0, 0

    result_fields = read_table_headers(result_table)
    form_index = 1

    while old_form_exists(old_book, study, form_index):
        if not named_range_exists(new_book, f"{study}_{form_index}_sampleCode"):
            warnings.append(
                f"{study}_{form_index}: в новой форме нет формы с таким индексом; "
                f"данные этой формы v20 пропущены"
            )
            form_index += 1
            continue

        form_has_any_data = False

        for target_field in result_fields:
            if should_skip_field(target_field):
                continue

            source_field = source_field_for_target(study, target_field)

            old_range_name = f"{study}_{form_index}_{source_field}"
            new_range_name = f"{study}_{form_index}_{target_field}"

            if not named_range_exists(old_book, old_range_name):
                continue

            if not named_range_exists(new_book, new_range_name):
                continue

            old_rng = get_named_range(old_book, old_range_name)

            if old_rng is None or range_has_formula(old_rng):
                continue

            source_value = get_cell_value_from_range(old_rng)

            value = transform_named_value(
                study=study,
                target_field=target_field,
                source_value=source_value,
                warnings=warnings,
                form_index=form_index,
            )

            new_rng = get_named_range(new_book, new_range_name)

            if write_value_to_range_if_not_formula(new_rng, value):
                named_values_copied += 1
                form_has_any_data = True

        old_src_table_name = old_source_form_table_name(study, form_index)
        new_src_table_name = new_source_form_table_name(study, form_index)

        old_src_table = try_get_list_object(old_book, study, old_src_table_name)
        new_src_table = try_get_list_object(new_book, study, new_src_table_name)

        if old_src_table is not None and new_src_table is not None:
            copied = copy_table_values_by_common_columns(
                old_src_table,
                new_src_table,
                study=study,
                skip_fields={"page"},
                source_header_map=SOURCE_TABLE_HEADER_MAP.get(study, {}),
            )
            table_values_copied += copied

            if copied > 0:
                form_has_any_data = True

        elif old_src_table is not None and new_src_table is None:
            warnings.append(
                f"{study}_{form_index}: в старой форме есть таблица {old_src_table_name}, "
                f"а в новой не найдена {new_src_table_name}"
            )

        # Отдельная миграция шифров полученных фаз GOR/SSF.
        phase_copied = migrate_legacy_phase_links(
            old_book=old_book,
            new_book=new_book,
            study=study,
            form_index=form_index,
        )

        table_values_copied += phase_copied

        if phase_copied > 0:
            form_has_any_data = True

        if form_has_any_data:
            forms_copied += 1

        form_index += 1

    return forms_copied, named_values_copied, table_values_copied


def migrate_op_table(
    *,
    old_book: xw.Book,
    new_book: xw.Book,
    warnings: list[str],
) -> tuple[int, int]:
    """
    OP — особый случай: форма OP сама является умной таблицей.
    v20.Id -> v23.sampleCode.
    VLiqPhase '-' -> LiqPhaseQualifier='Не выполнялось'.
    """
    old_table = try_get_list_object(old_book, "OP", "OP")
    new_table = try_get_list_object(new_book, "OP", "OP")

    if old_table is None:
        warnings.append("OP: в старой книге не найдена таблица OP")
        return 0, 0

    if new_table is None:
        warnings.append("OP: в новой книге не найдена таблица OP")
        return 0, 0

    def op_transform(target_header: str, value: Any) -> Any:
        if target_header == "VLiqPhase":
            amount, _qualifier = parse_legacy_liq_phase(value)
            return amount

        if target_header == "LiqPhaseQualifier":
            _amount, qualifier = parse_legacy_liq_phase(value)
            return qualifier

        return value

    copied = copy_table_values_by_common_columns(
        old_table,
        new_table,
        study="OP",
        skip_fields=OP_SKIP_FIELDS,
        source_header_map={
            "sampleCode": "Id",
            "LiqPhaseQualifier": "VLiqPhase",
        },
        value_transform=op_transform,
    )

    forms_copied = old_table.ListRows.Count if copied > 0 else 0

    return forms_copied, copied


def migrate_workbook_data(
    *,
    old_book: xw.Book,
    new_book: xw.Book,
) -> tuple[int, int, int, list[str]]:
    warnings: list[str] = []

    total_forms = 0
    total_named = 0
    total_table_values = 0

    unprotect_all_sheets(new_book)

    for study in STUDIES:
        logging.info("Миграция исследования %s", study)

        if study == "OP":
            forms, table_values = migrate_op_table(
                old_book=old_book,
                new_book=new_book,
                warnings=warnings,
            )

            total_forms += forms
            total_table_values += table_values
            continue

        forms, named_values, table_values = migrate_named_range_study(
            old_book=old_book,
            new_book=new_book,
            study=study,
            warnings=warnings,
        )

        total_forms += forms
        total_named += named_values
        total_table_values += table_values

    return total_forms, total_named, total_table_values, warnings


