def read_table_headers(table) -> list[str]:
    values = table.HeaderRowRange.Value

    if values is None:
        return []

    if isinstance(values, tuple) and values and isinstance(values[0], tuple):
        raw = values[0]
    else:
        raw = values

    return [str(v).strip() if v is not None else "" for v in raw]


def header_index_map(table) -> dict[str, int]:
    headers = read_table_headers(table)
    return {h: idx + 1 for idx, h in enumerate(headers) if h}


def ensure_table_rows(table, row_count: int) -> None:
    if row_count <= 0:
        return

    while table.ListRows.Count < row_count:
        table.ListRows.Add()


def cell_has_formula(cell) -> bool:
    try:
        if bool(cell.MergeCells):
            top_left = cell.MergeArea.Cells(1, 1)
            return bool(top_left.HasFormula)

        return bool(cell.HasFormula)
    except Exception:
        return False


def range_has_formula(rng) -> bool:
    if rng is None:
        return False

    try:
        if bool(rng.MergeCells):
            return bool(rng.MergeArea.Cells(1, 1).HasFormula)

        return bool(rng.Cells(1, 1).HasFormula)
    except Exception:
        return False


def is_blank_value(value: Any) -> bool:
    return value is None or (isinstance(value, str) and value.strip() == "")


def get_cell_value_from_range(rng):
    if rng is None:
        return None

    try:
        if bool(rng.MergeCells):
            return rng.MergeArea.Cells(1, 1).Value

        return rng.Cells(1, 1).Value
    except Exception:
        return rng.Value


def write_value_to_range_if_not_formula(target_rng, value: Any) -> bool:
    if target_rng is None or is_blank_value(value):
        return False

    try:
        if bool(target_rng.MergeCells):
            write_cell = target_rng.MergeArea.Cells(1, 1)
        else:
            write_cell = target_rng.Cells(1, 1)

        if cell_has_formula(write_cell):
            return False

        write_cell.Value = value
        return True

    except Exception:
        return False


def copy_named_range_value(
    old_book: xw.Book,
    new_book: xw.Book,
    old_range_name: str,
    new_range_name: str,
    *,
    transform=None,
) -> bool:
    old_rng = get_named_range(old_book, old_range_name)
    new_rng = get_named_range(new_book, new_range_name)

    if old_rng is None or new_rng is None:
        return False

    # Главное правило мигратора: результаты старых формул не переносим.
    if range_has_formula(old_rng):
        return False

    value = get_cell_value_from_range(old_rng)

    if transform is not None:
        value = transform(value)

    return write_value_to_range_if_not_formula(new_rng, value)


def should_skip_field(field_name: str) -> bool:
    f = str(field_name).strip().lower()

    if not f:
        return True

    if f in SKIP_RESULT_FIELDS:
        return True

    return any(f.startswith(prefix) for prefix in SKIP_FIELD_PREFIXES)


def normalize_header(value: Any) -> str:
    if value is None:
        return ""

    return re.sub(r"\s+", " ", str(value).strip())


def legacy_graph_flag_to_active(value: Any) -> Any:
    if isinstance(value, bool):
        return value

    if isinstance(value, (int, float)):
        return bool(value)

    if isinstance(value, str):
        v = value.strip().lower()

        if v in {"+", "1", "true", "истина", "да", "yes"}:
            return True

        if v in {"-", "0", "false", "ложь", "нет", "no"}:
            return False

    return value


def split_legacy_pvt_equipment(value: Any) -> tuple[Any | None, Any | None]:
    if is_blank_value(value):
        return None, None

    raw = str(value).strip()
    key = raw.lower()

    if key in LEGACY_PVT_EQUIPMENT_MAP:
        return LEGACY_PVT_EQUIPMENT_MAP[key]

    # AP-4 -> AP + 4
    m = re.fullmatch(r"ap\s*[- ]?\s*(\d+)", raw, flags=re.IGNORECASE)
    if m:
        return "AP", int(m.group(1))

    # EMV-A -> EMV + A
    m = re.fullmatch(r"emv\s*[- ]?\s*([a-zа-я0-9]+)", raw, flags=re.IGNORECASE)
    if m:
        return "EMV", m.group(1).upper()

    # miniPVT-2 и подобные варианты
    m = re.fullmatch(r"minipvt\s*[- ]?\s*(\d+)", raw, flags=re.IGNORECASE)
    if m:
        return "miniPVT", int(m.group(1))

    # Если старое значение явно говорит только о типе.
    if "pump" in key or "насос" in key:
        return "Pump", None

    if "minipvt" in key:
        return "miniPVT", None

    if "pvt" in key or key == "dbr":
        return "PVT", None

    return None, None


def warn_once(warnings: list[str], message: str) -> None:
    if message not in warnings:
        warnings.append(message)


def transform_named_value(
    *,
    study: str,
    target_field: str,
    source_value: Any,
    warnings: list[str],
    form_index: int,
) -> Any:
    if is_blank_value(source_value):
        return None

    # Поля оборудования в v23 разделены на тип + номер.
    equipment_field_pairs = {
        "AP": ("apEquipment", "apEquipmentNumber"),
        "BP": ("bpEquipment", "bpEquipmentNumber"),
        "GC": ("equipment", "equipmentNumber"),
        "GOR": ("smplTransfEq", "transfEqNumber"),
        "SSF": ("equipmentForTransfer", "equipForTransferNumber"),
        "EMV": ("emvEquipment", "emvEquipmentNumber"),
    }

    if study in equipment_field_pairs:
        type_field, number_field = equipment_field_pairs[study]

        if target_field in (type_field, number_field):
            eq_type, eq_number = split_legacy_pvt_equipment(source_value)

            if target_field == type_field:
                if eq_type is None:
                    warn_once(
                        warnings,
                        f"{study}_{form_index}: не удалось определить новый тип оборудования "
                        f"из старого значения '{source_value}'",
                    )
                return eq_type

            if eq_number is None and eq_type is not None:
                warn_once(
                    warnings,
                    f"{study}_{form_index}: для оборудования '{source_value}' в v20 нет "
                    f"однозначного номера единицы оборудования; номер в v23 оставлен пустым",
                )

            return eq_number

    # Газометр в GOR: v20 хранила только номер, v23 хранит GOR + номер.
    if study == "GOR" and target_field in ("gorEquipment", "gorEquipmentNumber"):
        if target_field == "gorEquipment":
            return "GOR"

        return source_value

    # Газометр / газовый счётчик в SSF.
    if study == "SSF" and target_field in ("ssfEquipment", "ssfEquipmentNumber"):
        s = str(source_value).strip().lower()

        if target_field == "ssfEquipment":
            if "счетчик" in s or "счётчик" in s or "gfm" in s:
                return "GFM"

            return "GOR"

        if "счетчик" in s or "счётчик" in s or "gfm" in s:
            warn_once(
                warnings,
                f"SSF_{form_index}: в v20 указано '{source_value}', но конкретного номера "
                f"газового счётчика нет; номер в v23 оставлен пустым",
            )
            return None

        return source_value

    return source_value


def transform_source_table_value(study: str, target_header: str, value: Any) -> Any:
    if target_header == "Активна":
        return legacy_graph_flag_to_active(value)

    return value


def copy_table_values_by_common_columns(
    old_table,
    new_table,
    *,
    study: str | None = None,
    skip_fields: set[str] | None = None,
    source_header_map: dict[str, str] | None = None,
    value_transform=None,
) -> int:
    if skip_fields is None:
        skip_fields = set()

    if source_header_map is None:
        source_header_map = {}

    skip_fields_normalized = {str(x).strip().lower() for x in skip_fields}

    old_map_raw = header_index_map(old_table)
    new_map_raw = header_index_map(new_table)

    old_map = {normalize_header(h): idx for h, idx in old_map_raw.items()}
    new_map = {normalize_header(h): idx for h, idx in new_map_raw.items()}

    source_header_map_normalized = {
        normalize_header(target): normalize_header(source)
        for target, source in source_header_map.items()
    }

    column_pairs: list[tuple[str, int, int]] = []

    for target_header, new_col in new_map.items():
        if not target_header:
            continue

        if target_header.lower() in skip_fields_normalized:
            continue

        if should_skip_field(target_header):
            continue

        source_header = source_header_map_normalized.get(target_header, target_header)

        if source_header not in old_map:
            continue

        column_pairs.append((target_header, old_map[source_header], new_col))

    if not column_pairs:
        return 0

    old_rows_count = old_table.ListRows.Count

    if old_rows_count == 0:
        return 0

    ensure_table_rows(new_table, old_rows_count)

    old_body = old_table.DataBodyRange
    new_body = new_table.DataBodyRange

    if old_body is None or new_body is None:
        return 0

    copied = 0

    for row_idx in range(1, old_rows_count + 1):
        for target_header, old_col, new_col in column_pairs:
            src_cell = old_body.Cells(row_idx, old_col)
            dst_cell = new_body.Cells(row_idx, new_col)

            # Не копируем ни формулы старой формы, ни поверх формул новой формы.
            if cell_has_formula(src_cell) or cell_has_formula(dst_cell):
                continue

            value = src_cell.Value

            if value_transform is not None:
                value = value_transform(target_header, value)
            elif study is not None:
                value = transform_source_table_value(study, target_header, value)

            if is_blank_value(value):
                continue

            dst_cell.Value = value
            copied += 1

    return copied


def parse_legacy_liq_phase(value: Any) -> tuple[Any | None, Any | None]:
    """
    v20: VLiqPhase могла содержать число или '-'.
    v23: число хранится в VLiqPhase, пояснение отдельно в LiqPhaseQualifier.
    """
    if is_blank_value(value):
        return None, None

    if isinstance(value, bool):
        return int(value), None

    if isinstance(value, (int, float)):
        return value, None

    s = str(value).strip()
    sl = s.lower()

    if s == "-" or "не выполня" in sl:
        return None, "Не выполнялось"

    if "менее" in sl:
        return None, "Менее 1 мл"

    if s.startswith("<"):
        return None, "Менее 1 мл"

    try:
        number = float(s.replace(",", "."))
        if number.is_integer():
            number = int(number)
        return number, None
    except Exception:
        return None, None


