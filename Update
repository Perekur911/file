Public Function ShouldSaveStudy( _
    ByVal newHash As String, _
    ByVal oldHash As String, _
    ByVal lastWorkflowStage As String, _
    Optional ByVal taskStatus As String = "" _
) As shouldSave

    Dim requestedStage As String
    requestedStage = EffectiveWorkflowStage(taskStatus)

    lastWorkflowStage = Trim$(lastWorkflowStage)

    ' Данные изменились — сохраняем всегда.
    If newHash = EMPTY_DATA_HASH Then
        If oldHash = EMPTY_DATA_HASH Or oldHash = "" Then
            ShouldSaveStudy = DATA_EMPTY
        Else
            ShouldSaveStudy = DATA_DELETED
        End If
        Exit Function
    End If
    
    If newHash <> oldHash Then
        ShouldSaveStudy = DATA_NEED_TO_SAVE
        Exit Function
    End If

    ' Данные не изменились.
    '
    ' Обычное сохранение повторять не нужно,
    ' независимо от того, были данные уже валидированы или нет.
    If requestedStage = "Завершено" Then
        ShouldSaveStudy = DATA_NO_CHANGES
        Exit Function
    End If

    ' Запрошенный этап уже был успешно сохранён.
    If StrComp( _
        requestedStage, _
        lastWorkflowStage, _
        vbTextCompare _
    ) = 0 Then

        ShouldSaveStudy = DATA_NO_CHANGES
        Exit Function

    End If

    ' Например:
    ' данные те же,
    ' было "Завершено",
    ' сейчас запросили "Валидировано".
    '
    ' Выполняем обычное полное сохранение ещё раз,
    ' но уже со статусом "Валидировано".
    ShouldSaveStudy = DATA_NEED_TO_SAVE

End Function

