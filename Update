Да, теперь по фотографии структура понятна полностью. У тебя сейчас VLiqPhase TEXT, а всё остальное сохраняем без изменений; также нужно восстановить уникальный индекс OP_results_sampleCode_IDX.

SQLite не умеет штатно сделать ALTER COLUMN VLiqPhase TYPE REAL, поэтому здесь правильно пересоздать таблицу, скопировать данные с преобразованием, удалить старую и переименовать новую. Это рекомендуемый SQLite способ изменения datatype. 

На копии БД я бы запускал вот этот скрипт:

BEGIN TRANSACTION;


-- ============================================================
-- 1. Создаём новую OP_results с новой структурой
-- ============================================================

CREATE TABLE OP_results_new (
    resultIdOp INTEGER PRIMARY KEY AUTOINCREMENT,
    TaskId INTEGER,
    sampleCode TEXT,
    operator TEXT,
    date TEXT,
    Popen REAL,
    Punit TEXT,
    Pabsolute INTEGER,
    PopenMPa REAL,
    Topen REAL,
    VH2O REAL,
    Pend REAL,
    PendMPa REAL,

    -- Был TEXT, теперь только число
    VLiqPhase REAL,

    -- Новое поле
    LiqPhaseQualifier TEXT,

    natureLiq TEXT,
    state INTEGER,
    comment TEXT,
    deltaPopenPCT REAL,
    PopenMPaT REAL,
    dateTimeSync TEXT
);


-- ============================================================
-- 2. Переносим данные
-- ============================================================

INSERT INTO OP_results_new (
    resultIdOp,
    TaskId,
    sampleCode,
    operator,
    date,
    Popen,
    Punit,
    Pabsolute,
    PopenMPa,
    Topen,
    VH2O,
    Pend,
    PendMPa,
    VLiqPhase,
    LiqPhaseQualifier,
    natureLiq,
    state,
    comment,
    deltaPopenPCT,
    PopenMPaT,
    dateTimeSync
)
SELECT
    resultIdOp,
    TaskId,
    sampleCode,
    operator,
    date,
    Popen,
    Punit,
    Pabsolute,
    PopenMPa,
    Topen,
    VH2O,
    Pend,
    PendMPa,

    -- ========================================================
    -- Новый VLiqPhase
    -- ========================================================
    CASE

        -- Для данного типа пробы определение не требуется
        WHEN VLiqPhase IS NULL
            THEN NULL

        -- Теперь эти состояния хранятся в qualifier
        WHEN TRIM(VLiqPhase) = 'Следы'
            THEN NULL

        WHEN TRIM(VLiqPhase) = 'Не выполнялось'
            THEN NULL

        -- 0 < значение < 1 теперь обозначаем qualifier
        WHEN CAST(
            REPLACE(TRIM(VLiqPhase), ',', '.')
            AS REAL
        ) > 0
        AND CAST(
            REPLACE(TRIM(VLiqPhase), ',', '.')
            AS REAL
        ) < 1
            THEN NULL

        -- 0 и >= 1 остаются числом
        ELSE CAST(
            REPLACE(TRIM(VLiqPhase), ',', '.')
            AS REAL
        )

    END AS VLiqPhase,


    -- ========================================================
    -- Новый LiqPhaseQualifier
    -- ========================================================
    CASE

        -- Определение для пробы не требуется
        WHEN VLiqPhase IS NULL
            THEN NULL

        -- Требовалось, но не выполнялось
        WHEN TRIM(VLiqPhase) = 'Не выполнялось'
            THEN 'Не выполнялось'

        -- Старые "Следы"
        WHEN TRIM(VLiqPhase) = 'Следы'
            THEN 'Менее 1 мл'

        -- Старые числовые значения 0 < x < 1
        WHEN CAST(
            REPLACE(TRIM(VLiqPhase), ',', '.')
            AS REAL
        ) > 0
        AND CAST(
            REPLACE(TRIM(VLiqPhase), ',', '.')
            AS REAL
        ) < 1
            THEN 'Менее 1 мл'

        -- Для нормального числового результата qualifier не нужен
        ELSE NULL

    END AS LiqPhaseQualifier,

    natureLiq,
    state,
    comment,
    deltaPopenPCT,
    PopenMPaT,
    dateTimeSync

FROM OP_results;


-- ============================================================
-- 3. Удаляем старую таблицу
-- ============================================================

DROP TABLE OP_results;


-- ============================================================
-- 4. Новую ставим на её место
-- ============================================================

ALTER TABLE OP_results_new
RENAME TO OP_results;


-- ============================================================
-- 5. Восстанавливаем уникальный индекс
-- ============================================================

CREATE UNIQUE INDEX OP_results_sampleCode_IDX
ON OP_results (sampleCode);


COMMIT;

resultIdOp переносится с прежними значениями. Поскольку новая таблица тоже INTEGER PRIMARY KEY AUTOINCREMENT, SQLite ведёт для неё sqlite_sequence; явные вставки ID учитываются при дальнейшем AUTOINCREMENT. 

