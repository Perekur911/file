def apply_theme(root, theme="dark"):
    global BG, FIELD, HEADER, FG, MUTED, BLUE, BORDER

    p = PALETTES[theme]

    BG, FIELD, HEADER = p["bg"], p["field"], p["header"]
    FG, MUTED = p["fg"], p["muted"]
    BLUE, BORDER = p["accent"], p["border"]

    COLORS.clear()
    COLORS.update(p["projects"])

    style = ttk.Style(root)

    if style.theme_use() != "clam":
        style.theme_use("clam")

    root.configure(background=BG)
    root.option_add("*Font", "{Segoe UI} 10")

    for option, value in {
        "background": FIELD,
        "foreground": FG,
        "selectBackground": p["selection"],
        "selectForeground": BLUE,
    }.items():
        root.option_add(
            "*TCombobox*Listbox." + option,
            value,
        )

    style.configure(
        ".",
        font=("Segoe UI", 10),
        background=BG,
        foreground=FG,
        bordercolor=BORDER,
        lightcolor=BORDER,
        darkcolor=BORDER,
        troughcolor=FIELD,
    )

    style.configure("TLabel", background=BG, foreground=FG)
    style.configure("TLabelframe", background=BG, bordercolor=BORDER)
    style.configure("TLabelframe.Label", background=BG, foreground=FG)

    style.configure(
        "Horizontal.TProgressbar",
        background=BLUE,
        troughcolor=FIELD,
    )

    style.configure(
        "TButton",
        padding=(10, 6),
        background=FIELD,
        foreground=FG,
    )
    style.map(
        "TButton",
        background=[("active", p["hover"])],
        foreground=[("disabled", MUTED)],
    )

    for name in ("TEntry", "TCombobox", "TSpinbox"):
        style.configure(
            name,
            fieldbackground=FIELD,
            foreground=FG,
            insertcolor=FG,
            padding=5,
            selectbackground=p["selection"],
            selectforeground=BLUE,
        )
        style.map(
            name,
            fieldbackground=[
                ("readonly", FIELD),
                ("disabled", BG),
            ],
            foreground=[("disabled", MUTED)],
            bordercolor=[("focus", BLUE)],
        )

    style.configure(
        "TNotebook",
        background=BG,
        borderwidth=0,
        tabmargins=(2, 3, 2, 0),
    )
    style.configure(
        "TNotebook.Tab",
        font=("Segoe UI", 10),
        padding=(14, 6, 14, 6),
        background=FIELD,
    )
    style.map(
        "TNotebook.Tab",
        padding=[
            ("selected", (14, 7, 14, 7)),
            ("!selected", (14, 6, 14, 6)),
        ],
        expand=[
            ("selected", (0, 0, 0, 0)),
            ("!selected", (0, 0, 0, 0)),
        ],
        background=[
            ("selected", HEADER),
            ("!selected", FIELD),
        ],
        foreground=[
            ("selected", BLUE),
            ("!selected", MUTED),
        ],
    )

    from tkinter import font as tkfont

    line_height = tkfont.Font(
        root=root,
        font=("Segoe UI", 10),
    ).metrics("linespace")

    style.configure(
        "Treeview",
        background=FIELD,
        fieldbackground=FIELD,
        foreground=FG,
        rowheight=max(30, line_height + 10),
        borderwidth=0,
    )
    style.map(
        "Treeview",
        background=[("selected", p["selection"])],
        foreground=[("selected", BLUE)],
    )

    style.configure(
        "Treeview.Heading",
        background=HEADER,
        foreground=MUTED,
        padding=(9, 8),
        relief="flat",
    )
    style.map(
        "Treeview.Heading",
        background=[("active", p["hover"])],
    )

    style.configure(
        "TaskProjects.Treeview",
        rowheight=max(49, 2 * line_height + 12),
    )

    style.configure(
        "TScrollbar",
        background=p["scroll"],
        troughcolor=FIELD,
        arrowcolor=MUTED,
        bordercolor=BORDER,
    )
    style.map(
        "TScrollbar",
        background=[("active", p["hover"])],
    )

    style.configure(
        "TCheckbutton",
        background=BG,
        foreground=FG,
        padding=5,
    )
    style.map(
        "TCheckbutton",
        background=[("active", HEADER)],
        foreground=[("disabled", MUTED)],
    )

    style.configure(
        "Muted.TLabel",
        foreground=MUTED,
    )

    style.layout(
        "Filter.TRadiobutton",
        style.layout("Toolbutton"),
    )
    style.configure(
        "Filter.TRadiobutton",
        background=FIELD,
        foreground=FG,
        padding=(10, 7),
        relief="flat",
    )
    style.map(
        "Filter.TRadiobutton",
        background=[
            ("selected", p["selection"]),
            ("active", HEADER),
        ],
        foreground=[
            ("disabled", MUTED),
            ("selected", BLUE),
        ],
    )

    # Обновляем существующие обычные Tk-виджеты.
    def update_native(widget):
        if isinstance(widget, tk.Text):
            widget.configure(
                background=FIELD,
                foreground=FG,
                insertbackground=FG,
                selectbackground=p["selection"],
                selectforeground=BLUE,
                highlightbackground=BORDER,
                highlightcolor=BLUE,
            )

        # Выпадающий список Combobox мог быть создан раньше.
        if isinstance(widget, ttk.Combobox):
            path = str(widget) + ".popdown.f.l"

            try:
                if root.tk.call("winfo", "exists", path):
                    root.tk.call(
                        path,
                        "configure",
                        "-background", FIELD,
                        "-foreground", FG,
                        "-selectbackground", p["selection"],
                        "-selectforeground", BLUE,
                    )
            except tk.TclError:
                pass

        for child in widget.winfo_children():
            update_native(child)

    update_native(root)
    return p


def apply_dark_theme(root):
    return apply_theme(root, "dark")

