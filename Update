        gorResultTable.ListColumns("sampleCode").DataBodyRange.Cells(1, 1).Value

    Debug.Print "GOR analyseNumber:", _
        gorResultTable.ListColumns("analyseNumber").DataBodyRange.Cells(1, 1).Value
End If
```

Затем сразу после цикла:

