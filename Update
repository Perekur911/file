Private Function GOR_SourceTableHasValidSampleCodes(ByVal formIndex As Long) As Boolean

    GOR_SourceTableHasValidSampleCodes = False

    Dim sheetGOR As Worksheet
    Set sheetGOR = ActiveWorkbook.Worksheets("GOR")

    If Not ListObjectExists(sheetGOR, "GOR_source_" & formIndex) Then
        Exit Function
    End If

    Dim sourceTable As ListObject
    Set sourceTable = sheetGOR.ListObjects("GOR_source_" & formIndex)

    If sourceTable.DataBodyRange Is Nothing Then
        Exit Function
    End If

    If Not ListColumnExists(sourceTable, COL_GOR_SAMPLE_CODE_DB) Then
        Exit Function
    End If

    If Not ListColumnExists(sourceTable, COL_GOR_TYPE_PH_DB) Then
        Exit Function
    End If

    Dim sampleCodeCol As Long
    Dim typePhCol As Long

    sampleCodeCol = sourceTable.ListColumns(COL_GOR_SAMPLE_CODE_DB).index
    typePhCol = sourceTable.ListColumns(COL_GOR_TYPE_PH_DB).index

    Dim rowIndex As Long
    Dim sampleCodeValue As Variant
    Dim typePhValue As Variant

    Dim sampleCodeText As String
    Dim typePhText As String

    For rowIndex = 1 To sourceTable.ListRows.count

        sampleCodeValue = sourceTable.DataBodyRange.Cells(rowIndex, sampleCodeCol).value
        typePhValue = sourceTable.DataBodyRange.Cells(rowIndex, typePhCol).value

        If IsError(sampleCodeValue) Or IsError(typePhValue) Then
            GoTo NextRow
        End If

        sampleCodeText = Trim$(CStr(sampleCodeValue))
        typePhText = Trim$(CStr(typePhValue))

        If sampleCodeText <> "" Then

            If StrComp(typePhText, "LPh", vbTextCompare) = 0 _
            Or StrComp(typePhText, "GPh", vbTextCompare) = 0 Then

                GOR_SourceTableHasValidSampleCodes = True
                Exit Function

            End If

        End If

NextRow:
    Next rowIndex

End Function

Public Function FindEmptyFormGOR() As Long

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetGOR As Worksheet
    Set sheetGOR = wb.Worksheets("GOR")

    Dim formIndex As Long
    formIndex = 1

    Do While NamedRangeExists(wb, "GOR_" & formIndex & "_sampleCode")

        If Get_GOR_FormState(formIndex) = GOR_FORM_EMPTY Then
            FindEmptyFormGOR = formIndex
            Exit Function
        End If

        formIndex = formIndex + 1

    Loop

    Call AddFormGOR

    FindEmptyFormGOR = formIndex

End Function


