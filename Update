            Case "page", _
                 "vgtot"

                If valueText <> "" _
                   And IsNumeric(fieldValue) Then

                    If CDbl(fieldValue) <= 0 Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Поле """ & fieldCaption & _
                            """ должно быть больше 0: " & _
                            rangeName, _
                            rng

                    End If

                End If

        End Select

        ' =========================================================
        ' ГРУППА 6. ЦЕЛЫЕ ЧИСЛА
        ' =========================================================

        Select Case fieldNameLower

            Case "page"

                If valueText <> "" _
                   And IsNumeric(fieldValue) Then

                    If CDbl(fieldValue) <> _
                       Fix(CDbl(fieldValue)) Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Поле """ & fieldCaption & _
                            """ должно содержать целое число: " & _
                            rangeName, _
                            rng

                    End If

                End If

        End Select

        ' =========================================================
        ' ГРУППА 7. ЛОГИЧЕСКИЕ ПОЛЯ TRUE/FALSE
        ' =========================================================

        Select Case fieldNameLower

            Case "correct"

                If valueText <> "" Then

                    If VarType(fieldValue) <> vbBoolean Then

                        Select Case LCase$(valueText)

                            Case "true", _
                                 "false", _
                                 "истина", _
                                 "ложь", _
                                 "1", _
                                 "0", _
                                 "да", _
                                 "нет", _
                                 "+", _
                                 "-"

                                ' Допустимое логическое значение.

                            Case Else

                                AddValidationError _
                                    errors, _
                                    errorCount, _
                                    "Поле """ & fieldCaption & _
                                    """ должно содержать значение " & _
                                    "True/False: " & rangeName, _
                                    rng

                        End Select

                    End If

                End If

        End Select

        ' =========================================================
        ' ГРУППА 8. ПОЛЯ С ДАТОЙ
        ' =========================================================

        Select Case fieldNameLower

            Case "datestart", _
                 "dateend"

                If valueText <> "" Then

                    If Not IsDate(fieldValue) Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Поле """ & fieldCaption & _
                            """ должно содержать дату: " & _
                            rangeName, _
                            rng

                    End If

                End If

        End Select

        ' =========================================================
        ' ГРУППА 9. ПОЛЯ СО ВРЕМЕНЕМ
        ' =========================================================

        Select Case fieldNameLower

            Case "timestart", _
                 "timeend"

                If valueText <> "" Then

                    If Not valueCell.text Like "##:##" _
                       And Not valueCell.text Like "#:##" Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Поле """ & fieldCaption & _
                            """ должно содержать время " & _
                            "в формате ЧЧ:ММ: " & rangeName, _
                            rng

                    End If

                End If

        End Select

        ' =========================================================
        ' ГРУППА 10. ПОЛЯ ВВОДА ИСПОЛНИТЕЛЯ
        ' =========================================================

        Select Case fieldNameLower

            Case "operator"

                If valueText <> "" Then

                    If Not IsValidExecutor(fieldValue) Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Неверно указан исполнитель: " & _
                            rangeName, _
                            rng

                    End If

                End If

        End Select

        ' =========================================================
        ' ГРУППА 11. ТЕМПЕРАТУРНЫЕ ПОЛЯ
        ' =========================================================

        Select Case fieldNameLower

            Case "tfact", _
                 "t"

                If valueText <> "" _
                   And IsNumeric(fieldValue) Then

                    If CDbl(fieldValue) < -20 _
                       Or CDbl(fieldValue) > 140 Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Поле """ & fieldCaption & _
                            """ должно находиться в диапазоне " & _
                            "от -20 до 140 °C: " & rangeName, _
                            rng

                    End If

                End If

        End Select

        ' =========================================================
        ' ГРУППА 12. ПОЛЯ С ЗАДАННЫМ ФОРМАТОМ ТЕКСТА
        ' =========================================================

        Select Case fieldNameLower

            Case "ppic"

                If valueText <> "" Then

                    If Not valueText Like "20##-P##" Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Поле """ & fieldCaption & _
                            """ должно иметь формат 20##-P##: " & _
                            rangeName, _
                            rng

                    End If

                End If

        End Select

        ' =========================================================
        ' ГРУППА 13. КОЛИЧЕСТВО ПОЛУЧЕННЫХ ПРОБ
        '
        ' Допускаются:
        '   - целое число >= 0;
        '   - символ "-".
        ' =========================================================

        Select Case fieldNameLower

            Case "vial", _
                 "bottle", _
                 "pics"

                countFieldsSeen = countFieldsSeen + 1

                If valueText <> "" Then

                    If Not IsNumeric(fieldValue) Then

                        If valueText <> "-" Then

                            AddValidationError _
                                errors, _
                                errorCount, _
                                "Поле """ & fieldCaption & _
                                """ должно содержать целое число " & _
                                "или символ ""-"": " & rangeName, _
                                rng

                        End If

                    ElseIf CDbl(fieldValue) < 0 Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Поле """ & fieldCaption & _
                            """ не может быть отрицательным: " & _
                            rangeName, _
                            rng

                    ElseIf CDbl(fieldValue) <> _
                           Fix(CDbl(fieldValue)) Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Поле """ & fieldCaption & _
                            """ должно содержать целое число: " & _
                            rangeName, _
                            rng

                    ElseIf CDbl(fieldValue) > 0 Then

                        Select Case fieldNameLower

                            Case "vial"
                                hasVialCount = True

                            Case "bottle"
                                hasBottleCount = True

                            Case "pics"
                                hasPicsCount = True

                        End Select

                    End If

                End If

        End Select

next_header:
