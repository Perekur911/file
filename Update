Private Function JoinVariantArray( _
    ByVal arr As Variant, _
    Optional ByVal separator As String = " " _
) As String

    Dim parts() As String
    Dim i As Long
    Dim n As Long

    ReDim parts(0 To UBound(arr) - LBound(arr))

    For i = LBound(arr) To UBound(arr)
        parts(n) = UCase$(Trim$(CStr(arr(i))))
        n = n + 1
    Next i

    JoinVariantArray = JOIN(parts, separator)

End Function


Private Sub LoadStudyForms( _
    ByVal wb As Workbook, _
