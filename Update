3. В VBA, в модуле equipment, замени только процедуру createMnemonicTabless.

getEquipmentNumbers, getEquipmentModels и sortStringArray оставь.

В твоей старой createMnemonicTabless есть ошибка на одну строку в циклах добавления/удаления строк. Ниже размер задаётся сразу, а сами номера по-прежнему берутся твоей функцией.

Вставь эту процедуру и две вспомогательные функции:

Public Sub createMnemonicTabless()
    Dim ws As Worksheet
    Set ws = ActiveWorkbook.Worksheets("Пересчет")

    Dim targets As Object
    Set targets = CreateObject("Scripting.Dictionary")
    targets.CompareMode = vbTextCompare

    Dim cell As Range, tbl As ListObject
    Dim mnemonic As String, key As Variant

    Dim source As Range
    Set source = ws.ListObjects("modelsEquipment") _
                   .ListColumns("mnemonicName").DataBodyRange

    If source Is Nothing Then Exit Sub

    ' Сначала находим все исходные таблицы.
    For Each cell In source.Cells
        mnemonic = Trim$(CStr(cell.Value2))

        If Len(mnemonic) > 0 Then
            If Not targets.Exists(mnemonic) Then
                Set tbl = FindEquipmentNumberTable(ws, mnemonic)

                If tbl Is Nothing Then
                    Err.Raise vbObjectError + 4820, _
                              "createMnemonicTabless", _
                              "Не найдена исходная таблица оборудования: " & mnemonic
                End If

                If tbl.ListColumns.Count <> 1 Then
                    Err.Raise vbObjectError + 4821, _
                              "createMnemonicTabless", _
                              "Таблица " & mnemonic & _
                              " должна содержать один столбец."
                End If

                If StrComp(tbl.ListColumns(1).Name, _
                           mnemonic, vbTextCompare) <> 0 Then

                    Err.Raise vbObjectError + 4822, _
                              "createMnemonicTabless", _
                              "Неожиданный заголовок таблицы " & mnemonic
                End If

                targets.Add mnemonic, tbl
            End If
        End If
    Next cell

    Dim numbers() As String
    Dim values() As Variant

    Dim count As Long, dataRows As Long, j As Long
    Dim oldBottom As Long, newBottom As Long, column As Long
    Dim newRange As Range

    For Each key In targets.Keys
        Set tbl = targets(key)

        numbers = getEquipmentNumbers(CStr(key))
        count = EquipmentNumberCount(numbers)

        If count > 1 Then sortStringArray numbers

        dataRows = count
        If dataRows = 0 Then dataRows = 1

        ReDim values(1 To dataRows, 1 To 1)

        For j = 1 To count
            values(j, 1) = numbers(LBound(numbers) + j - 1)
        Next j

        oldBottom = tbl.Range.Row + tbl.Range.Rows.Count - 1
        column = tbl.Range.Column

        Set newRange = tbl.HeaderRowRange.Cells(1, 1).Resize( _
            dataRows + 1 + IIf(tbl.ShowTotals, 1, 0), 1)

        newBottom = newRange.Row + newRange.Rows.Count - 1

        If tbl.ListRows.Count <> dataRows Then
            tbl.Resize newRange
        End If

        If oldBottom > newBottom Then
            ws.Range( _
                ws.Cells(newBottom + 1, column), _
                ws.Cells(oldBottom, column) _
            ).ClearContents
        End If

        tbl.DataBodyRange.NumberFormat = "@"
        tbl.DataBodyRange.Value2 = values
    Next key
End Sub


Private Function FindEquipmentNumberTable( _
    ByVal ws As Worksheet, _
    ByVal mnemonic As String _
) As ListObject

    Dim tbl As ListObject

    For Each tbl In ws.ListObjects
        If StrComp(tbl.Name, mnemonic, vbTextCompare) = 0 _
           Or StrComp(tbl.DisplayName, mnemonic, vbTextCompare) = 0 Then

            Set FindEquipmentNumberTable = tbl
            Exit Function
        End If
    Next tbl

    ' У исходных CSB-IB и КПП-1 DisplayName содержит подчёркивание.
    Dim aliasName As String
    aliasName = Replace(mnemonic, "-", "_")

    For Each tbl In ws.ListObjects
        If StrComp(tbl.Name, aliasName, vbTextCompare) = 0 _
           Or StrComp(tbl.DisplayName, aliasName, vbTextCompare) = 0 Then

            Set FindEquipmentNumberTable = tbl
            Exit Function
        End If
    Next tbl
End Function


Private Function EquipmentNumberCount( _
    ByRef numbers() As String _
) As Long

    On Error Resume Next
    EquipmentNumberCount = UBound(numbers) - LBound(numbers) + 1
    On Error GoTo 0
End Function

Эта версия сохраняет имена таблиц и заголовки. Если исходная таблица отсутствует, она сообщит её название. В проверенном шаблоне все необходимые таблицы есть.

В тот же модуль equipment добавь процедуру завершения обновления:

Public Sub CompleteEquipmentCatalogRefresh( _
    ByVal wb As Workbook, _
    ByVal catalogHash As String, _
    Optional ByVal saveWorkbook As Boolean = True _
)
    If wb Is Nothing Then
        Err.Raise vbObjectError + 4830, , _
                  "Не указана книга проекта."
    End If

    If Len(Trim$(catalogHash)) = 0 Then
        Err.Raise vbObjectError + 4831, , _
                  "Python не вернул хэш справочника."
    End If

    Dim previousBook As Workbook
    Dim previousSheet As Object

    Set previousBook = Application.ActiveWorkbook
    Set previousSheet = Application.ActiveSheet

    Dim oldCalculation As XlCalculation
    Dim oldEvents As Boolean, oldScreen As Boolean

    oldCalculation = Application.Calculation
    oldEvents = Application.EnableEvents
    oldScreen = Application.ScreenUpdating

    Dim previousHash As String
    previousHash = GetWorkbookMetadataProperty( _
        wb, "EquipmentCatalogHash")

    Dim unprotected As New Collection
    Dim sheetName As Variant, ws As Worksheet

    Dim errNumber As Long
    Dim errSource As String
    Dim errText As String

    On Error GoTo Failed

    Application.EnableEvents = False
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual

    wb.Activate

    For Each sheetName In Array( _
        "Пересчет", "AP", "BP", "EMV", "GC", _
        "GOR", "SSF", "Rec", "JOIN", "OPOH", "OP", "PD" _
    )
        Set ws = wb.Worksheets(CStr(sheetName))

        If ws.ProtectContents Then
            ws.Unprotect Password:="1984"
            unprotected.Add ws
        End If
    Next sheetName

    ' Заполняем существующие таблицы номерами оборудования.
    createMnemonicTabless

    ' Обновляем выбор моделей существующими процедурами.
    equipmentModelsRefreshAP
    equipmentModelsRefreshBP
    equipmentModelsRefreshEMV
    equipmentModelsRefreshGC
    equipmentModelsRefreshGOR
    equipmentModelsRefreshSSF
    equipmentModelsRefreshRec
    equipmentModelsRefreshJOIN
    equipmentModelsRefreshOPOH

    If Not wb.Worksheets("OP").ListObjects("Lab_samples") _
             .DataBodyRange Is Nothing Then
        equipmentModelsRefreshOP
    End If

    equipmentModelsRefreshPD

    RemoveObsoleteEquipmentModelTables wb

    ' Возвращаем защиту только тем листам, с которых сняли её здесь.
    Do While unprotected.Count > 0
        Set ws = unprotected(1)

        ws.Protect Password:="1984", _
                   UserInterfaceOnly:=True, _
                   AllowFiltering:=True

        unprotected.Remove 1
    Loop

    ' Подтверждаем хэш после заполнения списков.
    SetWorkbookMetadataProperty _
        wb, "EquipmentCatalogHash", catalogHash, False

    If saveWorkbook Then wb.Save

CleanExit:
    On Error Resume Next

    For Each ws In unprotected
        ws.Protect Password:="1984", _
                   UserInterfaceOnly:=True, _
                   AllowFiltering:=True
    Next ws

    If Not previousBook Is Nothing Then previousBook.Activate
    If Not previousSheet Is Nothing Then previousSheet.Activate

    Application.Calculation = oldCalculation
    Application.EnableEvents = oldEvents
    Application.ScreenUpdating = oldScreen

    On Error GoTo 0

    If errNumber <> 0 Then
        Err.Raise errNumber, errSource, errText
    End If

    Exit Sub

Failed:
    errNumber = Err.Number
    errSource = Err.Source
    errText = Err.Description

    On Error Resume Next

    SetWorkbookMetadataProperty _
        wb, "EquipmentCatalogHash", previousHash, False

    On Error GoTo 0
    GoTo CleanExit
End Sub

И сразу после неё добавь очистку созданных предыдущей реализацией таблиц eqModels_*:

Private Sub RemoveObsoleteEquipmentModelTables(ByVal wb As Workbook)
    Dim ws As Worksheet
    Dim tbl As ListObject
    Dim area As Range
    Dim i As Long

    Set ws = wb.Worksheets("Пересчет")

    For i = ws.ListObjects.Count To 1 Step -1
        Set tbl = ws.ListObjects(i)

        If LCase$(Left$(tbl.Name, 9)) = "eqmodels_" Then
            If tbl.ListColumns.Count = 1 Then
                If LCase$(tbl.ListColumns(1).Name) = "model" Then
                    Set area = tbl.Range
                    tbl.Unlist
                    area.Clear
                End If
            End If
        End If
    Next i
End Sub

Она удаляет только эти вспомогательные таблицы и очищает их собственный диапазон, без сдвига ячеек. Перед этим существующие VBA-процедуры возвращают источники списков моделей на формах.

