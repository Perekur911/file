Public Function cancelCurrentTaskGOR() As macroResult
    
    cancelCurrentTaskGOR = MACRO_FAILED
    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetGOR As Worksheet
    Set sheetGOR = wb.Worksheets("GOR")
    
    Dim lenght As Integer
    lenght = sheetGOR.Range("GOR_2_sampleCode").Column - sheetGOR.Range("GOR_1_sampleCode").Column
    
    Dim curFormIndex As Integer
    curFormIndex = (ActiveCell.Column - GOR_FIRST_FORM_FIRST_COL) \ lenght + 1
    
    Dim taskCell As Range
    Set taskCell = sheetGOR.Range("GOR_" & curFormIndex & "_taskId")
    
    Dim answer As Integer
    
    answer = MsgBox("Âû äåéñòâèòåëüíî õîòèòå óäàëèòü çàäàíèå ¹" & taskCell.value & "?", vbQuestion + vbYesNo, "Ïîäòâåðæäåíèå")
    
    If answer <> vbYes Then
        cancelCurrentTaskGOR = MACRO_NO_CHANGES
        Exit Function
    End If
    
    Dim comment As String
    comment = InputBox("Ââåäèòå ïðè÷èíó îòìåíû:", "Îêíî ââîäà")
    
    Dim syncResult As String
    syncResult = SetTaskStatusOnly(taskCell.value, "GOR", "Îòìåíà", comment)

    If InStr(1, syncResult, """ok"": true", vbTextCompare) > 0 Then
        With taskCell.MergeArea
            .Interior.ColorIndex = 3
            If .Locked = False Then
                .Locked = True
            End If
        End With
        cancelCurrentTaskGOR = MACRO_CHANGED
        
    ElseIf syncResult = "NoComment" Or syncResult = "NoTaskId" Then
        cancelCurrentTaskGOR = MACRO_NO_CHANGES
        
    End If
End Function

