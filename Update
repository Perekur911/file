Public Function Save_CVD(Optional ByVal taskStatus As String = "") As macroResult

    Save_CVD = MACRO_FAILED

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetCVD As Worksheet
    Set sheetCVD = wb.Worksheets("CVD")

    Dim sheetCVDResult As Worksheet
    Set sheetCVDResult = wb.Worksheets("CVD_results")

    Dim sheetCVDSourceData As Worksheet
    Set sheetCVDSourceData = wb.Worksheets("CVD_sourceData")

    Dim tasks As ListObject
    Set tasks = wb.Worksheets("Task").ListObjects(1)

    Dim CVDTable As ListObject
    Set CVDTable = sheetCVDResult.ListObjects("CVD_results")

    Dim CVDSourceDataTable As ListObject
    Set CVDSourceDataTable = sheetCVDSourceData.ListObjects("CVD_sourceData")

    Dim parentRows As Collection
    Set parentRows = New Collection

    Dim childRows As Collection
    Set childRows = New Collection

    Dim validForms As Collection
    Set validForms = New Collection

    Dim formState As CVDFormState
    Dim i As Long
    Dim stepIndex As Long
    Dim stepKey As String
    Dim steps As Variant

    steps = CVD_StepKeys()

    i = 1

    Do While NamedRangeExists(wb, "CVD_" & i & "_sampleCode")

        formState = Get_CVD_FormState(i)

        Select Case formState

            Case CVD_FORM_EMPTY
                GoTo NextFormFirstPass

            Case CVD_FORM_RESERVED
                GoTo NextFormFirstPass

            Case CVD_FORM_FILLED
                ' идём дальше

        End Select

        If NamedRangeExists(wb, "CVD_" & i & "_TaskId") Then
            If sheetCVD.Range("CVD_" & i & "_TaskId").Interior.ColorIndex = 3 Then
                GoTo NextFormFirstPass
            End If
        End If

        If sheetCVD.Range("CVD_" & i & "_analyseNumber").value = "" Then
            Call checkNumberAnalys2(sheetCVD.Range("CVD_" & i & "_sampleCode").value, "CVD")
        End If

        Dim curTask As Variant
        curTask = sheetCVD.Range("CVD_" & i & "_TaskId").value

        If Len(Trim$(CStr(curTask))) > 0 And CLng(val(curTask)) <> 0 Then
            If Not CheckCVDTask(tasks, CLng(val(curTask)), CStr(sheetCVD.Range("CVD_" & i & "_sampleCode").value), i) Then
                GoTo NextFormFirstPass
            End If
        End If

        ' Для каждого непустого step:
        ' если sampleCodeLPh и sampleCodeGPh оба пустые — вызываем создание шифров.
        For stepIndex = LBound(steps) To UBound(steps)

            stepKey = CStr(steps(stepIndex))

            If CVD_StepHasData(i, stepKey) Then

                Dim lphRangeName As String
                Dim gphRangeName As String

                lphRangeName = "CVD_" & i & "_" & stepKey & "_sampleCodeLPh"
                gphRangeName = "CVD_" & i & "_" & stepKey & "_sampleCodeGPh"

                If NamedRangeExists(wb, lphRangeName) And NamedRangeExists(wb, gphRangeName) Then

                    If Trim$(CStr(sheetCVD.Range(lphRangeName).value)) = "" _
                       And Trim$(CStr(sheetCVD.Range(gphRangeName).value)) = "" Then

                        Application.ScreenUpdating = True
                        DoEvents
                        Application.ScreenUpdating = False

                        If Not CreateSampleCodeCVD3(i, stepKey) Then
                            GoTo NextFormFirstPass
                        End If

                    End If

                End If

            End If

        Next stepIndex

        If Not Validate_CVD_Form(i) Then
            Exit Function
        End If

        validForms.Add i

NextFormFirstPass:
        i = i + 1
    Loop

    Dim pageValue As Variant

    For Each pageValue In validForms

        i = CLng(pageValue)

        Dim resultIdValue As Variant
        Dim parentKey As String

        resultIdValue = sheetCVD.Range("CVD_" & i & "_resultIdCVD").value

        If Len(NormalizeKeyValue(resultIdValue)) = 0 Or NormalizeKeyValue(resultIdValue) = "0" Then
            parentKey = "temp_" & i
        Else
            parentKey = NormalizeKeyValue(resultIdValue)
        End If

        Dim parentRow() As Variant
        ReDim parentRow(1 To CVDTable.ListColumns.count)

        Dim headerCell As Range
        Dim headerName As String
        Dim parentColIndex As Long
        Dim formRangeName As String

        For Each headerCell In CVDTable.HeaderRowRange.Cells

            headerName = CStr(headerCell.value)
            parentColIndex = CVDTable.ListColumns(headerName).index
            formRangeName = "CVD_" & i & "_" & headerName

            If headerName = "dateTimeSync" Then
                parentRow(parentColIndex) = Format$(Now, "yyyy-mm-dd hh:nn:ss")

            ElseIf headerName = COL_CVD_RESULT_ID_DB Then
                parentRow(parentColIndex) = parentKey

            ElseIf NamedRangeExists(wb, formRangeName) Then
                parentRow(parentColIndex) = FormatValueForSyncText( _
                    headerName, _
                    sheetCVD.Range(formRangeName).value _
                )

            Else
                parentRow(parentColIndex) = vbNullString

            End If

        Next headerCell

        parentRows.Add parentRow

        For stepIndex = LBound(steps) To UBound(steps)

            stepKey = CStr(steps(stepIndex))

            Dim hasStepData As Boolean
            hasStepData = CVD_StepHasData(i, stepKey)

            Dim oldRowIdCVD As String
            oldRowIdCVD = vbNullString

            Dim rowIdRangeName As String
            rowIdRangeName = "CVD_" & i & "_" & stepKey & "_rowIdCVD"

            If NamedRangeExists(wb, rowIdRangeName) Then
                oldRowIdCVD = NormalizeKeyValue(sheetCVD.Range(rowIdRangeName).value)
            End If

            ' Добавляем child-строку, если:
            ' 1) step заполнен — insert/update;
            ' 2) step очищен, но rowIdCVD остался — delete.
            If hasStepData Or Len(oldRowIdCVD) > 0 Then

                Dim childRow() As Variant
                ReDim childRow(1 To CVDSourceDataTable.ListColumns.count)

                Dim childHeaderCell As Range
                Dim childHeaderName As String
                Dim childColIndex As Long
                Dim childRangeName As String

                For Each childHeaderCell In CVDSourceDataTable.HeaderRowRange.Cells

                    childHeaderName = CStr(childHeaderCell.value)
                    childColIndex = CVDSourceDataTable.ListColumns(childHeaderName).index

                    Select Case childHeaderName

                        Case COL_CVD_ROW_ID_DB
                            childRow(childColIndex) = oldRowIdCVD

                        Case COL_CVD_RESULT_ID_DB
                            childRow(childColIndex) = parentKey

                        Case COL_CVD_STEP_DB
                            If hasStepData Then
                                childRow(childColIndex) = CStr(stepIndex + 1)
                            Else
                                childRow(childColIndex) = vbNullString
                            End If

                        Case Else

                            If hasStepData Then

                                childRangeName = "CVD_" & i & "_" & stepKey & "_" & childHeaderName

                                If NamedRangeExists(wb, childRangeName) Then
                                    childRow(childColIndex) = FormatValueForSyncText( _
                                        childHeaderName, _
                                        sheetCVD.Range(childRangeName).value _
                                    )
                                Else
                                    childRow(childColIndex) = vbNullString
                                End If

                            Else
                                childRow(childColIndex) = vbNullString
                            End If

                    End Select

                Next childHeaderCell

                childRows.Add childRow

            End If

        Next stepIndex

    Next pageValue

    WriteCollectionToListObject CVDTable, parentRows
    WriteCollectionToListObject CVDSourceDataTable, childRows

    If parentRows.count > 0 Then

        Dim syncTaskStatus As String

        If Trim$(taskStatus) <> "" Then
            syncTaskStatus = taskStatus
        Else
            syncTaskStatus = CVD_CalculateCommonTaskStatus(validForms)
        End If

        Dim syncResult As String
        syncResult = RunStudySync("save", studies:="CVD", taskStatus:=syncTaskStatus)

        If InStr(1, syncResult, """ok"": true", vbTextCompare) > 0 Then

            Call DeleteEmptyRowsByColumns( _
                CVDSourceDataTable, _
                COL_CVD_ROW_ID_DB, _
                Array(COL_CVD_STEP_DB) _
            )

            Call Load_CVD_results_to_forms( _
                "by_key", _
                Array(COL_CVD_RESULT_ID_DB, COL_CVD_ROW_ID_DB) _
            )

            Save_CVD = MACRO_CHANGED

        Else
            MsgBox "Синхронизация CVD не подтверждена как успешная." & vbCrLf & vbCrLf & syncResult, vbExclamation
        End If

    Else
        Save_CVD = MACRO_NO_CHANGES
    End If

End Function
```

