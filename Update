Public Sub LoadResearchesFromDB( _
    Optional ByVal studies As Variant, _
    Optional ByVal projectNumber As String = "", _
    Optional ByVal formFillMode As String = "sequential" _
)

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    If wb Is Nothing Then
        Err.Raise vbObjectError + 1101, , "Íåò àêòèâíîé êíèãè ñ äàííûìè"
    End If
    
    If wb.name = ThisWorkbook.name Then
        Err.Raise vbObjectError + 1102, , "Àêòèâíà êíèãà-íàäñòðîéêà, à íå êíèãà ñ äàííûìè"
    End If
    
    If Len(wb.path) = 0 Then
        Err.Raise vbObjectError + 1103, , "Êíèãà ñ äàííûìè äîëæíà áûòü ñîõðàíåíà ïåðåä çàãðóçêîé"
    End If

    Dim project As String
    
    If Len(Trim$(projectNumber)) > 0 Then
        project = Trim$(projectNumber)
    Else
        project = GetCurrentProject(wb)
    End If

    Dim studiesArr As Variant
    
    If IsMissing(studies) Then
        studiesArr = DefaultStudies()
    Else
        studiesArr = NormalizeStudiesOrDefault(studies)
    End If

    Dim studiesText As String
    studiesText = JoinVariantArray(studiesArr, " ")
    
    formFillMode = LCase$(Trim$(formFillMode))
    
    If formFillMode <> "sequential" And formFillMode <> "by_key" Then
        Err.Raise vbObjectError + 1104, , "formFillMode äîëæåí áûòü 'sequential' èëè 'by_key'"
    End If

    Dim macroStarted As Boolean
    Dim syncResult As String
    
    On Error GoTo CleanFail

    StartMacro wb, studiesArr, True
    macroStarted = True

    syncResult = RunStudySync( _
        mode:="load", _
        projectNumber:=project, _
        studies:=studiesText _
    )

    If InStr(1, syncResult, """ok"": true", vbTextCompare) = 0 Then
        MsgBox "Çàãðóçêà èç ÁÄ íå ïîäòâåðæäåíà êàê óñïåøíàÿ." & vbCrLf & vbCrLf & _
               syncResult, vbExclamation
        GoTo CleanExit
    End If

    Dim i As Long
    Dim studyCode As String

    For i = LBound(studiesArr) To UBound(studiesArr)
        studyCode = UCase$(Trim$(CStr(studiesArr(i))))
        LoadStudyForms wb, studyCode, formFillMode
    Next i

CleanExit:
    If macroStarted Then
        EndMacro wb, studiesArr, True
    End If
    Exit Sub

CleanFail:
    Dim errNumber As Long
    Dim errSource As String
    Dim errDescription As String

    errNumber = Err.Number
    errSource = Err.Source
    errDescription = Err.Description

    On Error Resume Next
    If macroStarted Then
        EndMacro wb, studiesArr, True
    End If
    On Error GoTo 0

    Err.Raise errNumber, errSource, errDescription

End Sub

