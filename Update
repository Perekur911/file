Public Sub Load_CVD_results_to_forms( _
    Optional ByVal mode As String = "by_key", _
    Optional ByVal fields As Variant _
)

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetCVD As Worksheet
    Set sheetCVD = wb.Worksheets("CVD")

    Dim resultTable As ListObject
    Set resultTable = wb.Worksheets("CVD_results").ListObjects("CVD_results")

    Dim sourceTable As ListObject
    Set sourceTable = wb.Worksheets("CVD_sourceData").ListObjects("CVD_sourceData")

    Dim fieldFilter As Object
    Set fieldFilter = BuildFieldFilter(fields)

    mode = LCase$(Trim$(mode))

    If mode <> "by_key" And mode <> "sequential" Then
        Err.Raise vbObjectError + 7101, , "mode должен быть 'by_key' или 'sequential'"
    End If

    If resultTable.DataBodyRange Is Nothing Then Exit Sub

    Dim resultRowIndex As Long
    Dim formIndex As Long
    Dim notFoundCount As Long

    For resultRowIndex = 1 To resultTable.ListRows.count

        If mode = "sequential" Then
            formIndex = resultRowIndex
            EnsureCVDFormExists wb, formIndex
        Else
            formIndex = FindFormIndexForResultRow( _
                wb, _
                sheetCVD, _
                resultTable, _
                resultRowIndex, _
                "CVD", _
                Array("sampleCode", "analyseNumber") _
            )
        End If

        If formIndex = 0 Or Not NamedRangeExists(wb, "CVD_" & formIndex & "_sampleCode") Then
            notFoundCount = notFoundCount + 1
            GoTo NextResultRow
        End If

        FillOneCVDFormFromResultRow _
            wb, _
            sheetCVD, _
            resultTable, _
            sourceTable, _
            resultRowIndex, _
            formIndex, _
            fieldFilter

NextResultRow:
    Next resultRowIndex

    If notFoundCount > 0 Then
        MsgBox "Данные CVD перенесены частично. Не найдено форм: " & notFoundCount, vbExclamation
    End If

End Sub


Private Sub EnsureCVDFormExists( _
    ByVal wb As Workbook, _
    ByVal formIndex As Long _
)

    Do While Not NamedRangeExists(wb, "CVD_" & formIndex & "_sampleCode")
        Call InsertListCVD2
    Loop

End Sub


Private Sub FillOneCVDFormFromResultRow( _
    ByVal wb As Workbook, _
    ByVal sheetCVD As Worksheet, _
    ByVal resultTable As ListObject, _
    ByVal sourceTable As ListObject, _
    ByVal resultRowIndex As Long, _
    ByVal formIndex As Long, _
    ByVal fieldFilter As Object _
)

    Dim resultId As Variant
    resultId = GetTableValue(resultTable, resultRowIndex, COL_CVD_RESULT_ID_DB)

    Call CopyTableRowToNamedRanges( _
        wb, _
        sheetCVD, _
        resultTable, _
        resultRowIndex, _
        "CVD", _
        formIndex, _
        fieldFilter _
    )

    If Len(NormalizeKeyValue(resultId)) > 0 Then
        FillCVDSourceRangesFromSourceData sheetCVD, sourceTable, formIndex, resultId, fieldFilter
    End If

End Sub


Private Sub FillCVDSourceRangesFromSourceData( _
    ByVal sheetCVD As Worksheet, _
    ByVal sourceTable As ListObject, _
    ByVal formIndex As Long, _
    ByVal resultId As Variant, _
    ByVal fieldFilter As Object _
)

    If sourceTable.DataBodyRange Is Nothing Then Exit Sub

    Dim rowIndex As Long
    Dim headerCell As Range
    Dim headerName As String
    Dim stepValue As Variant
    Dim stepKey As String
    Dim rangeName As String

    ' Сначала чистим все CVD_N_st*_поля по колонкам sourceData,
    ' кроме случаев, когда загружали только отдельные id.
    Dim steps As Variant
    Dim stepIndex As Long
    steps = CVD_StepKeys()

    For stepIndex = LBound(steps) To UBound(steps)

        stepKey = CStr(steps(stepIndex))

        For Each headerCell In sourceTable.HeaderRowRange.Cells

            headerName = CStr(headerCell.value)

            If headerName = COL_CVD_RESULT_ID_DB Then
                GoTo NextClearHeader
            End If

            rangeName = "CVD_" & formIndex & "_" & stepKey & "_" & headerName

            If NamedRangeExists(ActiveWorkbook, rangeName) Then
                If fieldFilter Is Nothing Or fieldFilter.Exists(headerName) Then
                    sheetCVD.Range(rangeName).value = vbNullString
                End If
            End If

NextClearHeader:
        Next headerCell

    Next stepIndex

    For rowIndex = 1 To sourceTable.ListRows.count

        If NormalizeKeyValue(GetTableValue(sourceTable, rowIndex, COL_CVD_RESULT_ID_DB)) <> NormalizeKeyValue(resultId) Then
            GoTo NextSourceRow
        End If

        stepValue = GetTableValue(sourceTable, rowIndex, COL_CVD_STEP_DB)
        stepKey = CVD_StepKeyFromDbValue(stepValue)

        If stepKey = "" Then
            GoTo NextSourceRow
        End If

        For Each headerCell In sourceTable.HeaderRowRange.Cells

            headerName = CStr(headerCell.value)
            rangeName = "CVD_" & formIndex & "_" & stepKey & "_" & headerName

            If NamedRangeExists(ActiveWorkbook, rangeName) Then

                If fieldFilter Is Nothing Or fieldFilter.Exists(headerName) Then
                    sheetCVD.Range(rangeName).value = GetTableValue(sourceTable, rowIndex, headerName)
                End If

            End If

        Next headerCell

NextSourceRow:
    Next rowIndex

End Sub
```

