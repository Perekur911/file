Вот макрос. Он:

* работает с указанным листом;
* перебирает только имена уровня книги;
* берёт только имена, относящиеся к этому листу;
* выбирает левую верхнюю ячейку именованного диапазона;
* переходит на 10 физических столбцов вправо через `Cells(row, column + 10)`;
* создаёт имя, заменяя `_1_` на `_2_`;
* не использует `Offset`, поэтому ширина объединённых ячеек не влияет.

```vba
Public Sub CreateShiftedNamedRanges()

    Const SHEET_NAME As String = "CVD"
    Const COLUMN_SHIFT As Long = 10

    Dim wb As Workbook
    Dim ws As Worksheet
    Dim nm As Name
    Dim sourceRange As Range
    Dim targetRange As Range

    Dim sourceName As String
    Dim targetName As String

    Dim namesToCreate As Collection
    Dim item As Variant

    Set wb = ThisWorkbook
    Set ws = wb.Worksheets(SHEET_NAME)
    Set namesToCreate = New Collection

    ' Сначала собираем все имена.
    ' Нельзя безопасно добавлять новые имена прямо во время перебора wb.Names.
    For Each nm In wb.Names

        ' Имена уровня листа содержат "!".
        ' Нам нужны только имена уровня книги.
        If InStr(1, nm.Name, "!", vbTextCompare) = 0 Then

            Set sourceRange = Nothing

            On Error Resume Next
            Set sourceRange = nm.RefersToRange
            On Error GoTo 0

            If Not sourceRange Is Nothing Then

                ' Проверяем, что имя относится именно к указанному листу.
                If sourceRange.Worksheet Is ws Then

                    sourceName = nm.Name

                    ' Берём только имена, содержащие "_1_".
                    If InStr(1, sourceName, "_1_", vbTextCompare) > 0 Then

                        targetName = Replace( _
                            Expression:=sourceName, _
                            Find:="_1_", _
                            Replace:="_2_", _
                            Compare:=vbTextCompare _
                        )

                        ' Смещение именно по номеру столбца,
                        ' независимо от объединения ячеек.
                        If sourceRange.Cells(1, 1).Column + COLUMN_SHIFT _
                                <= ws.Columns.Count Then

                            Set targetRange = ws.Cells( _
                                sourceRange.Cells(1, 1).Row, _
                                sourceRange.Cells(1, 1).Column + COLUMN_SHIFT _
                            )

                            namesToCreate.Add Array( _
                                targetName, _
                                targetRange.Address( _
                                    RowAbsolute:=True, _
                                    ColumnAbsolute:=True, _
                                    ReferenceStyle:=xlA1, _
                                    External:=True _
                                ) _
                            )

                        End If
                    End If
                End If
            End If
        End If
    Next nm

    ' Создаём новые имена уровня книги.
    For Each item In namesToCreate

        targetName = CStr(item(0))

        ' Если имя уже существует, удаляем его.
        On Error Resume Next
        wb.Names(targetName).Delete
        On Error GoTo 0

        wb.Names.Add _
            Name:=targetName, _
            RefersTo:="=" & CStr(item(1))

    Next item

    MsgBox "Создано именованных диапазонов: " & namesToCreate.Count, _
           vbInformation

End Sub
```

Название листа указывается здесь:

```vba
Const SHEET_NAME As String = "CVD"
```

Например, если исходное имя:

```text
CVD_1_st1_Ppic
```

и оно ссылается на `D15`, новое имя будет:

```text
CVD_2_st1_Ppic
```

и будет ссылаться на `N15`, то есть ровно на 10 номеров столбцов правее. Даже если `D15` входит в объединённый диапазон `D15:F15`, отсчёт всё равно пойдёт от столбца `D`, а не от правой границы объединения.
