```python
def format_date_range(min_date: Any, max_date: Any) -> str | None:
    min_date = normalize_excel_date(min_date)
    max_date = normalize_excel_date(max_date)

    if min_date is None and max_date is None:
        return None

    if min_date is None:
        return max_date.strftime("%d.%m.%Y")

    if max_date is None:
        return min_date.strftime("%d.%m.%Y")

    min_text = min_date.strftime("%d.%m.%Y")
    max_text = max_date.strftime("%d.%m.%Y")

    if min_text == max_text:
        return min_text

    return f"{min_text} - {max_text}"
```

