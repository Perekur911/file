Private Function CheckRecTask( _
    ByVal taskId As Long, _
    ByVal sampleCode As String, _
    ByVal pageNumber As Long _
) As String

    Dim tasks As ListObject
    Set tasks = ActiveWorkbook.Worksheets("Task").ListObjects(1)

    Dim taskCheck As Range
    Set taskCheck = tasks.ListColumns("Номер задания").DataBodyRange.Find( _
        What:=taskId, LookAt:=xlWhole, SearchOrder:=xlByColumns)

    If taskCheck Is Nothing Then
        CheckRecTask = "Указан неизвестный номер задания " & taskId & _
            " на странице " & pageNumber & _
            ". Попробуйте обновить данные проекта или исправьте значение."
        Exit Function
    End If

    Dim taskRowIndex As Long
    taskRowIndex = taskCheck.Row - tasks.DataBodyRange.Row + 1

    If CStr(tasks.ListColumns("Код проекта").DataBodyRange.Cells(taskRowIndex, 1).Value) <> sampleCode Then
        CheckRecTask = "Указан неверный номер задания " & taskId & _
            " на странице " & pageNumber & _
            ". Шифр пробы в задании отличается от шифра пробы в исследовании."
        Exit Function
    End If

    CheckRecTask = "OK"

End Function

Public Function Load_Rec_results_to_forms( _
    Optional ByVal mode As String = "sequential", _
    Optional ByVal fields As Variant, _
    Optional ByVal silence As Boolean = False _
) As String

    On Error GoTo CleanFail

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetREC As Worksheet
    Set sheetREC = wb.Worksheets("Rec")

    Dim resultTable As ListObject
    Set resultTable = _
        wb.Worksheets("Rec_results").ListObjects("Rec_results")

    Dim sourceTable As ListObject
    Set sourceTable = _
        wb.Worksheets("Rec_sourceData").ListObjects("Rec_sourceData")

    Dim fieldFilter As Object
    Set fieldFilter = BuildFieldFilter(fields)

    Dim text As String
    Dim warnText As String

    mode = LCase$(Trim$(mode))

    If mode <> "by_key" And mode <> "sequential" Then
        text = "ERROR|mode должен быть 'by_key' или 'sequential'"
        Load_Rec_results_to_forms = text

        If Not silence Then
            MsgBox text, vbExclamation
        End If

        Exit Function
    End If

    If resultTable.DataBodyRange Is Nothing Then
        text = "OK|Таблица Rec_results пустая."
        Load_Rec_results_to_forms = text

        If Not silence Then
            MsgBox text, vbInformation
        End If

        Exit Function
    End If

    Dim resultRowIndex As Long
    Dim formIndex As Long
    Dim notFoundCount As Long

    For resultRowIndex = 1 To resultTable.ListRows.count

        If mode = "sequential" Then

            formIndex = resultRowIndex

            Do While Not NamedRangeExists( _
                wb, _
                "Rec_" & formIndex & "_sampleCode" _
            )
                Call AddFormREC
            Loop

        Else

            formIndex = FindFormIndexForResultRow( _
                wb, _
                sheetREC, _
                resultTable, _
                resultRowIndex, _
                "Rec", _
                Array(COL_SAMPLE_CODE_DB, COL_TASK_ID_DB) _
            )

        End If

        If formIndex = 0 Or _
           Not NamedRangeExists( _
               wb, _
               "Rec_" & formIndex & "_sampleCode" _
           ) Then

            notFoundCount = notFoundCount + 1

            warnText = warnText & _
                "Не найдена форма для строки Rec_results #" & _
                resultRowIndex & vbCrLf & _
                "sampleCode = " & _
                GetTableValue( _
                    resultTable, _
                    resultRowIndex, _
                    COL_SAMPLE_CODE_DB _
                ) & vbCrLf & _
                "TaskId = " & _
                GetTableValue( _
                    resultTable, _
                    resultRowIndex, _
                    COL_TASK_ID_DB _
                ) & vbCrLf & vbCrLf

            GoTo NextResultRow
        End If

        ' Родительская строка:
        ' Rec_results -> Rec_x_*
        Call CopyTableRowToNamedRanges( _
            wb, _
            sheetREC, _
            resultTable, _
            resultRowIndex, _
            "Rec", _
            formIndex, _
            fieldFilter _
        )

        ' Дочерние строки:
        ' Rec_sourceData -> Rec_x_*1..12
        Call LoadRecSourceDataToIndexedNamedRanges( _
            wb, _
            sourceTable, _
            GetTableValue( _
                resultTable, _
                resultRowIndex, _
                COL_RESULT_ID_REC_DB _
            ), _
            formIndex, _
            fieldFilter _
        )

NextResultRow:
    Next resultRowIndex

    If notFoundCount = 0 Then

        text = "OK|Данные REC перенесены в формы."
        Load_Rec_results_to_forms = text

        If Not silence Then
            MsgBox text, vbInformation
        End If

    Else

        text = _
            "WARN|Данные REC перенесены частично. " & _
            "Не найдено форм: " & notFoundCount & _
            vbCrLf & warnText

        Load_Rec_results_to_forms = text

        If Not silence Then
            MsgBox text, vbExclamation
        End If

    End If

    Exit Function

CleanFail:
    text = _
        "ERROR|" & _
        CStr(Err.Number) & "|" & _
        Err.Description

    Load_Rec_results_to_forms = text

    If Not silence Then
        MsgBox text, vbCritical
    End If

End Function

Private Sub LoadRecSourceDataToIndexedNamedRanges( _
    ByVal wb As Workbook, _
    ByVal sourceTable As ListObject, _
    ByVal resultId As Variant, _
    ByVal formIndex As Long, _
    ByVal fieldFilter As Object _
)
    If sourceTable.DataBodyRange Is Nothing Then Exit Sub

    Dim childFields As Variant
    childFields = Array( _
        COL_MIX_SAMPLE_CODE_CHILD_DB, _
        COL_MASS_FRACTION_CHILD_DB, _
        COL_P_TRANSFER_CHILD_DB, _
        COL_T_TRANSFER_CHILD_DB, _
        COL_DENSITY_CHILD_DB, _
        COL_FIRST_CHILD_DB, _
        COL_VOLUME_CHILD_DB, _
        COL_MASS_CHILD_DB _
    )

    Dim childIndex As Long
    Dim fieldIndex As Long
    Dim fieldName As String
    Dim rangeName As String
    Dim targetRange As Range

    ' Сначала очищаем все 12 child-ячеек по нужным полям.
    For childIndex = 1 To REC_CHILD_COUNT_PER_FORM
        For fieldIndex = LBound(childFields) To UBound(childFields)

            fieldName = CStr(childFields(fieldIndex))

            If ShouldTransferField(fieldFilter, fieldName) Then
                rangeName = "Rec_" & formIndex & "_" & fieldName & childIndex

                If NamedRangeExists(wb, rangeName) Then
                    Set targetRange = wb.Names(rangeName).RefersToRange

                    Call ClearRecNamedTarget( _
                        targetRange, _
                        fieldName = COL_DENSITY_CHILD_DB _
                    )
                End If
            End If

        Next fieldIndex
    Next childIndex

    ' Потом заполняем сверху строки Rec_sourceData с нужным resultId.
    Dim srcRow As Long
    childIndex = 1

    For srcRow = 1 To sourceTable.ListRows.count

        If NormalizeKeyValue(GetTableValue(sourceTable, srcRow, COL_RESULT_ID_REC_CHILD_DB)) = _
           NormalizeKeyValue(resultId) Then

            If childIndex > REC_CHILD_COUNT_PER_FORM Then Exit For

            For fieldIndex = LBound(childFields) To UBound(childFields)

                fieldName = CStr(childFields(fieldIndex))

                If ShouldTransferField(fieldFilter, fieldName) Then

                    If ListColumnExists(sourceTable, fieldName) Then
                        rangeName = "Rec_" & formIndex & "_" & fieldName & childIndex

                        If NamedRangeExists(wb, rangeName) Then
                            Set targetRange = wb.Names(rangeName).RefersToRange

                            Call WriteRecNamedTarget( _
                                targetRange, _
                                GetTableValue(sourceTable, srcRow, fieldName), _
                                fieldName = COL_DENSITY_CHILD_DB _
                            )
                        End If
                    End If

                End If

            Next fieldIndex

            childIndex = childIndex + 1
        End If

    Next srcRow

End Sub

Private Sub ClearRecNamedTarget( _
    ByVal targetRange As Range, _
    ByVal allowFormulaOverwrite As Boolean _
)
    Dim writeCell As Range
    
    If targetRange.MergeCells Then
        Set writeCell = targetRange.MergeArea.Cells(1, 1)
    Else
        Set writeCell = targetRange.Cells(1, 1)
    End If
    
    If writeCell.HasFormula And Not allowFormulaOverwrite Then
        Exit Sub
    End If
    
    If targetRange.MergeCells Then
        targetRange.MergeArea.ClearContents
    Else
        targetRange.ClearContents
    End If
End Sub


Private Sub WriteRecNamedTarget( _
    ByVal targetRange As Range, _
    ByVal value As Variant, _
    ByVal allowFormulaOverwrite As Boolean _
)
    Dim writeCell As Range
    
    If targetRange.MergeCells Then
        Set writeCell = targetRange.MergeArea.Cells(1, 1)
    Else
        Set writeCell = targetRange.Cells(1, 1)
    End If
    
    If writeCell.HasFormula And Not allowFormulaOverwrite Then
        Exit Sub
    End If
    
    writeCell.value = value
End Sub

Private Sub ConvertRecDensityFormulaToValue( _
    ByVal wb As Workbook, _
    ByVal formIndex As Long, _
    ByVal childIndex As Long _
)
    Dim rangeName As String
    rangeName = "Rec_" & formIndex & "_" & COL_DENSITY_CHILD_DB & childIndex

    If Not NamedRangeExists(wb, rangeName) Then Exit Sub

    Dim targetRange As Range
    Set targetRange = wb.Names(rangeName).RefersToRange

    Dim writeCell As Range

    If targetRange.MergeCells Then
        Set writeCell = targetRange.MergeArea.Cells(1, 1)
    Else
        Set writeCell = targetRange.Cells(1, 1)
    End If

    If writeCell.HasFormula Then
        writeCell.Calculate
        writeCell.value = writeCell.value
    End If
End Sub

