Function FindEmptyPage2(sheet As Worksheet) As Integer
    Dim prm As String
    Select Case sheet.name
    Case "AP"
        prm = "kc"
    Case "BP", "GC"
        prm = "kb2"
    Case "PD"
        prm = "d"
    Case "GOR", "SSF"
        prm = "VGTot"
    Case "EMV"
        prm = "kb"
    Case "CCE"
        prm = "Pres"
    Case "OPOH"
        prm = "coldOpenPMPaAbs"
    Case "Rec"
        prm = "typeSampler"
        
    End Select
        
    
    For x = 1 To 999 Step 1
        Dim name As String
        name = sheet.name & "_" & x & "_"
        If o_Exist2(name & "sampleCode") Then
            If sheet.Range(name & "sampleCode").value = "" And sheet.Range(name & "TaskId").value = "" And (sheet.Range(name & prm).Value2 = 0 Or sheet.Range(name & prm).Value2 = "") Then
                FindEmptyPage2 = x
                Exit For
            End If
        Else
            FindEmptyPage2 = x
            Exit For
        End If
    Next x

End Function

Function FindEmptyRow2(sheet As Worksheet) As Integer
    Dim prm As String
    Select Case sheet.name
    Case "OP"
        prm = "Popen"
    Case "OPOH"
        prm = "Pcompression1Open"
    End Select
    
    Dim cell As Range
    Dim x As Integer
    x = 1
    For Each cell In sheet.ListObjects(sheet.name).ListColumns("sampleCode").DataBodyRange
        If cell.value = "" And cell.Offset(0, sheet.ListObjects(sheet.name).ListColumns("TaskId").index - 1).value = "" And cell.Offset(0, sheet.ListObjects(sheet.name).ListColumns(prm).index - 1).value = "" Then
            FindEmptyRow2 = x
            Exit For
        End If
        x = x + 1
    Next cell
    
End Function

Function o_Exist2(sName As String)
   Dim wsR As Object
   On Error Resume Next
   Set wsR = Range(sName)
   o_Exist2 = Not wsR Is Nothing
End Function



