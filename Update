Да. Замени `RunStudySync` целиком на этот вариант. Логика команды, расчёта листов, чтения результата и сообщений не меняется. Добавлена только нормальная работа окна и гарантированная уборка при любой ошибке. 

```vba
Public Function RunStudySync( _
    ByVal mode As String, _
    Optional ByVal projectNumber As String = "", _
    Optional ByVal studies As String = "", _
    Optional ByVal taskStatus As String = "" _
) As String

    Dim targetBook As Workbook
    Dim targetWorkbookPath As String

    Dim shell As Object
    Dim exec As Object

    Dim cmd As String
    Dim stdoutText As String
    Dim stderrText As String
    Dim progressFile As String

    Dim ws As Worksheet

    On Error GoTo CleanFail

    If ActiveWorkbook Is Nothing Then
        Err.Raise vbObjectError + 1002, , _
                  "Нет активной книги с данными"
    End If

    If ActiveWorkbook.Name = ThisWorkbook.Name Then
        Err.Raise vbObjectError + 1003, , _
                  "Активна книга-надстройка, а не книга с данными"
    End If

    If Len(ActiveWorkbook.Path) = 0 Then
        Err.Raise vbObjectError + 1004, , _
                  "Книга с данными должна быть сохранена перед запуском синхронизации"
    End If

    Set targetBook = ActiveWorkbook
    targetWorkbookPath = targetBook.FullName

    mode = LCase$(Trim$(mode))

    If mode <> "save" And mode <> "load" Then
        Err.Raise vbObjectError + 1000, , _
                  "mode должен быть save или load"
    End If

    If mode = "load" And Len(Trim$(projectNumber)) = 0 Then
        Err.Raise vbObjectError + 1001, , _
                  "Для режима load нужно указать projectNumber"
    End If

    If Len(Trim$(studies)) = 0 Then
        studies = "OP AP GC SSF GOR BP REC EMV"
    End If

    ' Пересчёт только книги с данными.
    For Each ws In targetBook.Worksheets
        ws.Calculate
    Next ws

    cmd = Quote(GetWorkingPythonExe) & " -u " & _
          Quote(SYNC_SCRIPT) & " " & _
          "--mode " & mode & " " & _
          "--workbook " & Quote(targetWorkbookPath) & " " & _
          "--db " & Quote(DB_PATH) & " " & _
          "--studies " & studies

    If mode = "load" Then
        cmd = cmd & " --project " & Quote(projectNumber)
    End If

    If Len(Trim$(taskStatus)) > 0 Then
        cmd = cmd & " --status " & Quote(taskStatus)
    End If

    progressFile = Environ$("TEMP") & _
                   "\python_progress_" & _
                   Format$(Now, "yyyymmdd_hhnnss") & "_" & _
                   CStr(Int(Rnd() * 1000000)) & _
                   ".log"

    cmd = cmd & " --progress-file " & Quote(progressFile)

    Set shell = CreateObject("WScript.Shell")
    Set exec = shell.Exec(cmd)

    ' Показываем окно прогресса.
    frmProgress.lblStatus.Caption = "Запуск Python-скрипта..."
    frmProgress.Show vbModeless
    frmProgress.Repaint
    DoEvents

    ' Ожидаем Python через общий безопасный цикл.
    WaitForPythonProcess exec, progressFile

    stdoutText = exec.StdOut.ReadAll
    stderrText = exec.StdErr.ReadAll

    If exec.ExitCode <> 0 Then
        MsgBox _
            "Ошибка выполнения Python-скрипта:" & _
            vbCrLf & vbCrLf & _
            stdoutText & vbCrLf & stderrText, _
            vbCritical
    Else
        MsgBox _
            "Готово:" & _
            vbCrLf & vbCrLf & _
            stdoutText, _
            vbInformation
    End If

    RunStudySync = stdoutText

CleanExit:
    On Error Resume Next

    Application.StatusBar = False

    ' Обязательно закрываем именно существующее окно.
    Unload frmProgress

    ' Удаляем временный progress-файл.
    If Len(progressFile) > 0 Then
        If Len(Dir$(progressFile)) > 0 Then
            Kill progressFile
        End If
    End If

    Set exec = Nothing
    Set shell = Nothing
    Set targetBook = Nothing

    On Error GoTo 0
    Exit Function

CleanFail:
    Dim errNumber As Long
    Dim errSource As String
    Dim errDescription As String

    errNumber = Err.Number
    errSource = Err.Source
    errDescription = Err.Description

    On Error Resume Next

    Application.StatusBar = False
    Unload frmProgress

    If Len(progressFile) > 0 Then
        If Len(Dir$(progressFile)) > 0 Then
            Kill progressFile
        End If
    End If

    Set exec = Nothing
    Set shell = Nothing
    Set targetBook = Nothing

    On Error GoTo 0

    Err.Raise _
        errNumber, _
        errSource, _
        errDescription

End Function
```

## `WaitForPythonProcess`

Сверь свой вариант с этим. Если написал иначе, лучше заменить полностью:

```vba
Private Sub WaitForPythonProcess( _
    ByVal exec As Object, _
    ByVal progressFile As String _
)

    Const POLL_INTERVAL_SECONDS As Double = 0.2
    Const LOOP_SLEEP_MS As Long = 25

    Dim lastProgressLen As Long
    Dim lastPoll As Double

    Dim progressText As String
    Dim newChunk As String

    lastProgressLen = 0
    lastPoll = Timer

    Do While exec.Status = 0

        ' Не даём циклу загружать Excel на 100%.
        Sleep LOOP_SLEEP_MS

        ' Даём Excel обработать перерисовку формы.
        DoEvents

        If SecondsElapsed(lastPoll, Timer) >= _
           POLL_INTERVAL_SECONDS Then

            progressText = _
                ReadUtf8TextFileSafe(progressFile)

            If Len(progressText) > lastProgressLen Then

                newChunk = Mid$( _
                    progressText, _
                    lastProgressLen + 1 _
                )

                lastProgressLen = Len(progressText)

                UpdateProgressFromText newChunk

            End If

            lastPoll = Timer

        End If

    Loop

    ' Python мог дописать последнюю строку непосредственно
    ' перед завершением процесса.
    progressText = ReadUtf8TextFileSafe(progressFile)

    If Len(progressText) > lastProgressLen Then

        newChunk = Mid$( _
            progressText, _
            lastProgressLen + 1 _
        )

        UpdateProgressFromText newChunk

    End If

End Sub
```

И `SecondsElapsed`:

```vba
Private Function SecondsElapsed( _
    ByVal startTimer As Double, _
    ByVal currentTimer As Double _
) As Double

    If currentTimer >= startTimer Then
        SecondsElapsed = currentTimer - startTimer
    Else
        SecondsElapsed = _
            86400# - startTimer + currentTimer
    End If

End Function
```

