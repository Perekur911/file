Public Function RunStudySync( _
    ByVal mode As String, _
    Optional ByVal projectNumber As String = "", _
    Optional ByVal studies As String = "", _
    Optional ByVal taskStatus As String = "" _
) As String
    
    Dim targetBook As Workbook
    Dim targetWorkbookPath As String
    
    Dim shell As Object
    Dim exec As Object
    Dim cmd As String
    Dim stdoutText As String
    Dim stderrText As String
    
    If ActiveWorkbook Is Nothing Then
        Err.Raise vbObjectError + 1002, , "Íåò àêòèâíîé êíèãè ñ äàííûìè"
    End If
    
    If ActiveWorkbook.name = ThisWorkbook.name Then
        Err.Raise vbObjectError + 1003, , "Àêòèâíà êíèãà-íàäñòðîéêà, à íå êíèãà ñ äàííûìè"
    End If
    
    If Len(ActiveWorkbook.path) = 0 Then
        Err.Raise vbObjectError + 1004, , "Êíèãà ñ äàííûìè äîëæíà áûòü ñîõðàíåíà ïåðåä çàïóñêîì ñèíõðîíèçàöèè"
    End If
    
    Set targetBook = ActiveWorkbook
    targetWorkbookPath = targetBook.fullName
    
    mode = LCase$(Trim$(mode))
    
    If mode <> "save" And mode <> "load" Then
        Err.Raise vbObjectError + 1000, , "mode äîëæåí áûòü save èëè load"
    End If
    
    If mode = "load" And Len(Trim$(projectNumber)) = 0 Then
        Err.Raise vbObjectError + 1001, , "Äëÿ ðåæèìà load íóæíî óêàçàòü projectNumber"
    End If
    
    If Len(Trim$(studies)) = 0 Then
        studies = "OP AP GC SSF GOR BP REC EMV"
    End If
    
    ' Ïåðåñ÷¸ò òîëüêî êíèãè ñ äàííûìè.
    Dim ws As Worksheet

    For Each ws In targetBook.Worksheets
        ws.Calculate
    Next ws
    
    cmd = Quote(GetWorkingPythonExe) & " -u " & _
          Quote(SYNC_SCRIPT) & " " & _
          "--mode " & mode & " " & _
          "--workbook " & Quote(targetWorkbookPath) & " " & _
          "--db " & Quote(DB_PATH) & " " & _
          "--studies " & studies
    
    If mode = "load" Then
        cmd = cmd & " --project " & Quote(projectNumber)
    End If
    
    If Len(Trim$(taskStatus)) > 0 Then
        cmd = cmd & " --status " & Quote(taskStatus)
    End If
    
    'Debug.Print cmd
    
    Dim progressFile As String
    progressFile = Environ$("TEMP") & "\python_progress_" & _
               Format$(Now, "yyyymmdd_hhnnss") & "_" & _
               CStr(Int(Rnd() * 1000000)) & ".log"
    
    cmd = cmd & " --progress-file " & Quote(progressFile)
    
    Set shell = CreateObject("WScript.Shell")
    Set exec = shell.exec(cmd)
    
    Dim lastProgressLen As Long
    Dim lastPoll As Double
    Dim progressText As String
    Dim newChunk As String
    
    frmProgress.lblStatus.Caption = "Çàïóñê Python-ñêðèïòà..."
    frmProgress.show vbModeless
    DoEvents
    
    lastProgressLen = 0
    lastPoll = Timer
    
    Do While exec.status = 0
        DoEvents
        
        If Timer - lastPoll >= 0.2 Then
            progressText = ReadUtf8TextFileSafe(progressFile)
            
            If Len(progressText) > lastProgressLen Then
                newChunk = Mid$(progressText, lastProgressLen + 1)
                lastProgressLen = Len(progressText)
                UpdateProgressFromText newChunk
            End If
            
            lastPoll = Timer
        End If
    Loop
    
    progressText = ReadUtf8TextFileSafe(progressFile)
    
    If Len(progressText) > lastProgressLen Then
        newChunk = Mid$(progressText, lastProgressLen + 1)
        UpdateProgressFromText newChunk
    End If
    
    stdoutText = exec.StdOut.ReadAll
    stderrText = exec.StdErr.ReadAll
    
    Application.StatusBar = False
    Unload frmProgress
    
    If exec.exitCode <> 0 Then
        MsgBox "Îøèáêà âûïîëíåíèÿ Python-ñêðèïòà:" & vbCrLf & vbCrLf & _
               stdoutText & vbCrLf & stderrText, vbCritical
    Else
        MsgBox "Ãîòîâî:" & vbCrLf & vbCrLf & stdoutText, vbInformation
    End If
    
    RunStudySync = stdoutText
End Function

Public Function SetTaskStatusOnly( _
