Attribute App.VB_VarHelpID = -1

Private Sub App_WorkbookOpen(ByVal wb As Workbook)
    'MsgBox "Открыта книга: " & Wb.Name, vbInformation
End Sub
'
Private Sub App_SheetChange(ByVal sh As Object, ByVal target As Range)
    Dim s As Range
    On Error Resume Next
    Set s = sh.Parent.Worksheets("OP").Range("ChoosenProject")
    On Error GoTo 0
    If s Is Nothing Then
        Exit Sub
    End If
    
    If Not sh.Parent.Worksheets("OP").Range("ChoosenProject").value Like "2#-F###" Then
        Exit Sub
    End If
    
    Dim formIndex As Long
    Dim cellName As String
    On Error Resume Next
    cellName = target.name.name
    On Error GoTo 0
    If sh.name = "CCE" Then
        If Len(cellName) = 0 Then
            Exit Sub
        ElseIf cellName Like "CCE_#_typeSample" Or cellName Like "CCE_##_typeSample" Then
            formIndex = Split(target.name.name, "_")(1)
            Call CallMacroWithParam("toggleTypeSample", formIndex, "CCE")
        End If
    End If

End Sub

