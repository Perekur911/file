Sub equipmentModelsRefreshJOIN()

    Dim sheetJOIN As Worksheet
    Set sheetJOIN = ActiveWorkbook.Sheets("JOIN")
    
    Dim eq() As String
    
    eq = getEquipmentModels("", "PVTCell")
    Dim strEq As String
    strEq = eq(1)
    
    Dim i As Long
    
    For i = 2 To UBound(eq)
        strEq = strEq & "," & eq(i)
    Next i
    
    Dim CellTS As Range
    i = 1
    
    On Error Resume Next
    Do While True
        Set CellTS = Nothing
        Set CellTS = sheetJOIN.Range("JOIN_" & i & "_equipment")
        If CellTS Is Nothing Then Exit Do
        
        With CellTS.Validation
            .Delete
            .Add Type:=xlValidateList, AlertStyle:=xlValidAlertStop, Operator:= _
            xlBetween, Formula1:=strEq
            .IgnoreBlank = True
            .InCellDropdown = True
            .ShowInput = True
            .ShowError = True
        End With
        i = i + 1
    Loop
    On Error GoTo 0
    
End Sub

Private Function Get_JOIN_FormState(ByVal formIndex As Long) As JOINFormState

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetJOIN As Worksheet
    Set sheetJOIN = wb.Worksheets("JOIN")

    If formIndex <= 0 Then
        Get_JOIN_FormState = JOIN_FORM_RESERVED
        Exit Function
    End If

    If Not NamedRangeExists(wb, "JOIN_" & formIndex & "_sampleCode") Then
        Get_JOIN_FormState = JOIN_FORM_RESERVED
        Exit Function
    End If

    Dim sampleCode As String
    sampleCode = Trim$(CStr(sheetJOIN.Range("JOIN_" & formIndex & "_sampleCode").value))

    Dim hasSampleCode As Boolean
    hasSampleCode = (sampleCode <> "")

    Dim filledMixRowsCount As Long
    filledMixRowsCount = JOIN_CountFilledMixSampleRows(formIndex)

    Dim hasEnoughMixSamples As Boolean
    hasEnoughMixSamples = (filledMixRowsCount >= 2)

    ' Ïóñòàÿ ôîðìà:
    ' - sampleCode ïóñòîé
    ' - â JOIN_source_N ìåíüøå äâóõ çàïîëíåííûõ ñòðîê â ñòîëáöå
    '   "Øèôð ïðîáû äëÿ îáúåäèíåíèÿ"
    If Not hasSampleCode And Not hasEnoughMixSamples Then
        Get_JOIN_FormState = JOIN_FORM_EMPTY
        Exit Function
    End If

    ' Çàïîëíåííàÿ ôîðìà:
    ' - sampleCode çàïîëíåí
    ' - åñòü ìèíèìóì 2 ïðîáû äëÿ îáúåäèíåíèÿ
    If hasSampleCode And hasEnoughMixSamples Then
        Get_JOIN_FormState = JOIN_FORM_FILLED
        Exit Function
    End If

    ' Âñ¸ ïðîìåæóòî÷íîå:
    ' - sampleCode åñòü, íî ïðîá ìåíüøå äâóõ
    ' - sampleCode íåò, íî ïðîáû óæå âíåñåíû
    Get_JOIN_FormState = JOIN_FORM_RESERVED

End Function

Private Function JOIN_CountFilledMixSampleRows(ByVal formIndex As Long) As Long

    JOIN_CountFilledMixSampleRows = 0

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetJOIN As Worksheet
    Set sheetJOIN = wb.Worksheets("JOIN")

    If Not ListObjectExists(sheetJOIN, "JOIN_source_" & formIndex) Then
        Exit Function
    End If

    Dim srcTable As ListObject
    Set srcTable = sheetJOIN.ListObjects("JOIN_source_" & formIndex)

    If srcTable.DataBodyRange Is Nothing Then
        Exit Function
    End If

    If Not ListColumnExists(srcTable, COL_MIX_SAMPLE_CODE_FORM) Then
        Exit Function
    End If

    Dim mixCol As Long
    mixCol = srcTable.ListColumns(COL_MIX_SAMPLE_CODE_FORM).index

    Dim rowIndex As Long
    Dim v As Variant

    For rowIndex = 1 To srcTable.ListRows.count

        v = srcTable.DataBodyRange.Cells(rowIndex, mixCol).value

        If IsError(v) Then
            JOIN_CountFilledMixSampleRows = JOIN_CountFilledMixSampleRows + 1
        ElseIf Trim$(CStr(v)) <> "" Then
            JOIN_CountFilledMixSampleRows = JOIN_CountFilledMixSampleRows + 1
        End If

    Next rowIndex

End Function

