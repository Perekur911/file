4. В Validate_OP_Row полностью замени старую ГРУППУ 11

Сейчас группа 11 разрешает в самом VLiqPhase число, "Следы" и "Не выполнялось". 

Весь этот старый блок:

' =========================================================
' ГРУППА 11. ОБЪЁМ ЖИДКОЙ ФАЗЫ
...
Select Case fieldName

    Case "VLiqPhase"
        ...
        
End Select

замени на этот:

' =========================================================
        ' ГРУППА 11. ОБЪЁМ ЖИДКОЙ ФАЗЫ
        '
        ' Для газа:
        '
        ' 1. Выполнено с числовым результатом:
        '       VLiqPhase = 0 или >= 1
        '       LiqPhaseQualifier = пусто
        '
        ' 2. Объём менее 1 мл:
        '       VLiqPhase = пусто
        '       LiqPhaseQualifier = "Менее 1 мл"
        '
        ' 3. Определение требовалось, но не выполнялось:
        '       VLiqPhase = пусто
        '       LiqPhaseQualifier = "Не выполнялось"
        '
        ' Для жидкой пробы оба поля должны быть пустыми.
        ' =========================================================

        Select Case fieldName

            Case "VLiqPhase"

                Dim liqVolumeValue As Variant
                Dim liqVolumeText As String

                Dim qualifierCell As Range
                Dim qualifierValue As Variant
                Dim qualifierText As String

                liqVolumeValue = fieldValue
                liqVolumeText = valueText

                Set qualifierCell = _
                    workTable.ListColumns("LiqPhaseQualifier") _
                             .DataBodyRange.Cells(rowIndex, 1)

                qualifierValue = qualifierCell.value

                If IsError(qualifierValue) Then

                    AddValidationError _
                        errors, _
                        errorCount, _
                        "OP, строка " & rowIndex & _
                        ": поле ""Уточнение объёма жидкой фазы"" " & _
                        "содержит ошибку Excel: " & _
                        qualifierCell.text, _
                        qualifierCell

                    GoTo next_field

                End If

                qualifierText = Trim$(CStr(qualifierValue))


                Select Case fluid

                    ' =================================================
                    ' ГАЗОВАЯ ПРОБА
                    ' =================================================

                    Case Gas

                        ' Сначала проверяем допустимое значение qualifier.
                        If qualifierText <> "" Then

                            Select Case LCase$(qualifierText)

                                Case "менее 1 мл", _
                                     "не выполнялось"

                                    ' допустимо

                                Case Else

                                    AddValidationError _
                                        errors, _
                                        errorCount, _
                                        "OP, строка " & rowIndex & _
                                        ": поле ""Уточнение объёма жидкой фазы"" " & _
                                        "может содержать только ""Менее 1 мл"" " & _
                                        "или ""Не выполнялось"".", _
                                        qualifierCell

                            End Select

                        End If


                        ' Оба поля пустые — результат не определён.
                        If liqVolumeText = "" _
                           And qualifierText = "" Then

                            AddValidationError _
                                errors, _
                                errorCount, _
                                "OP, строка " & rowIndex & _
                                ": для газовой пробы необходимо указать " & _
                                "объём жидкой фазы либо выбрать уточнение " & _
                                """Менее 1 мл"" / ""Не выполнялось"".", _
                                fieldCell

                        End If


                        ' Оба поля одновременно заполнены — противоречие.
                        If liqVolumeText <> "" _
                           And qualifierText <> "" Then

                            AddValidationError _
                                errors, _
                                errorCount, _
                                "OP, строка " & rowIndex & _
                                ": нельзя одновременно указывать числовой " & _
                                "объём жидкой фазы и его уточнение.", _
                                qualifierCell

                        End If


                        ' Если указан числовой объём.
                        If liqVolumeText <> "" Then

                            If Not IsNumeric(liqVolumeValue) Then

                                AddValidationError _
                                    errors, _
                                    errorCount, _
                                    "OP, строка " & rowIndex & _
                                    ": поле ""Объём жидкой фазы"" " & _
                                    "должно содержать число.", _
                                    fieldCell

                            ElseIf CDbl(liqVolumeValue) < 0 Then

                                AddValidationError _
                                    errors, _
                                    errorCount, _
                                    "OP, строка " & rowIndex & _
                                    ": поле ""Объём жидкой фазы"" " & _
                                    "не может быть отрицательным.", _
                                    fieldCell

                            ElseIf CDbl(liqVolumeValue) > 0 _
                               And CDbl(liqVolumeValue) < 1 Then

                                AddValidationError _
                                    errors, _
                                    errorCount, _
                                    "OP, строка " & rowIndex & _
                                    ": для объёма менее 1 мл оставьте " & _
                                    "числовое поле пустым и выберите " & _
                                    """Менее 1 мл"" в поле " & _
                                    """Уточнение объёма жидкой фазы"".", _
                                    fieldCell

                            End If

                        End If


                    ' =================================================
                    ' ЖИДКАЯ ПРОБА
                    ' =================================================

                    Case Liquid

                        If liqVolumeText <> "" Then

                            AddValidationError _
                                errors, _
                                errorCount, _
                                "OP, строка " & rowIndex & _
                                ": поле ""Объём жидкой фазы"" " & _
                                "для жидкой пробы должно быть пустым.", _
                                fieldCell

                        End If

                        If qualifierText <> "" Then

                            AddValidationError _
                                errors, _
                                errorCount, _
                                "OP, строка " & rowIndex & _
                                ": поле ""Уточнение объёма жидкой фазы"" " & _
                                "для жидкой пробы должно быть пустым.", _
                                qualifierCell

                        End If

                End Select

        End Select

Тут специально вся совместная проверка сидит в:

Case "VLiqPhase"

а не выполняется ещё раз при проходе LiqPhaseQualifier. Иначе одни и те же ошибки могли бы добавляться дважды.

Что в итоге будет разрешено

VLiqPhase = 0
LiqPhaseQualifier = ""

✅

VLiqPhase = 5
LiqPhaseQualifier = ""

✅

VLiqPhase = ""
LiqPhaseQualifier = "Менее 1 мл"

✅

VLiqPhase = ""
LiqPhaseQualifier = "Не выполнялось"

✅

А вот:

0.5 + пусто

❌ — надо выбрать Менее 1 мл.

5 + "Менее 1 мл"

❌ — одновременно два взаимоисключающих результата.

пусто + пусто

❌ для газа, но нормально для жидкой пробы.

И ещё один момент: поскольку Validate_OP_Row идёт именно по столбцам OP_results и требует наличие одноимённого столбца в OP, новый LiqPhaseQualifier действительно должен присутствовать в обеих таблицах, иначе валидатор выдаст «В таблице OP не найдена колонка». 

После этих изменений по VBA всё. Save_OP и Build_OP_HashData автоматически подхватят новый столбец.
