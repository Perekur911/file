Добавь в конец модуля helpersRange, после последнего End Function, такую процедуру:

Public Sub DeleteFormNames( _
    ByVal wb As Workbook, _
    ByVal formPrefix As String, _
    ByVal formIndex As Long _
)

    Dim prefix As String
    prefix = Trim$(formPrefix) & "_" & CStr(formIndex) & "_"

    Dim i As Long
    Dim nm As Excel.Name
    Dim shortName As String

    ' Перебираем с конца, поскольку удаление меняет индексы.
    For i = wb.Names.Count To 1 Step -1

        Set nm = wb.Names(i)
        shortName = nm.Name

        ' Убираем указание листа у локальных имён.
        shortName = Mid$( _
            shortName, _
            InStrRev(shortName, "!") + 1 _
        )

        If StrComp( _
            Left$(shortName, Len(prefix)), _
            prefix, _
            vbTextCompare _
        ) = 0 Then

            nm.Delete

        End If

    Next i

End Sub

