Option Explicit

Private Enum APFormState
    AP_FORM_EMPTY = 0       ' пустая, не нужна
    AP_FORM_RESERVED = 1    ' зарезервирована, не сохраняем
    AP_FORM_FILLED = 2      ' заполнена, можно валидировать и сохранять
End Enum

Private Const COL_PRESSURE_FORM As String = "Давление, psig"
Private Const COL_TEMPERATURE_FORM As String = "Температура, °С"
Private Const COL_DENSITY_FORM As String = "Плотность, г/см3"
Private Const COL_ACTIVE_FORM As String = "Активна"

Private Const COL_ROW_ID_DB As String = "rowIdAP"
Private Const COL_RESULT_ID_DB As String = "resultIdAP"
Private Const COL_PRESSURE_DB As String = "pressure"
Private Const COL_TEMPERATURE_DB As String = "temperature"
Private Const COL_DENSITY_DB As String = "density"
Private Const COL_ACTIVE_DB As String = "active"

Private Const AP_FIRST_FORM_FIRST_COL As Long = 1
Private Const AP_PAGE_ROW = 11
Private Const AP_PAGE_FIRST_COL = 4


Public Sub DeleteLastListAP2()
    
    Dim sheetAP As Worksheet
    Set sheetAP = ActiveWorkbook.Worksheets("AP")
    
    Dim sheetAPresults As Worksheet
    Set sheetAPresults = ActiveWorkbook.Worksheets("AP_results")
    
    Dim tableResults As ListObject
    Set tableResults = sheetAPresults.ListObjects("AP_results")
    
    Dim lastForm As Long
    lastForm = sheetAP.ListObjects.count
    
    If lastForm <= 2 Then
        MsgBox "Нельзя удалить 2 первые формы"
        Exit Sub
    End If
    
    Dim countFormCols As Long
    countFormCols = sheetAP.Range("AP_2_sampleCode").Column - sheetAP.Range("AP_1_sampleCode").Column
    
    Dim firstColLastForm As Long
    firstColLastForm = AP_FIRST_FORM_FIRST_COL + (lastForm - 1) * countFormCols
    
    Dim lastColLastForm As Long
    lastColLastForm = firstColLastForm + countFormCols - 1
    
    Dim headerCell As Range
    Dim namedRange As String
    
    For Each headerCell In tableResults.HeaderRowRange.Cells
        namedRange = "AP_" & lastForm & "_" & CStr(headerCell.value)
        
        If NamedRangeExists(ActiveWorkbook, namedRange) Then
            ActiveWorkbook.Names(namedRange).Delete
        End If
    Next headerCell
    
    sheetAP.Range( _
        sheetAP.columns(firstColLastForm), _
        sheetAP.columns(lastColLastForm) _
    ).EntireColumn.Delete
    
    Call DeleteCheckBoxesFromColumnRight(sheetAP, firstColLastForm)

End Sub

Public Function cancelCurrentTaskAP() As macroResult
    
    cancelCurrentTaskAP = MACRO_FAILED
    
    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetAP As Worksheet
    Set sheetAP = wb.Worksheets("AP")
    
    Dim lenght As Integer
    lenght = sheetAP.Range("AP_2_sampleCode").Column - sheetAP.Range("AP_1_sampleCode").Column
    
    Dim curFormIndex As Integer
    curFormIndex = (activeCell.Column - AP_FIRST_FORM_FIRST_COL) \ lenght + 1
    
    Dim taskCell As Range
    Set taskCell = sheetAP.Range("AP_" & curFormIndex & "_taskId")
    
    Dim answer As Integer
    
    answer = MsgBox("Вы действительно хотите удалить задание №" & taskCell.value & "?", vbQuestion + vbYesNo, "Подтверждение")
    
    If answer <> vbYes Then
        cancelCurrentTaskAP = MACRO_NO_CHANGES
        Exit Function
    End If
    
    Dim comment As String
    comment = InputBox("Введите причину отмены:", "Окно ввода")
    
    If comment = "" Then
        
    End If
    
    Dim syncResult As String
    syncResult = SetTaskStatusOnly(taskCell.value, "AP", "Отмена", comment)

    If InStr(1, syncResult, """ok"": true", vbTextCompare) > 0 Then
        With taskCell.MergeArea
            .Interior.ColorIndex = 3
            If .Locked = False Then
                .Locked = True
            End If
        End With
        cancelCurrentTaskAP = MACRO_CHANGED
    
    ElseIf syncResult = "NoComment" Or syncResult = "NoTaskId" Then
    
        cancelCurrentTaskAP = MACRO_NO_CHANGES
        
    End If
    
End Function

Public Sub AddFormAP()
    
    Dim sheetAP As Worksheet
    Set sheetAP = ActiveWorkbook.Worksheets("AP")
    
    Dim lastList As Integer
    Dim lastColumn As Integer
    Dim firstColumn As Integer
    Dim lenght As Integer
    Dim dataRow As Integer
    
    Dim i As Long
    Dim X As Long
    Dim oldName As String
    
    lenght = sheetAP.Range("AP_2_sampleCode").Column - sheetAP.Range("AP_1_sampleCode").Column
    lastList = sheetAP.ListObjects.count + 1
    lastColumn = lastList * lenght
    firstColumn = lastColumn - lenght + 1
    dataRow = sheetAP.Range("AP_source_1").row
    
    sheetAP.Activate
    sheetAP.Range(sheetAP.columns(firstColumn - lenght), sheetAP.columns(lastColumn - lenght)).EntireColumn.Select
    sheetAP.Application.Selection.Copy
    sheetAP.columns(firstColumn).Select
    sheetAP.Paste
    
    sheetAP.Cells(AP_PAGE_ROW, AP_PAGE_FIRST_COL + firstColumn - AP_FIRST_FORM_FIRST_COL).value = lastList
    
    Dim name As String
    Dim new_name As String
    Dim prev_src_name As String
    Dim new_src_name As String
    
    name = "AP_" & (lastList - 1)
    prev_src_name = "AP_source_" & (lastList - 1)
    new_name = "AP_" & lastList
    new_src_name = "AP_source_" & lastList
    
    Dim TableAPResult As ListObject
    Set TableAPResult = ActiveWorkbook.Worksheets("AP_results").ListObjects("AP_results")
    
    Dim name_rng As Range

    For Each name_rng In TableAPResult.HeaderRowRange
        If name_rng.value = "dateTimeSync" Then
            GoTo cont
        End If
        
        Dim current As Range
        oldName = name & "_" & name_rng.value
        
        Set current = sheetAP.Cells(sheetAP.Range(oldName).row, sheetAP.Range(oldName).Column + lenght)
        current.name = Replace(oldName, name, new_name)
        
        If Not current.HasFormula Then
            current.value = ""
        Else
            If current.HasArray Then
                current.FormulaArray = Replace(current.FormulaArray, "_" & (lastList - 1), "_" & lastList)
            Else
                current.Formula = Replace(current.Formula, "_" & (lastList - 1), "_" & lastList)
            End If
        End If
cont:
    Next name_rng
    
    Dim xTable As ListObject
    
    For i = sheetAP.ListObjects.count To 1 Step -1
        Set xTable = sheetAP.ListObjects(i)
        
        If xTable.name Like name & "##*" Then
            xTable.name = new_name
            
            For X = 1 To xTable.ListRows.count
                xTable.ListRows(1).Delete
            Next X
            
            Exit For
        End If
    Next i
    
    For i = sheetAP.ListObjects.count To 1 Step -1
        Set xTable = sheetAP.ListObjects(i)
        
        If xTable.name Like prev_src_name & "##*" Then
            xTable.name = new_src_name
            Exit For
        End If
    Next i
        
    ' находим столбцы данных давления, температуры, вязкости
    Dim PCol As Integer
    Dim VCol As Integer
    Dim TCol As Integer
    
    PCol = xTable.ListColumns("VPR P").Range.Column
    VCol = xTable.ListColumns("VPR d").Range.Column
    TCol = xTable.ListColumns("VPR T").Range.Column
    
    ' создаем именованные диапазоны
    ActiveWorkbook.Names.Add name:=new_name & "_P", RefersToR1C1:= _
        "=OFFSET(AP!R" & dataRow & "C" & PCol & ", 0, 0, COUNT(" & new_src_name & "[VPR P]), 1)"
        
    ActiveWorkbook.Names.Add name:=new_name & "_d", RefersToR1C1:= _
        "=OFFSET(AP!R" & dataRow & "C" & VCol & ", 0, 0, COUNT(" & new_src_name & "[VPR d]), 1)"
        
    ActiveWorkbook.Names.Add name:=new_name & "_Tt", RefersToR1C1:= _
        "=OFFSET(AP!R" & dataRow & "C" & TCol & ", 0, 0, COUNT(" & new_src_name & "[VPR T]), 1)"
    
    sheetAP.Range(new_name & "_ka").FormulaArray = "=LINEST(" & new_name & "_d, " & new_name & "_P^{1,2}, 1, 0)"
    
    Dim chrt As Chart

    For i = sheetAP.Shapes.count To 1 Step -1
        If sheetAP.Shapes(i).Type = 3 Then
            If sheetAP.Shapes(i).TopLeftCell.Column = sheetAP.Shapes("AP_1_chart").TopLeftCell.Column + lenght * (lastList - 1) Then
                sheetAP.Shapes(i).name = new_name & "_chart"
                Set chrt = sheetAP.Shapes(i).Chart
            End If
        End If
    Next i
    
    xTable.ShowAutoFilterDropDown = False
    
    chrt.FullSeriesCollection(1).XValues = _
        "='" & ActiveWorkbook.name & "'!" & new_name & "_P"
        
    chrt.FullSeriesCollection(1).values = _
        "='" & ActiveWorkbook.name & "'!" & new_name & "_d"
    
    With sheetAP
        .Range(.Cells(dataRow, firstColumn + 2), .Cells(dataRow, firstColumn + 4)).value = 0
        .Range(.Cells(dataRow + 1, firstColumn + 2), .Cells(dataRow + xTable.ListRows.count - 1, firstColumn + 4)).ClearContents
    End With
    
    Dim sh As CheckBox
    Dim count As Integer
    
    count = 0
    sheetAP.Activate
    
    For X = sheetAP.CheckBoxes.count To 1 Step -1
        Set sh = sheetAP.CheckBoxes(X)
        
        If sh.TopLeftCell.Column >= sheetAP.Range("AP_" & lastList & "_Correct").Column Then
            dataRow = sh.TopLeftCell.row - xTable.HeaderRowRange.row
            
            If dataRow < 0 Then
                sh.name = "CheckBox_" & lastList
                sh.value = xlOn
            Else
                sh.name = "CheckBox_AP_" & lastList & "_" & dataRow
            End If
            
            sh.linkedCell = sh.TopLeftCell.Address
            
            count = count + 1
            
            If count = xTable.ListRows.count + 1 Then
                Exit For
            End If
        End If
    Next X
    sheetAP.Range(new_src_name & "[" & COL_ROW_ID_DB & "]").ClearContents
    sheetAP.Range(new_src_name & "[[Давление, psig]:[Плотность, г/см3]]").ClearContents
    sheetAP.Range(new_src_name & "[[Давление, psig]:[Активна]]").Resize(1, 3).value = 0
    sheetAP.Range(new_src_name & "[Активна]").value = True
    
    sheetAP.Range(new_name & "_sampleCode").Resize(1, 2).Locked = False
    sheetAP.Range(new_name & "_sampleCode").Interior.Color = xlNone
    
    sheetAP.Range(new_name & "_TaskId").Resize(1, 2).Locked = False
    sheetAP.Range(new_name & "_TaskId").Interior.Color = xlNone
    
End Sub

Sub equipmentModelsRefreshAP()

    Dim sheetAP As Worksheet
    Set sheetAP = ActiveWorkbook.Sheets("AP")
    
    Dim eq() As String
    
    eq = getEquipmentModels("", "Density")
    Dim strEq As String
    strEq = eq(1)
    
    Dim i As Long
    
    For i = 2 To UBound(eq)
        strEq = strEq & "," & eq(i)
    Next i
    
    Dim CellTS As Range
    i = 1
    
    On Error Resume Next
    Do While True
        Set CellTS = Nothing
        Set CellTS = sheetAP.Range("AP_" & i & "_apEquipment")
        If CellTS Is Nothing Then Exit Do
        
        With CellTS.Validation
            .Delete
            .Add Type:=xlValidateList, AlertStyle:=xlValidAlertStop, Operator:= _
            xlBetween, Formula1:=strEq
            .IgnoreBlank = True
            .InCellDropdown = True
            .ShowInput = True
            .ShowError = True
        End With
        i = i + 1
    Loop
    On Error GoTo 0
    
End Sub

Public Function Validate_AP() As macroResult
    Validate_AP = Save_AP("Валидировано")
End Function

Public Function Save_AP(Optional ByVal taskStatus As String = "") As macroResult
    On Error GoTo ErrHandler
    
    Save_AP = MACRO_FAILED
    
    Dim wb As Workbook
    Set wb = ActiveWorkbook
    
    Dim newHashResult As String
    Dim oldHashResult As String
    Dim lastWorkflowStage As String
    
    newHashResult = CalculateCurrentAPHash()
    
    oldHashResult = _
        GetWorkbookMetadataProperty( _
            wb, _
            PROP_AP_DATA_HASH _
        )
    
    lastWorkflowStage = _
        GetWorkbookMetadataProperty( _
            wb, _
            PROP_AP_LAST_WORKFLOW_STAGE _
        )
    Dim needToSave As shouldSave
    needToSave = ShouldSaveStudy(newHashResult, oldHashResult, lastWorkflowStage, taskStatus)
    If needToSave = DATA_NO_CHANGES Then
        Save_AP = MACRO_NO_CHANGES
        Exit Function
        
    ElseIf needToSave = DATA_EMPTY Then
        Call SetWorkbookMetadataProperty(wb, PROP_AP_DATA_HASH, newHashResult, False)
        Call SetWorkbookMetadataProperty(wb, PROP_AP_LAST_WORKFLOW_STAGE, EffectiveWorkflowStage(taskStatus), False)
        SetStudySyncStatus wb, PROP_AP_DATA_STATE, SYNC_STATUS_EMPTY, False
        Exit Function
    ElseIf needToSave = DATA_DELETED Then
        SetStudySyncStatus wb, PROP_AP_DATA_STATE, SYNC_STATUS_ERROR, False
        Exit Function
    End If
    
    Dim sheetAP As Worksheet
    Set sheetAP = wb.Worksheets("AP")

    Dim sheetAPresults As Worksheet
    Set sheetAPresults = wb.Worksheets("AP_results")

    Dim sheetAPSourceData As Worksheet
    Set sheetAPSourceData = wb.Worksheets("AP_sourceData")

    Dim APTable As ListObject
    Set APTable = sheetAPresults.ListObjects("AP_results")

    Dim APSourceDataTable As ListObject
    Set APSourceDataTable = sheetAPSourceData.ListObjects("AP_sourceData")

    Dim parentRows As Collection
    Set parentRows = New Collection

    Dim childRows As Collection
    Set childRows = New Collection
    
    Dim i As Long
    Dim X As Long

    i = 1
    
    Dim formState As APFormState
    Dim newResultIDs As Collection
    Set newResultIDs = New Collection

    Do While NamedRangeExists(wb, "AP_" & i & "_sampleCode")

        formState = Get_AP_FormState(i)
        
        Select Case formState

            Case AP_FORM_EMPTY
                GoTo NextForm
    
            Case AP_FORM_RESERVED
                GoTo NextForm
    
            Case AP_FORM_FILLED
                
        End Select
        
        If sheetAP.Range("AP_" & i & "_TaskId").Interior.ColorIndex = 3 Then
            GoTo NextForm
        End If
        
        If sheetAP.Range("AP_" & i & "_analyseNumber").value = "" Then
            Call checkNumberAnalys2(sheetAP.Range("AP_" & i & "_sampleCode").value, "AP")
        End If
        
        If Not Validate_AP_Form(i) Then
            Exit Function
        End If

        Dim resultIdValue As Variant
        Dim parentKey As String

        resultIdValue = sheetAP.Range("AP_" & i & "_resultIdAP").value

        If Len(NormalizeKeyValue(resultIdValue)) = 0 Or NormalizeKeyValue(resultIdValue) = "0" Then
            parentKey = "temp_" & i
        Else
            parentKey = NormalizeKeyValue(resultIdValue)
        End If

        Dim parentRow() As Variant
        ReDim parentRow(1 To APTable.ListColumns.count)

        Dim headerCell As Range
        Dim headerName As String
        Dim parentColIndex As Long
        Dim formatValue As Variant
        
        For Each headerCell In APTable.HeaderRowRange.Cells
            headerName = CStr(headerCell.value)
            parentColIndex = APTable.ListColumns(headerName).index

            If headerName = "dateTimeSync" Then
                parentRow(parentColIndex) = Format$(Now, "yyyy-mm-dd hh:nn:ss")
            ElseIf headerName = "resultIdAP" Then
                parentRow(parentColIndex) = parentKey
                If IsNumeric(parentKey) Then
                    newResultIDs.Add parentKey
                End If
            Else
                formatValue = FormatValueForSyncText( _
                    headerName, _
                    sheetAP.Range("AP_" & i & "_" & headerName).value _
                )
                parentRow(parentColIndex) = formatValue
            End If

        Next headerCell

        parentRows.Add parentRow

        Dim srcTable As ListObject
        Set srcTable = sheetAP.ListObjects("AP_source_" & i)
        
        If SourceTableNeedsCompact( _
            srcTable, _
            Array(COL_PRESSURE_FORM, COL_DENSITY_FORM), _
            Array("AND") _
        ) Then
            Call CompactSourceTable( _
                srcTable, _
                Array(COL_PRESSURE_FORM, COL_DENSITY_FORM), _
                Array(COL_PRESSURE_FORM, COL_TEMPERATURE_FORM, _
                    COL_DENSITY_FORM, COL_ACTIVE_FORM, COL_ROW_ID_DB), _
                COL_ROW_ID_DB _
            )
        End If

        Dim pressureCol As Long
        Dim temperatureCol As Long
        Dim densityCol As Long
        Dim activeCol As Long

        pressureCol = srcTable.ListColumns(COL_PRESSURE_FORM).index
        temperatureCol = srcTable.ListColumns(COL_TEMPERATURE_FORM).index
        densityCol = srcTable.ListColumns(COL_DENSITY_FORM).index
        activeCol = srcTable.ListColumns(COL_ACTIVE_FORM).index

        For X = 1 To srcTable.ListRows.count

            Dim hasSourceData As Boolean
            Dim oldRowIdAP As String
        
            hasSourceData = SourceRowHasData( _
                srcTable, _
                X, _
                Array(COL_PRESSURE_FORM, COL_DENSITY_FORM), _
                Array("AND") _
            )
            oldRowIdAP = NormalizeKeyValue( _
                srcTable.DataBodyRange.Cells(X, srcTable.ListColumns(COL_ROW_ID_DB).index).value _
            )
            
            If hasSourceData Or Len(oldRowIdAP) > 0 Then
                
                Dim childRow() As Variant
                ReDim childRow(1 To APSourceDataTable.ListColumns.count)
        
                childRow(APSourceDataTable.ListColumns(COL_ROW_ID_DB).index) = oldRowIdAP
                childRow(APSourceDataTable.ListColumns(COL_RESULT_ID_DB).index) = parentKey
                
                If hasSourceData Then
                    formatValue = FormatValueForSyncText(COL_PRESSURE_DB, srcTable.DataBodyRange.Cells(X, pressureCol).value)
                    childRow(APSourceDataTable.ListColumns(COL_PRESSURE_DB).index) = formatValue

                    formatValue = FormatValueForSyncText(COL_TEMPERATURE_DB, srcTable.DataBodyRange.Cells(X, temperatureCol).value)
                    childRow(APSourceDataTable.ListColumns(COL_TEMPERATURE_DB).index) = formatValue

                    formatValue = FormatValueForSyncText(COL_DENSITY_DB, srcTable.DataBodyRange.Cells(X, densityCol).value)
                    childRow(APSourceDataTable.ListColumns(COL_DENSITY_DB).index) = formatValue

                    formatValue = FormatValueForSyncText(COL_ACTIVE_DB, srcTable.DataBodyRange.Cells(X, activeCol).value)
                    childRow(APSourceDataTable.ListColumns(COL_ACTIVE_DB).index) = formatValue

                End If

                childRows.Add childRow

            End If
        
        Next X

NextForm:
        i = i + 1
    Loop

    Dim cellID As Range
    Dim oldResultID As String

    If Not APTable.DataBodyRange Is Nothing Then

        For Each cellID In _
            APTable.ListColumns(COL_RESULT_ID_DB).DataBodyRange.Cells

            If Not IsError(cellID.value) Then

                oldResultID = NormalizeKeyValue(cellID.value)

                ' Проверяем только реальные ID из БД.
                If IsNumeric(oldResultID) And oldResultID <> "0" Then

                    If Not CollectionContains( _
                        newResultIDs, _
                        oldResultID _
                    ) Then

                        MsgBox _
                            "Удалены данные синхронизированной формы AP. " & _
                            "Синхронизация невозможна. " & _
                            "Вызовите загрузку данных из БД.", _
                            vbExclamation

                        Save_AP = MACRO_FAILED
                        Exit Function

                    End If

                End If

            End If

        Next cellID

    End If
    
    WriteCollectionToListObject APTable, parentRows
    WriteCollectionToListObject APSourceDataTable, childRows
    
    Dim syncResult As String
    syncResult = RunStudySync("save", studies:="AP", taskStatus:=taskStatus)

    If InStr(1, syncResult, """ok"": true", vbTextCompare) > 0 Then
        Call DeleteEmptyRowsByColumns( _
            APSourceDataTable, _
            COL_ROW_ID_DB, _
            Array(COL_PRESSURE_DB, COL_DENSITY_DB) _
        )
        Call Load_AP_results_to_forms("by_key", Array(COL_RESULT_ID_DB, COL_ROW_ID_DB))
        
        newHashResult = CalculateCurrentAPHash()
        
        Call SetWorkbookMetadataProperty(wb, PROP_AP_DATA_HASH, newHashResult, False)
        Call SetWorkbookMetadataProperty(wb, PROP_AP_LAST_WORKFLOW_STAGE, EffectiveWorkflowStage(taskStatus), False)
        
        SetStudySyncStatus _
            wb, _
            PROP_AP_DATA_STATE, _
            SYNC_STATUS_SYNCED, _
            False

        ClearStudyHashCheck wb, "AP"
    Else
        MsgBox "Python-синхронизация AP не подтвердила успешное сохранение." & vbCrLf & vbCrLf & _
                syncResult, vbExclamation
        Exit Function
    End If
    
    Save_AP = MACRO_CHANGED
    Exit Function

ErrHandler:
    Debug.Print Err.Number & ": " & Err.Description
    Save_AP = MACRO_FAILED
End Function

Public Function CalculateCurrentAPHash() As String

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim Data As Object
    Set Data = Build_AP_HashData(wb)

    CalculateCurrentAPHash = _
        CalculateDataHash(Data)

End Function

Private Function Build_AP_HashData( _
    ByVal wb As Workbook _
) As Object

    Dim Data As Object
    Set Data = CreateObject("Scripting.Dictionary")

    Dim sheetAP As Worksheet
    Set sheetAP = wb.Worksheets("AP")

    Dim APTable As ListObject
    Set APTable = _
        wb.Worksheets("AP_results") _
          .ListObjects("AP_results")

    Dim i As Long
    Dim formIndex As Long

    i = 1
    formIndex = 0

    Do While NamedRangeExists( _
        wb, _
        "AP_" & i & "_sampleCode" _
    )

        Dim formState As APFormState
        formState = Get_AP_FormState(i)

        Select Case formState

            Case AP_FORM_EMPTY, _
                 AP_FORM_RESERVED

                GoTo NextForm

            Case AP_FORM_FILLED

                ' идём дальше

        End Select

        ' Если такие формы принципиально не участвуют
        ' в сохранении — не включаем их и в хеш.
        If sheetAP.Range( _
            "AP_" & i & "_TaskId" _
        ).Interior.ColorIndex = 3 Then

            GoTo NextForm

        End If

        formIndex = formIndex + 1

        ' =========================================================
        ' РОДИТЕЛЬСКИЕ ПОЛЯ
        ' =========================================================

        Dim headerCell As Range
        Dim headerName As String
        Dim formatValue As Variant

        For Each headerCell _
            In APTable.HeaderRowRange.Cells

            headerName = CStr(headerCell.value)

            Select Case headerName

                Case "dateTimeSync", _
                     "resultIdAP"

                    ' Эти поля не влияют на пользовательские данные.

                Case Else

                    formatValue = _
                        FormatValueForSyncText( _
                            headerName, _
                            sheetAP.Range( _
                                "AP_" & i & "_" & headerName _
                            ).value _
                        )

                    Data.Add _
                        formIndex & "." & headerName, _
                        formatValue

            End Select

        Next headerCell

        ' =========================================================
        ' ДОЧЕРНЯЯ ТАБЛИЦА
        ' =========================================================

        Dim srcTable As ListObject
        Set srcTable = _
            sheetAP.ListObjects( _
                "AP_source_" & i _
            )

        Dim pressureCol As Long
        Dim temperatureCol As Long
        Dim densityCol As Long
        Dim activeCol As Long

        pressureCol = _
            srcTable.ListColumns( _
                COL_PRESSURE_FORM _
            ).index

        temperatureCol = _
            srcTable.ListColumns( _
                COL_TEMPERATURE_FORM _
            ).index

        densityCol = _
            srcTable.ListColumns( _
                COL_DENSITY_FORM _
            ).index

        activeCol = _
            srcTable.ListColumns( _
                COL_ACTIVE_FORM _
            ).index

        Dim X As Long
        Dim sourceIndex As Long

        sourceIndex = 0

        For X = 1 To srcTable.ListRows.count

            If SourceRowHasData( _
                srcTable, _
                X, _
                Array( _
                    COL_PRESSURE_FORM, _
                    COL_DENSITY_FORM _
                ), _
                Array("AND") _
            ) Then

                sourceIndex = sourceIndex + 1

                formatValue = _
                    FormatValueForSyncText( _
                        COL_PRESSURE_DB, _
                        srcTable.DataBodyRange.Cells( _
                            X, _
                            pressureCol _
                        ).value _
                    )

                Data.Add _
                    formIndex & "." & _
                    COL_PRESSURE_DB & "." & sourceIndex, _
                    formatValue


                formatValue = _
                    FormatValueForSyncText( _
                        COL_TEMPERATURE_DB, _
                        srcTable.DataBodyRange.Cells( _
                            X, _
                            temperatureCol _
                        ).value _
                    )

                Data.Add _
                    formIndex & "." & _
                    COL_TEMPERATURE_DB & "." & sourceIndex, _
                    formatValue


                formatValue = _
                    FormatValueForSyncText( _
                        COL_DENSITY_DB, _
                        srcTable.DataBodyRange.Cells( _
                            X, _
                            densityCol _
                        ).value _
                    )

                Data.Add _
                    formIndex & "." & _
                    COL_DENSITY_DB & "." & sourceIndex, _
                    formatValue


                formatValue = _
                    FormatValueForSyncText( _
                        COL_ACTIVE_DB, _
                        srcTable.DataBodyRange.Cells( _
                            X, _
                            activeCol _
                        ).value _
                    )

                Data.Add _
                    formIndex & "." & _
                    COL_ACTIVE_DB & "." & sourceIndex, _
                    formatValue

            End If

        Next X

NextForm:
        i = i + 1

    Loop

    Set Build_AP_HashData = Data

End Function

Private Function CheckAPTask( _
    ByVal taskId As Long, _
    ByVal sampleCode As String, _
    ByVal temperature As Variant, _
    ByVal pageNumber As Long _
) As String

    Dim tasks As ListObject
    Set tasks = ActiveWorkbook.Worksheets("Task").ListObjects(1)

    Dim taskCheck As Range
    Set taskCheck = tasks.ListColumns("Номер задания").DataBodyRange.Find( _
        What:=taskId, _
        LookAt:=xlWhole, _
        SearchOrder:=xlByColumns _
    )

    If taskCheck Is Nothing Then
        CheckAPTask = "Указан неизвестный номер анализа " & taskId & _
               " на странице " & pageNumber & _
               ". Попробуйте обновить данные проекта или исправьте значение."
        Exit Function
    End If

    Dim taskRowIndex As Long
    taskRowIndex = taskCheck.row - tasks.DataBodyRange.row + 1

    If CStr(tasks.ListColumns("Код проекта").DataBodyRange.Cells(taskRowIndex, 1).value) <> sampleCode Then
        CheckAPTask = "Указан неверный номер анализа " & taskId & _
               " на странице " & pageNumber & _
               ". Шифр пробы в задании отличается от шифра пробы в исследовании. " & _
               "Исправьте номер задания или выберите верную форму для внесения."
        Exit Function
    Else
        If IsNumeric(tasks.ListColumns("Тэкс, °C").DataBodyRange.Cells(taskRowIndex, 1).value) And _
                IsNumeric(temperature) Then
            If Abs(CDbl(tasks.ListColumns("Тэкс, °C").DataBodyRange.Cells(taskRowIndex, 1).value) - temperature) > 0.5 Then
                CheckAPTask = "Температура исследования в задании " & taskId & _
                    " на странице " & pageNumber & _
                    " отличается от фактической более чем на 0,5 C. " & _
                    "Исправьте номер задания или выберите верную форму для внесения."
                Exit Function
            End If
        End If
    End If

    CheckAPTask = "OK"

End Function


Public Function Load_AP_results_to_forms( _
    Optional ByVal mode As String = "by_key", _
    Optional ByVal fields As Variant, _
    Optional ByVal silence As Boolean = False _
) As String
    
    On Error GoTo CleanFail
    
    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetAP As Worksheet
    Set sheetAP = wb.Worksheets("AP")

    Dim resultTable As ListObject
    Set resultTable = wb.Worksheets("AP_results").ListObjects("AP_results")

    Dim sourceTable As ListObject
    Set sourceTable = wb.Worksheets("AP_sourceData").ListObjects("AP_sourceData")

    Dim fieldFilter As Object
    Set fieldFilter = BuildFieldFilter(fields)
    
    Dim text As String
    Dim warnText As String
    
    mode = LCase$(Trim$(mode))

    If mode <> "by_key" And mode <> "sequential" Then
        text = "ERROR|mode должен быть 'by_key' или 'sequential'"
        Load_AP_results_to_forms = text
        If Not silence Then
            MsgBox text, vbExclamation
        End If
        Exit Function
    End If

    If resultTable.DataBodyRange Is Nothing Or _
            Application.WorksheetFunction.CountA(resultTable.DataBodyRange) = 0 Then
        text = "OK|Таблица AP_results пустая."
        Load_AP_results_to_forms = text
        If Not silence Then
            'MsgBox text, vbInformation
        End If
        Exit Function
    End If

    Dim resultRowIndex As Long
    Dim formIndex As Long
    Dim notFoundCount As Long

    For resultRowIndex = 1 To resultTable.ListRows.count

        If mode = "sequential" Then
            formIndex = resultRowIndex
            EnsureAPFormExists wb, formIndex
        Else
            formIndex = FindFormIndexForResultRow( _
                wb, _
                sheetAP, _
                resultTable, _
                resultRowIndex, _
                "AP", _
                Array("sampleCode", "analyseNumber") _
            )
        End If

        If formIndex = 0 Or Not NamedRangeExists(wb, "AP_" & formIndex & "_sampleCode") Then
            notFoundCount = notFoundCount + 1
            warnText = warnText & "Не найдена форма для строки AP_results #" & resultRowIndex & vbCrLf & _
                   "sampleCode = " & GetTableValue(resultTable, resultRowIndex, "sampleCode") & vbCrLf & _
                   "TaskId = " & GetTableValue(resultTable, resultRowIndex, "TaskId") & vbCrLf & _
                   "analyseNumber = " & GetTableValue(resultTable, resultRowIndex, "analyseNumber") & vbCrLf & vbCrLf
            GoTo NextResultRow
        End If

        FillOneAPFormFromResultRow _
            wb, _
            sheetAP, _
            resultTable, _
            sourceTable, _
            resultRowIndex, _
            formIndex, _
            fieldFilter

NextResultRow:
    Next resultRowIndex

    If notFoundCount = 0 Then
        Load_AP_results_to_forms = "OK|Данные AP перенесены в формы."
    Else
        text = "WARN|Данные AP перенесены частично. Не найдено форм: " & notFoundCount & vbCrLf & warnText
        Load_AP_results_to_forms = text
        If Not silence Then
            MsgBox text, vbExclamation
        End If
    End If
    
    Exit Function
    
CleanFail:
    text = _
        "ERROR|" & _
        CStr(Err.Number) & "|" & _
        Err.Description

    Load_AP_results_to_forms = text

    If Not silence Then
        MsgBox text, vbCritical
    End If
End Function

Private Sub EnsureAPFormExists( _
    ByVal wb As Workbook, _
    ByVal formIndex As Long _
)
    Do While Not NamedRangeExists(wb, "AP_" & formIndex & "_sampleCode")
        Call AddFormAP
    Loop
End Sub

Private Sub FillOneAPFormFromResultRow( _
    ByVal wb As Workbook, _
    ByVal sheetAP As Worksheet, _
    ByVal resultTable As ListObject, _
    ByVal sourceTable As ListObject, _
    ByVal resultRowIndex As Long, _
    ByVal formIndex As Long, _
    ByVal fieldFilter As Object _
)
    Dim resultId As Variant
    resultId = GetTableValue(resultTable, resultRowIndex, COL_RESULT_ID_DB)

    Call CopyTableRowToNamedRanges( _
        wb, _
        sheetAP, _
        resultTable, _
        resultRowIndex, _
        "AP", _
        formIndex, _
        fieldFilter _
    )

    If Len(Trim$(CStr(resultId))) > 0 Then
        FillAPSourceTableFromSourceData sheetAP, sourceTable, formIndex, resultId, fieldFilter
    End If
End Sub


Private Sub FillAPSourceTableFromSourceData( _
    ByVal sheetAP As Worksheet, _
    ByVal sourceTable As ListObject, _
    ByVal formIndex As Long, _
    ByVal resultId As Variant, _
    ByVal fieldFilter As Object _
)
    Dim formSourceTable As ListObject
    Set formSourceTable = sheetAP.ListObjects("AP_source_" & formIndex)

    If formSourceTable.DataBodyRange Is Nothing Then
        Exit Sub
    End If

    Call ClearMappedColumnsInTable( _
        formSourceTable, _
        APSourceLoadMappings(), _
        fieldFilter _
    )

    Call CopyMatchingTableRowsToTableRows( _
        sourceTable, _
        formSourceTable, _
        COL_RESULT_ID_DB, _
        resultId, _
        APSourceLoadMappings(), _
        fieldFilter _
    )
End Sub


