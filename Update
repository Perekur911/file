Private Const COL_ROW_ID_REC_CHILD_DB As String = "rowIdRec"
Private Const COL_MIX_SAMPLE_CODE_CHILD_DB As String = "mixSampleCode"
Private Const COL_MASS_FRACTION_CHILD_DB As String = "massFraction"
Private Const COL_P_TRANSFER_CHILD_DB As String = "Ptransfer"
Private Const COL_T_TRANSFER_CHILD_DB As String = "Ttransfer"
Private Const COL_DENSITY_CHILD_DB As String = "Density"
Private Const COL_FIRST_CHILD_DB As String = "first"
Private Const COL_VOLUME_CHILD_DB As String = "Volume"
Private Const COL_MASS_CHILD_DB As String = "Mass"

Private Const COL_RESULT_ID_REC_DB As String = "resultIdRec"
Private Const COL_TASK_ID_DB As String = "TaskId"
Private Const COL_SAMPLE_CODE_DB As String = "sampleCode"
Private Const COL_OPERATOR_DB As String = "operator"
