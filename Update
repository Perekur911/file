Public Function CreateSampleCodeCVD3( _
    Optional ByVal formIndex As Long = 0, _
    Optional ByVal stepKey As String = "" _
) As Boolean

    CreateSampleCodeCVD3 = False

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetCVD As Worksheet
    Set sheetCVD = wb.Worksheets("CVD")

    If formIndex <= 0 Then Exit Function

    stepKey = LCase$(Trim$(stepKey))

    If stepKey = "" Then
        MsgBox "Не указан step для создания шифров CVD.", vbExclamation
        Exit Function
    End If

    If Not NamedRangeExists(wb, "CVD_" & formIndex & "_sampleCode") Then
        MsgBox "Форма CVD_" & formIndex & " не найдена.", vbExclamation
        Exit Function
    End If

    Dim baseSampleCode As String
    baseSampleCode = Trim$(CStr(sheetCVD.Range("CVD_" & formIndex & "_sampleCode").value))

    If baseSampleCode = "" Then
        MsgBox "Не заполнен шифр исследуемой пробы.", vbExclamation
        Exit Function
    End If

    Dim lphRangeName As String
    Dim gphRangeName As String

    lphRangeName = "CVD_" & formIndex & "_" & stepKey & "_sampleCodeLPh"
    gphRangeName = "CVD_" & formIndex & "_" & stepKey & "_sampleCodeGPh"

    If Not NamedRangeExists(wb, lphRangeName) Then
        MsgBox "Не найден диапазон: " & lphRangeName, vbExclamation
        Exit Function
    End If

    If Not NamedRangeExists(wb, gphRangeName) Then
        MsgBox "Не найден диапазон: " & gphRangeName, vbExclamation
        Exit Function
    End If

    Dim sampleCodeLPh As New Collection
    Dim sampleCodeGPh As New Collection

    Dim existingLPh As String
    Dim existingGPh As String

    existingLPh = Trim$(CStr(sheetCVD.Range(lphRangeName).value))
    existingGPh = Trim$(CStr(sheetCVD.Range(gphRangeName).value))

    If existingLPh <> "" Then
        sampleCodeLPh.Add existingLPh
    End If

    If existingGPh <> "" Then
        sampleCodeGPh.Add existingGPh
    End If

    If existingLPh = "" And existingGPh = "" Then

        Dim stepPostfix As String

        If stepKey = "last" Then
            stepPostfix = "laststep"
        Else
            stepPostfix = stepKey
        End If

        sampleCodeLPh.Add baseSampleCode & "-CVD-" & stepPostfix & "-Rinse"
        sampleCodeGPh.Add baseSampleCode & "-CVD-" & stepPostfix & "-G"

    End If

    Dim frm As New frmCheckCodes
    frm.InitWithCollections sampleCodeLPh, sampleCodeGPh, "CVD", sheetCVD.Range("CVD_" & formIndex & "_sampleCode"), formIndex
    frm.Show

    If Not frm.result Then
        MsgBox "Ввод шифров для CVD_" & formIndex & "_" & stepKey & " отменен.", vbInformation
        Exit Function
    End If

    sheetCVD.Range(lphRangeName).NumberFormat = "@"
    sheetCVD.Range(gphRangeName).NumberFormat = "@"

    If sampleCodeLPh.count > 0 Then
        sheetCVD.Range(lphRangeName).value = sampleCodeLPh(1)
    Else
        sheetCVD.Range(lphRangeName).value = vbNullString
    End If

    If sampleCodeGPh.count > 0 Then
        sheetCVD.Range(gphRangeName).value = sampleCodeGPh(1)
    Else
        sheetCVD.Range(gphRangeName).value = vbNullString
    End If

    If sampleCodeLPh.count = 0 And sampleCodeGPh.count = 0 Then
        MsgBox "Для CVD_" & formIndex & "_" & stepKey & " не указан ни один шифр полученной пробы.", vbExclamation
        Exit Function
    End If

    CreateSampleCodeCVD3 = True

End Function
