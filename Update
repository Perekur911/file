3. В equipment_catalog.py убери чтение свойства через COM.

Замени начало refresh_for_book — от объявления функции до проверки совпадения хэшей включительно — следующим кодом:

def refresh_for_book(book, db_path, *, saved_hash=None, force=False):
    if saved_hash is None:
        raise ValueError(
            f"Не передан сохранённый {HASH_PROPERTY} из VBA."
        )

    logger = logging.getLogger("refresh_tasks")

    started_at = perf_counter()
    catalog, new_hash = read_catalog(db_path)

    logger.info(
        "Оборудование: чтение БД и расчёт хэша — %.3f с",
        perf_counter() - started_at,
    )

    old_hash = str(saved_hash or "")

    logger.info(
        "Оборудование: сравнение хэшей; "
        "old=%r; new=%r; force=%s",
        old_hash,
        new_hash,
        force,
    )

    if not force and old_hash == new_hash:
        return {
            "ok": True,
            "changed": False,
            "catalog_hash": new_hash,
        }

