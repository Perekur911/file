Private Function Validate_Rec_Form( _
    ByVal formIndex As Long _
) As Boolean

    Validate_Rec_Form = False

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetREC As Worksheet
    Set sheetREC = wb.Worksheets("Rec")

    Dim recTable As ListObject
    Set recTable = _
        wb.Worksheets("Rec_results") _
          .ListObjects("Rec_results")

    Dim errors As String
    Dim errorCount As Long

    If formIndex <= 0 Then

        MsgBox _
            "Некорректный номер формы REC: " & formIndex, _
            vbExclamation

        Exit Function

    End If

    If Not NamedRangeExists( _
        wb, _
        "Rec_" & formIndex & "_" & COL_SAMPLE_CODE_DB _
    ) Then

        MsgBox _
            "Форма Rec_" & formIndex & " не найдена.", _
            vbExclamation

        Exit Function

    End If

    ' =============================================================
    ' ПРОВЕРКА РОДИТЕЛЬСКИХ ПОЛЕЙ REC_RESULTS
    ' =============================================================

    Dim headerCell As Range
    Dim rng As Range
    Dim valueCell As Range

    Dim fieldName As String
    Dim fieldCaption As String
    Dim rangeName As String

    Dim fieldValue As Variant
    Dim valueText As String

    For Each headerCell In recTable.HeaderRowRange.Cells

        fieldName = Trim$(CStr(headerCell.value))

        If LCase$(fieldName) = "datetimesync" Then
            GoTo next_parent_field
        End If

        rangeName = _
            "Rec_" & formIndex & "_" & fieldName

        If Not NamedRangeExists(wb, rangeName) Then

            AddValidationError _
                errors, _
                errorCount, _
                "Не найден именованный диапазон: " & rangeName

            GoTo next_parent_field

        End If

        Set rng = GetNamedRangeStrict(wb, rangeName)
        Set valueCell = rng.Cells(1, 1)

        ' Снимаем результат предыдущей валидации.
        ClearValidationFill rng

        fieldValue = valueCell.value
        fieldCaption = REC_FieldCaption(fieldName)

        If IsError(fieldValue) Then

            AddValidationError _
                errors, _
                errorCount, _
                rangeName & _
                " содержит ошибку Excel: " & _
                valueCell.text & _
                " (" & valueCell.Worksheet.name & _
                "!" & valueCell.Address(False, False) & ")", _
                rng

            GoTo next_parent_field

        End If

        valueText = Trim$(CStr(fieldValue))

        ' =========================================================
        ' ГРУППА 1. ОБЯЗАТЕЛЬНЫЕ НЕПУСТЫЕ ПОЛЯ
        ' =========================================================

        Select Case fieldName

            Case COL_SAMPLE_CODE_DB, _
                 COL_OPERATOR_DB, _
                 COL_DATE_DB, _
                 COL_EQUIPMENT_FOR_TRANSFER_DB, _
                 COL_EQUIPMENT_NUMBER_DB, _
                 COL_TYPE_SAMPLER_DB, _
                 COL_NUMBER_SAMPLER_DB

                If valueText = "" Then

                    AddValidationError _
                        errors, _
                        errorCount, _
                        "Не заполнено обязательное поле """ & _
                        fieldCaption & """: " & rangeName, _
                        rng

                End If

        End Select

        ' =========================================================
        ' ГРУППА 2. ЧИСЛОВЫЕ ПОЛЯ
        ' =========================================================

        Select Case fieldName

            Case COL_RESULT_ID_REC_DB, _
                 COL_TASK_ID_DB

                If valueText <> "" Then

                    If Not IsNumeric(fieldValue) Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Поле """ & fieldCaption & _
                            """ должно содержать число: " & _
                            rangeName, _
                            rng

                    End If

                    If fieldName = COL_TASK_ID_DB And valueText <> "" And IsNumeric(fieldValue) Then
                        If CDbl(fieldValue) = Fix(CDbl(fieldValue)) And CDbl(fieldValue) > 0 Then

                            Dim taskCheckResult As String
                            taskCheckResult = CheckRecTask( _
                                CLng(fieldValue), _
                                CStr(sheetREC.Range("Rec_" & formIndex & "_sampleCode").Value), _
                                formIndex)

                            If taskCheckResult <> "OK" Then
                                AddValidationError errors, errorCount, taskCheckResult, rng
                            End If

                        End If
                    End If
                End If

        End Select

        ' =========================================================
        ' ГРУППА 3. ЧИСЛА, КОТОРЫЕ ДОЛЖНЫ БЫТЬ БОЛЬШЕ НУЛЯ
        ' =========================================================

        Select Case fieldName

            Case COL_RESULT_ID_REC_DB, _
                 "page"

                If valueText <> "" _
                   And IsNumeric(fieldValue) Then

                    If CDbl(fieldValue) <= 0 Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Поле """ & fieldCaption & _
                            """ должно быть больше 0: " & _
                            rangeName, _
                            rng

                    End If

                End If

        End Select

        ' =========================================================
        ' ГРУППА 4. ЧИСЛА, КОТОРЫЕ НЕ МОГУТ БЫТЬ ОТРИЦАТЕЛЬНЫМИ
        ' =========================================================

        Select Case fieldName

            Case COL_TASK_ID_DB

                If valueText <> "" _
                   And IsNumeric(fieldValue) Then

                    If CDbl(fieldValue) < 0 Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Поле """ & fieldCaption & _
                            """ не может быть отрицательным: " & _
                            rangeName, _
                            rng

                    End If

                End If

        End Select

        ' =========================================================
        ' ГРУППА 5. ЦЕЛЫЕ ЧИСЛА
        ' =========================================================

        Select Case fieldName

            Case COL_RESULT_ID_REC_DB, _
                 COL_TASK_ID_DB, _
                 "page"

                If valueText <> "" _
                   And IsNumeric(fieldValue) Then

                    If CDbl(fieldValue) <> _
                       Fix(CDbl(fieldValue)) Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Поле """ & fieldCaption & _
                            """ должно содержать целое число: " & _
                            rangeName, _
                            rng

                    End If

                End If

        End Select

        ' =========================================================
        ' ГРУППА 6. ПОЛЯ С ДАТОЙ
        ' =========================================================

        Select Case fieldName

            Case COL_DATE_DB

                If valueText <> "" Then

                    If Not IsDate(fieldValue) Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Поле """ & fieldCaption & _
                            """ должно содержать дату: " & _
                            rangeName, _
                            rng

                    End If

                End If

        End Select

        ' =========================================================
        ' ГРУППА 7. ПОЛЯ ВВОДА ИСПОЛНИТЕЛЯ
        ' =========================================================

        Select Case fieldName

            Case COL_OPERATOR_DB

                If valueText <> "" Then

                    If Not IsValidExecutor(fieldValue) Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Неверно указан исполнитель: " & _
                            rangeName, _
                            rng

                    End If

                End If

        End Select

next_parent_field:
    Next headerCell

    ' =============================================================
    ' ДОЧЕРНИЕ КОМПОНЕНТЫ REC_X_*1 ... REC_X_*12
    ' =============================================================

    Dim childFields As Variant

    childFields = Array( _
        COL_MIX_SAMPLE_CODE_CHILD_DB, _
        COL_MASS_FRACTION_CHILD_DB, _
        COL_P_TRANSFER_CHILD_DB, _
        COL_T_TRANSFER_CHILD_DB, _
        COL_DENSITY_CHILD_DB, _
        COL_FIRST_CHILD_DB, _
        COL_VOLUME_CHILD_DB, _
        COL_MASS_CHILD_DB _
    )

    Dim childStarted() As Boolean
    Dim childIsFirst() As Boolean
    Dim childMassFractionIsValid() As Boolean

    ReDim childStarted(1 To REC_CHILD_COUNT_PER_FORM)
    ReDim childIsFirst(1 To REC_CHILD_COUNT_PER_FORM)
    ReDim childMassFractionIsValid(1 To REC_CHILD_COUNT_PER_FORM)

    Dim childIndex As Long
    Dim fieldIndex As Long

    Dim rowHasAnyData As Boolean
    Dim validChildCount As Long
    Dim firstComponentCount As Long

    Dim massFractionSum As Double
    Dim validMassFractionCount As Long

    For childIndex = 1 To REC_CHILD_COUNT_PER_FORM

        rowHasAnyData = False

        ' ---------------------------------------------------------
        ' СНАЧАЛА ОЧИЩАЕМ ПОДСВЕТКУ И ОПРЕДЕЛЯЕМ,
        ' НАЧАТ ЛИ КОМПОНЕНТ
        ' ---------------------------------------------------------

        For fieldIndex = LBound(childFields) _
                         To UBound(childFields)

            fieldName = CStr(childFields(fieldIndex))

            rangeName = _
                "Rec_" & formIndex & "_" & _
                fieldName & childIndex

            If Not NamedRangeExists(wb, rangeName) Then
                GoTo next_field_state_check
            End If

            Set rng = GetNamedRangeStrict(wb, rangeName)
            Set valueCell = rng.Cells(1, 1)

            ' Убираем старую жёлтую подсветку
            ' даже у полностью очищенного компонента.
            ClearValidationFill rng

            fieldValue = valueCell.value

            If IsError(fieldValue) Then

                rowHasAnyData = True
                Exit For

            End If

            valueText = Trim$(CStr(fieldValue))

            If fieldName = COL_FIRST_CHILD_DB Then

                Select Case LCase$(valueText)

                    Case "", _
                         "false", _
                         "ложь", _
                         "0", _
                         "нет", _
                         "-"

                        ' Значение False само по себе
                        ' не делает компонент заполненным.

                    Case Else

                        rowHasAnyData = True
                        Exit For

                End Select

            ElseIf valueText <> "" Then

                rowHasAnyData = True
                Exit For

            End If

next_field_state_check:
        Next fieldIndex

        childStarted(childIndex) = rowHasAnyData

        If Not rowHasAnyData Then
            GoTo next_child
        End If

        validChildCount = validChildCount + 1

        ' ---------------------------------------------------------
        ' ПРОВЕРКА ПОЛЕЙ ЗАПОЛНЕННОГО КОМПОНЕНТА
        ' ---------------------------------------------------------

        For fieldIndex = LBound(childFields) _
                         To UBound(childFields)

            fieldName = CStr(childFields(fieldIndex))

            rangeName = _
                "Rec_" & formIndex & "_" & _
                fieldName & childIndex

            If Not NamedRangeExists(wb, rangeName) Then

                AddValidationError _
                    errors, _
                    errorCount, _
                    "Компонент " & childIndex & _
                    ": не найден именованный диапазон " & _
                    rangeName & "."

                GoTo next_child_field

            End If

            Set rng = GetNamedRangeStrict(wb, rangeName)
            Set valueCell = rng.Cells(1, 1)

            fieldValue = valueCell.value
            fieldCaption = REC_FieldCaption(fieldName)

            If IsError(fieldValue) Then

                AddValidationError _
                    errors, _
                    errorCount, _
                    "Компонент " & childIndex & _
                    ": поле """ & fieldCaption & _
                    """ содержит ошибку Excel: " & _
                    valueCell.text & _
                    " (" & rangeName & ").", _
                    rng

                GoTo next_child_field

            End If

            valueText = Trim$(CStr(fieldValue))

            ' =====================================================
            ' ГРУППА 1. ОБЯЗАТЕЛЬНЫЕ ПОЛЯ КОМПОНЕНТА
            ' =====================================================

            Select Case fieldName

                Case COL_MIX_SAMPLE_CODE_CHILD_DB, _
                     COL_MASS_FRACTION_CHILD_DB, _
                     COL_P_TRANSFER_CHILD_DB, _
                     COL_T_TRANSFER_CHILD_DB, _
                     COL_DENSITY_CHILD_DB, _
                     COL_VOLUME_CHILD_DB, _
                     COL_MASS_CHILD_DB

                    If valueText = "" Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Компонент " & childIndex & _
                            ": не заполнено обязательное поле """ & _
                            fieldCaption & """ (" & rangeName & ").", _
                            rng

                    End If

            End Select

            ' =====================================================
            ' ГРУППА 2. ЧИСЛОВЫЕ ПОЛЯ КОМПОНЕНТА
            ' =====================================================

            Select Case fieldName

                Case COL_MASS_FRACTION_CHILD_DB, _
                     COL_P_TRANSFER_CHILD_DB, _
                     COL_T_TRANSFER_CHILD_DB, _
                     COL_DENSITY_CHILD_DB, _
                     COL_VOLUME_CHILD_DB, _
                     COL_MASS_CHILD_DB

                    If valueText <> "" Then

                        If Not IsNumeric(fieldValue) Then

                            AddValidationError _
                                errors, _
                                errorCount, _
                                "Компонент " & childIndex & _
                                ": поле """ & fieldCaption & _
                                """ должно содержать число " & _
                                "(" & rangeName & ").", _
                                rng

                        End If

                    End If

            End Select

            ' =====================================================
            ' ГРУППА 3. ЧИСЛА, КОТОРЫЕ ДОЛЖНЫ БЫТЬ БОЛЬШЕ НУЛЯ
            ' =====================================================

            Select Case fieldName

                Case COL_MASS_FRACTION_CHILD_DB, _
                     COL_P_TRANSFER_CHILD_DB, _
                     COL_DENSITY_CHILD_DB, _
                     COL_VOLUME_CHILD_DB, _
                     COL_MASS_CHILD_DB

                    If valueText <> "" _
                       And IsNumeric(fieldValue) Then

                        If CDbl(fieldValue) <= 0 Then

                            AddValidationError _
                                errors, _
                                errorCount, _
                                "Компонент " & childIndex & _
                                ": поле """ & fieldCaption & _
                                """ должно быть больше 0 " & _
                                "(" & rangeName & ").", _
                                rng

                        End If

                    End If

            End Select

            ' =====================================================
            ' ГРУППА 4. МАССОВАЯ ДОЛЯ НЕ МОЖЕТ БЫТЬ БОЛЬШЕ 1
            ' =====================================================

            Select Case fieldName

                Case COL_MASS_FRACTION_CHILD_DB

                    If valueText <> "" _
                       And IsNumeric(fieldValue) Then

                        If CDbl(fieldValue) > 1 Then

                            AddValidationError _
                                errors, _
                                errorCount, _
                                "Компонент " & childIndex & _
                                ": массовая доля не может быть " & _
                                "больше 1 (" & rangeName & ").", _
                                rng

                        ElseIf CDbl(fieldValue) > 0 Then

                            massFractionSum = _
                                massFractionSum + _
                                CDbl(fieldValue)

                            validMassFractionCount = _
                                validMassFractionCount + 1

                            childMassFractionIsValid(childIndex) = True

                        End If

                    End If

            End Select

            ' =====================================================
            ' ГРУППА 5. ЛОГИЧЕСКОЕ ПОЛЕ «ПЕРВЫЙ КОМПОНЕНТ»
            ' =====================================================

            Select Case fieldName

                Case COL_FIRST_CHILD_DB

                    Select Case LCase$(valueText)

                        Case "true", _
                             "истина", _
                             "1", _
                             "да", _
                             "+"

                            firstComponentCount = _
                                firstComponentCount + 1

                            childIsFirst(childIndex) = True

                        Case "false", _
                             "ложь", _
                             "0", _
                             "нет", _
                             "-", _
                             ""

                            ' Допустимое значение False.

                        Case Else

                            AddValidationError _
                                errors, _
                                errorCount, _
                                "Компонент " & childIndex & _
                                ": поле """ & fieldCaption & _
                                """ должно содержать True/False " & _
                                "(" & rangeName & ").", _
                                rng

                    End Select

            End Select

next_child_field:
        Next fieldIndex

next_child:
    Next childIndex

    ' =============================================================
    ' ОБЩИЕ ПРОВЕРКИ КОМПОНЕНТОВ
    ' =============================================================

    If validChildCount = 0 Then

        AddValidationError _
            errors, _
            errorCount, _
            "Не указано ни одного компонента смеси."

        ' Подсвечиваем поля шифров компонентов.
        For childIndex = 1 To REC_CHILD_COUNT_PER_FORM

            rangeName = _
                "Rec_" & formIndex & "_" & _
                COL_MIX_SAMPLE_CODE_CHILD_DB & _
                childIndex

            If NamedRangeExists(wb, rangeName) Then

                SetValidationErrorFill _
                    GetNamedRangeStrict(wb, rangeName)

            End If

        Next childIndex

    End If

    ' =============================================================
    ' ДОЛЖЕН БЫТЬ ВЫБРАН РОВНО ОДИН ПЕРВЫЙ КОМПОНЕНТ
    ' =============================================================

    If validChildCount > 0 Then

        If firstComponentCount = 0 Then

            AddValidationError _
                errors, _
                errorCount, _
                "Не выбран первый компонент смеси."

            ' Подсвечиваем поле First у всех начатых компонентов.
            For childIndex = 1 To REC_CHILD_COUNT_PER_FORM

                If childStarted(childIndex) Then

                    rangeName = _
                        "Rec_" & formIndex & "_" & _
                        COL_FIRST_CHILD_DB & childIndex

                    If NamedRangeExists(wb, rangeName) Then

                        SetValidationErrorFill _
                            GetNamedRangeStrict(wb, rangeName)

                    End If

                End If

            Next childIndex

        ElseIf firstComponentCount > 1 Then

            AddValidationError _
                errors, _
                errorCount, _
                "Первым отмечено более одного компонента смеси."

            ' Подсвечиваем только компоненты с First = True.
            For childIndex = 1 To REC_CHILD_COUNT_PER_FORM

                If childIsFirst(childIndex) Then

                    rangeName = _
                        "Rec_" & formIndex & "_" & _
                        COL_FIRST_CHILD_DB & childIndex

                    If NamedRangeExists(wb, rangeName) Then

                        SetValidationErrorFill _
                            GetNamedRangeStrict(wb, rangeName)

                    End If

                End If

            Next childIndex

        End If

    End If

    ' =============================================================
    ' СУММА МАССОВЫХ ДОЛЕЙ ДОЛЖНА БЫТЬ РАВНА 1
    ' =============================================================

    If validChildCount > 0 _
       And validMassFractionCount = validChildCount Then

        If Abs(massFractionSum - 1#) > 0.001 Then

            AddValidationError _
                errors, _
                errorCount, _
                "Сумма массовых долей компонентов должна " & _
                "быть равна 1." & vbCrLf & _
                "   Текущая сумма: " & _
                Format$(massFractionSum, "0.000000")

            ' Подсвечиваем массовые доли всех компонентов.
            For childIndex = 1 To REC_CHILD_COUNT_PER_FORM

                If childStarted(childIndex) _
                   And childMassFractionIsValid(childIndex) Then

                    rangeName = _
                        "Rec_" & formIndex & "_" & _
                        COL_MASS_FRACTION_CHILD_DB & _
                        childIndex

                    If NamedRangeExists(wb, rangeName) Then

                        SetValidationErrorFill _
                            GetNamedRangeStrict(wb, rangeName)

                    End If

                End If

            Next childIndex

        End If

    End If

    ' =============================================================
    ' РЕЗУЛЬТАТ ВАЛИДАЦИИ
    ' =============================================================

    If errorCount > 0 Then

        MsgBox _
            "REC_" & formIndex & _
            " не сохранена. Исправьте ошибки:" & _
            vbCrLf & vbCrLf & errors, _
            vbExclamation

        Exit Function

    End If

    Validate_Rec_Form = True

End Function

Private Function REC_FieldCaption( _
    ByVal fieldName As String _
) As String

    Select Case LCase$(fieldName)

        ' =========================================================
        ' ПОЛЯ REC_RESULTS
        ' =========================================================

        Case LCase$(COL_RESULT_ID_REC_DB)
            REC_FieldCaption = "Номер результата"

        Case LCase$(COL_TASK_ID_DB)
            REC_FieldCaption = "Номер задания"

        Case LCase$(COL_SAMPLE_CODE_DB)
            REC_FieldCaption = "Шифр пробы"

        Case LCase$(COL_OPERATOR_DB)
            REC_FieldCaption = "Исполнитель"

        Case LCase$(COL_DATE_DB)
            REC_FieldCaption = "Дата выполнения"

        Case LCase$(COL_EQUIPMENT_FOR_TRANSFER_DB)
            REC_FieldCaption = "Оборудование для перевода"

        Case LCase$(COL_EQUIPMENT_NUMBER_DB)
            REC_FieldCaption = "Номер оборудования для перевода"

        Case LCase$(COL_TYPE_SAMPLER_DB)
            REC_FieldCaption = "Тип пробоотборника"

        Case LCase$(COL_NUMBER_SAMPLER_DB)
            REC_FieldCaption = "Номер пробоотборника"

        ' =========================================================
        ' ПОЛЯ КОМПОНЕНТОВ
        ' =========================================================

        Case LCase$(COL_MIX_SAMPLE_CODE_CHILD_DB)
            REC_FieldCaption = "Шифр смешиваемой пробы"

        Case LCase$(COL_MASS_FRACTION_CHILD_DB)
            REC_FieldCaption = "Массовая доля"

        Case LCase$(COL_P_TRANSFER_CHILD_DB)
            REC_FieldCaption = "Давление перевода"

        Case LCase$(COL_T_TRANSFER_CHILD_DB)
            REC_FieldCaption = "Температура перевода"

        Case LCase$(COL_DENSITY_CHILD_DB)
            REC_FieldCaption = "Плотность"

        Case LCase$(COL_FIRST_CHILD_DB)
            REC_FieldCaption = "Первый компонент"

        Case LCase$(COL_VOLUME_CHILD_DB)
            REC_FieldCaption = "Объём"

        Case LCase$(COL_MASS_CHILD_DB)
            REC_FieldCaption = "Масса"

        Case Else
            REC_FieldCaption = fieldName

    End Select

End Function

Private Function Get_Rec_FormState( _
    ByVal formIndex As Long _
) As RecFormState

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetREC As Worksheet
    Set sheetREC = wb.Worksheets("Rec")

    Dim recTable As ListObject
    Set recTable = wb.Worksheets("Rec_results") _
                     .ListObjects("Rec_results")

    Dim sampleCode As String
    sampleCode = Trim$(CStr( _
        sheetREC.Range( _
            "Rec_" & formIndex & "_" & COL_SAMPLE_CODE_DB _
        ).value _
    ))

    Dim hasSampleCode As Boolean
    hasSampleCode = (sampleCode <> "")

    Dim hasCoreChildData As Boolean
    hasCoreChildData = RecFormHasAnyChildData(wb, formIndex)

    Dim hasAnyParentData As Boolean
    hasAnyParentData = False

    Dim headerCell As Range
    Dim fieldName As String
    Dim rangeName As String

    Dim fieldValue As Variant
    Dim fieldText As String

    For Each headerCell In recTable.HeaderRowRange.Cells

        fieldName = Trim$(CStr(headerCell.value))

        Select Case LCase$(fieldName)

            Case "", _
                 LCase$(COL_RESULT_ID_REC_DB), _
                 "datetimesync"

                GoTo NextParentField

        End Select

        rangeName = "Rec_" & formIndex & "_" & fieldName

        If NamedRangeExists(wb, rangeName) Then

            fieldValue = GetNamedRangeStrict(wb, rangeName).value

            If IsError(fieldValue) Then

                hasAnyParentData = True
                Exit For

            End If

            fieldText = Trim$(CStr(fieldValue))

            If fieldText <> "" Then

                hasAnyParentData = True
                Exit For

            End If

        End If

NextParentField:
    Next headerCell

    Dim childFields As Variant

    childFields = Array( _
        COL_MIX_SAMPLE_CODE_CHILD_DB, _
        COL_MASS_FRACTION_CHILD_DB, _
        COL_P_TRANSFER_CHILD_DB, _
        COL_T_TRANSFER_CHILD_DB, _
        COL_DENSITY_CHILD_DB, _
        COL_FIRST_CHILD_DB, _
        COL_VOLUME_CHILD_DB, _
        COL_MASS_CHILD_DB _
    )

    Dim hasAnyChildData As Boolean
    hasAnyChildData = False

    Dim childIndex As Long
    Dim fieldIndex As Long

    For childIndex = 1 To REC_CHILD_COUNT_PER_FORM

        For fieldIndex = LBound(childFields) To UBound(childFields)

            fieldName = CStr(childFields(fieldIndex))

            rangeName = _
                "Rec_" & formIndex & "_" & _
                fieldName & childIndex

            If Not NamedRangeExists(wb, rangeName) Then
                GoTo NextChildField
            End If

            fieldValue = GetNamedRangeStrict(wb, rangeName).value

            If IsError(fieldValue) Then

                hasAnyChildData = True
                Exit For

            End If

            fieldText = Trim$(CStr(fieldValue))

            If fieldName = COL_FIRST_CHILD_DB Then

                Select Case LCase$(fieldText)

                    Case "", "false", "????", "0", "???", "-"
                        ' ?? ??????? ??????? ???????.

                    Case Else
                        hasAnyChildData = True
                        Exit For

                End Select

            ElseIf fieldText <> "" Then

                hasAnyChildData = True
                Exit For

            End If

NextChildField:
        Next fieldIndex

        If hasAnyChildData Then
            Exit For
        End If

    Next childIndex

    If Not hasAnyParentData _
       And Not hasAnyChildData Then

        Get_Rec_FormState = REC_FORM_EMPTY
        Exit Function

    End If

    If hasSampleCode _
       And hasCoreChildData Then

        Get_Rec_FormState = REC_FORM_FILLED
        Exit Function

    End If

    Get_Rec_FormState = REC_FORM_RESERVED

End Function

Public Function FindEmptyFormREC() As Long

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetREC As Worksheet
    Set sheetREC = wb.Worksheets("REC")

    Dim formIndex As Long
    formIndex = 1

    Do While NamedRangeExists(wb, "REC_" & formIndex & "_sampleCode")

        If Get_Rec_FormState(formIndex) = REC_FORM_EMPTY Then
            FindEmptyFormREC = formIndex
            Exit Function
        End If

        formIndex = formIndex + 1

    Loop

    Call AddFormREC

    FindEmptyFormREC = formIndex

End Function


