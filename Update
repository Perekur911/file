5. **Добавить хэш SSF.**

```vb
Public Function CalculateCurrentSSFHash() As String

    Dim data As Object
    Set data = Build_SSF_HashData(ActiveWorkbook)

    CalculateCurrentSSFHash = CalculateDataHash(data)

End Function


Private Function Build_SSF_HashData(ByVal wb As Workbook) As Object

    Dim data As Object
    Set data = CreateObject("Scripting.Dictionary")

    Dim sheetSSF As Worksheet
    Set sheetSSF = wb.Worksheets("SSF")

    Dim SSFTable As ListObject
    Set SSFTable = wb.Worksheets("SSF_results").ListObjects("SSF_results")

    Dim i As Long, resultIndex As Long
    i = 1

    Do While NamedRangeExists(wb, "SSF_" & i & "_sampleCode")

        If Get_SSF_FormState(i) <> SSF_FORM_FILLED Then GoTo NextForm
        If sheetSSF.Range("SSF_" & i & "_TaskId").Interior.ColorIndex = 3 Then GoTo NextForm

        resultIndex = resultIndex + 1

        Dim headerCell As Range
        Dim headerName As String
        Dim formatValue As Variant

        For Each headerCell In SSFTable.HeaderRowRange.Cells

            headerName = CStr(headerCell.Value)

            Select Case LCase$(headerName)

                Case "datetimesync", "resultidssf"

                Case Else
                    If NamedRangeExists(wb, "SSF_" & i & "_" & headerName) Then
                        formatValue = FormatValueForSyncText( _
                            headerName, sheetSSF.Range("SSF_" & i & "_" & headerName).Value)
                    Else
                        formatValue = vbNullString
                    End If

                    data.Add resultIndex & "." & headerName, formatValue

            End Select

        Next headerCell

        Dim srcTable As ListObject
        Set srcTable = sheetSSF.ListObjects("SSF_source_" & i)

        Dim x As Long, sourceIndex As Long

        For x = 1 To srcTable.ListRows.Count

            If SourceRowHasData( _
                srcTable, x, _
                Array(COL_SSF_SAMPLE_CODE_DB, COL_SSF_TYPE_PH_DB), _
                Array("AND")) Then

                sourceIndex = sourceIndex + 1

                formatValue = FormatValueForSyncText( _
                    COL_SSF_SAMPLE_CODE_DB, _
                    srcTable.DataBodyRange.Cells( _
                        x, srcTable.ListColumns(COL_SSF_SAMPLE_CODE_DB).Index).Value)

                data.Add resultIndex & "." & sourceIndex & "." & _
                    COL_SSF_SAMPLE_CODE_DB, formatValue

                formatValue = FormatValueForSyncText( _
                    COL_SSF_TYPE_PH_DB, _
                    srcTable.DataBodyRange.Cells( _
                        x, srcTable.ListColumns(COL_SSF_TYPE_PH_DB).Index).Value)

                data.Add resultIndex & "." & sourceIndex & "." & _
                    COL_SSF_TYPE_PH_DB, formatValue

            End If

        Next x

NextForm:
        i = i + 1
    Loop

    Set Build_SSF_HashData = data

End Function
```

`rowIdSSF/resultIdSSF` сюда намеренно не входят.

