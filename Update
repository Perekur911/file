Public Sub SetWorkbookMetadataProperty( _
    ByVal wb As Workbook, _
    ByVal propertyName As String, _
    ByVal propertyValue As String, _
    Optional ByVal saveWorkbook As Boolean = False _
)

    Dim documentProperty As Object

    If wb Is Nothing Then
        Err.Raise _
            vbObjectError + 2100, _
            "SetWorkbookMetadataProperty", _
            "Книга не указана."
    End If

    propertyName = Trim$(propertyName)

    If propertyName = "" Then
        Err.Raise _
            vbObjectError + 2101, _
            "SetWorkbookMetadataProperty", _
            "Название свойства не указано."
    End If

    On Error Resume Next

    Set documentProperty = _
        wb.CustomDocumentProperties(propertyName)

    On Error GoTo ErrorHandler

    If documentProperty Is Nothing Then

        wb.CustomDocumentProperties.Add _
            name:=propertyName, _
            LinkToContent:=False, _
            Type:=msoPropertyTypeString, _
            value:=propertyValue

    Else

        documentProperty.value = propertyValue

    End If

    If saveWorkbook Then
        wb.Save
    End If

    Exit Sub

ErrorHandler:

    Err.Raise _
        vbObjectError + 2102, _
        "SetWorkbookMetadataProperty", _
        "Не удалось записать свойство '" & _
        propertyName & "' в книгу '" & _
        wb.name & "'." & vbCrLf & _
        Err.Description

End Sub


