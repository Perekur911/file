CREATE TABLE IF NOT EXISTS CVD_results (
    resultIdCVD       INTEGER PRIMARY KEY AUTOINCREMENT,

    sampleCode        TEXT    NOT NULL,
    TaskId            INTEGER,
    analyseNumber     INTEGER NOT NULL,

    dateEnd           TEXT,
    dateStart         TEXT,
    timeEnd           TEXT,
    timeStart         TEXT,
    
    deltaMatBalance   REAL,

    Pabs              REAL,
    Pstart            REAL,
    Ptransfer         REAL,
    Punit             TEXT,

    pvtCell           TEXT,

    Tstart            REAL,
    Ttransfer         REAL,

    Vstart            REAL,
    Vtransfer         REAL,

    dateTimeSync      TEXT,

    CONSTRAINT UQ_CVD_results_sampleCode_analyseNumber
        UNIQUE (sampleCode, analyseNumber)
);


-- =========================================================
-- Дочерняя таблица
-- =========================================================

CREATE TABLE IF NOT EXISTS CVD_sourceData (
    rowIdCVD             INTEGER PRIMARY KEY AUTOINCREMENT,

    resultIdCVD          INTEGER NOT NULL,

    step                 TEXT,

    cellFluidMass        REAL,
    d20                  REAL,
    date                 TEXT,
    dGas                 REAL,
    evacuatedFluidMass   REAL,

    GF                   REAL,
    gorEquipment         TEXT,

    initPatm             REAL,

    m0                   REAL,
    m0Trap               REAL,
    m1                   REAL,
    m1Trap               REAL,
    m2                   REAL,

    mgas                 REAL,
    mLiq                 REAL,

    operator             TEXT,

    Patm                 REAL,
    picDen               REAL,
    Ppic                 TEXT,

    sampleCodeGPh        TEXT,
    sampleCodeLPh        TEXT,

    stepPcell            REAL,
    stepTcell            REAL,

    T                    REAL,
    transferPcell        REAL,

    Upic                 TEXT,

    V1                   REAL,
    V2                   REAL,
    Vcell                REAL,
    Vcellend             REAL,
    VCellLiq             REAL,

    Vgas                 REAL,
    VgasSt               REAL,

    VGCyl                REAL,
    VGTot                REAL,

    VHeCyl               REAL,
    VHeTot               REAL,

    VLiq                 REAL,
    VLiqRelative         REAL,

    Vtransfer            REAL,

    CONSTRAINT FK_CVD_sourceData_resultIdCVD
        FOREIGN KEY (resultIdCVD)
        REFERENCES CVD_results (resultIdCVD)
        ON UPDATE CASCADE
        ON DELETE CASCADE,

    CONSTRAINT UQ_CVD_sourceData_sampleCodeGPh
        UNIQUE (sampleCodeGPh),

    CONSTRAINT UQ_CVD_sourceData_sampleCodeLPh
        UNIQUE (sampleCodeLPh)
);
