Private Function Get_GOR_FormState(ByVal formIndex As Long) As GORFormState

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetGOR As Worksheet
    Set sheetGOR = wb.Worksheets("GOR")

    Dim sampleCode As String
    sampleCode = Trim$(CStr(sheetGOR.Range("GOR_" & formIndex & "_sampleCode").value))

    Dim hasSampleCode As Boolean
    hasSampleCode = (sampleCode <> "")

    Dim hasVGTot As Boolean
    hasVGTot = GOR_HasNonZeroOrError(sheetGOR.Range("GOR_" & formIndex & "_VGTot").value)
    
    Dim hasInitMass As Boolean
    hasInitMass = GOR_HasNonZeroOrError(sheetGOR.Range("GOR_" & formIndex & "_m0").value)
    
    Dim hasVial As Boolean
    Dim hasBottle As Boolean
    Dim hasTedlarBag As Boolean
    Dim hasPics As Boolean

    hasVial = GOR_HasNonZeroOrError(sheetGOR.Range("GOR_" & formIndex & "_vial").value)
    hasBottle = GOR_HasNonZeroOrError(sheetGOR.Range("GOR_" & formIndex & "_bottle").value)
    hasTedlarBag = GOR_HasNonZeroOrError(sheetGOR.Range("GOR_" & formIndex & "_TedlarBag").value)
    hasPics = GOR_HasNonZeroOrError(sheetGOR.Range("GOR_" & formIndex & "_pics").value)

    Dim hasAnySampleCount As Boolean
    hasAnySampleCount = hasVial Or hasBottle Or hasTedlarBag Or hasPics

    Dim hasSourceRows As Boolean
    hasSourceRows = GOR_SourceTableHasData(formIndex)

    ' Совсем пустая форма.
    If Not hasSampleCode _
       And Not hasVGTot _
       And Not hasInitMass _
       And Not hasAnySampleCount _
       And Not hasSourceRows Then

        Get_GOR_FormState = GOR_FORM_EMPTY
        Exit Function
    End If

    If hasSampleCode And hasVGTot Then
        Get_GOR_FormState = GOR_FORM_FILLED
        Exit Function
    End If

    ' Всё остальное зарезервированно
    Get_GOR_FormState = GOR_FORM_RESERVED

End Function


Private Function GOR_HasNonZeroOrError(ByVal value As Variant) As Boolean

    If IsError(value) Then
        GOR_HasNonZeroOrError = True
        Exit Function
    End If

    If Trim$(CStr(value)) = "" Then
        GOR_HasNonZeroOrError = False
        Exit Function
    End If

    If Not IsNumeric(value) Then
        GOR_HasNonZeroOrError = True
        Exit Function
    End If

    GOR_HasNonZeroOrError = (Abs(CDbl(value)) > 0)

End Function


Private Function GOR_NamedPositiveNumber( _
    ByVal wb As Workbook, _
    ByVal ws As Worksheet, _
    ByVal rangeName As String _
) As Boolean

    GOR_NamedPositiveNumber = False

    If Not NamedRangeExists(wb, rangeName) Then
        Exit Function
    End If

    Dim v As Variant
    v = ws.Range(rangeName).value

    If IsError(v) Then
        Exit Function
    End If

    If Trim$(CStr(v)) = "" Then
        Exit Function
    End If

    If Not IsNumeric(v) Then
        Exit Function
    End If

    GOR_NamedPositiveNumber = (CDbl(v) > 0)

End Function


Private Function GOR_IsBooleanLike(ByVal value As Variant) As Boolean

    If VarType(value) = vbBoolean Then
        GOR_IsBooleanLike = True
        Exit Function
    End If

    Select Case LCase$(Trim$(CStr(value)))

        Case "true"
            GOR_IsBooleanLike = True

        Case "false"
            GOR_IsBooleanLike = True

        Case "истина"
            GOR_IsBooleanLike = True

        Case "ложь"
            GOR_IsBooleanLike = True

        Case "1"
            GOR_IsBooleanLike = True

        Case "0"
            GOR_IsBooleanLike = True

        Case "да"
            GOR_IsBooleanLike = True

        Case "нет"
            GOR_IsBooleanLike = True

        Case "+"
            GOR_IsBooleanLike = True

        Case "-"
            GOR_IsBooleanLike = True

        Case Else
            GOR_IsBooleanLike = False

    End Select

End Function


Private Function GOR_SourceTableHasData(ByVal formIndex As Long) As Boolean

    GOR_SourceTableHasData = False

    Dim sheetGOR As Worksheet
    Set sheetGOR = ActiveWorkbook.Worksheets("GOR")

    If Not ListObjectExists(sheetGOR, "GOR_source_" & formIndex) Then
        Exit Function
    End If

    Dim sourceTable As ListObject
    Set sourceTable = sheetGOR.ListObjects("GOR_source_" & formIndex)

    If sourceTable.DataBodyRange Is Nothing Then
        Exit Function
    End If

    If Not ListColumnExists(sourceTable, COL_GOR_SAMPLE_CODE_DB) Then
        Exit Function
    End If

    If Not ListColumnExists(sourceTable, COL_GOR_TYPE_PH_DB) Then
        Exit Function
    End If

    Dim rowIndex As Long
    Dim sampleCodeValue As Variant
    Dim typePhValue As Variant

    For rowIndex = 1 To sourceTable.ListRows.count

        sampleCodeValue = sourceTable.DataBodyRange.Cells( _
            rowIndex, _
            sourceTable.ListColumns(COL_GOR_SAMPLE_CODE_DB).index _
        ).value

        typePhValue = sourceTable.DataBodyRange.Cells( _
            rowIndex, _
            sourceTable.ListColumns(COL_GOR_TYPE_PH_DB).index _
        ).value

        If IsError(sampleCodeValue) Or IsError(typePhValue) Then
            GOR_SourceTableHasData = True
            Exit Function
        End If

        If Trim$(CStr(sampleCodeValue)) <> "" Then
            GOR_SourceTableHasData = True
            Exit Function
        End If

        If Trim$(CStr(typePhValue)) <> "" Then
            GOR_SourceTableHasData = True
            Exit Function
        End If

    Next rowIndex

End Function

Private Function Validate_GOR_Form( _
    ByVal formIndex As Long _
) As Boolean

    Validate_GOR_Form = False

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetGOR As Worksheet
    Set sheetGOR = wb.Worksheets("GOR")

    Dim GORTable As ListObject
    Set GORTable = wb.Worksheets("GOR_results").ListObjects("GOR_results")



    Dim errors As String
    Dim errorCount As Long

    If formIndex <= 0 Then

        MsgBox _
            "Некорректный номер формы GOR: " & formIndex, _
            vbExclamation

        Exit Function

    End If

    If Not NamedRangeExists( _
        wb, _
        "GOR_" & formIndex & "_sampleCode" _
    ) Then

        MsgBox _
            "Форма GOR_" & formIndex & " не найдена.", _
            vbExclamation

        Exit Function

    End If

    If Not ListObjectExists( _
        sheetGOR, _
        "GOR_source_" & formIndex _
    ) Then

        MsgBox _
            "Таблица GOR_source_" & formIndex & _
            " не найдена.", _
            vbExclamation

        Exit Function

    End If
    Dim sourceTable As ListObject
    Set sourceTable = sheetGOR.ListObjects("GOR_source_" & formIndex)

    If Not ListColumnExists(sourceTable, COL_GOR_ROW_ID_DB) _
            Or Not ListColumnExists(sourceTable, COL_GOR_RESULT_ID_DB) _
            Or Not ListColumnExists(sourceTable, COL_GOR_SAMPLE_CODE_DB) _
            Or Not ListColumnExists(sourceTable, COL_GOR_TYPE_PH_DB) Then
        MsgBox "В таблице GOR_source_" & formIndex & " отсутствуют обязательные столбцы.", vbExclamation
        Exit Function
    End If

    ' =============================================================
    ' ПРОВЕРКА ИМЕНОВАННЫХ ДИАПАЗОНОВ ФОРМЫ
    ' =============================================================

    Dim headerCell As Range
    Dim rng As Range
    Dim valueCell As Range

    Dim fieldName As String
    Dim fieldCaption As String
    Dim rangeName As String

    Dim fieldValue As Variant
    Dim valueText As String

    For Each headerCell In GORTable.HeaderRowRange.Cells

        fieldName = CStr(headerCell.value)

        If fieldName = "dateTimeSync" Then
            GoTo next_header
        End If

        rangeName = _
            "GOR_" & formIndex & "_" & fieldName

        If Not NamedRangeExists(wb, rangeName) Then

            AddValidationError _
                errors, _
                errorCount, _
                "Не найден именованный диапазон: " & rangeName

            GoTo next_header

        End If

        Set rng = sheetGOR.Range(rangeName)
        Set valueCell = rng.Cells(1, 1)

        ' Снимаем результат предыдущей валидации.
        ClearValidationFill rng

        fieldValue = valueCell.value
        fieldCaption = GOR_FieldCaption(fieldName)

        If IsError(fieldValue) Then

            AddValidationError _
                errors, _
                errorCount, _
                rangeName & _
                " содержит ошибку Excel: " & valueCell.text & _
                " (" & valueCell.Worksheet.name & _
                "!" & valueCell.Address(False, False) & ")", _
                rng

            GoTo next_header

        End If

        valueText = Trim$(CStr(fieldValue))

        ' =========================================================
        ' ГРУППА 1. ОБЯЗАТЕЛЬНЫЕ НЕПУСТЫЕ ПОЛЯ
        ' =========================================================

        Select Case fieldName

            Case "sampleCode", _
                 "Correct", _
                 "date", _
                 "dateStart", _
                 "dateEnd", _
                 "timeStart", _
                 "timeEnd", _
                 "operator", _
                 "analyseNumber", _
                 "smplTransfEq", _
                 "transfEqNumber", _
                 "gorEquipment", _
                 "gorEquipmentNumber", _
                 "Tfact", _
                 "VGTot"

                If valueText = "" Then

                    AddValidationError _
                        errors, _
                        errorCount, _
                        "Не заполнено обязательное поле """ & _
                        fieldCaption & """: " & rangeName, _
                        rng

                End If

        End Select

        ' =========================================================
        ' ГРУППА 2. ЧИСЛОВЫЕ ПОЛЯ
        '
        ' Проверяем только заполненные значения.
        ' Поля с допустимым значением "-" вынесены отдельно.
        ' =========================================================

        Select Case fieldName

            Case "TaskId", _
                 "Tfact", _
                 "PtransferMPa", _
                 "Ptransfer", _
                 "VGTot", _
                 "VHeTot", _
                 "m0", _
                 "m1", _
                 "m2", _
                 "deltaAP", _
                 "deltaMatBalance", _
                 "circ1", _
                 "circ2"

                If valueText <> "" Then

                If Not IsNumeric(fieldValue) Then

                    AddValidationError errors, errorCount, _
                        "Поле """ & fieldCaption & """ должно содержать число: " & rangeName, rng

                ElseIf fieldName = "TaskId" Then

                    If CDbl(fieldValue) <> Fix(CDbl(fieldValue)) Then

                        AddValidationError errors, errorCount, _
                            "Поле """ & fieldCaption & """ должно содержать целое число: " & rangeName, rng

                    ElseIf CDbl(fieldValue) > 0 Then

                        Dim taskCheckResult As String

                        taskCheckResult = CheckGORTask( _
                            CLng(fieldValue), _
                            CStr(sheetGOR.Range("GOR_" & formIndex & "_sampleCode").value), _
                            sheetGOR.Range("GOR_" & formIndex & "_Tfact").value, _
                            formIndex _
                        )

                        If taskCheckResult <> "OK" Then
                            AddValidationError errors, errorCount, taskCheckResult, rng
                        End If

                    End If

                End If

            End If

        End Select

        ' =========================================================
        ' ГРУППА 3. ЧИСЛА, КОТОРЫЕ НЕ МОГУТ БЫТЬ ОТРИЦАТЕЛЬНЫМИ
        ' =========================================================

        Select Case fieldName

            Case "TaskId", _
                 "PtransferMPa", _
                 "Ptransfer", _
                 "VHeTot", _
                 "m0", _
                 "m1", _
                 "m2"

                If valueText <> "" _
                   And IsNumeric(fieldValue) Then

                    If CDbl(fieldValue) < 0 Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Поле """ & fieldCaption & _
                            """ не может быть отрицательным: " & _
                            rangeName, _
                            rng

                    End If

                End If

        End Select

        ' =========================================================
        ' ГРУППА 4. ЧИСЛА, КОТОРЫЕ ДОЛЖНЫ БЫТЬ БОЛЬШЕ НУЛЯ
        ' =========================================================

        Select Case fieldName

            Case "VGTot"

                If valueText <> "" _
                   And IsNumeric(fieldValue) Then

                    If CDbl(fieldValue) <= 0 Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Поле """ & fieldCaption & _
                            """ должно быть больше 0: " & _
                            rangeName, _
                            rng

                    End If

                End If

        End Select

        ' =========================================================
        ' ГРУППА 5. ЛОГИЧЕСКИЕ ПОЛЯ TRUE/FALSE
        ' =========================================================

        Select Case fieldName

            Case "Correct"

                If valueText <> "" Then

                    If Not GOR_IsBooleanLike(fieldValue) Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Поле """ & fieldCaption & _
                            """ должно содержать значение True/False: " & _
                            rangeName, _
                            rng

                    End If

                End If

        End Select

        ' =========================================================
        ' ГРУППА 6. ПОЛЯ С ДАТОЙ
        ' =========================================================

        Select Case fieldName

            Case "date", _
                 "dateStart", _
                 "dateEnd"

                If valueText <> "" Then

                    If Not IsDate(fieldValue) Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Значение поля """ & fieldCaption & _
                            """ невозможно преобразовать в дату: " & _
                            rangeName, _
                            rng

                    End If

                End If

        End Select

        ' =========================================================
        ' ГРУППА 7. ПОЛЯ СО ВРЕМЕНЕМ
        ' =========================================================

        Select Case fieldName

            Case "timeStart", _
                 "timeEnd"

                If valueText <> "" Then

                    If Not valueCell.text Like "##:##" _
                       And Not valueCell.text Like "#:##" Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Поле """ & fieldCaption & _
                            """ должно содержать время в формате ЧЧ:ММ: " & _
                            rangeName, _
                            rng

                    End If

                End If

        End Select

        ' =========================================================
        ' ГРУППА 8. ПОЛЯ ВВОДА ИСПОЛНИТЕЛЯ
        ' =========================================================

        Select Case fieldName

            Case "operator"

                If valueText <> "" Then

                    If Not IsValidExecutor(fieldValue) Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Неверно указан исполнитель: " & _
                            rangeName, _
                            rng

                    End If

                End If

        End Select

        ' =========================================================
        ' ГРУППА 9. ТЕМПЕРАТУРНЫЕ ПОЛЯ
        ' =========================================================

        Select Case fieldName

            Case "Tfact"

                If valueText <> "" _
                   And IsNumeric(fieldValue) Then

                    If CDbl(fieldValue) < -20 _
                       Or CDbl(fieldValue) > 140 Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Поле """ & fieldCaption & _
                            """ должно находиться в диапазоне " & _
                            "от -20 до 140 °C: " & rangeName, _
                            rng

                    End If

                End If

        End Select

        ' =========================================================
        ' ГРУППА 10. ПОЛЯ С ЗАДАННЫМ ФОРМАТОМ ТЕКСТА
        ' =========================================================

        Select Case fieldName

            Case "Ppic"

                If valueText <> "" Then

                    If Not valueText Like "20##-P##" Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Поле """ & fieldCaption & _
                            """ должно иметь формат 20##-P##: " & _
                            rangeName, _
                            rng

                    End If

                End If

        End Select

        ' =========================================================
        ' ГРУППА 11. КОЛИЧЕСТВО ПОЛУЧЕННЫХ ЁМКОСТЕЙ
        '
        ' Допускаются:
        '   - целое число >= 0;
        '   - символ "-".
        ' =========================================================

        Select Case fieldName

            Case "vial", _
                 "bottle", _
                 "TedlarBag", _
                 "pics"

                If valueText <> "" Then

                    If Not IsNumeric(fieldValue) Then

                        If valueText <> "-" Then

                            AddValidationError _
                                errors, _
                                errorCount, _
                                "Поле """ & fieldCaption & _
                                """ должно содержать целое число " & _
                                "или символ ""-"": " & rangeName, _
                                rng

                        End If

                    ElseIf CDbl(fieldValue) < 0 Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Поле """ & fieldCaption & _
                            """ не может быть отрицательным: " & _
                            rangeName, _
                            rng

                    ElseIf CDbl(fieldValue) <> _
                           Fix(CDbl(fieldValue)) Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Поле """ & fieldCaption & _
                            """ должно содержать целое число: " & _
                            rangeName, _
                            rng

                    End If

                End If

        End Select

next_header:
    Next headerCell

    ' =============================================================
    ' ОБЩАЯ ПРОВЕРКА ПОЛУЧЕННЫХ ПРОБ
    '
    ' Хотя бы в одном поле должно находиться число больше нуля.
    ' =============================================================

    Dim vialRangeName As String
    Dim bottleRangeName As String
    Dim tedlarBagRangeName As String
    Dim picsRangeName As String

    vialRangeName = _
        "GOR_" & formIndex & "_vial"

    bottleRangeName = _
        "GOR_" & formIndex & "_bottle"

    tedlarBagRangeName = _
        "GOR_" & formIndex & "_TedlarBag"

    picsRangeName = _
        "GOR_" & formIndex & "_pics"

    Dim hasVialCount As Boolean
    Dim hasBottleCount As Boolean
    Dim hasTedlarBagCount As Boolean
    Dim hasPicsCount As Boolean

    If NamedRangeExists(wb, vialRangeName) Then

        hasVialCount = _
            GOR_NamedPositiveNumber( _
                wb, _
                sheetGOR, _
                vialRangeName _
            )

    End If

    If NamedRangeExists(wb, bottleRangeName) Then

        hasBottleCount = _
            GOR_NamedPositiveNumber( _
                wb, _
                sheetGOR, _
                bottleRangeName _
            )

    End If

    If NamedRangeExists(wb, tedlarBagRangeName) Then

        hasTedlarBagCount = _
            GOR_NamedPositiveNumber( _
                wb, _
                sheetGOR, _
                tedlarBagRangeName _
            )

    End If

    If NamedRangeExists(wb, picsRangeName) Then

        hasPicsCount = _
            GOR_NamedPositiveNumber( _
                wb, _
                sheetGOR, _
                picsRangeName _
            )

    End If

    If Not hasVialCount _
       And Not hasBottleCount _
       And Not hasTedlarBagCount _
       And Not hasPicsCount Then

        AddValidationError _
            errors, _
            errorCount, _
            "Не указана ни одна полученная проба: " & _
            "виалы, банки, тедларовые пакеты или пикнометры."

        If NamedRangeExists(wb, vialRangeName) Then

            SetValidationErrorFill _
                sheetGOR.Range(vialRangeName)

        End If

        If NamedRangeExists(wb, bottleRangeName) Then

            SetValidationErrorFill _
                sheetGOR.Range(bottleRangeName)

        End If

        If NamedRangeExists(wb, tedlarBagRangeName) Then

            SetValidationErrorFill _
                sheetGOR.Range(tedlarBagRangeName)

        End If

        If NamedRangeExists(wb, picsRangeName) Then

            SetValidationErrorFill _
                sheetGOR.Range(picsRangeName)

        End If

    End If

    ' =============================================================
    ' РЕЗУЛЬТАТ ПРОВЕРКИ
    ' =============================================================

    If errorCount > 0 Then

        MsgBox _
            "GOR_" & formIndex & _
            " не сохранена. Исправьте ошибки:" & _
            vbCrLf & vbCrLf & errors, _
            vbExclamation

        Exit Function

    End If

    Validate_GOR_Form = True

End Function

