Public Function Save_JOIN(Optional ByVal taskStatus As String = "") As macroResult
    On Error GoTo ErrHandler
    Save_JOIN = MACRO_FAILED
    Dim wb As Workbook
    Set wb = ActiveWorkbook
    
    Dim newHashResult As String
    Dim oldHashResult As String
    Dim lastWorkflowStage As String
    
    newHashResult = CalculateCurrentJOINHash()
    oldHashResult = GetWorkbookMetadataProperty(wb, PROP_JOIN_DATA_HASH)
    lastWorkflowStage = GetWorkbookMetadataProperty(wb, PROP_JOIN_LAST_WORKFLOW_STAGE)
    
    If Not ShouldSaveStudy(newHashResult, oldHashResult, lastWorkflowStage, taskStatus) Then
        Save_JOIN = MACRO_NO_CHANGES
        Exit Function
    End If
    
    Dim sheetJOIN As Worksheet
    Set sheetJOIN = wb.Worksheets("JOIN")

    Dim sheetJOINResults As Worksheet
    Set sheetJOINResults = wb.Worksheets("Join_results")

    Dim sheetJOINSourceData As Worksheet
    Set sheetJOINSourceData = wb.Worksheets("Join_sourceData")

    Dim joinTable As ListObject
    Set joinTable = sheetJOINResults.ListObjects("Join_results")

    Dim joinSourceDataTable As ListObject
    Set joinSourceDataTable = sheetJOINSourceData.ListObjects("Join_sourceData")

    Dim parentRows As Collection
    Set parentRows = New Collection

    Dim childRows As Collection
    Set childRows = New Collection

    Dim newResultIDs As Collection
    Set newResultIDs = New Collection
    
    Dim i As Long
    Dim x As Long

    i = 1

    Do While NamedRangeExists(wb, "JOIN_" & i & "_sampleCode")

        Dim formState As JOINFormState

        formState = Get_JOIN_FormState(i)

        Select Case formState

            Case JOIN_FORM_EMPTY, _
                JOIN_FORM_RESERVED

                GoTo NextForm

            Case JOIN_FORM_FILLED

        End Select

        If sheetJOIN.Range("JOIN_" & i & "_TaskId").Interior.ColorIndex = 3 Then
            GoTo NextForm
        End If

        If Not Validate_JOIN_Form(i) Then
            Exit Function
        End If

        Dim resultIdValue As Variant
        Dim parentKey As String

        resultIdValue = sheetJOIN.Range("JOIN_" & i & "_resultIdJoin").value

        If Len(NormalizeKeyValue(resultIdValue)) = 0 Or NormalizeKeyValue(resultIdValue) = "0" Then
            parentKey = "temp_" & i
        Else
            parentKey = NormalizeKeyValue(resultIdValue)
        End If
        
        If IsNumeric(parentKey) Then
            newResultIDs.Add parentKey
        End If

        Dim parentRow() As Variant
        ReDim parentRow(1 To joinTable.ListColumns.count)

        Dim headerCell As Range
        Dim headerName As String
        Dim parentColIndex As Long
        Dim formRangeName As String

        For Each headerCell In joinTable.HeaderRowRange.Cells

            headerName = CStr(headerCell.value)
            parentColIndex = joinTable.ListColumns(headerName).index
            formRangeName = "JOIN_" & i & "_" & headerName

            If headerName = COL_DATE_TIME_SYNC_DB Then
                parentRow(parentColIndex) = Format$(Now, "yyyy-mm-dd hh:nn:ss")

            ElseIf headerName = COL_RESULT_ID_DB Then
                parentRow(parentColIndex) = parentKey

            ElseIf NamedRangeExists(wb, formRangeName) Then
                parentRow(parentColIndex) = FormatValueForSyncText( _
                    headerName, _
                    sheetJOIN.Range(formRangeName).value _
                )

            Else
                parentRow(parentColIndex) = vbNullString

            End If

        Next headerCell

        parentRows.Add parentRow

        Dim srcTable As ListObject
        Set srcTable = sheetJOIN.ListObjects("JOIN_source_" & i)

        If Not srcTable.DataBodyRange Is Nothing Then

            For x = 1 To srcTable.ListRows.count

                Dim hasSourceData As Boolean
                Dim oldRowIdJoin As String

                hasSourceData = SourceRowHasData( _
                    srcTable, _
                    x, _
                    Array(COL_MIX_SAMPLE_CODE_FORM), _
                    Array("AND") _
                )

                oldRowIdJoin = NormalizeKeyValue( _
                    srcTable.DataBodyRange.Cells( _
                        x, _
                        srcTable.ListColumns(COL_ROW_ID_DB).index _
                    ).value _
                )

                ' Äîáàâëÿåì ñòðîêó, åñëè:
                ' 1) åñòü øèôð ïðîáû äëÿ îáúåäèíåíèÿ;
                ' 2) äàííûõ óæå íåò, íî åñòü ñòàðûé rowIdJoin — çíà÷èò ñòðîêó íàäî óäàëèòü â ÁÄ.
                If hasSourceData Or Len(oldRowIdJoin) > 0 Then

                    Dim childRow() As Variant
                    ReDim childRow(1 To joinSourceDataTable.ListColumns.count)

                    childRow(joinSourceDataTable.ListColumns(COL_ROW_ID_DB).index) = oldRowIdJoin
                    childRow(joinSourceDataTable.ListColumns(COL_RESULT_ID_CHILD_DB).index) = parentKey

                    If hasSourceData Then

                        childRow(joinSourceDataTable.ListColumns(COL_MIX_SAMPLE_CODE_DB).index) = _
                            FormatValueForSyncText( _
                                COL_MIX_SAMPLE_CODE_DB, _
                                srcTable.DataBodyRange.Cells( _
                                    x, _
                                    srcTable.ListColumns(COL_MIX_SAMPLE_CODE_FORM).index _
                                ).value _
                            )

                        If ListColumnExists(srcTable, COL_DEPLETED_FORM) _
                            And ListColumnExists(joinSourceDataTable, COL_DEPLETED_DB) Then

                            childRow(joinSourceDataTable.ListColumns(COL_DEPLETED_DB).index) = _
                                FormatValueForSyncText( _
                                    COL_DEPLETED_DB, _
                                    srcTable.DataBodyRange.Cells( _
                                        x, _
                                        srcTable.ListColumns(COL_DEPLETED_FORM).index _
                                    ).value _
                                )

                        End If

                    End If

                    childRows.Add childRow

                End If

            Next x

        End If

NextForm:
        i = i + 1
    Loop

    Dim cellID As Range
    Dim oldResultID As String

    If Not joinTable.DataBodyRange Is Nothing Then

        For Each cellID In _
            joinTable.ListColumns( _
                COL_RESULT_ID_DB _
            ).DataBodyRange.Cells

            If Not IsError(cellID.value) Then

                oldResultID = _
                    NormalizeKeyValue(cellID.value)

                If IsNumeric(oldResultID) _
                And oldResultID <> "0" Then

                    If Not CollectionContains( _
                        newResultIDs, _
                        oldResultID _
                    ) Then

                        MsgBox _
                            "Óäàëåíû äàííûå ñèíõðîíèçèðîâàííîé ôîðìû JOIN. " & _
                            "Ñèíõðîíèçàöèÿ íåâîçìîæíà. " & _
                            "Âûçîâèòå çàãðóçêó äàííûõ èç ÁÄ.", _
                            vbExclamation

                        Save_JOIN = MACRO_FAILED
                        Exit Function

                    End If

                End If

            End If

        Next cellID

    End If

    WriteCollectionToListObject joinTable, parentRows
    WriteCollectionToListObject joinSourceDataTable, childRows


    Dim syncResult As String
    syncResult = RunStudySync("save", studies:="JOIN", taskStatus:=taskStatus)

    If InStr(1, syncResult, """ok"": true", vbTextCompare) > 0 Then

        Call DeleteEmptyRowsByColumns( _
            joinSourceDataTable, _
            COL_ROW_ID_DB, _
            Array(COL_MIX_SAMPLE_CODE_DB) _
        )

        Call Load_JOIN_results_to_forms("by_key", Array(COL_RESULT_ID_DB, COL_ROW_ID_DB))

        newHashResult = CalculateCurrentJOINHash()
        Call SetWorkbookMetadataProperty(wb, PROP_JOIN_DATA_HASH, newHashResult, False)
        Call SetWorkbookMetadataProperty(wb, PROP_JOIN_LAST_WORKFLOW_STAGE, EffectiveWorkflowStage(taskStatus), False)
        SetStudySyncStatus wb, PROP_JOIN_DATA_STATE, SYNC_STATUS_SYNCED, False
        ClearStudyHashCheck wb, "JOIN"
    Else
        MsgBox "Ñèíõðîíèçàöèÿ JOIN íå ïîäòâåðæäåíà êàê óñïåøíàÿ." & vbCrLf & vbCrLf & syncResult, vbExclamation
        Exit Function
    End If

    Save_JOIN = MACRO_CHANGED
    Exit Function

ErrHandler:
    Debug.Print Err.Number & ": " & Err.Description
    Save_JOIN = MACRO_FAILED
End Function

Public Function CalculateCurrentJOINHash() As String

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim data As Object
    Set data = Build_JOIN_HashData(wb)

    CalculateCurrentJOINHash = CalculateDataHash(data)

End Function


Private Function Build_JOIN_HashData( _
    ByVal wb As Workbook _
) As Object

    Dim data As Object
    Set data = CreateObject("Scripting.Dictionary")

    Dim sheetJOIN As Worksheet
    Set sheetJOIN = wb.Worksheets("JOIN")

    Dim joinTable As ListObject
    Set joinTable = _
        wb.Worksheets("Join_results") _
          .ListObjects("Join_results")

    Dim i As Long
    Dim formIndex As Long

    i = 1
    formIndex = 0

    Do While NamedRangeExists(wb, "JOIN_" & i & "_sampleCode")

        If sheetJOIN.Range( _
            "JOIN_" & i & "_TaskId" _
        ).Interior.ColorIndex = 3 Then
            GoTo NextForm
        End If

        If Get_JOIN_FormState(i) <> JOIN_FORM_FILLED Then
            GoTo NextForm
        End If

        formIndex = formIndex + 1

        ' Ðîäèòåëüñêèå ïîëÿ.
        Dim headerCell As Range
        Dim headerName As String
        Dim rangeName As String
        Dim formatValue As Variant

        For Each headerCell In joinTable.HeaderRowRange.Cells

            headerName = CStr(headerCell.value)

            Select Case headerName

                Case COL_DATE_TIME_SYNC_DB, _
                     COL_RESULT_ID_DB

                    ' Ñëóæåáíûå ïîëÿ íå õåøèðóåì.

                Case Else

                    rangeName = _
                        "JOIN_" & i & "_" & headerName

                    If NamedRangeExists(wb, rangeName) Then

                        formatValue = FormatValueForSyncText( _
                            headerName, _
                            sheetJOIN.Range(rangeName).value _
                        )

                    Else
                        formatValue = vbNullString
                    End If

                    data.Add _
                        formIndex & "." & headerName, _
                        formatValue

            End Select

        Next headerCell

        ' Äî÷åðíèå ñòðîêè.
        Dim srcTable As ListObject
        Set srcTable = _
            sheetJOIN.ListObjects("JOIN_source_" & i)

        Dim x As Long
        Dim sourceIndex As Long

        sourceIndex = 0

        For x = 1 To srcTable.ListRows.count

            If SourceRowHasData( _
                srcTable, _
                x, _
                Array(COL_MIX_SAMPLE_CODE_FORM), _
                Array("AND") _
            ) Then

                sourceIndex = sourceIndex + 1

                formatValue = FormatValueForSyncText( _
                    COL_MIX_SAMPLE_CODE_DB, _
                    srcTable.DataBodyRange.Cells( _
                        x, _
                        srcTable.ListColumns( _
                            COL_MIX_SAMPLE_CODE_FORM _
                        ).index _
                    ).value _
                )

                data.Add _
                    formIndex & "." & _
                    COL_MIX_SAMPLE_CODE_DB & "." & _
                    sourceIndex, _
                    formatValue

                formatValue = FormatValueForSyncText( _
                    COL_DEPLETED_DB, _
                    srcTable.DataBodyRange.Cells( _
                        x, _
                        srcTable.ListColumns( _
                            COL_DEPLETED_FORM _
                        ).index _
                    ).value _
                )

                data.Add _
                    formIndex & "." & _
                    COL_DEPLETED_DB & "." & _
                    sourceIndex, _
                    formatValue

            End If

        Next x

NextForm:
        i = i + 1

    Loop

    Set Build_JOIN_HashData = data

End Function

Private Function Validate_JOIN_Form( _
    ByVal formIndex As Long _
) As Boolean

    Validate_JOIN_Form = False

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetJOIN As Worksheet
    Set sheetJOIN = wb.Worksheets("JOIN")

    Dim resultTable As ListObject
    Set resultTable = _
        wb.Worksheets("Join_results") _
          .ListObjects("Join_results")

    Dim errors As String
    Dim errorCount As Long

    If formIndex <= 0 Then
        MsgBox _
            "Íåêîððåêòíûé íîìåð ôîðìû JOIN: " & formIndex, _
            vbExclamation
        Exit Function
    End If

    If Not NamedRangeExists( _
        wb, _
        "JOIN_" & formIndex & "_sampleCode" _
    ) Or Not ListObjectExists( _
        sheetJOIN, _
        "JOIN_source_" & formIndex _
    ) Then

        MsgBox _
            "Ôîðìà JOIN_" & formIndex & " íå íàéäåíà.", _
            vbExclamation

        Exit Function
    End If


    ' =============================================================
    ' ÏÎËß ÎÑÍÎÂÍÎÉ ÔÎÐÌÛ
    ' =============================================================

    Dim headerCell As Range
    Dim rng As Range

    Dim fieldName As String
    Dim fieldCaption As String
    Dim rangeName As String

    Dim fieldValue As Variant
    Dim valueText As String

    For Each headerCell In resultTable.HeaderRowRange.Cells

        fieldName = CStr(headerCell.value)

        If fieldName = COL_DATE_TIME_SYNC_DB Then
            GoTo next_header
        End If

        rangeName = _
            "JOIN_" & formIndex & "_" & fieldName

        If Not NamedRangeExists(wb, rangeName) Then

            AddValidationError _
                errors, _
                errorCount, _
                "Íå íàéäåí èìåíîâàííûé äèàïàçîí: " & rangeName

            GoTo next_header
        End If

        Set rng = _
            wb.Names(rangeName) _
              .RefersToRange.Cells(1, 1)

        ClearValidationFill rng

        fieldValue = rng.value
        fieldCaption = JOIN_FieldCaption(fieldName)

        If IsError(fieldValue) Then

            AddValidationError _
                errors, _
                errorCount, _
                rangeName & _
                " ñîäåðæèò îøèáêó Excel: " & rng.text & _
                " (" & rng.Worksheet.name & _
                "!" & rng.Address(False, False) & ")", _
                rng

            GoTo next_header
        End If

        valueText = Trim$(CStr(fieldValue))


        ' =========================================================
        ' ÃÐÓÏÏÀ 1. ÎÁßÇÀÒÅËÜÍÛÅ ÏÎËß
        ' =========================================================

        Select Case fieldName

            Case "sampleCode", _
                 COL_OPERATOR_DB, _
                 COL_DATE_DB, _
                 COL_EQUIPMENT_DB, _
                 COL_EQUIPMENT_NUMBER_DB, _
                 COL_PREPARATION_PRESSURE_DB, _
                 COL_PRESSURE_UNIT_DB, _
                 COL_PREPARATION_TEMP_DB, _
                 COL_PREPARATION_PRES_MPA_DB

                If valueText = "" Then

                    AddValidationError _
                        errors, _
                        errorCount, _
                        "Íå çàïîëíåíî îáÿçàòåëüíîå ïîëå """ & _
                        fieldCaption & """: " & rangeName, _
                        rng

                End If

        End Select


        ' =========================================================
        ' ÃÐÓÏÏÀ 2. ×ÈÑËÎÂÛÅ ÏÎËß
        ' =========================================================

        Select Case fieldName

            Case COL_RESULT_ID_DB, _
                 COL_TASK_ID_DB, _
                 COL_PREPARATION_PRESSURE_DB, _
                 COL_PREPARATION_TEMP_DB, _
                 COL_PREPARATION_PRES_MPA_DB

                If valueText <> "" Then

                    If Not IsNumeric(fieldValue) Then

                        AddValidationError _
                            errors, _
                            errorCount, _
                            "Ïîëå """ & fieldCaption & _
                            """ äîëæíî ñîäåðæàòü ÷èñëî: " & _
                            rangeName, _
                            rng

                    ElseIf fieldName = COL_TASK_ID_DB Then

                        If CDbl(fieldValue) <> Fix(CDbl(fieldValue)) Then

                            AddValidationError _
                                errors, _
                                errorCount, _
                                "Ïîëå """ & fieldCaption & _
                                """ äîëæíî ñîäåðæàòü öåëîå ÷èñëî: " & _
                                rangeName, _
                                rng

                        ElseIf CDbl(fieldValue) > 0 Then

                            Dim taskCheckResult As String

                            taskCheckResult = _
                                CheckJOINTask( _
                                    CLng(fieldValue), _
                                    formIndex _
                                )

                            If taskCheckResult <> "OK" Then

                                AddValidationError _
                                    errors, _
                                    errorCount, _
                                    taskCheckResult, _
                                    rng

                            End If

                        End If

                    End If

                End If

        End Select


        ' =========================================================
        ' ÃÐÓÏÏÀ 3. ÖÅËÛÅ ×ÈÑËÀ
        ' =========================================================

        Select Case fieldName

            Case COL_RESULT_ID_DB

                If valueText <> "" _
                   And IsNumeric(fieldValue) Then

                    If CDbl(fieldValue) <> _
