```vb
Private Function CheckSSFTask( _
    ByVal taskId As Long, _
    ByVal sampleCode As String, _
    ByVal formIndex As Long _
) As String

    Dim tasks As ListObject
    Set tasks = ActiveWorkbook.Worksheets("Task").ListObjects(1)

    Dim taskCheck As Range
    Set taskCheck = tasks.ListColumns("Номер задания").DataBodyRange.Find( _
        What:=taskId, LookAt:=xlWhole, SearchOrder:=xlByColumns)

    If taskCheck Is Nothing Then
        CheckSSFTask = "Указан неизвестный номер задания " & taskId & _
            " на странице " & formIndex & _
            ". Попробуйте обновить данные проекта или исправьте значение."
        Exit Function
    End If

    Dim taskRowIndex As Long
    taskRowIndex = taskCheck.Row - tasks.DataBodyRange.Row + 1

    If CStr(tasks.ListColumns("Код проекта").DataBodyRange.Cells(taskRowIndex, 1).Value) <> sampleCode Then
        CheckSSFTask = "Указан неверный номер задания " & taskId & _
            " на странице " & formIndex & _
            ". Шифр пробы в задании отличается от шифра пробы в исследовании."
        Exit Function
    End If

    CheckSSFTask = "OK"

End Function
```

