    ' =============================================================
    ' ÒÀÁËÈÖÀ JOIN_SOURCE_N
    ' =============================================================

    Dim sourceTable As ListObject
    Dim sourceTableName As String

    sourceTableName = _
        "JOIN_source_" & formIndex

    Set sourceTable = _
        sheetJOIN.ListObjects(sourceTableName)

    If Not ListColumnExists(sourceTable, COL_ROW_ID_DB) _
       Or Not ListColumnExists(sourceTable, COL_MIX_SAMPLE_CODE_FORM) _
