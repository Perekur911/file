Public Sub DeleteLastListGOR()
    
    Dim sheetGOR As Worksheet
    Set sheetGOR = ActiveWorkbook.Worksheets("GOR")
    
    Dim sheetGORresults As Worksheet
    Set sheetGORresults = ActiveWorkbook.Worksheets("GOR_results")
    
    Dim tableResults As ListObject
    Set tableResults = sheetGORresults.ListObjects("GOR_results")
    
    Dim lastForm As Long
    lastForm = sheetGOR.ListObjects.count
    
    If lastForm <= 2 Then
        MsgBox "Íåëüçÿ óäàëèòü 2 ïåðâûå ôîðìû"
        Exit Sub
    End If
    
    Dim countFormCols As Long
    countFormCols = sheetGOR.Range("GOR_2_sampleCode").Column - sheetGOR.Range("GOR_1_sampleCode").Column
    
    Dim firstColLastForm As Long
    firstColLastForm = GOR_FIRST_FORM_FIRST_COL + (lastForm - 1) * countFormCols
    
    Dim lastColLastForm As Long
    lastColLastForm = firstColLastForm + countFormCols - 1
    
    Dim headerCell As Range
    Dim namedRange As String
    
    For Each headerCell In tableResults.HeaderRowRange.Cells
        namedRange = "GOR_" & lastForm & "_" & CStr(headerCell.value)
        
        If NamedRangeExists(ActiveWorkbook, namedRange) Then
            ActiveWorkbook.Names(namedRange).Delete
        End If
    Next headerCell
    
    sheetGOR.Range( _
        sheetGOR.columns(firstColLastForm), _
        sheetGOR.columns(lastColLastForm) _
    ).EntireColumn.Delete
    
    Call DeleteCheckBoxesFromColumnRight(sheetGOR, firstColLastForm)

End Sub

