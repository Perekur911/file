Private Enum RecFormState
    REC_FORM_EMPTY = 0
    REC_FORM_RESERVED = 1
    REC_FORM_FILLED = 2
End Enum


Public Sub AddFormREC()

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetREC As Worksheet
    Set sheetREC = wb.Worksheets("Rec")

    Dim lastList As Long
    Dim lastColumn As Long
    Dim firstColumn As Long
    Dim lenght As Long

    lenght = sheetREC.Range("Rec_2_sampleCode").Column - sheetREC.Range("Rec_1_sampleCode").Column
    lastList = sheetREC.CheckBoxes.count \ REC_CHILD_COUNT_PER_FORM + 1

    lastColumn = lastList * lenght + REC_FIRST_FORM_FIRST_COL - 1
    firstColumn = lastColumn - lenght + 1

    sheetREC.Activate

    Dim oldCopyObjectsWithCells As Boolean
    oldCopyObjectsWithCells = Application.CopyObjectsWithCells
    
    Application.CopyObjectsWithCells = False
    
    sheetREC.Activate
    
    sheetREC.Range( _
        sheetREC.columns(firstColumn - lenght), _
        sheetREC.columns(lastColumn - lenght) _
    ).EntireColumn.Copy
    
    sheetREC.columns(firstColumn).PasteSpecial Paste:=xlPasteAll
    sheetREC.columns(firstColumn).PasteSpecial Paste:=xlPasteColumnWidths
    
    Application.CutCopyMode = False
    Application.CopyObjectsWithCells = oldCopyObjectsWithCells
    
    ' Номер страницы
    sheetREC.Cells(REC_PAGE_ROW, firstColumn + REC_PAGE_FIRST_COL - 1).value = lastList

    ' Создаём новые имена уровня книги для новой формы
    CreateRecParentNamesForNewForm wb, sheetREC, lastList - 1, lastList, lenght
    CreateRecChildNamesForNewForm wb, sheetREC, lastList - 1, lastList, lenght
    
    ' Принудительно обновляем формулы плотности
    Dim childIndex As Long

    For childIndex = 1 To REC_CHILD_COUNT_PER_FORM
        UpdateRecDensityFormula wb, lastList, childIndex
    Next childIndex
    
    
    ' создаем чекбоксы новой формы
    CreateRecFirstCheckBoxes wb, sheetREC, lastList

    ' Скрываем синие колонки начиная с 5-й
    HideRecExtraChildColumns wb, sheetREC, lastList, firstColumn, lastColumn, 4
    
    'добавляем кнопки скрытия/показа колонок
    CreateRecExtraColumnButtons lastList

SafeExit:

End Sub

Public Sub showExtraColumn(ByVal show As Boolean)
    
    Dim wb As Workbook
    Dim ws As Worksheet
    
    Set wb = ActiveWorkbook
    Set ws = wb.Worksheets("Rec")
    
    Dim formLenght As Long

    formLenght = ws.Range("Rec_2_sampleCode").Column - ws.Range("Rec_1_sampleCode").Column

    Dim sheetREC As Worksheet
    Set sheetREC = wb.Worksheets("Rec")
    
    Dim lenght As Integer
    lenght = sheetREC.Range("Rec_2_sampleCode").Column - sheetREC.Range("Rec_1_sampleCode").Column
    
    Dim currentForm As Integer
    currentForm = (activeCell.Column - REC_FIRST_FORM_FIRST_COL) \ lenght + 1
    
    Dim lastFormColumn As Long
    lastFormColumn = currentForm * formLenght + REC_FIRST_FORM_FIRST_COL - 1
    
    Dim firstFormColumn As Long
    firstFormColumn = lastFormColumn - formLenght + 1
    
    Dim countVisibleColumns As Integer
    
    countVisibleColumns = GetRecVisibleColumnCount(currentForm)
    
    If show Then
        If countVisibleColumns >= 12 Then
            Exit Sub
        End If
        HideRecExtraChildColumns wb, ws, currentForm, firstFormColumn, lastFormColumn, countVisibleColumns + 1
    Else
        If countVisibleColumns <= 4 Then Exit Sub
        
        If RecChildHasData(wb, currentForm, countVisibleColumns) Then Exit Sub
        
        HideRecExtraChildColumns wb, ws, currentForm, firstFormColumn, lastFormColumn, countVisibleColumns - 1
    End If
    SyncFormCheckBoxesVisibilityWithColumns ws
End Sub


Private Sub CreateRecParentNamesForNewForm( _
    ByVal wb As Workbook, _
    ByVal ws As Worksheet, _
    ByVal oldFormNumber As Long, _
    ByVal newFormNumber As Long, _
    ByVal formLength As Long)

    Dim tableRecResult As ListObject
    Set tableRecResult = wb.Worksheets("Rec_results").ListObjects("Rec_results")

    Dim headerCell As Range
    Dim fieldName As String

    Dim oldName As String
    Dim newName As String

    Dim oldRange As Range
    Dim newRange As Range

    For Each headerCell In tableRecResult.HeaderRowRange

        fieldName = CStr(headerCell.value)

        If fieldName = vbNullString Then GoTo ContinueLoop
        If fieldName = "dateTimeSync" Then GoTo ContinueLoop

        oldName = "Rec_" & oldFormNumber & "_" & fieldName
        newName = "Rec_" & newFormNumber & "_" & fieldName

        Set oldRange = GetNamedRangeStrict(wb, oldName)
        Set newRange = ws.Cells(oldRange.row, oldRange.Column + formLength)

        SetWorkbookLevelName wb, newName, newRange

        ResetCopiedCell newRange, oldFormNumber, newFormNumber

ContinueLoop:
    Next headerCell

End Sub

Private Sub CreateRecChildNamesForNewForm( _
    ByVal wb As Workbook, _
    ByVal ws As Worksheet, _
    ByVal oldFormNumber As Long, _
    ByVal newFormNumber As Long, _
    ByVal formLength As Long)

    Dim childFields As Variant

    childFields = Array( _
        COL_ROW_ID_REC_CHILD_DB, _
        COL_MIX_SAMPLE_CODE_CHILD_DB, _
        COL_MASS_FRACTION_CHILD_DB, _
        COL_P_TRANSFER_CHILD_DB, _
        COL_T_TRANSFER_CHILD_DB, _
        COL_DENSITY_CHILD_DB, _
        COL_FIRST_CHILD_DB, _
        COL_VOLUME_CHILD_DB, _
        COL_MASS_CHILD_DB _
    )

    Dim fieldIndex As Long
    Dim childIndex As Long

    Dim fieldName As String
    Dim oldName As String
    Dim newName As String

    Dim oldRange As Range
    Dim newRange As Range

    For fieldIndex = LBound(childFields) To UBound(childFields)

        fieldName = CStr(childFields(fieldIndex))

        For childIndex = 1 To REC_CHILD_COUNT_PER_FORM

            oldName = "Rec_" & oldFormNumber & "_" & fieldName & childIndex
            newName = "Rec_" & newFormNumber & "_" & fieldName & childIndex

            Set oldRange = GetNamedRangeStrict(wb, oldName)
            Set newRange = ws.Cells(oldRange.row, oldRange.Column + formLength)

            SetWorkbookLevelName wb, newName, newRange

            If fieldName = COL_FIRST_CHILD_DB Then
                newRange.value = False
            ElseIf fieldName <> COL_DENSITY_CHILD_DB Then
                ResetCopiedCell newRange, oldFormNumber, newFormNumber
            End If

        Next childIndex

    Next fieldIndex

End Sub

Private Sub UpdateRecDensityFormula( _
    ByVal wb As Workbook, _
    ByVal formNumber As Long, _
    ByVal childIndex As Long)

    Dim densityName As String
    Dim sampleCodeName As String
    Dim pTransferName As String
    Dim tTransferName As String

    densityName = "Rec_" & formNumber & "_" & COL_DENSITY_CHILD_DB & childIndex
    sampleCodeName = "Rec_" & formNumber & "_" & COL_MIX_SAMPLE_CODE_CHILD_DB & childIndex
    pTransferName = "Rec_" & formNumber & "_" & COL_P_TRANSFER_CHILD_DB & childIndex
    tTransferName = "Rec_" & formNumber & "_" & COL_T_TRANSFER_CHILD_DB & childIndex

    Dim densityCell As Range
    Set densityCell = GetNamedRangeStrict(wb, densityName)

    Dim q As String
    q = Chr$(34)

    densityCell.FormulaLocal = _
        "=@ЕСЛИ(" & sampleCodeName & "=" & q & q & _
        "; " & q & q & _
        "; getAPUnit2(" & sampleCodeName & _
        ";" & pTransferName & _
        ";" & tTransferName & _
        ";" & q & "psi" & q & _
        ";ИСТИНА;AP_results!$AA$1))"

End Sub

Public Sub SetWorkbookLevelName( _
    ByVal wb As Workbook, _
    ByVal rangeName As String, _
    ByVal targetRange As Range)

    DeleteNameIfExists wb, rangeName

    wb.Names.Add _
        name:=rangeName, _
        RefersTo:="=" & targetRange.Address(External:=True)

End Sub

Private Sub DeleteNameIfExists( _
    ByVal wb As Workbook, _
    ByVal rangeName As String)

    Dim ws As Worksheet

    On Error Resume Next

    wb.Names(rangeName).Delete

    For Each ws In wb.Worksheets
        ws.Names(rangeName).Delete
    Next ws

    On Error GoTo 0

End Sub

Public Function GetNamedRangeStrict( _
    ByVal wb As Workbook, _
    ByVal rangeName As String) As Range

    Dim resultRange As Range
    Dim ws As Worksheet

    On Error Resume Next
    Set resultRange = wb.Names(rangeName).RefersToRange
    On Error GoTo 0

    If Not resultRange Is Nothing Then
        Set GetNamedRangeStrict = resultRange
        Exit Function
    End If

    For Each ws In wb.Worksheets

        On Error Resume Next
        Set resultRange = ws.Names(rangeName).RefersToRange
        On Error GoTo 0

        If Not resultRange Is Nothing Then
            Set GetNamedRangeStrict = resultRange
            Exit Function
        End If

    Next ws

    Err.Raise vbObjectError + 2100, , _
        "Именованный диапазон не найден: " & rangeName

End Function

Public Sub ResetCopiedCell( _
    ByVal targetCell As Range, _
    ByVal oldFormNumber As Long, _
    ByVal newFormNumber As Long)

    If targetCell.HasFormula Then

        If targetCell.HasArray Then
            targetCell.FormulaArray = Replace( _
                targetCell.FormulaArray, _
                "_ " & oldFormNumber, _
                "_ " & newFormNumber _
            )
        Else
            targetCell.Formula = Replace( _
                targetCell.Formula, _
                "_" & oldFormNumber, _
                "_" & newFormNumber _
            )
        End If

    Else
        targetCell.value = vbNullString
    End If

End Sub

Private Sub CreateRecFirstCheckBoxes( _
    ByVal wb As Workbook, _
    ByVal ws As Worksheet, _
    ByVal formNumber As Long)

    Dim i As Long
    Dim rangeName As String
    Dim linkedCell As Range
    Dim area As Range
    Dim cb As CheckBox

    Const CB_SIZE As Double = 14

    For i = 1 To 12

        rangeName = "Rec_" & formNumber & "_" & COL_FIRST_CHILD_DB & i

        Set linkedCell = wb.Names(rangeName).RefersToRange

        If linkedCell.MergeCells Then
            Set area = linkedCell.MergeArea
        Else
            Set area = linkedCell
        End If

        Set cb = ws.CheckBoxes.Add( _
            area.Left, _
            area.Top, _
            area.Width, _
            area.Height _
        )
        
        With cb
            .name = "CheckBox_Rec_" & formNumber & "_" & i
            .caption = vbNullString
            .linkedCell = "'" & ws.name & "'!" & linkedCell.Address(False, False)
            .value = xlOff
            .Placement = xlMove
            .OnAction = "checkbox_disable"
        End With

        linkedCell.value = False

    Next i

End Sub

Private Function FindCheckBoxOnRange( _
    ByVal ws As Worksheet, _
    ByVal targetRange As Range) As CheckBox

    Dim cb As CheckBox
    Dim area As Range

    If targetRange.MergeCells Then
        Set area = targetRange.MergeArea.Cells(1, 1)
    Else
        Set area = targetRange.Cells(1, 1)
    End If

    For Each cb In ws.CheckBoxes

        If cb.TopLeftCell.row = area.row _
           And cb.TopLeftCell.Column = area.Column Then

            Set FindCheckBoxOnRange = cb
            Exit Function

        End If

    Next cb

    Err.Raise vbObjectError + 2200, , _
        "Не найден CheckBox для ячейки: " & area.Address(External:=True)

End Function

Private Sub HideRecExtraChildColumns( _
    ByVal wb As Workbook, _
    ByVal ws As Worksheet, _
    ByVal formNumber As Long, _
    ByVal firstFormCol As Long, _
    ByVal lastFormCol As Long, _
    ByVal visibleChildCount As Long)

    Const MIN_VISIBLE_CHILD_COUNT As Long = 4

    If visibleChildCount < MIN_VISIBLE_CHILD_COUNT Or visibleChildCount > REC_CHILD_COUNT_PER_FORM Then
        Err.Raise vbObjectError + 2400, , _
            "Количество видимых синих колонок должно быть от " & _
            MIN_VISIBLE_CHILD_COUNT & " до " & REC_CHILD_COUNT_PER_FORM & _
            ". Передано: " & visibleChildCount
    End If

    ' Сначала показываем всю область формы
    ws.Range( _
        ws.Cells(1, firstFormCol), _
        ws.Cells(1, lastFormCol - 1) _
    ).EntireColumn.Hidden = False

    ' Если нужно показать все 12 — больше ничего не скрываем
    If visibleChildCount = REC_CHILD_COUNT_PER_FORM Then
        Exit Sub
    End If

    Dim firstHiddenName As String
    Dim firstHiddenRange As Range

    ' Первая скрываемая синяя колонка = visibleChildCount + 1
    firstHiddenName = "Rec_" & formNumber & "_" & _
                      COL_MIX_SAMPLE_CODE_CHILD_DB & _
                      (visibleChildCount + 1)

    Set firstHiddenRange = GetNamedRangeStrict(wb, firstHiddenName)

    ' Начиная со следующей после видимой — скрываем
    ws.Range( _
        ws.Cells(1, firstHiddenRange.Column), _
        ws.Cells(1, lastFormCol - 1) _
    ).EntireColumn.Hidden = True
    
    SyncFormCheckBoxesVisibilityWithColumns ws
    
End Sub


Public Function Save_Rec(Optional ByVal taskStatus As String = "") As macroResult
    On Error GoTo ErrHandler
    Save_Rec = MACRO_FAILED
    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Dim sheetREC As Worksheet
    Set sheetREC = wb.Worksheets("Rec")

    Dim sheetRecResults As Worksheet
    Set sheetRecResults = wb.Worksheets("Rec_results")

    Dim sheetRecSourceData As Worksheet
    Set sheetRecSourceData = wb.Worksheets("Rec_sourceData")

    Dim recTable As ListObject
    Set recTable = sheetRecResults.ListObjects("Rec_results")

    Dim recSourceDataTable As ListObject
    Set recSourceDataTable = sheetRecSourceData.ListObjects("Rec_sourceData")

    Dim parentRows As Collection
    Set parentRows = New Collection

    Dim newResultIDs As Collection
    Set newResultIDs = New Collection

    Dim childRows As Collection
    Set childRows = New Collection

    Dim sourceFormNumbers As Collection
    Set sourceFormNumbers = New Collection

    Dim i As Long
    Dim formState As RecFormState
    i = 1

    Do While NamedRangeExists(wb, "Rec_" & i & "_sampleCode")
        
        formState = Get_Rec_FormState(i)

        Select Case formState
    
            Case REC_FORM_EMPTY, REC_FORM_RESERVED
                GoTo NextForm
    
            Case REC_FORM_FILLED
                ' продолжаем
    
        End Select

        If sheetREC.Range("Rec_" & i & "_TaskId").MergeArea.Interior.ColorIndex = 3 Then
            GoTo NextForm
        End If

        If Not Validate_Rec_Form(i) Then Exit Function

        Dim resultIdValue As Variant
        Dim parentKey As String

        resultIdValue = sheetREC.Range("Rec_" & i & "_" & COL_RESULT_ID_REC_DB).Value

        If Len(NormalizeKeyValue(resultIdValue)) = 0 Or NormalizeKeyValue(resultIdValue) = "0" Then
            parentKey = "temp_" & i
        Else
            parentKey = NormalizeKeyValue(resultIdValue)
        End If

        If IsNumeric(parentKey) Then newResultIDs.Add parentKey

        Dim parentRow() As Variant
        ReDim parentRow(1 To recTable.ListColumns.count)

        Dim headerCell As Range
        Dim headerName As String
        Dim parentColIndex As Long

        For Each headerCell In recTable.HeaderRowRange.Cells

            headerName = CStr(headerCell.value)
            parentColIndex = recTable.ListColumns(headerName).index

            If headerName = "dateTimeSync" Then
                parentRow(parentColIndex) = Format$(Now, "yyyy-mm-dd hh:nn:ss")

            ElseIf headerName = COL_RESULT_ID_REC_DB Then
                parentRow(parentColIndex) = parentKey

            ElseIf NamedRangeExists(wb, "Rec_" & i & "_" & headerName) Then
                parentRow(parentColIndex) = FormatValueForSyncText( _
                    headerName, _
                    sheetREC.Range("Rec_" & i & "_" & headerName).value _
                )

            Else
                parentRow(parentColIndex) = vbNullString
            End If

        Next headerCell

        parentRows.Add parentRow
        sourceFormNumbers.Add i

        Dim childIndex As Long

        For childIndex = 1 To REC_CHILD_COUNT_PER_FORM

            Dim hasChildData As Boolean
            Dim oldRowIdRec As String

            hasChildData = RecChildHasData(wb, i, childIndex)
            
            If hasChildData Then
                Call ConvertRecDensityFormulaToValue(wb, i, childIndex)
            End If

            oldRowIdRec = NormalizeKeyValue( _
                GetNamedRangeStrict( _
                    wb, _
                    "Rec_" & i & "_" & COL_ROW_ID_REC_CHILD_DB & childIndex _
                ).Value _
            )

            If hasChildData Or Len(oldRowIdRec) > 0 Then

                Dim childRow() As Variant
                ReDim childRow(1 To recSourceDataTable.ListColumns.count)

                childRow(recSourceDataTable.ListColumns(COL_ROW_ID_REC_CHILD_DB).index) = oldRowIdRec
                childRow(recSourceDataTable.ListColumns(COL_RESULT_ID_REC_CHILD_DB).index) = parentKey

                If hasChildData Then
                    FillRecChildField wb, recSourceDataTable, childRow, i, childIndex, COL_MIX_SAMPLE_CODE_CHILD_DB
                    FillRecChildField wb, recSourceDataTable, childRow, i, childIndex, COL_MASS_FRACTION_CHILD_DB
                    FillRecChildField wb, recSourceDataTable, childRow, i, childIndex, COL_P_TRANSFER_CHILD_DB
                    FillRecChildField wb, recSourceDataTable, childRow, i, childIndex, COL_T_TRANSFER_CHILD_DB
                    FillRecChildField wb, recSourceDataTable, childRow, i, childIndex, COL_DENSITY_CHILD_DB
                    FillRecChildField wb, recSourceDataTable, childRow, i, childIndex, COL_FIRST_CHILD_DB
                    FillRecChildField wb, recSourceDataTable, childRow, i, childIndex, COL_VOLUME_CHILD_DB
                    FillRecChildField wb, recSourceDataTable, childRow, i, childIndex, COL_MASS_CHILD_DB
                End If

                childRows.Add childRow
            End If

        Next childIndex

NextForm:
        i = i + 1
    Loop

    Dim newHashResult As String
    Dim oldHashResult As String

    newHashResult = CalculateCurrentRecHash()
    oldHashResult = GetWorkbookMetadataProperty(wb, PROP_REC_DATA_HASH)

    If newHashResult = oldHashResult Then
        Save_Rec = MACRO_NO_CHANGES
        Exit Function
    End If

    Dim cellID As Range
    Dim oldResultID As String

    If Not recTable.DataBodyRange Is Nothing Then

        For Each cellID In recTable.ListColumns(COL_RESULT_ID_REC_DB).DataBodyRange.Cells

            If Not IsError(cellID.Value) Then
                oldResultID = NormalizeKeyValue(cellID.Value)

                If IsNumeric(oldResultID) And oldResultID <> "0" Then
                    If Not CollectionContains(newResultIDs, oldResultID) Then

                        MsgBox "Удалены данные синхронизированной формы REC. " & _
                            "Синхронизация невозможна. Вызовите загрузку данных из БД.", vbExclamation

                        Save_Rec = MACRO_FAILED
                        Exit Function
                    End If
                End If
            End If

        Next cellID

    End If

    WriteCollectionToListObject recTable, parentRows
    WriteCollectionToListObject recSourceDataTable, childRows

    Dim syncResult As String
    syncResult = RunStudySync("save", studies:="REC", taskStatus:=taskStatus)

    If InStr(1, syncResult, """ok"": true", vbTextCompare) > 0 Then

        Call DeleteEmptyRowsByColumns( _
            recSourceDataTable, COL_ROW_ID_REC_CHILD_DB, _
            Array(COL_MIX_SAMPLE_CODE_CHILD_DB, COL_P_TRANSFER_CHILD_DB, _
                COL_T_TRANSFER_CHILD_DB, COL_MASS_CHILD_DB) _
        )

        Call Load_Rec_results_to_forms("by_key", Array(COL_RESULT_ID_REC_DB, COL_ROW_ID_REC_CHILD_DB))
        Call SetWorkbookMetadataProperty(wb, PROP_REC_DATA_HASH, newHashResult, False)
    Else
        MsgBox "Python-синхронизация REC не подтвердила успешное сохранение." & _
            vbCrLf & vbCrLf & syncResult, vbExclamation
        Exit Function
    End If

    Save_Rec = MACRO_CHANGED
    Exit Function

ErrHandler:
    Debug.Print Err.Number & ": " & Err.Description
    Save_Rec = MACRO_FAILED
End Function

Public Function CalculateCurrentRecHash() As String

    Dim data As Object
    Set data = Build_Rec_HashData(ActiveWorkbook)

    CalculateCurrentRecHash = CalculateDataHash(data)

End Function


Private Function Build_Rec_HashData(ByVal wb As Workbook) As Object

    Dim data As Object
    Set data = CreateObject("Scripting.Dictionary")

    Dim sheetREC As Worksheet
    Set sheetREC = wb.Worksheets("Rec")

    Dim recTable As ListObject
    Set recTable = wb.Worksheets("Rec_results").ListObjects("Rec_results")

    Dim childFields As Variant
    childFields = Array( _
        COL_MIX_SAMPLE_CODE_CHILD_DB, COL_MASS_FRACTION_CHILD_DB, _
        COL_P_TRANSFER_CHILD_DB, COL_T_TRANSFER_CHILD_DB, _
        COL_DENSITY_CHILD_DB, COL_FIRST_CHILD_DB, _
        COL_VOLUME_CHILD_DB, COL_MASS_CHILD_DB)

    Dim formIndex As Long
    Dim resultIndex As Long
    formIndex = 1

    Do While NamedRangeExists(wb, "Rec_" & formIndex & "_sampleCode")

        If Get_Rec_FormState(formIndex) <> REC_FORM_FILLED Then GoTo NextForm

        If sheetREC.Range("Rec_" & formIndex & "_TaskId").MergeArea.Interior.ColorIndex = 3 Then
            GoTo NextForm
        End If

        resultIndex = resultIndex + 1

        Dim headerCell As Range
        Dim headerName As String
        Dim formatValue As Variant

        For Each headerCell In recTable.HeaderRowRange.Cells

            headerName = CStr(headerCell.Value)

            Select Case LCase$(headerName)
                Case "datetimesync", "resultidrec"

                Case Else
                    If NamedRangeExists(wb, "Rec_" & formIndex & "_" & headerName) Then
                        formatValue = FormatValueForSyncText( _
                            headerName, sheetREC.Range("Rec_" & formIndex & "_" & headerName).Value)
                    Else
                        formatValue = vbNullString
                    End If

                    data.Add resultIndex & "." & headerName, formatValue
            End Select

        Next headerCell

        Dim childIndex As Long
        Dim childDataIndex As Long
        Dim fieldIndex As Long
        Dim fieldName As String
        Dim rangeName As String

        For childIndex = 1 To REC_CHILD_COUNT_PER_FORM

            If RecChildHasData(wb, formIndex, childIndex) Then

                childDataIndex = childDataIndex + 1

                For fieldIndex = LBound(childFields) To UBound(childFields)

                    fieldName = CStr(childFields(fieldIndex))
                    rangeName = "Rec_" & formIndex & "_" & fieldName & childIndex

                    formatValue = FormatValueForSyncText( _
                        fieldName, GetNamedRangeStrict(wb, rangeName).Value)

                    data.Add resultIndex & "." & childDataIndex & "." & fieldName, formatValue

                Next fieldIndex

            End If

        Next childIndex

NextForm:
        formIndex = formIndex + 1
    Loop

    Set Build_Rec_HashData = data

End Function

Sub checkbox_disable()
    
    Dim sheetREC As Worksheet
    Set sheetREC = ActiveWorkbook.Worksheets("Rec")
    
    Dim chbox As CheckBox
    Set chbox = sheetREC.CheckBoxes(Application.Caller)
    Dim list As Integer
    list = Split(chbox.name, "_")(2)
    Dim ch As CheckBox
    Dim i As Integer
    If chbox.value = xlOn Then
        For i = 1 To 12
            Set ch = sheetREC.CheckBoxes("CheckBox_Rec_" & list & "_" & i)
            If ch.name <> chbox.name Then
                ch.value = xlOff
            End If
        Next i
    Else
        For i = 1 To 12
            Set ch = sheetREC.CheckBoxes("CheckBox_Rec_" & list & "_" & i)
            If ch.name <> chbox.name Then
                If ch.value = xlOn Then
                    Exit For
                End If
            End If
        Next i
        chbox.value = xlOn
    End If
    
End Sub


Sub equipmentModelsRefreshRec()

