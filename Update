Private Function GOR_SourceTableHasData(ByVal formIndex As Long) As Boolean

    GOR_SourceTableHasData = False

    Dim sheetGOR As Worksheet
    Set sheetGOR = ActiveWorkbook.Worksheets("GOR")

    If Not ListObjectExists(sheetGOR, "GOR_source_" & formIndex) Then
        Exit Function
    End If

    Dim sourceTable As ListObject
    Set sourceTable = sheetGOR.ListObjects("GOR_source_" & formIndex)

    If sourceTable.DataBodyRange Is Nothing Then
        Exit Function
    End If

    If Not ListColumnExists(sourceTable, COL_GOR_SAMPLE_CODE_DB) Then
        Exit Function
    End If

    If Not ListColumnExists(sourceTable, COL_GOR_TYPE_PH_DB) Then
        Exit Function
    End If

    Dim rowIndex As Long
    Dim sampleCodeValue As Variant
    Dim typePhValue As Variant

    For rowIndex = 1 To sourceTable.ListRows.count

        sampleCodeValue = sourceTable.DataBodyRange.Cells( _
            rowIndex, _
            sourceTable.ListColumns(COL_GOR_SAMPLE_CODE_DB).index _
        ).value

        typePhValue = sourceTable.DataBodyRange.Cells( _
            rowIndex, _
            sourceTable.ListColumns(COL_GOR_TYPE_PH_DB).index _
        ).value

        If IsError(sampleCodeValue) Or IsError(typePhValue) Then
            GOR_SourceTableHasData = True
            Exit Function
        End If

        If Trim$(CStr(sampleCodeValue)) <> "" Then
            GOR_SourceTableHasData = True
            Exit Function
        End If

        If Trim$(CStr(typePhValue)) <> "" Then
            GOR_SourceTableHasData = True
            Exit Function
        End If

    Next rowIndex

End Function

