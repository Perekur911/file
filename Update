Обработка заняла 51s

Подставь свой список в VALUES. Запрос добавит только те пары (taskid, status), которых ещё нет в TaskStatus. Если одна пара повторяется в самом списке, он возьмёт строку с самым ранним dateTime.

WITH incoming (status, taskid, task_type, "dateTime", statusComment) AS (
    VALUES
        ('В работе', 101, 'AP',  '2026-11-20 09:00:00', NULL),
        ('Готово',   101, 'AP',  '2026-11-20 12:30:00', 'Проверено'),
        ('В работе', 102, 'GOR', '2026-11-20 10:15:00', NULL)
),
ranked AS (
    SELECT incoming.*,
           ROW_NUMBER() OVER (
               PARTITION BY taskid, status
               ORDER BY "dateTime"
           ) AS rn
    FROM incoming
)
INSERT INTO TaskStatus (status, taskid, task_type, "dateTime", statusComment)
SELECT r.status, r.taskid, r.task_type, r."dateTime", r.statusComment
FROM ranked AS r
WHERE r.rn = 1
  AND NOT EXISTS (
      SELECT 1
      FROM TaskStatus AS t
      WHERE t.taskid IS r.taskid
        AND t.status IS r.status
  );
