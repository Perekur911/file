    GetCurrentProject = CStr(wsOP.ListObjects("ChoosenProject").DataBodyRange(1, 1).value)

    If Len(Trim$(GetCurrentProject)) = 0 Then
        Err.Raise vbObjectError + 1000, , "Не выбран проект в таблице ChoosenProject."
    End If

End Function

